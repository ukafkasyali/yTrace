 height: 48px; padding-inline: 24px; }\\n .assistant-capability { font-size: 12px; color: var(--quiet); }\\n+.assistant-model-select { max-width: 140px; border: 0; background: transparent; color: var(--quiet); font-size: 11px; text-align: right; }\\n+.assistant-model-select:focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }\\n .model-input-status { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 24px; border-bottom: 1px solid var(--line); }\\n .model-input-status > div { display: grid; gap: 5px; }\\n .model-input-status strong { font-size: 14px; font-weight: 500; }\\n@@ -269,6 +271,9 @@ input,textarea{caret-color:var(--accent)}\\n .prediction-facts { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; color: var(--quiet); font-size: 12px; }\\n .prediction-facts strong { color: var(--text); font-weight: 500; }\\n .assistant-answer .prediction-caution { font-size: 11px; color: var(--quiet); line-height: 1.5; margin-top: 10px; }\\n+.generated-rationale { margin-top: 12px; color: #b8c6c1; font-size: 11px; }\\n+.generated-rationale summary { cursor: pointer; color: var(--accent); }\\n+.generated-rationale p { margin-top: 7px; line-height: 1.55; }\\n .measured-summary { margin-top: 18px; }\\n .measured-summary h3 { font-size: 11px; color: var(--quiet); font-weight: 500; margin-bottom: 5px; text-transform: uppercase; letter-spacing: .04em; }\\n .measured-summary p { color: #c5ced1; font-size: 12px; line-height: 1.55; }\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a099d0-3015-7732-b534-5b9f4604a0b7","create_time":1789288129.693458}}}
