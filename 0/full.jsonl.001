5px;margin-bottom:12px}.workspace-section p{color:#b5c1c5;font-size:13px;max-width:720px;line-height:1.7}.status-note{color:#b7c7c0;background:#25312c;border:1px solid #43554b;padding:9px 12px;border-radius:4px;margin:10px 0;display:flex;align-items:center;gap:8px;font-size:12px}.data-table{width:100%;border-collapse:collapse;font-size:12px}.data-table th{text-align:left;color:#a9b6bb;font-weight:400;font-size:11px}.data-table th,.data-table td{padding:10px 14px 10px 0;border-bottom:1px solid #333e43}.data-table td{color:#d4dfe1}.field-row{display:flex;align-items:end;gap:12px;flex-wrap:wrap;margin:14px 0}.field-row label{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#bdc9ce;flex:1;min-width:180px}.field-row input,.field-row select,.workspace-section textarea{background:#20282c;border:1px solid #45535a;border-radius:4px;color:var(--text);padding:9px 12px;min-height:36px;width:100%}.field-row input:disabled{opacity:.55}.error-message{color:#efb0a4!important;font-size:12px}.empty-state{border:1px dashed #465358;border-radius:4px;display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:20px;color:#a9b8be;margin:16px 0}.empty-state h3{color:#d2dedf}.table-scroll{max-width:100%;overflow:auto;scrollbar-gutter:stable}.source-results{display:flex;flex-direction:column;gap:10px;margin:12px 0;padding:0;list-style:none}.source-results article,.source-results li,.model-result{padding:16px 0;border-bottom:1px solid #3b464b}.source-results h3,.model-result h3{font-size:15px}.source-results a{color:var(--accent)}.ingestion-stages{display:flex;gap:18px;flex-wrap:wrap;margin:15px 0;padding:0;list-style:none;color:var(--quiet)}.ingestion-stages li{display:flex;align-items:center;gap:6px}.comparison-results{display:flex;flex-direction:column;gap:12px}.answer-text{white-space:pre-wrap;line-height:1.7}.workspace-section dl{display:grid;grid-template-columns:140px 1fr;gap:8px 20px;font-size:12px}.workspace-section dt{color:var(--quiet)}.workspace-secti