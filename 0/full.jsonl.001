t:12px;padding-right:12px}.event-browser{width:100px}.range-title>span{font-size:9px}.range-row>span:last-child{width:65px;font-size:9px}.range-caption{font-size:10px}.explorer-footer{font-size:9px;padding-left:12px;padding-right:10px}.plot-footer{font-size:9px;flex-wrap:wrap}.transport{position:fixed;z-index:20;bottom:32px;left:0;right:0;height:77px;flex-wrap:wrap;gap:4px 12px;padding:6px 12px;background:#1c2225}.transport-controls{gap:2px}.transport-controls .icon-button{width:30px;height:30px}.replay-clock{gap:5px}.replay-clock strong{font-size:11px}.replay-clock>span{font-size:9px}.timeline-control{order:5;flex-basis:100%;margin:3px 3px 8px}.play-state{display:none}.speed-control{margin-left:auto}.speed-control select{height:31px}.selection-footer{position:fixed;z-index:21;bottom:0;left:0;right:0;padding:0 12px;gap:8px;font-size:9px}.selection-footer form,.selection-footer .annotation-key{display:none}.selection-footer strong{font-size:9px}.secondary-view{padding:15px}.workspace-heading{align-items:flex-start;flex-direction:column;gap:10px}.workspace-heading h1,.workspace-heading h2{font-size:22px}.field-row{align-items:stretch;flex-direction:column}.field-row label{min-width:0}.data-table{font-size:11px}.data-table th,.data-table td{padding-right:10px;min-width:65px}.workspace-section dl{grid-template-columns:1fr;gap:3px}.workspace-section dd{margin-bottom:10px}.conversation{padding:18px 14px}.composer{margin-left:12px;margin-right:12px}.composer-context{font-size:9px}.composer textarea{font-size:16px}.composer .mode-select select{max-width:190px}.send-button{width:36px;height:34px}.suggestion-list button{min-height:44px}.evidence-links button{min-height:36px}.text-button{min-height:32px}.plot-actions .icon-button{width:34px;height:34px}}\nfrontend/src/styles.css:67:.evidence-links button{font-size:12px;padding:5px 9px;min-height:32px}\nfrontend/src/styles.css:157:.decision-evidence{margin:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0}.decision-evidence-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.decision-evidence h3{font-size:17px}.decision-evidence h4{font-size:12px;margin:18px 0 8px;color:var(--text)}.evidence-count{color:var(--quiet);font-size:11px}.decision-outcome{margin:10px 0!important;max-width:850px;color:var(--quiet)!important;line-height:1.55!important}.decision-outcome strong{color:var(--text)}.workspace-section dl.decision-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:14px 0}.decision-metrics>div{padding:10px 14px;border-right:1px solid var(--line)}.decision-metrics>div:first-child{padding-left:0}.decision-metrics>div:last-child{border-right:0}.decision-metrics dt,.evidence-table small{display:block;color:var(--quiet);font-size:10px}.decision-metrics dd{margin:3px 0 0;font-size:12px}.requirement-evidence-help{color:var(--quiet)!important;font-size:11px!important;margin:-3px 0 8px!important}.evidence-table{min-width:720px}.evidence-table th,.evidence-table td{vertical-align:top}.evidence-table td:first-child{min-width:170px}.evidence-table td:last-child{min-width:300px}.evidence-table a{display:inline-flex;align-items:center;gap:4px;min-height:28px}.evidence-status{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}.evidence-verified{color:var(--accent)}.evidence-missing,.evidence-not_found,.evidence-conflicting,.evidence-unverified{color:#efb0a4}.requirement-evidence ul{list-style:none;margin:0;padding:0}.requirement-evidence details summary{font-size:10px!important;color:var(--quiet)!important}.requirement-evidence-item{display:grid;grid-template-columns:minmax(90px,1fr) minmax(130px,1fr) auto;gap:4px 12px;align-items:start}.requirement-evidence-item>div{display:flex;flex-direction:column}.requirement-evidence-item>div>span{color:var(--quiet);font-size:9px}.requirement-evidence-item>div>strong{font-size:11px;font-weight:500;overflow-wrap:anywhere}.requirement-evidence-item>div>small{font-size:9px}.requirement-evidence-item>a{white-space:nowrap;font-size:10px}.requirement-evidence-item>p{grid-column:1/-1;color:var(--quiet)!important;font-size:9px!important;line-height:1.5!important;margin:2px 0 6px!important}.evidence-empty{color:var(--quiet);font-size:11px}.discovery-leads{margin-top:16px;border-top:1px solid var(--line);padding-top:8px}.discovery-leads>p{color:var(--quiet)!important;font-size:11px!important;max-width:760px}.discovery-leads ul{list-style:none;margin:4px 0 0;padding:0}.discovery-leads li{display:grid;grid-template-columns:minmax(180px,1fr) minmax(240px,2fr);gap:18px;padding:9px 0;border-bottom:1px solid var(--line);font-size:11px}.discovery-leads a{display:inline-flex;align-items:center;gap:4px}.discovery-leads span{color:var(--quiet)}\nfrontend/src/styles.css:158:.refinement-results{display:grid;gap:8px;margin:14px 0}.refinement-result{border-left:1px solid var(--line);padding:8px 12px;background:var(--raised)}.refinement-recommendation_changed,.refinement-evidence_expanded{border-left-color:var(--accent)}.refinement-recommendation_withheld,.refinement-candidates_added{border-left-color:var(--amber)}.refinement-result>strong{font-size:12px}.refinement-result>p{margin:3px 0!important;color:var(--quiet)!important;font-size:11px!important}.refinement-result>p strong{color:var(--text)}.refinement-result details{margin-top:4px}.refinement-result summary{cursor:pointer;color:var(--quiet);font-size:10px}.refinement-result details p{display:grid;grid-template-columns:110px 1fr;gap:8px;margin:5px 0!important;color:var(--quiet)!important;font-size:10px!important}.refinement-result details span{color:var(--text)}\nfrontend/src/styles.css:159:@media(max-width:850px){section.scout-approval>.scout-approval-grid{grid-template-columns:1fr;gap:18px}.scout-approval-choice select,.scout-refinement textarea{font-size:16px}.decision-evidence-heading{flex-direction:column;gap:6px}.workspace-section dl.decision-metrics{grid-template-columns:1fr}.decision-metrics>div{padding:9px 0;border-right:0;border-bottom:1px solid var(--line)}.decision-metrics>div:last-child{border-bottom:0}.table-scroll{padding-bottom:4px}.evidence-table a{min-height:34px}}\nfrontend/src/styles.css:271:.evidence-links { margin-top: 18px; }\nfrontend/src/styles.css:272:.evidence-links button { min-height: 34px; }\nfrontend/src/lib/modelWindow.test.ts:8:  it('accepts exact raw input and rejects display, subsets, gaps, and other lengths', () => {\nfrontend/src/lib/modelWindow.test.ts:17:  it('fits to raw bounds without using future samples or padding a short history', () => {\nfrontend/src/lib/rawWindow.test.ts:4:import { withRawWindow } from './rawWindow';\nfrontend/src/lib/rawWindow.test.ts:18:  resolution: 'raw', series: ids.map((channelId, i) => ({ channelId, timeSec: times, values: times.map(t => t * (i + 1)) })),\nfrontend/src/lib/rawWindow.test.ts:21:describe('on-demand raw model window', () => {\ndocs/submission/README.md:1:# Trace: evidence-backed robot contact-event investigation\ndocs/submission/README.md:3:Trace helps a robotics engineer investigate a recorded contact event, inspect synchronized torque measurements and a trained OpenTSLM interpretation, and export the evidence for a teammate. Its immediate business hypothesis is less time spent assembling a correct incident report. That time saving has **not yet been measured**.\ndocs/submission/README.md:5:## Challenge audit and evidence\ndocs/submission/README.md:11:observed in the private deployment, and what still needs evidence.\ndocs/submission/README.md:13:| Requirement | Repository artifact | Verified / observed evidence | Remaining gap |\ndocs/submission/README.md:19:| Working evidence-linked demo | [Demo script](DEMO.md), [smoke receipt](demo/smoke-result.json), [exported investigation](demo/investigation-example.json) | Private canary-v4 path was smoke-tested; export retains telemetry receipt, measurements and prediction separately | The three fixed examples are not a quality benchmark; raw coverage remains limited |\ndocs/submission/README.md:50:- Main `126a8c6` includes PR #9's unified builder and PR #10's bounded documentation evidence. This work uses both existing dataset contracts and does not add another document-search backend.\ndocs/submission/README.md:51:- Open [PR #3, Add LangGraph evidence-complete dataset scout](https://github.com/ukafkasyali/ysamet/pull/3) is mergeable. It owns dataset discovery, requirement preflight, review and the Data source UI. It remains a separate reviewed integration; no duplicate scout or broad runtime web-search agent was added here.\ndocs/submission/README.md:57:The demonstration is replay-only. Publisher markers do not prove physical causes or production safety stops. The dataset is one robot with experimental class/implement confounding and unknown subject identities. Strongest-joint labels and evidence intervals are derived signal targets. Measured joint articulation is available for the demo recording, but world pose and contact location are not reconstructed. Raw model input is available only within `[4,9)` seconds of the bundled recording; wider overview plots are reduced data.\ndocs/submission/README.md:61:Use the pilot to establish whether evidence navigation and export reduce correct-report time. Expand raw-window access through the existing adapter before claiming cross-run investigation. Evaluate output-contract changes on validation. Add incident retrieval or document RAG only for a demonstrated investigation question, and keep held-out answers out of retrieval.\nfrontend/src/lib/useRawWindow.ts:5:import { withRawWindow } from './rawWindow';\ndocs/submission/timenet/part1-profile.json:7:    \"raw_data_copied\": false\ndocs/submission/timenet/part1-profile.json:401:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:414:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:427:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:440:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:453:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:466:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:479:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:492:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:505:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:518:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:531:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:544:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:557:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:570:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:583:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:596:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:609:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:622:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:635:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:648:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:661:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:674:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:687:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:700:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:713:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:726:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:739:            \"evidence\": [\ndocs/submission/timenet/part1-profile.json:817:        \"evidence\": [\ndocs/submission/timenet/part1-profile.json:841:        \"evidence\": [\ndocs/submission/timenet/part1-profile.json:865:        \"evidence\": [\ndocs/submission/timenet/part1-profile.json:887:        \"evidence\": [\ndocs/submission/timenet/part1-profile.json:949:      \"evidence\": [\ndocs/submission/timenet/part1-profile.json:959:      \"evidence\": [\ndocs/submission/timenet/part1-profile.json:968:      \"evidence\": [\ndocs/submission/timenet/part1-profile.json:979:    \"The intended prediction target and evaluation protocol are not specified by the raw batch.\"\nfrontend/src/recordings/RecordingExplorer.tsx:26:    <footer className=\"explorer-footer\"><details className=\"marker-explainer\"><summary><Info size={13}/><span>{selectedMarker ? `${selectedMarker.label} · marker details` : 'What is a marker?'}</span></summary><div className=\"marker-detail\"><strong>{selectedMarker ? `${selectedMarker.label} at ${selectedMarker.timeSeconds.toFixed(3)} s` : 'Publisher event marker'}</strong><p>This timestamp comes from <span className=\"mono\">{selectedMarker?.source ?? 'JK_moments'}</span>, the dataset publisher's manual event annotation. It helps navigate the recording, but it is not an independently verified exact collision onset.</p>{selectedMarker && <p className=\"marker-analysis-status\">{selectedMarkerHasRaw ? 'Selecting it automatically runs measured analysis and OpenTSLM on the surrounding raw window.' : 'Selecting it automatically summarizes the available display samples. OpenTSLM requires the full-resolution window from the data adapter.'}</p>}{selectedMarker && <button className=\"text-button\" onClick={() => onMarker(selectedMarker)}>Analyze its context <ChevronRight size={13}/></button>}</div></details><span className=\"data-resolution\">{stats?.resolution === 'raw' ? 'Raw samples' : 'Display samples'}</span></footer>\ndocs/submission/DEMO.md:15:| 0:00–0:15 | Show seven synchronized torque traces | “After a contact incident, an engineer needs a defensible account of what changed. The manual way is scrolling seven synchronized 1 kHz traces and assembling notes by hand. Trace turns a recorded interval into measurements, a model interpretation, and evidence they can share.” |\ndocs/submission/DEMO.md:17:| 0:30–0:55 | Read the actual automatic analysis | “These torque ranges are calculated from 1,024 raw samples per joint. OpenTSLM separately predicts event type, affected joints, and timing. The two sources remain visible.” |\ndocs/submission/DEMO.md:18:| 0:55–1:10 | Click the input evidence link | “The answer links back to its exact input interval. Joint 2 has the largest measured range here; the model names J4 as its strongest disturbance. These are different quantities, and neither identifies the physical impact location.” |\ndocs/submission/DEMO.md:19:| 1:10–1:20 | Click Export investigation | “The report preserves the recording, interval, annotation, measurements, generated output, checkpoint and input receipt for a teammate.” |\ndocs/submission/DEMO.md:21:| 1:40–1:50 | Show TimeNet receipt | “Both original dataset parts passed build, load and raw-array validation. Code, configuration, predictions and scoring are reproducible.” |\ndocs/submission/DEMO.md:24:Do not memorize a generated answer as a guaranteed future result. Read the actual response. The model and measured quantities can disagree; that is a reason to inspect evidence. The exact archived live response is in `demo/smoke-result.json`.\ndocs/submission/DEMO.md:28:**Why use a TSLM when the feature baseline wins?** The experiment establishes that direct feature methods are very competitive on this controlled dataset, whose labels are themselves derived from signal formulas. The decomposed confusion matrices show the trained OpenTSLM checkpoint matches the baseline's accuracy on the windows it answers (98.5% on 399 of 512); its measured gap is failing to produce a valid structured \"no event\" summary on 46.5% of free-motion windows. That is an output-reliability problem, not evidence the model misreads contact events — and it is the checkpoint's documented next improvement, to be selected on validation. The temporal-language interface additionally provides readable interpretations and free-form questions that a feature classifier cannot. We do not claim the TSLM is necessary for calculating peaks or ranges.\ndocs/submission/DEMO.md:30:**How is this faster than just looking at charts?** The manual workflow is scrolling seven synchronized 1 kHz traces and writing notes by hand; in Trace the same incident is marker → analyze → linked evidence → export in a few interactions, as shown in the demo. We deliberately state this as a workflow demonstration, not a measured time saving: the timed engineer study is prepared (`PILOT.md`) but has not been run.\ndocs/submission/DEMO.md:36:**Can it find an unknown event anywhere in a run?** The demo opens publisher-marked intervals. General unannotated incident localization and multi-recording raw-window inference are not demonstrated by the bundled fixture.\nfrontend/src/lib/rawWindow.ts:8:  if (response.resolution !== 'raw' || w.datasetId !== datasetId || w.recordingId !== data.recording.id ||\nfrontend/src/lib/rawWindow.ts:11:    throw new Error('The raw response does not match this recording and selected model window.');\nfrontend/src/lib/rawWindow.ts:17:      throw new Error('The raw response must contain seven ordered joints and 1,024 contiguous finite samples at 1 kHz.');\ndocs/submission/timenet/part2-validation.json:145:      \"expected\": \"exact raw equality\",\ndocs/submission/timenet/part2-validation.json:158:      \"expected\": \"exact raw equality\",\ndocs/submission/timenet/part2-validation.json:171:      \"expected\": \"exact raw equality\",\ndocs/submission/timenet/part2-validation.json:183:      \"expected\": \"exact raw equality\",\ndocs/submission/timenet/README.md:3:On 12 September 2026, a fresh Python 3.14 environment built and loaded both datasets with TimeNet pinned to `c39ca32b64ad0c89ea54093dbcb285c1a93eb006`. Both persisted datasets passed the existing raw-array and annotation validators. This is a full-recording round trip for **one recording per part**, not a claim that the complete 445-recording corpus was rebuilt.\nfrontend/src/lib/modelWindow.ts:10:    if (selected.resolution !== 'raw' || selected.sampleRateHz !== 1000 || selected.times.length !== 1024 ||\nfrontend/src/lib/modelWindow.ts:12:      selected.times.some((t, i) => Math.abs(t - interval.start - i / 1000) > 1e-8)) return 'Select 1,024 contiguous raw samples at 1 kHz.';\nfrontend/src/lib/modelWindow.ts:13:  } catch { return 'No raw model input is available for this selection.'; }\nfrontend/src/App.tsx:58:    const next: DemoData = { recording: { id: recording.id, name: recording.name, durationSeconds: recording.durationSec, sampleRateHz: recording.channels[0].sampleRateHz, displaySampleRateHz: rate, sourceUrl: '', archive: 'Backend recording', channelCount: 7, eventCount: events.filter(e => e.origin === 'publisher_annotation').length }, channels, times, events: events.filter(e => e.origin === 'publisher_annotation').map(e => ({ id: e.id, timeSeconds: e.startSec, label: e.label, source: e.source, kind: 'publisher_annotation' as const })), detail: signals.resolution === 'raw' ? { startSeconds: 0, endSeconds: recording.durationSec, times, channels } : emptyDetail };\nfrontend/src/App.tsx:71:  const rawWindow = useRawWindow(sourceData, datasetId, interval, services);\nfrontend/src/App.tsx:72:  const data = rawWindow.data;\nfrontend/src/App.tsx:133:  function evidence(e: EvidenceLink) { setReplayStop(undefined); if (e.interval.start < 0 || e.interval.end > data.recording.durationSeconds || e.interval.end <= e.interval.start) return; replay.seek(e.interval.start); setInterval({ ...e.interval }); setFollowing(false); setHighlighted(e.channelIds?.length ? e.channelIds : [e.channelId]); setView('inspect'); setMobile('signals'); setVisualMode('signals'); }\nfrontend/src/App.tsx:138:        {view === 'inspect' && (cases.lengt