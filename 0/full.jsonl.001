{"timestamp":"2026-09-13T00:34:08.539Z","ordinal":4906,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0982f-8e1b-7610-bda9-c2b1f60e6bdd","call_id":"call_xfgjHBPz8fh2ezU1XRXZpIF8","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import { useEffect, useMemo, useRef, useState } from 'react';\nimport { ArrowUp, ArrowUpRight, CircleStop, Cpu, Download, MessageSquare, RotateCcw, SlidersHorizontal, Waves } from 'lucide-react';\nimport { predictionBrief, predictionCue, type PredictionCue } from './predictionBrief';\nimport { downloadInvestigationJson, downloadInvestigationMarkdown, type InvestigationAnswer } from './investigationReport';\nimport { checkpointLabel, fitModelWindow, modelWindowIssue } from '../lib/modelWindow';\nimport { analyzeWindow } from '../lib/data';\nimport { intervalLabel } from '../lib/format';\nimport type { DemoData, EvidenceLink, Interval } from '../types';\nimport type { Evidence, Services } from '../services';\nimport type { ModelRegistry } from '../services/useModelRegistry';\n\ntype Message = InvestigationAnswer & { telemetry: DemoData; id: string; tools: string[]; status: 'running' | 'complete' | 'error' | 'cancelled' };\ntype Props = { rawLoading?: boolean; rawError?: string; onRetryRaw: () => void; data: DemoData; datasetId: string; playhead: number; interval: Interval; services: Services; registry: ModelRegistry; onEvidence: (e: EvidenceLink) => void; onModelWindow: (interval: Interval) => void; onCompare: (interval: Interval) => void; onRobotPrediction: (prediction: PredictionCue) => void };\nfunction AnswerText({ text }: { text: string }) {\n  const blocks = text.split(/\\n\\s*\\n/).filter(Boolean);\n  return <div className=\"answer-brief\">{blocks.map((block, index) => {\n    const [heading, ...body] = block.split('\\n');\n    const structured = body.length > 0 && /^(Measured in this selected window|OpenTSLM interpretation)$/i.test(heading.trim());\n    return structured\n      ? <section key={`${heading}-${index}`}><h3>{heading}</h3><p>{body.join(' ')}</p></section>\n      : <p key={`${heading}-${index}`}>{block.replace(/\\n+/g, ' ')}</p>;\n  })}</div>;\n}\nexport default function AssistantPanel({ rawLoading, rawError, onRetryRaw, data, datasetId, playhead, interval, services, registry, onEvidence, onModelWindow, onRobotPrediction, onCompare }: Props) {\n  const [question, setQuestion] = useState('');\n  const [mode, setMode] = useState<'local' | 'assistant'>('assistant');\n  const availableThrough = data.recording.durationSeconds;\n  const historical = interval.end <= availableThrough;\n  const dataIssue = useMemo(() => modelWindowIssue(data, interval, historical ? interval.end : 0), [data, interval, historical]);\n  const windowIssue = rawLoading ? 'Loading 1,024 raw samples for this interval…' : rawError ?? dataIssue;\n  const fitHorizon = Math.min(Math.floor(availableThrough * 1000) / 1000, data.detail.endSeconds);\n  const fittedWindow = useMemo(() => fitModelWindow(data, interval, fitHorizon), [data, interval, fitHorizon]);\n  const [exportStatus, setExportStatus] = useState('');\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [busy, setBusy] = useState(false);\n  const assistantAvailable = services.connected && !registry.loading && !registry.error && registry.models.some(model => model.id === 'assistant' && model.available && model.capabilities.includes('language'));\n  const modeUnavailable = mode === 'assistant' && (!assistantAvailable || Boolean(windowIssue));\n  const active = useRef<{ id: string; controller: AbortController; queryId?: string } | null>(null);\n  const body = useRef<HTMLDivElement>(null);\n  const completed = useRef(false);\n  useEffect(() => { const container = body.current; const latest = container?.lastElementChild as HTMLElement | null; if (!messages.length || !container || !latest) return; container.scrollTo({ top: latest.offsetTop - container.offsetTop, behavior: 'instant' }); }, [messages.length]);\n  useEffect(() => () => { const job = active.current; job?.controller.abort(); if (job?.queryId) void services.cancelQuery(job.queryId).catch(() => undefined); active.current = null; }, [services]);\n  function update(id: string, changes: Partial<Message> | ((m: Message) => Partial<Message>)) { setMessages(ms => ms.map(m => m.id === id ? { ...m, ...(typeof changes === 'function' ? changes(m) : changes) } : m)); }\n  function evidenceFrom(e: Evidence): EvidenceLink[] {\n    if (e.window.recordingId !== data.recording.id) return [];\n    if (!e.window.channelIds.length) return [];\n    return [{ channelId: e.window.channelIds[0], channelIds: e.window.channelIds, label: `Inspect ${e.window.channelIds.length} input channels`, interval: { start: e.window.startSec, end: e.window.endSec } }];\n  }\n  async function submit(prompt = question, runMode: 'local' | 'assistant' = mode) {\n    if (!prompt.trim() || busy || (runMode === 'assistant' && (rawLoading || rawError)) || (runMode === 'assistant' && !assistantAvailable)) return;\n    const snapshot = { ...interval }, horizon = Math.max(playhead, snapshot.end);\n    if (runMode === 'assistant' && modelWindowIssue(data, snapshot, horizon)) return;\n    const id = crypto.randomUUID(); const controller = new AbortController();\n    active.current = { id, controller }; completed.current = false;\n    setMessages(ms => [...ms, { id, telemetry: data, mode: runMode, question: prompt.trim(), interval: snapshot, playhead: horizon, replayCursor: playhead, text: '', source: runMode === 'local' ? 'Local numerical analysis' : 'Assistant', tools: [], evidence: [], status: 'running' }]);\n    setQuestion('');\n    setBusy(true);\n    try {\n      if (runMode === 'local') {\n        const result = analyzeWindow(data, snapshot, prompt, horizon);\n        update(id, { text: result.text, tools: result.tools, evidence: result.evidence, status: 'complete' });\n      } else {\n        const request = { mode: 'assistant' as const, question: prompt, playheadSec: horizon, window: { datasetId, recordingId: data.recording.id, startSec: snapshot.start, endSec: snapshot.end, channelIds: data.channels.map(c => c.id) } };\n        const job = await services.startQuery(request, controller.signal);\n        if (active.current?.id !== id) { await services.cancelQuery(job.queryId); return; }\n        active.current.queryId = job.queryId;\n        await services.streamQuery(job.streamUrl, event => {\n          if (active.current?.id !== id || event.queryId !== job.queryId) return;\n          const p = event.payload;\n          if (event.type === 'tool.started') update(id, m => ({ tools: [...m.tools, p.label ?? p.tool ?? 'Tool started'] }));\n          if (event.type === 'tool.completed') update(id, m => ({ tools: [...m.tools, p.summary ?? 'Tool completed'] }));\n          if (event.type === 'answer.delta') update(id, m => ({ text: m.text + (p.text ?? '') }));\n          if (event.type === 'answer.completed') { completed.current = true; update(id, m => ({ status: 'complete', text: p.answer ?? m.text, modelId: p.modelId, modelRevision: p.modelRevision, inputTrace: p.inputTrace, modelOutput: typeof p.modelOutput === 'string' ? p.modelOutput : undefined, source: `${p.modelId ?? 'Assistant'} · completed`, evidence: (p.evidence ?? []).flatMap(evidenceFrom) })); }\n          if (event.type === 'query.error') { completed.current = true; update(id, m => ({ status: 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${p.message ?? 'Inference failed.'}` })); }\n          if (event.type === 'query.cancelled') { completed.current = true; update(id, { status: 'cancelled' }); }\n        }, controller.signal);\n      }\n    } catch (error) {\n      update(id, m => ({ status: controller.signal.aborted ? 'cancelled' : 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${controller.signal.aborted ? 'Stopped. This answer is incomplete.' : error instanceof Error ? error.message : 'The request failed.'}` }));\n    } finally { if (active.current?.id === id) { active.current = null; setBusy(false); } }\n  }\n  function exportReport(message: Message) {\n    try { downloadInvestigationMarkdown(message.telemetry, datasetId, message); setExportStatus('Readable investigation report downloaded as Markdown.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The report could not be exported.'); }\n  }\n  function exportEvidence(message: Message) {\n    try { downloadInvestigationJson(message.telemetry, datasetId, message); setExportStatus('Machine-readable evidence downloaded as JSON.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The evidence could not be exported.'); }\n  }\n  async function stop() {\n    const job = active.current; if (!job) return;\n    job.controller.abort();\n    if (job.queryId) { try { await services.cancelQuery(job.queryId); } catch { update(job.id, { status: 'error', text: 'The browser stopped listening, but server cancellation could not be confirmed.' }); } }\n  }\n  return <section className=\"assistant-panel\" aria-label=\"Telemetry assistant\">\n    <header className=\"panel-heading\"><div className=\"assistant-title\"><MessageSquare size={16}/><h2>Event investigation</h2></div><span className=\"assistant-capability\">{checkpointLabel(registry.models.find(m => m.id === 'assistant')?.revision).split(' · ')[0]}</span></header>\n    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\n    <button className=\"text-button compare-current\" onClick={() => onCompare(interval)}>Compare with reference <ArrowUpRight size={12}/></button>\n    {windowIssue && <div className=\"input-guidance\"><p>{windowIssue}</p>{rawError && <button className=\"text-button\" onClick={onRetryRaw}>Retry raw window</button>}{!rawLoading && !rawError && fittedWindow && <button className=\"text-button\" disabled={busy} onClick={() => onModelWindow(fittedWindow)}>Use 1.024 s window</button>}</div>}\n    <div className=\"conversation\" ref={body} aria-live=\"polite\">\n      {!messages.length && <div className=\"conversation-intro\"><Waves size={26}/><h3>Turn a contact event into an investigation.</h3><p>Analyze the selected interval to compare a model interpretation with measured joint signals. Then inspect the evidence and save your findings.</p><p className=\"intro-limit\">Recorded telemetry can suggest what to investigate. It cannot verify a physical cause.</p></div>}\n      {messages.map(m => {\n        const brief = predictionBrief(m.modelOutput);\n        const cue = m.status === 'complete' ? predictionCue(m.modelOutput, m.interval) : undefined;\n        const measuredText = m.text.split(/\\n\\s*\\n/).find(block => block.startsWith('Measured in this selected window'))?.split('\\n').slice(1).join(' ');\n        return <article className=\"conversation-turn\" key={m.id}>\n          <div className=\"user-question\"><div><p>{m.question}</p><small className=\"mono\">{intervalLabel(m.interval)}</small></div></div>\n          <div className=\"assistant-answer\"><div>\n            {m.status !== 'complete' && <div className=\"answer-source\">{m.status === 'running' ? 'Reading the selected telemetry…' : m.status}</div>}\n            <div className={m.status === 'error' ? 'error-message' : ''}>\n              {brief ? <><section className=\"prediction-summary\"><h3>{brief.title}</h3><div className=\"prediction-facts\">{brief.strongest && <span>Predicted strongest joint <strong>{brief.strongest}</strong></span>}{brief.onset !== undefined && <span>Predicted onset <strong>{brief.onset} ms</strong> into the window</span>}</div><p className=\"prediction-caution\">OpenTSLM prediction · not a verified physical diagnosis.</p></section>{measuredText && <section className=\"measured-summary\"><h3>Measured torque</h3><p>{measuredText}</p></section>}</> : m.text ? <AnswerText text={m.text}/> : null}\n            </div>\n            {m.evidence.length > 0 && <div className=\"evidence-links\">{m.evidence.map((e, i) => <button key={i} onClick={() => onEvidence(e)}><SlidersHorizontal size={12}/>{e.label}<ArrowUpRight size={11}/></button>)}</div>}\n            {cue && <button className=\"text-button robot-prediction-action\" onClick={() => onRobotPrediction(cue)}>Show predicted time cue in 3D <ArrowUpRight size={12}/></button>}\n            {m.status === 'complete' && m.mode === 'assistant' && <details className=\"input-receipt\"><summary>Model &amp; input details</summary><p>{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s</p>{brief && <AnswerText text={m.text}/>}<details><summary>Raw model generation · unverified</summary><p>Generated text can disagree with publisher annotations. Review those annotations separately.</p><pre>{m.modelOutput}</pre></details><details><summary>1,024-sample input receipt</summary><pre>{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}</pre><p>{m.modelRevision}</p></details>{m.tools.length > 0 && <details className=\"tool-log\"><summary>{m.tools.length} completed tool steps</summary>{m.tools.map((t, i) => <p key={i}>{t}</p>)}</details>}<button className=\"text-button\" onClick={() => exportEvidence(m)}><Download size={12}/>Download audit JSON</button></details>}\n            {m.status === 'complete' && <button className=\"text-button\" onClick={() => onCompare(m.interval)}>Compare this answer’s window <ArrowUpRight size={12}/></button>}\n            {m.status === 'complete' && <button className=\"text-button report-export\" onClick={() => exportReport(m)}><Download size={13}/>Export report (.md)</button>}\n            {(m.status === 'error' || m.status === 'cancelled') && <button className=\"text-button\" disabled={busy} onClick={() => { setQuestion(m.question); }}><RotateCcw size={12}/>Use this question again</button>}\n          </div></div>\n        </article>;\n      })}\n    </div>\n    {exportStatus && <p className=\"report-status\" role=\"status\">{exportStatus}</p>}\n    {mode === 'assistant' && !assistantAvailable && <p className=\"status-note\" role=\"status\">Model unavailable. Choose Measurements only to inspect torque ranges, peaks and variability.</p>}\n    <form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form>\n  </section>;\n}\n"},{"type":"input_text","text":"frontend/src/styles.css:7:.assistant-panel{flex:1;min-height:0;display:flex;flex-direction:column;background:#191d1f}.assistant-title{gap:8px!important}.assistant-title>svg{color:#b3c0c3}.conversation{overflow:auto;flex:1;min-height:0;padding:20px}.conversation-intro{max-width:530px;margin:auto}.assistant-emblem{color:var(--accent);margin-bottom:9px;display:flex}.conversation-intro h3{font-size:18px;font-weight:400;letter-spacing:-.01em}.conversation-intro>p{color:var(--quiet);font-size:12px;margin:6px 0 15px;max-width:400px}.suggestion-list{display:flex;flex-direction:column;gap:2px}.suggestion-list button{padding:7px 0;display:flex;justify-content:space-between;align-items:center;gap:15px;border:0;border-bottom:1px solid #30373b;background:transparent;text-align:left;font-size:12px;color:#ccd6d7}.suggestion-list button>svg{color:#849994}.suggestion-list button:hover{color:var(--accent)}.connection-note{display:flex;align-items:center;gap:6px;margin-top:12px;font-size:10px;color:#9facb0}.composer{margin:0 18px 15px;border:1px solid #485450;background:#22282a;border-radius:6px;flex-shrink:0}.composer:focus-within{border-color:var(--accent)}.composer-context{display:flex;align-items:center;gap:7px;padding:9px 12px 0;font-size:10px;color:#a2adb1}.composer-context strong{font-weight:400;color:#d0ded7}.composer-context>span:last-child{margin-left:auto}.selection-dot{width:5px;height:5px;background:var(--accent);display:inline-block;flex-shrink:0}.composer textarea{display:block;width:100%;border:0;resize:none;background:transparent;padding:10px 12px 3px;color:var(--text);font-size:13px;outline:none;min-height:51px}.composer textarea::placeholder{color:#a5b0b4}.composer-bottom{display:flex;align-items:center;justify-content:space-between;padding:5px 8px 7px 12px}.mode-select{display:flex;align-items:center;gap:6px;color:var(--quiet)}.mode-select select{background:transparent;border:0;color:#c0ceca;font-size:11px;max-width:245px}.send-button{width:29px;height:28px;background:var(--accent);border:0;border-radius:4px;display:grid;place-items:center;color:#173128}.send-button:hover:not(:disabled){background:#b6e5d0}.conversation-turn{margin-bottom:23px;font-size:13px}.user-question{display:flex;align-items:flex-start;gap:10px;margin-bottom:15px}.user-question .avatar{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#39453f;color:#d5e5dc;font-size:11px;flex-shrink:0}.user-question small{display:block;color:var(--quiet);font-size:10px;margin-top:4px}.assistant-answer{display:flex;gap:12px}.assistant-answer>svg{margin-top:2px;color:var(--accent)}.assistant-answer>div{min-width:0;flex:1}.answer-source{font-size:11px;color:#b4c5bc;margin-bottom:8px}.answer-source>span{margin-left:10px;color:var(--amber)}.assistant-answer p{white-space:pre-wrap;font-size:13px;line-height:1.7;overflow-wrap:anywhere}.tool-log{margin:0 0 8px;color:#a5b8b0;font-size:11px}.tool-log summary{display:flex;align-items:center;gap:6px;cursor:pointer;list-style:none}.tool-log summary::-webkit-details-marker{display:none}.tool-log>div{display:flex;align-items:center;gap:5px;padding:4px 0}.evidence-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.evidence-links button{border:1px solid #425149;border-radius:3px;background:#26332c;color:#c0dacb;font-size:11px;padding:4px 7px;display:flex;gap:6px;align-items:center}\nfrontend/src/styles.css:10:.secondary-view{overflow:auto;min-height:0;flex:1;padding:22px 30px;background:#191e21}.back-inspect{margin-bottom:18px}.workspace-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.workspace-heading h1,.workspace-heading h2{font-size:24px;font-weight:500}.workspace-heading p{color:var(--quiet);margin-top:6px;max-width:680px}.workspace-content{max-width:1120px;margin:0 auto}.workspace-section{margin:0 0 28px;padding-bottom:22px;border-bottom:1px solid var(--line)}.workspace-section h2,.workspace-section h3{font-size:15px;margin-bottom:12px}.workspace-section p{color:#b5c1c5;font-size:13px;max-width:720px;line-height:1.7}.status-note{color:#b7c7c0;background:#25312c;border:1px solid #43554b;padding:9px 12px;border-radius:4px;margin:10px 0;display:flex;align-items:center;gap:8px;font-size:12px}.data-table{width:100%;border-collapse:collapse;font-size:12px}.data-table th{text-align:left;color:#a9b6bb;font-weight:400;font-size:11px}.data-table th,.data-table td{padding:10px 14px 10px 0;border-bottom:1px solid #333e43}.data-table td{color:#d4dfe1}.field-row{display:flex;align-items:end;gap:12px;flex-wrap:wrap;margin:14px 0}.field-row label{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#bdc9ce;flex:1;min-width:180px}.field-row input,.field-row select,.workspace-section textarea{background:#20282c;border:1px solid #45535a;border-radius:4px;color:var(--text);padding:9px 12px;min-height:36px;width:100%}.field-row input:disabled{opacity:.55}.error-message{color:#efb0a4!important;font-size:12px}.empty-state{border:1px dashed #465358;border-radius:4px;display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:20px;color:#a9b8be;margin:16px 0}.empty-state h3{color:#d2dedf}.table-scroll{max-width:100%;overflow:auto;scrollbar-gutter:stable}.source-results{display:flex;flex-direction:column;gap:10px;margin:12px 0;padding:0;list-style:none}.source-results article,.source-results li,.model-result{padding:16px 0;border-bottom:1px solid #3b464b}.source-results h3,.model-result h3{font-size:15px}.source-results a{color:var(--accent)}.ingestion-stages{display:flex;gap:18px;flex-wrap:wrap;margin:15px 0;padding:0;list-style:none;color:var(--quiet)}.ingestion-stages li{display:flex;align-items:center;gap:6px}.comparison-results{display:flex;flex-direction:column;gap:12px}.answer-text{white-space:pre-wrap;line-height:1.7}.workspace-section dl{display:grid;grid-template-columns:140px 1fr;gap:8px 20px;font-size:12px}.workspace-section dt{color:var(--quiet)}.workspace-section dd{margin:0;overflow-wrap:anywhere}.model-result header{display:flex;gap:15px;align-