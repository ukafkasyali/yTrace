{"timestamp":"2026-09-13T00:47:20.066Z","ordinal":5501,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","item":{"type":"CommandExecution","id":"exec-1375f7df-d2ed-4bc6-81c1-8991a9f7916b","process_id":"2602","command":["/bin/zsh","-lc","sed -n '280,365p' model_training/src/robot_observability/comparison.py && rg -n \"render|markdown|superiority|Legacy positive\" model_training/tests/test_comparison.py"],"cwd":"file:///Users/sametdegirmenci/Downloads/ysamet","parsed_cmd":[{"type":"read","cmd":"sed -n '280,365p' model_training/src/robot_observability/comparison.py","name":"comparison.py","path":"model_training/src/robot_observability/comparison.py"},{"type":"search","cmd":"rg -n 'render|markdown|superiority|Legacy positive' model_training/tests/test_comparison.py","query":"render|markdown|superiority|Legacy positive","path":"test_comparison.py"}],"source":"unified_exec_startup","status":"failed","stdout":"def markdown(report: dict) -> str:\n    lines = [\n        \"# Trace: audited held-out comparison\",\n        \"\",\n        (\n            f\"{report['window_count']} identical windows from {report['recording_count']} held-out recordings. \"\n            f\"Class counts: {report['class_counts']}. All windows are 1,024 samples at 1 kHz.\"\n        ),\n        \"\",\n        \"| Task / metric | Signal features | OpenTSLM | Qwen plots | Test size / limitation |\",\n        \"|---|---:|---:|---:|---|\",\n    ]\n    specs = [\n        (\n            \"Semantics macro-F1\",\n            \"semantics_macro_f1\",\n            \"512; three experimental classes; abstentions are errors\",\n        ),\n        (\"Semantics accuracy\", \"semantics_accuracy\", \"512; missing answers incorrect\"),\n        (\"Contact macro-F1\", \"contact_macro_f1\", \"512; includes free-motion failures\"),\n        (\"Contact answer coverage\", \"contact_answer_coverage\", \"512; requires a JSON boolean\"),\n        (\"Usable complete summary\", \"usable_summary_rate\", \"512; types, ranges and cross-field consistency\"),\n        (\n            \"Strongest-joint accuracy\",\n            \"strongest_joint_accuracy\",\n            \"271 contact windows; derived signal target\",\n        ),\n        (\n            \"Affected-joint set F1\",\n            \"affected_joint_set_f1_contact_only\",\n            \"271 contacts only; invalid lists score zero\",\n        ),\n        (\"Onset MAE (ms)\", \"onset_mae_ms\", \"Only finite in-window predictions; read with coverage\"),\n        (\"Onset median error (ms)\", \"onset_median_ae_ms\", \"Same conditional denominator as MAE\"),\n        (\"Onset P90 error (ms)\", \"onset_p90_ae_ms\", \"Same conditional denominator as MAE\"),\n        (\"Onset coverage\", \"onset_coverage\", \"271 contact windows\"),\n        (\n            \"Onset within 50 ms / all contacts\",\n            \"onset_within_50ms_all_contacts\",\n            \"271; missing/invalid onsets fail\",\n        ),\n    ]\n    for title, key, note in specs:\n        values = [report[\"models\"][m][key] for m in (\"features\", \"opentslm\", \"qwen\")]\n        rendered = [\"—\" if v is None else f\"{v:.2f}\" if key.endswith(\"_ms\") else f\"{v:.4f}\" for v in values]\n        lines.append(f\"| {title} | \" + \" | \".join(rendered) + f\" | {note} |\")\n    lines += [\n        \"\",\n        \"## Interpretation\",\n        \"\",\n        (\n            \"The signal-feature baseline outperforms this OpenTSLM checkpoint on semantics, joint ranking, \"\n            \"and successful localization within 50 ms. OpenTSLM has higher onset coverage and slightly lower \"\n            \"conditional mean onset error, but a worse median. These results do not establish OpenTSLM superiority.\"\n        ),\n        \"\",\n        (\n            \"OpenTSLM was fine-tuned; Qwen3-VL 4B was zero-shot on plots. This comparison changes training \"\n            \"and representation together. Qwen frequently emitted null contact fields: JSON parsing and matching \"\n            \"keys did not mean usable answers. No plain-Llama baseline was run in these artifacts.\"\n        ),\n        \"\",\n        (\n            \"Legacy positive-contact F1 can stay high while free-motion answers are missing. This report adds \"\n            \"contact macro-F1, answer coverage, strict usable-summary rate, and abstention columns in the JSON \"\n            \"confusion matrices. It does not repair generations or substitute labels.\"\n        ),\n        \"\",\n        \"## Paired uncertainty\",\n        \"\",\n        (\n            \"95% percentile intervals for OpenTSLM minus signal features, resampling recording groups \"\n            f\"({report['paired_uncertainty']['repeats']} replicates). Negative values favor signal features.\"\n        ),\n        \"\",\n    ]\n    for key, interval in report[\"paired_uncertainty\"][\"interval_95\"].items():\n        lines.append(f\"- {key}: [{interval[0]:.4f}, {interval[1]:.4f}]\")\n    lines += [\n        \"\",\n        \"## Scope and provenance\",\n        \"\",\n        (\n            \"The 512 windows are a fixed subset of 4,202 test windows. The source split assigns 311/67/67 \"\n            \"recordings to train/validation/test. Every prediction is joined by record ID, checked against the \"\n            \"prepared target and test-session assignment, and matched across all four input conditions. \"\n","stderr":"","aggregated_output":"def markdown(report: dict) -> str:\n    lines = [\n        \"# Trace: audited held-out comparison\",\n        \"\",\n        (\n            f\"{report['window_count']} identical windows from {report['recording_count']} held-out recordings. \"\n            f\"Class counts: {report['class_counts']}. All windows are 1,024 samples at 1 kHz.\"\n        ),\n        \"\",\n        \"| Task / metric | Signal features | OpenTSLM | Qwen plots | Test size / limitation |\",\n        \"|---|---:|---:|---:|---|\",\n    ]\n    specs = [\n        (\n            \"Semantics macro-F1\",\n            \"semantics_macro_f1\",\n            \"512; three experimental classes; abstentions are errors\",\n        ),\n        (\"Semantics accuracy\", \"semantics_accuracy\", \"512; missing answers incorrect\"),\n        (\"Contact macro-F1\", \"contact_macro_f1\", \"512; includes free-motion failures\"),\n        (\"Contact answer coverage\", \"contact_answer_coverage\", \"512; requires a JSON boolean\"),\n        (\"Usable complete summary\", \"usable_summary_rate\", \"512; types, ranges and cross-field consistency\"),\n        (\n            \"Strongest-joint accuracy\",\n            \"strongest_joint_accuracy\",\n            \"271 contact windows; derived signal target\",\n        ),\n        (\n            \"Affected-joint set F1\",\n            \"affected_joint_set_f1_contact_only\",\n            \"271 contacts only; invalid lists score zero\",\n        ),\n        (\"Onset MAE (ms)\", \"onset_mae_ms\", \"Only finite in-window predictions; read with coverage\"),\n        (\"Onset median error (ms)\", \"onset_median_ae_ms\", \"Same conditional denominator as MAE\"),\n        (\"Onset P90 error (ms)\", \"onset_p90_ae_ms\", \"Same conditional denominator as MAE\"),\n        (\"Onset coverage\", \"onset_coverage\", \"271 contact windows\"),\n        (\n            \"Onset within 50 ms / all contacts\",\n            \"onset_within_50ms_all_contacts\",\n            \"271; missing/invalid onsets fail\",\n        ),\n    ]\n    for title, key, note in specs:\n        values = [report[\"models\"][m][key] for m in (\"features\", \"opentslm\", \"qwen\")]\n        rendered = [\"—\" if v is None else f\"{v:.2f}\" if key.endswith(\"_ms\") else f\"{v:.4f}\" for v in values]\n        lines.append(f\"| {title} | \" + \" | \".join(rendered) + f\" | {note} |\")\n    lines += [\n        \"\",\n        \"## Interpretation\",\n        \"\",\n        (\n            \"The signal-feature baseline outperforms this OpenTSLM checkpoint on semantics, joint ranking, \"\n            \"and successful localization within 50 ms. OpenTSLM has higher onset coverage and slightly lower \"\n            \"conditional mean onset error, but a worse median. These results do not establish OpenTSLM superiority.\"\n        ),\n        \"\",\n        (\n            \"OpenTSLM was fine-tuned; Qwen3-VL 4B was zero-shot on plots. This comparison changes training \"\n            \"and representation together. Qwen frequently emitted null contact fields: JSON parsing and matching \"\n            \"keys did not mean usable answers. No plain-Llama baseline was run in these artifacts.\"\n        ),\n        \"\",\n        (\n            \"Legacy positive-contact F1 can stay high while free-motion answers are missing. This report adds \"\n            \"contact macro-F1, answer coverage, strict usable-summary rate, and abstention columns in the JSON \"\n            \"confusion matrices. It does not repair generations or substitute labels.\"\n        ),\n        \"\",\n        \"## Paired uncertainty\",\n        \"\",\n        (\n            \"95% percentile intervals for OpenTSLM minus signal features, resampling recording groups \"\n            f\"({report['paired_uncertainty']['repeats']} replicates). Negative values favor signal features.\"\n        ),\n        \"\",\n    ]\n    for key, interval in report[\"paired_uncertainty\"][\"interval_95\"].items():\n        lines.append(f\"- {key}: [{interval[0]:.4f}, {interval[1]:.4f}]\")\n    lines += [\n        \"\",\n        \"## Scope and provenance\",\n        \"\",\n        (\n            \"The 512 windows are a fixed subset of 4,202 test windows. The source split assigns 311/67/67 \"\n            \"recordings to train/validation/test. Every prediction is joined by record ID, checked against the \"\n            \"prepared target and test-session assignment, and matched across all four input conditions. \"\n","exit_code":1,"duration":{"secs":0,"nanos":3667},"formatted_output":"def markdown(report: dict) -> str:\n    lines = [\n        \"# Trace: audited held-out comparison\",\n        \"\",\n        (\n            f\"{report['window_count']} identical windows from {report['recording_count']} held-out recordings. \"\n            f\"Class counts: {report['class_counts']}. All windows are 1,024 samples at 1 kHz.\"\n        ),\n        \"\",\n        \"| Task / metric | Signal features | OpenTSLM | Qwen plots | Test size / limitation |\",\n        \"|---|---:|---:|---:|---|\",\n    ]\n    specs = [\n        (\n            \"Semantics macro-F1\",\n            \"semantics_macro_f1\",\n            \"512; three experimental classes; abstentions are errors\",\n        ),\n        (\"Semantics accuracy\", \"semantics_accuracy\", \"512; missing answers incorrect\"),\n        (\"Contact macro-F1\", \"contact_macro_f1\", \"512; includes free-motion failures\"),\n        (\"Contact answer coverage\", \"contact_answer_coverage\", \"512; requires a JSON boolean\"),\n        (\"Usable complete summary\", \"usable_summary_rate\", \"512; types, ranges and cross-field consistency\"),\n        (\n            \"Strongest-joint accuracy\",\n            \"strongest_joint_accuracy\",\n            \"271 contact windows; derived signal target\",\n        ),\n        (\n            \"Affected-joint set F1\",\n            \"affected_joint_set_f1_contact_only\",\n            \"271 contacts only; invalid lists score zero\",\n        ),\n        (\"Onset MAE (ms)\", \"onset_mae_ms\", \"Only finite in-window predictions; read with coverage\"),\n        (\"Onset median error (ms)\", \"onset_median_ae_ms\", \"Same conditional denominator as MAE\"),\n        (\"Onset P90 error (ms)\", \"onset_p90_ae_ms\", \"Same conditional denominator as MAE\"),\n        (\"Onset coverage\", \"onset_coverage\", \"271 contact windows\"),\n        (\n            \"Onset within 50 ms / all contacts\",\n            \"onset_within_50ms_all_contacts\",\n            \"271; missing/invalid onsets fail\",\n        ),\n    ]\n    for title, key, note in specs:\n        values = [report[\"models\"][m][key] for m in (\"features\", \"opentslm\", \"qwen\")]\n        rendered = [\"—\" if v is None else f\"{v:.2f}\" if key.endswith(\"_ms\") else f\"{v:.4f}\" for v in values]\n        lines.append(f\"| {title} | \" + \" | \".join(rendered) + f\" | {note} |\")\n    lines += [\n        \"\",\n        \"## Interpretation\",\n        \"\",\n        (\n            \"The signal-feature baseline outperforms this OpenTSLM checkpoint on semantics, joint ranking, \"\n            \"and successful localization within 50 ms. OpenTSLM has higher onset coverage and slightly lower \"\n            \"conditional mean onset error, but a worse median. These results do not establish OpenTSLM superiority.\"\n        ),\n        \"\",\n        (\n            \"OpenTSLM was fine-tuned; Qwen3-VL 4B was zero-shot on plots. This comparison changes training \"\n            \"and representation together. Qwen frequently emitted null contact fields: JSON parsing and matching \"\n            \"keys did not mean usable answers. No plain-Llama baseline was run in these artifacts.\"\n        ),\n        \"\",\n        (\n            \"Legacy positive-contact F1 can stay high while free-motion answers are missing. This report adds \"\n            \"contact macro-F1, answer coverage, strict usable-summary rate, and abstention columns in the JSON \"\n            \"confusion matrices. It does not repair generations or substitute labels.\"\n        ),\n        \"\",\n        \"## Paired uncertainty\",\n        \"\",\n        (\n            \"95% percentile intervals for OpenTSLM minus signal features, resampling recording groups \"\n            f\"({report['paired_uncertainty']['repeats']} replicates). Negative values favor signal features.\"\n        ),\n        \"\",\n    ]\n    for key, interval in report[\"paired_uncertainty\"][\"interval_95\"].items():\n        lines.append(f\"- {key}: [{interval[0]:.4f}, {interval[1]:.4f}]\")\n    lines += [\n        \"\",\n        \"## Scope and provenance\",\n        \"\",\n        (\n            \"The 512 windows are a fixed subset of 4,202 test windows. The source split assigns 311/67/67 \"\n            \"recordings to train/validation/test. Every prediction is joined by record ID, checked against the \"\n            \"prepared target and test-session assignment, and matched across all four input conditions. \"\n"},"started_at_ms":1789260440066,"completed_at_ms":1789260440066}}
{"timestamp":"2026-09-13T00:47:20.119Z","ordinal":5502,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0983b-a237-7453-9074-0317c5d1d453","call_id":"call_Upa5VnUawC8oaPVLvymWl2AS","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"23aae3\",\"wall_time_seconds\":0.000003667,\"exit_code\":1,\"original_token_count\":1053,\"output\":\"def markdown(report: dict) -> str:\\n    lines = [\\n        \\\"# Trace: audited held-out comparison\\\",\\n        \\\"\\\",\\n        (\\n            f\\\"{report['window_count']} identical windows from {report['recording_count']} held-out recordings. \\\"\\n            f\\\"Class counts: {report['class_counts']}. All windows are 1,024 samples at 1 kHz.\\\"\\n        ),\\n        \\\"\\\",\\n        \\\"| Task / metric | Signal features | OpenTSLM | Qwen plots | Test size / limitation |\\\",\\n        \\\"|---|---:|---:|---:|---|\\\",\\n    ]\\n    specs = [\\n        (\\n            \\\"Semantics macro-F1\\\",\\n            \\\"semantics_macro_f1\\\",\\n            \\\"512; three experimental classes; abstentions are errors\\\",\\n        ),\\n        (\\\"Semantics accuracy\\\", \\\"semantics_accuracy\\\", \\\"512; missing answers incorrect\\\"),\\n        (\\\"Contact macro-F1\\\", \\\"contact_macro_f1\\\", \\\"512; includes free-motion failures\\\"),\\n        (\\\"Contact answer coverage\\\", \\\"contact_answer_coverage\\\", \\\"512; requires a JSON boolean\\\"),\\n        (\\\"Usable complete summary\\\", \\\"usable_summary_rate\\\", \\\"512; types, ranges and cross-field consistency\\\"),\\n        (\\n            \\\"Strongest-joint accuracy\\\",\\n            \\\"strongest_joint_accuracy\\\",\\n            \\\"271 contact windows; derived signal target\\\",\\n        ),\\n        (\\n            \\\"Affected-joint set F1\\\",\\n            \\\"affected_joint_set_f1_contact_only\\\",\\n            \\\"271 contacts only; invalid lists score zero\\\",\\n        ),\\n        (\\\"Onset MAE (ms)\\\", \\\"onset_mae_ms\\\", \\\"Only finite in-window predictions; read with coverage\\\"),\\n        (\\\"Onset median error (ms)\\\", \\\"onset_median_ae_ms\\\", \\\"Same conditional denominator as MAE\\\"),\\n        (\\\"Onset P90 error (ms)\\\", \\\"onset_p90_ae_ms\\\", \\\"Same conditional denominator as MAE\\\"),\\n        (\\\"Onset coverage\\\", \\\"onset_coverage\\\", \\\"271 contact windows\\\"),\\n        (\\n            \\\"Onset within 50 ms / all contacts\\\",\\n            \\\"onset_within_50ms_all_contacts\\\",\\n            \\\"271; missing/invalid onsets fail\\\",\\n        ),\\n    ]\\n    for title, key, note in specs:\\n        values = [report[\\\"models\\\"][m][key] for m in (\\\"features\\\", \\\"opentslm\\\", \\\"qwen\\\")]\\n        rendered = [\\\"—\\\" if v is None else f\\\"{v:.2f}\\\" if key.endswith(\\\"_ms\\\") else f\\\"{v:.4f}\\\" for v in values]\\n        lines.append(f\\\"| {title} | \\\" + \\\" | \\\".join(rendered) + f\\\" | {note} |\\\")\\n    lines += [\\n        \\\"\\\",\\n        \\\"## Interpretation\\\",\\n        \\\"\\\",\\n        (\\n            \\\"The signal-feature baseline outperforms this OpenTSLM checkpoint on semantics, joint ranking, \\\"\\n            \\\"and successful localization within 50 ms. OpenTSLM has higher onset coverage and slightly lower \\\"\\n            \\\"conditional mean onset error, but a worse median. These results do not establish OpenTSLM superiority.\\\"\\n        ),\\n        \\\"\\\",\\n        (\\n            \\\"OpenTSLM was fine-tuned; Qwen3-VL 4B was zero-shot on plots. This comparison changes training \\\"\\n            \\\"and representation together. Qwen frequently emitted null contact fields: JSON parsing and matching \\\"\\n            \\\"keys did not mean usable answers. No plain-Llama baseline was run in these artifacts.\\\"\\n        ),\\n        \\\"\\\",\\n        (\\n            \\\"Legacy positive-contact F1 can stay high while free-motion answers are missing. This report adds \\\"\\n            \\\"contact macro-F1, answer coverage, strict usable-summary rate, and abstention columns in the JSON \\\"\\n            \\\"confusion matrices. It does not repair generations or substitute labels.\\\"\\n        ),\\n        \\\"\\\",\\n        \\\"## Paired uncertainty\\\",\\n        \\\"\\\",\\n        (\\n            \\\"95% percentile intervals for OpenTSLM minus signal features, resampling recording groups \\\"\\n            f\\\"({report['paired_uncertainty']['repeats']} replicates). Negative values favor signal features.\\\"\\n        ),\\n        \\\"\\\",\\n    ]\\n    for key, interval in report[\\\"paired_uncertainty\\\"][\\\"interval_95\\\"].items():\\n        lines.append(f\\\"- {key}: [{interval[0]:.4f}, {interval[1]:.4f}]\\\")\\n    lines += [\\n        \\\"\\\",\\n        \\\"## Scope and provenance\\\",\\n        \\\"\\\",\\n        (\\n            \\\"The 512 windows are a fixed subset of 4,202 test windows. The source split assigns 311/67/67 \\\"\\n            \\\"recordings to train/validation/test. Every prediction is joined by record ID, checked against the \\\"\\n            \\\"prepared target and test-session assignment, and matched across all four input conditions. \\\"\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","create_time":1789260440.119455}}}
