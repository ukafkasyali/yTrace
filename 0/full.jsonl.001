{"timestamp":"2026-09-13T00:47:25.825Z","ordinal":5507,"type":"token_usage_record","payload":{"thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","session_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","root_turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","response_id":"resp_0f3535a43349ee3d016aa5f29849b487d2aadaf7a231dc6e7f","usage":{"input_tokens":138982,"cached_input_tokens":137650,"cache_write_input_tokens":1329,"output_tokens":246,"reasoning_output_tokens":166,"total_tokens":139228},"turn_token_usage":{"input_tokens":16603748,"cached_input_tokens":16268065,"cache_write_input_tokens":321104,"output_tokens":47965,"reasoning_output_tokens":13203,"total_tokens":16651713},"thread_token_usage":{"input_tokens":98714077,"cached_input_tokens":95339933,"cache_write_input_tokens":3339293,"output_tokens":347082,"reasoning_output_tokens":90095,"total_tokens":99061159}}}
{"timestamp":"2026-09-13T00:47:25.866Z","ordinal":5508,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","item":{"type":"CommandExecution","id":"exec-54f88ef3-7100-451d-b407-b23c54f794e2","process_id":"81254","command":["/bin/zsh","-lc","sed -n '1,320p' model_training/tests/test_comparison.py"],"cwd":"file:///Users/sametdegirmenci/Downloads/ysamet","parsed_cmd":[{"type":"read","cmd":"sed -n '1,320p' model_training/tests/test_comparison.py","name":"test_comparison.py","path":"model_training/tests/test_comparison.py"}],"source":"unified_exec_startup","status":"completed","stdout":"import copy\nimport math\n\nimport pytest\n\nfrom robot_observability.comparison import percentile, schema_valid, score, validate_alignment\n\n\ndef target(contact=True):\n    return {\n        \"contact\": contact,\n        \"event_type\": \"accidental\" if contact else \"free\",\n        \"onset_ms\": 300 if contact else None,\n        \"strongest_joint\": \"J1\" if contact else None,\n        \"affected_joints\": [\"J1\"] if contact else [],\n        \"evidence_start_ms\": 300 if contact else None,\n        \"evidence_end_ms\": 450 if contact else None,\n    }\n\n\ndef test_abstention_on_free_motion_is_not_a_correct_negative():\n    items = [{\"target\": target(), \"prediction\": target()}, {\"target\": target(False), \"prediction\": None}]\n    result = score(items)\n    assert result[\"contact_accuracy\"] == 0.5\n    assert result[\"contact_answer_coverage\"] == 0.5\n    assert result[\"contact_positive_f1\"] == 1\n    assert result[\"contact_macro_f1\"] == 0.5\n    assert result[\"contact_confusion\"][\"false\"] == {\"abstain\": 1}\n\n\n@pytest.mark.parametrize(\"bad\", [True, \"300\", math.nan, math.inf, -1, 1024])\ndef test_onset_invalid_values_fail_coverage_and_success(bad):\n    prediction = target()\n    prediction[\"onset_ms\"] = bad\n    result = score([{\"target\": target(), \"prediction\": prediction}])\n    assert result[\"onset_coverage\"] == 0\n    assert result[\"onset_mae_ms\"] is None\n    assert result[\"onset_within_50ms_all_contacts\"] == 0\n    assert not schema_valid(prediction)\n\n\ndef test_missing_joint_lists_do_not_get_free_motion_credit():\n    result = score([{\"target\": target(False), \"prediction\": None}, {\"target\": target(), \"prediction\": {}}])\n    assert result[\"affected_joint_set_f1_contact_only\"] == 0\n\n\ndef test_percentile_uses_linear_interpolation():\n    assert percentile([1, 2, 3, 10], 0.9) == pytest.approx(7.9)\n    assert percentile([], 0.9) is None\n\n\ndef test_keys_alone_are_not_schema_validity():\n    p = target()\n    p[\"contact\"] = None\n    assert not schema_valid(p)\n    assert schema_valid(target())\n    assert schema_valid(target(False))\n    p = target(False)\n    p[\"event_type\"] = \"accidental\"\n    assert not schema_valid(p)\n    p = target()\n    p[\"affected_joints\"] = [[\"J1\"]]\n    assert not schema_valid(p)\n\n\ndef fixture():\n    record = dict(target(), record_id=\"run/event\", session_id=\"run\", split=\"test\", onset_sample=300)\n    row = {\"record_id\": \"run/event\", \"target\": target(), \"prediction\": target()}\n    return {\"a\": [row], \"b\": [copy.deepcopy(row)]}, [record], {\"run\": \"test\"}\n\n\ndef test_alignment_accepts_identical_held_out_targets():\n    predictions, records, splits = fixture()\n    assert validate_alignment(predictions, records, splits) == [\"run/event\"]\n\n\n@pytest.mark.parametrize(\"problem\", [\"duplicate\", \"missing\", \"wrong_target\", \"train\", \"wrong_session\"])\ndef test_alignment_rejects_invalid_comparisons(problem):\n    predictions, records, splits = fixture()\n    if problem == \"duplicate\":\n        predictions[\"a\"].append(copy.deepcopy(predictions[\"a\"][0]))\n    elif problem == \"missing\":\n        predictions[\"b\"] = []\n    elif problem == \"wrong_target\":\n        predictions[\"b\"][0][\"target\"][\"onset_ms\"] = 301\n    elif problem == \"train\":\n        splits[\"run\"] = \"train\"\n    else:\n        predictions[\"b\"][0][\"session_id\"] = \"different\"\n    with pytest.raises(ValueError):\n        validate_alignment(predictions, records, splits)\n","stderr":"","aggregated_output":"import copy\nimport math\n\nimport pytest\n\nfrom robot_observability.comparison import percentile, schema_valid, score, validate_alignment\n\n\ndef target(contact=True):\n    return {\n        \"contact\": contact,\n        \"event_type\": \"accidental\" if contact else \"free\",\n        \"onset_ms\": 300 if contact else None,\n        \"strongest_joint\": \"J1\" if contact else None,\n        \"affected_joints\": [\"J1\"] if contact else [],\n        \"evidence_start_ms\": 300 if contact else None,\n        \"evidence_end_ms\": 450 if contact else None,\n    }\n\n\ndef test_abstention_on_free_motion_is_not_a_correct_negative():\n    items = [{\"target\": target(), \"prediction\": target()}, {\"target\": target(False), \"prediction\": None}]\n    result = score(items)\n    assert result[\"contact_accuracy\"] == 0.5\n    assert result[\"contact_answer_coverage\"] == 0.5\n    assert result[\"contact_positive_f1\"] == 1\n    assert result[\"contact_macro_f1\"] == 0.5\n    assert result[\"contact_confusion\"][\"false\"] == {\"abstain\": 1}\n\n\n@pytest.mark.parametrize(\"bad\", [True, \"300\", math.nan, math.inf, -1, 1024])\ndef test_onset_invalid_values_fail_coverage_and_success(bad):\n    prediction = target()\n    prediction[\"onset_ms\"] = bad\n    result = score([{\"target\": target(), \"prediction\": prediction}])\n    assert result[\"onset_coverage\"] == 0\n    assert result[\"onset_mae_ms\"] is None\n    assert result[\"onset_within_50ms_all_contacts\"] == 0\n    assert not schema_valid(prediction)\n\n\ndef test_missing_joint_lists_do_not_get_free_motion_credit():\n    result = score([{\"target\": target(False), \"prediction\": None}, {\"target\": target(), \"prediction\": {}}])\n    assert result[\"affected_joint_set_f1_contact_only\"] == 0\n\n\ndef test_percentile_uses_linear_interpolation():\n    assert percentile([1, 2, 3, 10], 0.9) == pytest.approx(7.9)\n    assert percentile([], 0.9) is None\n\n\ndef test_keys_alone_are_not_schema_validity():\n    p = target()\n    p[\"contact\"] = None\n    assert not schema_valid(p)\n    assert schema_valid(target())\n    assert schema_valid(target(False))\n    p = target(False)\n    p[\"event_type\"] = \"accidental\"\n    assert not schema_valid(p)\n    p = target()\n    p[\"affected_joints\"] = [[\"J1\"]]\n    assert not schema_valid(p)\n\n\ndef fixture():\n    record = dict(target(), record_id=\"run/event\", session_id=\"run\", split=\"test\", onset_sample=300)\n    row = {\"record_id\": \"run/event\", \"target\": target(), \"prediction\": target()}\n    return {\"a\": [row], \"b\": [copy.deepcopy(row)]}, [record], {\"run\": \"test\"}\n\n\ndef test_alignment_accepts_identical_held_out_targets():\n    predictions, records, splits = fixture()\n    assert validate_alignment(predictions, records, splits) == [\"run/event\"]\n\n\n@pytest.mark.parametrize(\"problem\", [\"duplicate\", \"missing\", \"wrong_target\", \"train\", \"wrong_session\"])\ndef test_alignment_rejects_invalid_comparisons(problem):\n    predictions, records, splits = fixture()\n    if problem == \"duplicate\":\n        predictions[\"a\"].append(copy.deepcopy(predictions[\"a\"][0]))\n    elif problem == \"missing\":\n        predictions[\"b\"] = []\n    elif problem == \"wrong_target\":\n        predictions[\"b\"][0][\"target\"][\"onset_ms\"] = 301\n    elif problem == \"train\":\n        splits[\"run\"] = \"train\"\n    else:\n        predictions[\"b\"][0][\"session_id\"] = \"different\"\n    with pytest.raises(ValueError):\n        validate_alignment(predictions, records, splits)\n","exit_code":0,"duration":{"secs":0,"nanos":3917},"formatted_output":"import copy\nimport math\n\nimport pytest\n\nfrom robot_observability.comparison import percentile, schema_valid, score, validate_alignment\n\n\ndef target(contact=True):\n    return {\n        \"contact\": contact,\n        \"event_type\": \"accidental\" if contact else \"free\",\n        \"onset_ms\": 300 if contact else None,\n        \"strongest_joint\": \"J1\" if contact else None,\n        \"affected_joints\": [\"J1\"] if contact else [],\n        \"evidence_start_ms\": 300 if contact else None,\n        \"evidence_end_ms\": 450 if contact else None,\n    }\n\n\ndef test_abstention_on_free_motion_is_not_a_correct_negative():\n    items = [{\"target\": target(), \"prediction\": target()}, {\"target\": target(False), \"prediction\": None}]\n    result = score(items)\n    assert result[\"contact_accuracy\"] == 0.5\n    assert result[\"contact_answer_coverage\"] == 0.5\n    assert result[\"contact_positive_f1\"] == 1\n    assert result[\"contact_macro_f1\"] == 0.5\n    assert result[\"contact_confusion\"][\"false\"] == {\"abstain\": 1}\n\n\n@pytest.mark.parametrize(\"bad\", [True, \"300\", math.nan, math.inf, -1, 1024])\ndef test_onset_invalid_values_fail_coverage_and_success(bad):\n    prediction = target()\n    prediction[\"onset_ms\"] = bad\n    result = score([{\"target\": target(), \"prediction\": prediction}])\n    assert result[\"onset_coverage\"] == 0\n    assert result[\"onset_mae_ms\"] is None\n    assert result[\"onset_within_50ms_all_contacts\"] == 0\n    assert not schema_valid(prediction)\n\n\ndef test_missing_joint_lists_do_not_get_free_motion_credit():\n    result = score([{\"target\": target(False), \"prediction\": None}, {\"target\": target(), \"prediction\": {}}])\n    assert result[\"affected_joint_set_f1_contact_only\"] == 0\n\n\ndef test_percentile_uses_linear_interpolation():\n    assert percentile([1, 2, 3, 10], 0.9) == pytest.approx(7.9)\n    assert percentile([], 0.9) is None\n\n\ndef test_keys_alone_are_not_schema_validity():\n    p = target()\n    p[\"contact\"] = None\n    assert not schema_valid(p)\n    assert schema_valid(target())\n    assert schema_valid(target(False))\n    p = target(False)\n    p[\"event_type\"] = \"accidental\"\n    assert not schema_valid(p)\n    p = target()\n    p[\"affected_joints\"] = [[\"J1\"]]\n    assert not schema_valid(p)\n\n\ndef fixture():\n    record = dict(target(), record_id=\"run/event\", session_id=\"run\", split=\"test\", onset_sample=300)\n    row = {\"record_id\": \"run/event\", \"target\": target(), \"prediction\": target()}\n    return {\"a\": [row], \"b\": [copy.deepcopy(row)]}, [record], {\"run\": \"test\"}\n\n\ndef test_alignment_accepts_identical_held_out_targets():\n    predictions, records, splits = fixture()\n    assert validate_alignment(predictions, records, splits) == [\"run/event\"]\n\n\n@pytest.mark.parametrize(\"problem\", [\"duplicate\", \"missing\", \"wrong_target\", \"train\", \"wrong_session\"])\ndef test_alignment_rejects_invalid_comparisons(problem):\n    predictions, records, splits = fixture()\n    if problem == \"duplicate\":\n        predictions[\"a\"].append(copy.deepcopy(predictions[\"a\"][0]))\n    elif problem == \"missing\":\n        predictions[\"b\"] = []\n    elif problem == \"wrong_target\":\n        predictions[\"b\"][0][\"target\"][\"onset_ms\"] = 301\n    elif problem == \"train\":\n        splits[\"run\"] = \"train\"\n    else:\n        predictions[\"b\"][0][\"session_id\"] = \"different\"\n    with pytest.raises(ValueError):\n        validate_alignment(predictions, records, splits)\n"},"started_at_ms":1789260445866,"completed_at_ms":1789260445866}}
{"timestamp":"2026-09-13T00:47:25.913Z","ordinal":5509,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0983b-b8d9-7652-abc7-e11a82cbdf31","call_id":"call_ibYqXlueSzafe53MAGpBgkys","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"3c3749\",\"wall_time_seconds\":0.000003917,\"exit_code\":0,\"original_token_count\":831,\"output\":\"import copy\\nimport math\\n\\nimport pytest\\n\\nfrom robot_observability.comparison import percentile, schema_valid, score, validate_alignment\\n\\n\\ndef target(contact=True):\\n    return {\\n        \\\"contact\\\": contact,\\n        \\\"event_type\\\": \\\"accidental\\\" if contact else \\\"free\\\",\\n        \\\"onset_ms\\\": 300 if contact else None,\\n        \\\"strongest_joint\\\": \\\"J1\\\" if contact else None,\\n        \\\"affected_joints\\\": [\\\"J1\\\"] if contact else [],\\n        \\\"evidence_start_ms\\\": 300 if contact else None,\\n        \\\"evidence_end_ms\\\": 450 if contact else None,\\n    }\\n\\n\\ndef test_abstention_on_free_motion_is_not_a_correct_negative():\\n    items = [{\\\"target\\\": target(), \\\"prediction\\\": target()}, {\\\"target\\\": target(False), \\\"prediction\\\": None}]\\n    result = score(items)\\n    assert result[\\\"contact_accuracy\\\"] == 0.5\\n    assert result[\\\"contact_answer_coverage\\\"] == 0.5\\n    assert result[\\\"contact_positive_f1\\\"] == 1\\n    assert result[\\\"contact_macro_f1\\\"] == 0.5\\n    assert result[\\\"contact_confusion\\\"][\\\"false\\\"] == {\\\"abstain\\\": 1}\\n\\n\\n@pytest.mark.parametrize(\\\"bad\\\", [True, \\\"300\\\", math.nan, math.inf, -1, 1024])\\ndef test_onset_invalid_values_fail_coverage_and_success(bad):\\n    prediction = target()\\n    prediction[\\\"onset_ms\\\"] = bad\\n    result = score([{\\\"target\\\": target(), \\\"prediction\\\": prediction}])\\n    assert result[\\\"onset_coverage\\\"] == 0\\n    assert result[\\\"onset_mae_ms\\\"] is None\\n    assert result[\\\"onset_within_50ms_all_contacts\\\"] == 0\\n    assert not schema_valid(prediction)\\n\\n\\ndef test_missing_joint_lists_do_not_get_free_motion_credit():\\n    result = score([{\\\"target\\\": target(False), \\\"prediction\\\": None}, {\\\"target\\\": target(), \\\"prediction\\\": {}}])\\n    assert result[\\\"affected_joint_set_f1_contact_only\\\"] == 0\\n\\n\\ndef test_percentile_uses_linear_interpolation():\\n    assert percentile([1, 2, 3, 10], 0.9) == pytest.approx(7.9)\\n    assert percentile([], 0.9) is None\\n\\n\\ndef test_keys_alone_are_not_schema_validity():\\n    p = target()\\n    p[\\\"contact\\\"] = None\\n    assert not schema_valid(p)\\n    assert schema_valid(target())\\n    assert schema_valid(target(False))\\n    p = target(False)\\n    p[\\\"event_type\\\"] = \\\"accidental\\\"\\n    assert not schema_valid(p)\\n    p = target()\\n    p[\\\"affected_joints\\\"] = [[\\\"J1\\\"]]\\n    assert not schema_valid(p)\\n\\n\\ndef fixture():\\n    record = dict(target(), record_id=\\\"run/event\\\", session_id=\\\"run\\\", split=\\\"test\\\", onset_sample=300)\\n    row = {\\\"record_id\\\": \\\"run/event\\\", \\\"target\\\": target(), \\\"prediction\\\": target()}\\n    return {\\\"a\\\": [row], \\\"b\\\": [copy.deepcopy(row)]}, [record], {\\\"run\\\": \\\"test\\\"}\\n\\n\\ndef test_alignment_accepts_identical_held_out_targets():\\n    predictions, records, splits = fixture()\\n    assert validate_alignment(predictions, records, splits) == [\\\"run/event\\\"]\\n\\n\\n@pytest.mark.parametrize(\\\"problem\\\", [\\\"duplicate\\\", \\\"missing\\\", \\\"wrong_target\\\", \\\"train\\\", \\\"wrong_session\\\"])\\ndef test_alignment_rejects_invalid_comparisons(problem):\\n    predictions, records, splits = fixture()\\n    if problem == \\\"duplicate\\\":\\n        predictions[\\\"a\\\"].append(copy.deepcopy(predictions[\\\"a\\\"][0]))\\n    elif problem == \\\"missing\\\":\\n        predictions[\\\"b\\\"] = []\\n    elif problem == \\\"wrong_target\\\":\\n        predictions[\\\"b\\\"][0][\\\"target\\\"][\\\"onset_ms\\\"] = 301\\n    elif problem == \\\"train\\\":\\n        splits[\\\"run\\\"] = \\\"train\\\"\\n    else:\\n        predictions[\\\"b\\\"][0][\\\"session_id\\\"] = \\\"different\\\"\\n    with pytest.raises(ValueError):\\n        validate_alignment(predictions, records, splits)\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","create_time":1789260445.91339}}}
