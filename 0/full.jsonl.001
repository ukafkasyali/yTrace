rontend/src/sourcing/DecisionEvidence.test.tsx:79:    expect(markup).toContain('Decision evidence');\nfrontend/src/sourcing/DecisionEvidence.test.tsx:83:    expect(markup).toContain('All mandatory requirements are supported by native evidence.');\nfrontend/src/sourcing/DecisionEvidence.test.tsx:111:        evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:115:        evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:180:  it('explains when refinement found no decision-changing evidence', () => {\nfrontend/src/sourcing/DecisionEvidence.test.tsx:201:    expect(markup).toContain('No new candidates or native evidence were found');\nfrontend/src/sourcing/DecisionEvidence.test.tsx:242:        kind: 'BLOCKER', label: 'Explicit licence', explanation: 'No licence evidence',\nfrontend/src/sourcing/DecisionEvidence.test.tsx:243:        evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:245:      gates: [{ gate: 'license', passed: false, reason: 'No licence evidence', evidenceIds: [] }],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:266:      explanation: 'Mandatory requirement is unsupported by native evidence.', evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:287:      category: 'DOMAIN', expectedValues: ['cnc'], status: 'VERIFIED', evidenceIds: ['ev_cnc'],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:293:        explanation: 'Native sources do not match the requested domain', evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:295:      gates: [{ gate: 'domain', passed: false, reason: 'Native sources do not match the requested domain', evidenceIds: [] }],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:306:        explanation: 'Mandatory requirement is unsupported by native evidence.', evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:309:        explanation: 'Mandatory requirement is unsupported by native evidence.', evidenceIds: [],\nfrontend/src/sourcing/DecisionEvidence.test.tsx:310:      }], gates: [{ gate: 'domain', passed: true, reason: 'Native sources match the requested domain', evidenceIds: ['ev_cnc'] }],\nfrontend/src/comparison/ComparisonPanel.tsx:41:    <p>Circles mark each curve’s largest absolute sampled torque, with its signed value. {result.resolution === 'raw' ? 'Raw samples.' : 'Overview samples; brief peaks may be missed.'} Peaks are measurements, not detected collisions. Motion phases may differ.</p></figure>;\nfrontend/src/comparison/ComparisonPanel.tsx:87:    <header><h2>What changed?</h2><p>Compare this incident with a reference window or another run.</p></header>\nfrontend/src/comparison/ComparisonPanel.tsx:92:      <div><label>Start (seconds)<input aria-label=\"Reference start seconds\" type=\"number\" min=\"0\" step=\"0.001\" value={start} onChange={e => setStart(e.target.value)} disabled={loading}/></label><span>{fixed(duration)} s window</span><button className=\"btn\" type=\"submit\" disabled={loading}>Compare windows</button></div>\nfrontend/src/comparison/ComparisonPanel.tsx:95:    {reference && Number(start) !== reference.start && <p className=\"reference-note\">Press Compare windows to apply the new reference start.</p>}\nfrontend/src/comparison/ComparisonPanel.tsx:100:      <div className=\"comparison-finding\"><span>Reference · {result.reference.recordingId} · {intervalLabel(result.reference.interval)}</span><h3>{result.joints[0].rangeDelta === 0 ? 'No change in sampled torque ranges' : `${result.joints[0].name} has the largest change in torque range`}</h3><p>{fixed(result.joints[0].reference.range)} → {fixed(result.joints[0].selected.range)} Nm <strong>({signed(result.joints[0].rangeDelta)} Nm)</strong></p><span>{result.resolution === 'raw' ? 'Both windows · raw' : 'Both windows · overview; brief peaks may be missed'} · {result.sampleRateHz} Hz · {result.reference.samplesPerChannel}/{result.selected.samplesPerChannel} samples</span></div>\nfrontend/src/comparison/ComparisonPanel.tsx:106:      <button className=\"btn comparison-export\" onClick={exportComparison}><Download size={13}/>Export comparison</button>{status && <p role=\"status\">{status}</p>}\nfrontend/src/comparison/compare.test.ts:17:  it('calculates signed differences on equal raw windows and ranks magnitude', () => {\nfrontend/src/comparison/compare.test.ts:25:  it('compares both sides at overview rate when one side lacks raw coverage', () => {\nfrontend/src/comparison/compare.test.ts:29:    // Alternating raw spikes alias in this fixture: demonstrates why mixed resolutions are invalid.\ninference/raw_recordings.py:60:    def raw_window(self, start_seconds: float, end_seconds: float, channel_ids: list[str]):\ninference/raw_recordings.py:84:        \"\"\"Return a 100 Hz display-only view; never label it raw.\"\"\"\ninference/raw_recordings.py:85:        times, values = self.raw_window(start_seconds, end_seconds, channel_ids)\ninference/raw_recordings.py:89:        \"\"\"Make a compatible replay response without exposing a full raw recording.\"\"\"\ninference/raw_recordings.py:92:        detail_times, detail_values = self.raw_window(0.0, detail_end, list(CHANNEL_IDS))\ninference/raw_recordings.py:132:                raise ValueError(f\"Duplicate raw recording identity: {record.recording_id}\")\ninference/raw_recordings.py:152:            raise ValueError(f\"Non-finite raw torque values: {torque_path}\")\ninference/raw_recordings.py:156:        raw_markers = np.asarray(loadmat(marker_path)[\"JK_moments\"]).reshape(-1)\ninference/raw_recordings.py:157:        if not np.issubdtype(raw_markers.dtype, np.number) or not np.isfinite(raw_markers).all() or not np.all(raw_markers == np.floor(raw_markers)):\ninference/raw_recordings.py:159:        markers = tuple(int(value) for value in raw_markers)\ninference/raw_recordings.py:161:            raise ValueError(f\"Publisher marker outside raw recording: {marker_path}\")\ndocs/submission/PILOT.md:3:Status: protocol prepared; no participants recruited, no results collected. This document must not be presented as user-study evidence. The facilitator materials are in [PILOT_RUNBOOK.md](PILOT_RUNBOOK.md); record observations only in `pilot-results.csv` using its documented columns.\ndocs/submission/PILOT.md:7:Does Trace's evidence-linked analysis and export help robotics engineers complete a correct contact-event report faster than chart inspection? The buyer hypothesis is a robotics engineering or test lead responsible for incident review; the initial user is the engineer assembling the report.\ndocs/submission/PILOT.md:15:Condition A: synchronized charts and ordinary numerical tools, without generated interpretations. Condition B: Trace with its actual measurements, model predictions, evidence links and export. Include at least one model failure or unavailable answer in B. Allow the same short tool familiarization in both conditions. Apply a five-minute task cap and retain incomplete attempts.\ndocs/submission/PILOT.md:17:Each task asks the participant to locate the event, state its class or abstain, identify strongest signal changes, and produce a short evidence-backed report. A reviewer blinded to condition scores against publisher labels for class/onset and separately against deterministic measurements for joint quantities. Do not score a physical root-cause diagnosis: no such ground truth exists.\nfrontend/src/comparison/compare.ts:25:function rawCovers(data: DemoData, w: Interval) { return w.start >= data.detail.startSeconds && w.end <= data.detail.endSeconds; }\nfrontend/src/comparison/compare.ts:26:function samples(data: DemoData, w: Interval, raw: boolean) {\nfrontend/src/comparison/compare.ts:28:  const source = raw ? data.detail : data;\nfrontend/src/comparison/compare.ts:29:  const rate = raw ? data.recording.sampleRateHz : data.recording.displaySampleRateHz;\nfrontend/src/comparison/compare.ts:45:  const raw = rawCovers(selectedData, selected) && rawCovers(referenceData, reference);\nfrontend/src/comparison/compare.ts:46:  const a = samples(selectedData, selected, raw), b = samples(referenceData, reference, raw);\nfrontend/src/comparison/compare.ts:58:    resolution: raw ? 'raw' : 'display', sampleRateHz: a.rate, joints,\nfrontend/src/comparison/compare.ts:59:    method: 'Equal-duration half-open windows; both raw only when both have raw coverage, otherwise both overview. Range=max-min; variability=population standard deviation; deltas=selected-reference. No resampling.',\nfrontend/src/comparison/compare.ts:60:    limitations: ['Reference normality and matching motion phase, payload and operating conditions are not verified.', 'Lower torque variation alone does not prove a successful repair, safety or fewer collisions.', ...(raw ? [] : ['Both windows use overview samples; short peaks may be missing.'])],\nfrontend/src/comparison/compare.ts:67:    verification: 'Repeat under matched operating conditions after an engineer-selected change. Compare the same metrics; record the intervention separately. This comparison does not establish causality.' };\ndocs/submission/VERIFICATION.md:22:| Browser, 1280×720 desktop and 390×844 mobile | Real automatic model answer, evidence control and export visible; mobile document width 390 px with no horizontal overflow |\ndocs/submission/VERIFICATION.md:23:| Actual downloaded investigation JSON | Verified 1,024 raw samples/channel, seven measurement rows, one in-window publisher marker, expected checkpoint and matching model receipt |\ndocs/submission/VERIFICATION.md:33:## Remaining evidence gaps\ndocs/submission/VERIFICATION.md:40:- No multi-recording raw-window demo, live control, verified root cause or physical contact localization.\nfrontend/src/evaluation/EvaluationWorkspace.tsx:32:    limitation: 'The joint targets use related signal formulas, so joint accuracy is not independent physical localization evidence.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:56:      'Patch and encode the raw numeric series, then project them into the language-model token space.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:57:      'Generate an evidence sentence and structured incident fields from the same temporal input.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:73:      'Ask Qwen3-VL 4B for the same evidence sentence and JSON fields at temperature zero.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:163:    <div className=\"evaluation-conclusion\"><CheckCircle2 size={17} aria-hidden=\"true\" /><div><strong>The transparent baseline wins classification; each learned model adds a different capability.</strong><p>The CNN gives the best typical onset timing. OpenTSLM has the best recorded onset P90 and produces operator-readable evidence, but its output reliability is the main weakness.</p></div></div>\nfrontend/src/evaluation/EvaluationWorkspace.tsx:212:    <details className=\"evaluation-methodology\"><summary>Evaluation contract and provenance</summary><p>Signal features, OpenTSLM, and Qwen are recomputed from checksum-verified archived predictions joined to the same 512 record IDs across 67 held-out recording groups. The CNN summary reports the same locked test size and seed, but its row-level predictions are not in that audited bundle, so it is visibly marked as a recorded run.</p><p>Recording sessions were split before window generation. Normalization and thresholds use training sessions only. Joint and evidence targets are deterministic signal-derived labels rather than physical contact-location truth.</p><p className=\"mono\">Audited pipeline · records {comparison.record_ids_sha256.slice(0, 12)}… · checkpoint {comparison.checkpoint_sha256.slice(0, 12)}… · CNN checkpoint 67e883b997c4…</p></details>\ndocs/submission/PRODUCT_PRIORITIES.md:13:1. Deploy full-recording raw access. The backend adapter and frontend request path\ndocs/submission/PRODUCT_PRIORITIES.md:16:   GPU service still needs the trusted archive mounted with `--raw-root`, followed\ndocs/submission/PRODUCT_PRIORITIES.md:24:   evidence-backed report and report errors, not just speed. Include model failures\ndocs/submission/PRODUCT_PRIORITIES.md:32:   without evidence. Finish checkpoint provenance and submission handoff.\ndocs/submission/PRODUCT_PRIORITIES.md:36:Use sparse labels linked to precise evidence. The implemented comparison graph\nfrontend/src/styles.css:7:.assistant-panel{flex:1;min-height:0;display:flex;flex-direction:column;background:#191d1f}.assistant-title{gap:8px!important}.assistant-title>svg{color:#b3c0c3}.conversation{overflow:auto;flex:1;min-height:0;padding:20px}.conversation-intro{max-width:530px;margin:auto}.assistant-emblem{color:var(--accent);margin-bottom:9px;display:flex}.conversation-intro h3{font-size:18px;font-weight:400;letter-spacing:-.01em}.conversation-intro>p{color:var(--quiet);font-size:12px;margin:6px 0 15px;max-width:400px}.suggestion-list{display:flex;flex-direction:column;gap:2px}.suggestion-list button{padding:7px 0;display:flex;justify-content:space-between;align-items:center;gap:15px;border:0;border-bottom:1px solid #30373b;background:transparent;text-align:left;font-size:12px;color:#ccd6d7}.suggestion-list button>svg{color:#849994}.suggestion-list button:hover{color:var(--accent)}.connection-note{display:flex;align-items:center;gap:6px;margin-top:12px;font-size:10px;color:#9facb0}.composer{margin:0 18px 15px;border:1px solid #485450;background:#22282a;border-radius:6px;flex-shrink:0}.composer:focus-within{border-color:var(--accent)}.composer-context{display:flex;align-items:center;gap:7px;padding:9px 12px 0;font-size:10px;color:#a2adb1}.composer-context strong{font-weight:400;color:#d0ded7}.composer-context>span:last-child{margin-left:auto}.selection-dot{width:5px;height:5px;background:var(--accent);display:inline-block;flex-shrink:0}.composer textarea{display:block;width:100%;border:0;resize:none;background:transparent;padding:10px 12px 3px;color:var(--text);font-size:13px;outline:none;min-height:51px}.composer textarea::placeholder{color:#a5b