tsx:94:    <footer className=\"robot-footer\" title={positions?.validation.scope}><span>{measured ? positions?.validation.mappingVerified ? 'Recorded angles · schematic frame' : 'Recorded angles · reference mapping; schematic frame' : positionError || 'No position sample at this cursor · fixed pose'}</span><span>{sample?.resolution === 'raw' ? 'Torque · 1 kHz raw' : 'Torque · 100 Hz overview'}</span></footer>\nfrontend/src/robot/telemetry.ts:18:    throw new Error('Measured joint positions could not be validated.');\nfrontend/src/recordings/RecordingContext.tsx:21:      <button aria-pressed={view === 'robot'} disabled={!isKuka} title={isKuka ? 'Inspect measured articulation when available; body and base frame are schematic' : 'A robot mapping is not available for this recording'} onClick={() => setView('robot')}><Box size={13}/>3D reference</button>\n"},"started_at_ms":1789260363809,"completed_at_ms":1789260363810}}
