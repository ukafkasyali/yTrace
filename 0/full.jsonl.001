Brief.test.ts:12:    expect(predictionCue(raw, interval)).toBeUndefined();\nfrontend/src/assistant/predictionBrief.test.ts:22:    for (const raw of [undefined, '', 'malformed', '{\"contact\":null,\"event_type\":\"free\"}', '{\"contact\":false,\"event_type\":\"accidental\"}', '{\"contact\":true,\"event_type\":\"unknown\"}']) expect(predictionBrief(raw)).toBeUndefined();\nfrontend/src/assistant/investigationReport.test.ts:15:  playhead: 2, text: 'A generated interpretation', mode: 'assistant', source: 'OpenTSLM', evidence: [],\nfrontend/src/assistant/investigationReport.test.ts:47:  it('requires canonical evidence before treating an assistant receipt as complete', () => {\nfrontend/src/assistant/investigationReport.test.ts:72:  it('renders a readable Markdown handoff without collapsing evidence sources', () => {\ndocs/submission/QWEN_BASELINE_PROMPT.txt:1:Use only the seven-panel telemetry plot as evidence. Diagnose the complete telemetry window. The panels are synchronized and their x axis starts at 0 ms. Return one short evidence sentence, then `Answer:` and compact valid JSON with exactly these keys: contact, event_type, onset_ms, strongest_joint, affected_joints, evidence_start_ms, evidence_end_ms. Use null onset/joint/interval values and an empty affected_joints list for free motion. Event types are free, intentional, or accidental. Joint names are J1 through J7. Do not use markdown fences.\nfrontend/src/assistant/investigationReport.ts:6:  mode: 'local' | 'assistant'; source: string; evidence: EvidenceLink[];\nfrontend/src/assistant/investigationReport.ts:64:      modelRevision: answer.modelRevision ?? null, rawModelOutput: answer.modelOutput ?? null,\nfrontend/src/assistant/investigationReport.ts:65:      inputReceipt: answer.inputTrace ?? null, evidence: answer.evidence },\nfrontend/src/assistant/investigationReport.ts:68:      'Publisher annotations, measured quantities and generated predictions are distinct evidence sources.',\nfrontend/src/assistant/investigationReport.ts:103:  const evidence = report.interpretation.evidence.length\nfrontend/src/assistant/investigationReport.ts:104:    ? report.interpretation.evidence.map(item =>\nfrontend/src/assistant/investigationReport.ts:106:    : '- No separate evidence links were returned.';\nfrontend/src/assistant/investigationReport.ts:114:    '> Retrospective robot telemetry report. Measurements, publisher annotations, and generated predictions are recorded as separate evidence sources.',\nfrontend/src/assistant/investigationReport.ts:148:    evidence,\nfrontend/src/robot/telemetry.test.ts:16:  it('uses raw samples inside the verified detail excerpt', () => {\nfrontend/src/robot/telemetry.test.ts:18:    expect(sample.resolution).toBe('raw');\ndocs/submission/demo/motion-activation.json:60:        \"summary\": \"Calculated per-joint torque ranges from the selected raw telemetry.\"\ndocs/submission/demo/motion-activation.json:70:        \"label\": \"Running OpenTSLM on selected raw telemetry\"\ndocs/submission/demo/motion-activation.json:79:        \"summary\": \"OpenTSLM generation completed; explanation has not been independently verified.\"\ndocs/submission/demo/motion-activation.json:87:        \"answer\": \"Measured in this selected window\\nLargest observed torque ranges: Joint 2 (2.914 Nm range), Joint 1 (1.594 Nm range), Joint 4 (1.047 Nm range).\\n\\nOpenTSLM interpretation\\nOpenTSLM predicts external contact. Interaction class: accidental. Strongest predicted disturbance: J1. Affected joints: J1. Predicted onset: 429 ms after the window starts. Predicted evidence interval: 429\\u2013679 ms. Treat these generated predictions as leads, not verified physical facts.\",\ndocs/submission/demo/motion-activation.json:88:        \"modelOutput\": \"Answer: {\\\"affected_joints\\\":[\\\"J1\\\"],\\\"contact\\\":true,\\\"event_type\\\":\\\"accidental\\\",\\\"evidence_end_ms\\\":679,\\\"evidence_start_ms\\\":429,\\\"onset_ms\\\":429,\\\"strongest_joint\\\":\\\"J1\\\"}\\nEvidence: The manual event marker is at 429 ms; calibrated top joint scores are J1=0.71, J2=0.54, J4=0.44. Sustained evidence spans 429\\u2013679 ms.\",\ndocs/submission/demo/motion-activation.json:116:        \"evidence\": [\ndocs/submission/demo/intentional-case.json:60:        \"summary\": \"Calculated per-joint torque ranges from the selected raw telemetry.\"\ndocs/submission/demo/intentional-case.json:70:        \"label\": \"Running OpenTSLM on selected raw telemetry\"\ndocs/submission/demo/intentional-case.json:79:        \"summary\": \"OpenTSLM generation completed; explanation has not been independently verified.\"\ndocs/submission/demo/intentional-case.json:87:        \"answer\": \"Measured in this selected window\\nLargest observed torque ranges: Joint 2 (6.129 Nm range), Joint 4 (3.507 Nm range), Joint 1 (1.699 Nm range).\\n\\nOpenTSLM interpretation\\nOpenTSLM predicts external contact. Interaction class: intentional. Strongest predicted disturbance: J4. Affected joints: J4, J2. Predicted onset: 312 ms after the window starts. Predicted evidence interval: 511\\u2013562 ms. Treat these generated predictions as leads, not verified physical facts.\",\ndocs/submission/demo/intentional-case.json:88:        \"modelOutput\": \"Answer: {\\\"affected_joints\\\":[\\\"J4\\\",\\\"J2\\\"],\\\"contact\\\":true,\\\"event_type\\\":\\\"intentional\\\",\\\"evidence_end_ms\\\":562,\\\"evidence_start_ms\\\":511,\\\"onset_ms\\\":312,\\\"strongest_joint\\\":\\\"J4\\\"}\\nEvidence: The manual event marker is at 312 ms; calibrated top joint scores are J4=1.71, J2=1.50, J6=0.62. Sustained evidence spans 511\\u2013562 ms.\",\ndocs/submission/demo/intentional-case.json:116:        \"evidence\": [\ndocs/submission/demo/free-case.json:60:        \"summary\": \"Calculated per-joint torque ranges from the selected raw telemetry.\"\ndocs/submission/demo/free-case.json:70:        \"label\": \"Running OpenTSLM on selected raw telemetry\"\ndocs/submission/demo/free-case.json:79:        \"summary\": \"OpenTSLM generation completed; explanation has not been independently verified.\"\ndocs/submission/demo/free-case.json:88:        \"modelOutput\": \"Answer: {\\\"affected_joints\\\":[],\\\"contact\\\":false,\\\"event_type\\\":\\\"free\\\",\\\"evidence_end_ms\\\":null,\\\"evidence_start_ms\\\":null,\\\"onset_ms\\\":null,\\\"strongest_joint\\\":null}\\nEvidence: No sustained joint disturbance crosses the threshold calibrated on train-only free motion.\",\ndocs/submission/demo/free-case.json:116:        \"evidence\": [\nfrontend/src/signals/SignalViewer.tsx:55:    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\nfrontend/src/signals/SignalViewer.tsx:70:    <footer className=\"plot-footer\"><span data-cursor-time>Hover to inspect · drag to select</span><span><Maximize2 size={12}/>{visible ? `${visible.sampleRateHz >= 1000 ? `${(visible.sampleRateHz / 1000).toFixed(0)} kHz` : `${visible.sampleRateHz.toFixed(0)} Hz`} ${visible.resolution === 'raw' ? 'raw' : 'overview'} · extrema-preserving plot` : 'No replayed samples'}</span></footer>\ndocs/submission/demo/collision-case.json:60:        \"summary\": \"Calculated per-joint torque ranges from the selected raw telemetry.\"\ndocs/submission/demo/collision-case.json:70:        \"label\": \"Running OpenTSLM on selected raw telemetry\"\ndocs/submission/demo/collision-case.json:79:        \"summary\": \"OpenTSLM generation completed; explanation has not been independently verified.\"\ndocs/submission/demo/collision-case.json:87:        \"answer\": \"Measured in this selected window\\nLargest observed torque ranges: Joint 2 (7.296 Nm range), Joint 4 (3.334 Nm range), Joint 1 (1.256 Nm range).\\n\\nOpenTSLM interpretation\\nOpenTSLM predicts external contact. Interaction class: accidental. Strongest predicted disturbance: J4. Affected joints: J4, J2. Predicted onset: 298 ms after the window starts. Predicted evidence interval: 298\\u2013548 ms. Treat these generated predictions as leads, not verified physical facts.\",\ndocs/submission/demo/collision-case.json:88:        \"modelOutput\": \"Answer: {\\\"affected_joints\\\":[\\\"J4\\\",\\\"J2\\\"],\\\"contact\\\":true,\\\"event_type\\\":\\\"accidental\\\",\\\"evidence_end_ms\\\":548,\\\"evidence_start_ms\\\":298,\\\"onset_ms\\\":298,\\\"strongest_joint\\\":\\\"J4\\\"}\\nEvidence: The manual event marker is at 298 ms; calibrated top joint scores are J4=1.61, J2=1.55, J6=0.54. Sustained evidence spans 298\\u2013548 ms.\",\ndocs/submission/demo/collision-case.json:116:        \"evidence\": [\ndocs/submission/demo/smoke-result.json:41:        \"label\": \"Running OpenTSLM on selected raw telemetry\"\ndocs/submission/demo/smoke-result.json:50:        \"summary\": \"OpenTSLM generation completed; explanation has not been independently verified.\"\ndocs/submission/demo/smoke-result.json:58:        \"answer\": \"Measured in this selected window\\nLargest observed torque ranges: Joint 2 (4.456 Nm range), Joint 1 (3.088 Nm range), Joint 4 (2.451 Nm range).\\n\\nOpenTSLM interpretation\\nOpenTSLM predicts external contact. Interaction class: accidental. Strongest predicted disturbance: J4. Affected joints: J4, J1. Predicted onset: 276 ms after the window starts. Predicted evidence interval: 295\\u2013325 ms. Treat these generated predictions as leads, not verified physical facts.\",\ndocs/submission/demo/smoke-result.json:59:        \"modelOutput\": \"Answer: {\\\"affected_joints\\\":[\\\"J4\\\",\\\"J1\\\"],\\\"contact\\\":true,\\\"event_type\\\":\\\"accidental\\\",\\\"evidence_end_ms\\\":325,\\\"evidence_start_ms\\\":295,\\\"onset_ms\\\":276,\\\"strongest_joint\\\":\\\"J4\\\"}\\nEvidence: The manual event marker is at 276 ms; calibrated top joint scores are J4=1.31, J1=1.28, J2=0.91. Sustained evidence spans 295\\u2013325 ms.\",\ndocs/submission/demo/smoke-result.json:87:        \"evidence\": [\n"},"started_at_ms":1789259595640,"completed_at_ms":1789259595640}}
