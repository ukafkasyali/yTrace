in-height:32px}.plot-actions .icon-button{width:34px;height:34px}}\nfrontend/src/styles.css:67:.evidence-links button{font-size:12px;padding:5px 9px;min-height:32px}\nfrontend/src/styles.css:157:.decision-evidence{margin:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0}.decision-evidence-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.decision-evidence h3{font-size:17px}.decision-evidence h4{font-size:12px;margin:18px 0 8px;color:var(--text)}.evidence-count{color:var(--quiet);font-size:11px}.decision-outcome{margin:10px 0!important;max-width:850px;color:var(--quiet)!important;line-height:1.55!important}.decision-outcome strong{color:var(--text)}.workspace-section dl.decision-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:14px 0}.decision-metrics>div{padding:10px 14px;border-right:1px solid var(--line)}.decision-metrics>div:first-child{padding-left:0}.decision-metrics>div:last-child{border-right:0}.decision-metrics dt,.evidence-table small{display:block;color:var(--quiet);font-size:10px}.decision-metrics dd{margin:3px 0 0;font-size:12px}.requirement-evidence-help{color:var(--quiet)!important;font-size:11px!important;margin:-3px 0 8px!important}.evidence-table{min-width:720px}.evidence-table th,.evidence-table td{vertical-align:top}.evidence-table td:first-child{min-width:170px}.evidence-table td:last-child{min-width:300px}.evidence-table a{display:inline-flex;align-items:center;gap:4px;min-height:28px}.evidence-status{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}.evidence-verified{color:var(--accent)}.evidence-missing,.evidence-not_found,.evidence-conflicting,.evidence-unverified{color:#efb0a4}.requirement-evidence ul{list-style:none;margin:0;padding:0}.requirement-evidence details summary{font-size:10px!important;color:var(--quiet)!important}.requirement-evidence-item{