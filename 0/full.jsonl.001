{"timestamp":"2026-09-13T00:51:08.121Z","ordinal":5712,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","item":{"type":"CommandExecution","id":"exec-ba6ee710-0a9b-4fa7-a2b7-0c588582a201","process_id":"59812","command":["/bin/zsh","-lc","sed -n '100,170p' frontend/src/App.tsx && sed -n '1,140p' frontend/src/signals/SignalViewer.tsx && rg -n \"plotWindow|selection|visibleWindow|start\" frontend/src/signals -g '*.ts*'"],"cwd":"file:///Users/sametdegirmenci/Downloads/ysamet","parsed_cmd":[{"type":"read","cmd":"sed -n '100,170p' frontend/src/App.tsx","name":"App.tsx","path":"frontend/src/App.tsx"},{"type":"read","cmd":"sed -n '1,140p' frontend/src/signals/SignalViewer.tsx","name":"SignalViewer.tsx","path":"frontend/src/signals/SignalViewer.tsx"},{"type":"search","cmd":"rg -n 'plotWindow|selection|visibleWindow|start' frontend/src/signals -g '*.ts*'","query":"plotWindow|selection|visibleWindow|start","path":"signals"}],"source":"unified_exec_startup","status":"completed","stdout":"    if (highlighted.length && highlighted.length <= 2) return highlighted;\n    try {\n      return selectWindow(data, interval).channels.map(c => ({ id: c.id, range: Math.max(...c.values) - Math.min(...c.values) }))\n        .sort((a, b) => b.range - a.range).slice(0, 2).map(c => c.id);\n    } catch { return data.channels.slice(0, 2).map(c => c.id); }\n  }, [data, interval, highlighted]);\n  const viewport = useMemo(() => {\n    if (following) return { start: zoom ? Math.max(0, replay.playhead-zoom) : 0, end: Math.max(.01, replay.playhead) };\n    const padding = (interval.end-interval.start)*.18;\n    return { start: Math.max(0, interval.start-padding), end: Math.max(.01, Math.min(data.recording.durationSeconds, interval.end+padding, replay.playhead)) };\n  }, [following, zoom, interval, data.recording.durationSeconds, replay.playhead]);\n  const validViewport = viewport.end > viewport.start ? viewport : { start: 0, end: Math.max(.01, replay.playhead) };\n  // Playback moves the visual cursor, never the investigation's selected input.\n  const effectiveInterval = interval;\n  function select(next: Interval) { setReplayStop(undefined); if (next.start < 0 || next.end <= next.start || next.end > data.recording.durationSeconds) { setSelectionError('Choose a nonempty interval within this recording.'); return; } replay.pause(); setFollowing(false); setInterval(next); setSelectionError(''); }\n  function seek(value: number) {\n    setReplayStop(undefined); replay.seek(value); setFollowing(true); setHighlighted([]); setSelectionError('');\n  }\n  function marker(e: Marker) {\n    setReplayStop(undefined);\n    const context = markerWindow(e, data.recording.durationSeconds);\n    replay.seek(context.start);\n    setInterval(context);\n    setVisualMode('robot');\n    setMobile('signals');\n    setFollowing(false);\n    setHighlighted([]);\n    setSelectionError('');\n  }\n  function navigateMarker(direction: number) {\n    const target = direction > 0 ? data.events.find(e => e.timeSeconds > Math.max(interval.end, replay.playhead)) : [...data.events].reverse().find(e => e.timeSeconds < (effectiveInterval.start || replay.playhead));\n    if (target) marker(target);\n  }\n  function evidence(e: EvidenceLink) { setReplayStop(undefined); if (e.interval.start < 0 || e.interval.end > data.recording.durationSeconds || e.interval.end <= e.interval.start) return; replay.seek(e.interval.end); setInterval({ ...e.interval }); setFollowing(false); setHighlighted(e.channelIds?.length ? e.channelIds : [e.channelId]); setView('inspect'); setMobile('signals'); setVisualMode('signals'); }\n  return <div className={`app-shell view-${view}`}>\n    <header className=\"app-header\"><a className=\"brand\" href=\"#\" onClick={e => { e.preventDefault(); setView('inspect'); }}><Activity size={23} strokeWidth={1.8}/><span>trace</span></a><div className=\"header-divider\"/><span className=\"project-name\">Recorded incident handoff</span><span className=\"replay-label\"><RotateCcw size={11}/>Replay</span><div className=\"header-right\"><span className=\"model-status\"><CpuStatus/>{availability}</span><button className=\"btn btn-subtle\" aria-pressed={view === 'evaluation'} onClick={() => { replay.pause(); setView('evaluation'); }}><BarChart3 size={14}/>Evaluation</button><button className=\"btn btn-subtle\" aria-pressed={view === 'data'} onClick={() => { replay.pause(); setView('data'); }}><Database size={14}/>Data source</button></div></header>\n    <div className=\"app-body\">\n      <main className=\"main-workspace\">\n        {view === 'inspect' && (cases.length > 0 || caseError) && <div className=\"demo-cases\"><label>Recording <select aria-label=\"Example case\" disabled={caseLoading} value={data.demoCase?.id ?? ''} onChange={e => void onOpenCase(e.target.value)}><option value=\"\" disabled>KUKA · original recording</option>{cases.map(c => <option key={c.id} value={c.id}>{c.title}</option>)}</select></label><details className=\"case-source\"><summary>Source · {data.recording.id}</summary><p>{data.demoCase?.note ?? 'Original KUKA recording. Publisher markers are annotations, not verified contact onset. Raw model input is available from 4 to 9 seconds.'}</p></details>{(caseLoading || caseError) && <span role={caseError ? 'alert' : 'status'}>{caseLoading ? 'Loading raw telemetry…' : caseError}</span>}</div>}\n        {view === 'inspect' && <div className=\"mobile-switch\"><button className={mobile === 'signals' ? 'active' : ''} onClick={() => { setView('inspect'); setMobile('signals'); setVisualMode('signals'); }}>Replay</button><button className={mobile === 'assistant' ? 'active' : ''} onClick={() => { setView('inspect'); setMobile('assistant'); }}>Investigation</button></div>}\n        <div className={`inspect-grid mobile-${mobile}`} style={{ display: view === 'inspect' ? undefined : 'none' }}>\n          <div className=\"left-workspace\"><AssistantPanel rawLoading={rawWindow.loading} rawError={rawWindow.error} onRetryRaw={rawWindow.retry} registry={registry} data={data} datasetId={datasetId} playhead={replay.playhead} interval={effectiveInterval} services={services} onEvidence={evidence} onCompare={openComparison} onRobotPrediction={showRobotPrediction} onModelWindow={select}/></div>\n          <div className={`visual-workspace visual-${visualMode}`}>\n            <div className=\"visual-tabs\" role=\"group\" aria-label=\"Replay view\">{(['robot', 'signals', 'markers', 'compare'] as const).map(mode => <button key={mode} aria-pressed={visualMode === mode} onClick={() => setVisualMode(mode)}>{mode === 'robot' ? 'Robot' : mode === 'signals' ? 'All 7 signals' : mode === 'markers' ? 'Publisher markers' : 'Compare'}</button>)}<button className=\"text-button replay-interval\" onClick={replayInterval}><Play size={12}/>Replay interval · 0.5×</button></div>\n            {visualMode === 'compare' && <ComparisonPanel key={`${interval.start}:${interval.end}`} data={data} interval={interval} cases={cases} services={services} onEvidence={e => { evidence(e); replay.seek(e.interval.end); }}/> }\n            {(visualMode === 'robot' || visualMode === 'markers') && <RecordingContext prediction={visiblePrediction} display={visualMode === 'robot' ? 'robot' : 'overview'} datasetId={datasetId} data={data} playhead={replay.playhead} interval={effectiveInterval} highlighted={highlighted} onMarker={marker} onHighlight={id => setHighlighted(h => h.includes(id) ? h.filter(x => x !== id) : [id])} onData={() => { replay.pause(); setView('data'); }}/>}\n            {(visualMode === 'robot' || visualMode === 'signals') && <SignalViewer visibleChannelIds={visualMode === 'robot' ? previewChannels : undefined} data={data} playhead={replay.playhead} interval={effectiveInterval} viewport={validViewport} highlighted={highlighted} following={following} zoom={zoom} onSelect={select} onFollow={() => { setFollowing(true); setZoom(10); }} onZoom={n => { setFollowing(true); setZoom(n); }}/>}\n          </div>\n        </div>\n        {view === 'data' && <div className=\"secondary-view\"><button className=\"text-button back-inspect\" onClick={() => setView('inspect')}><ArrowLeft size={14}/>Back to replay</button><DataWorkspace services={services} data={data} onOpenRecording={onOpenRecording}/></div>}\n        {view === 'evaluation' && <div className=\"secondary-view\"><button className=\"text-button back-inspect\" onClick={() => setView('inspect')}><ArrowLeft size={14}/>Back to replay</button><EvaluationWorkspace /></div>}\n      </main>\n    </div>\n    {view === 'inspect' && <><footer className=\"transport\"><div className=\"transport-controls\"><button className=\"icon-button\" aria-label=\"Replay from beginning\" title=\"Replay from beginning\" onClick={() => { setReplayStop(undefined); setFollowing(true); setHighlighted([]); replay.restart(); }}><RotateCcw size={15}/></button><button className=\"icon-button\" aria-label=\"Previous publisher marker\" disabled={!data.events.some(e => e.timeSeconds < effectiveInterval.start)} onClick={() => navigateMarker(-1)}><SkipBack size={15}/></button><button className=\"play-button\" aria-label={replay.playing ? 'Pause replay' : 'Play replay'} onClick={() => { if (!replay.playing) setFollowing(true); replay.toggle(); }}>{replay.playing ? <Pause size={17} fill=\"currentColor\"/> : <Play size={17} fill=\"currentColor\"/>}</button><button className=\"icon-button\" aria-label=\"Next publisher marker\" disabled={!data.events.some(e => e.timeSeconds > Math.max(interval.end, replay.playhead))} onClick={() => navigateMarker(1)}><SkipForward size={15}/></button></div><div className=\"replay-clock\"><strong className=\"mono\">{timecode(replay.playhead, true)}</strong><span className=\"mono\">/ {timecode(data.recording.durationSeconds)}</span></div><div className=\"timeline-control\"><label className=\"sr-only\" htmlFor=\"playhead\">Replay position in seconds</label><input id=\"playhead\" type=\"range\" min=\"0\" max={data.recording.durationSeconds} step=\"0.001\" value={replay.playhead} onChange={e => seek(Number(e.target.value))} style={{ '--progress': `${replay.playhead/data.recording.durationSeconds*100}%` } as React.CSSProperties}/><div className=\"timeline-marks\">{data.events.map(e => <button key={e.id} className={e.timeSeconds <= replay.playhead ? 'reached' : 'upcoming'} style={{ left: `${e.timeSeconds/data.recording.durationSeconds*100}%` }} aria-label={`${e.label}, publisher annotation at ${e.timeSeconds.toFixed(3)} seconds${e.timeSeconds > replay.playhead ? ', upcoming' : ''}`} title={`${e.label} · ${e.timeSeconds.toFixed(3)} s · publisher annotation`} onClick={() => marker(e)}/>)}</div></div><label className=\"speed-control\"><span className=\"sr-only\">Playback speed</span><select aria-label=\"Playback speed\" value={replay.speed} onChange={e => replay.setSpeed(Number(e.target.value))}>{[.5,1,2,4].map(n => <option key={n} value={n}>{n}×</option>)}</select></label><span className=\"play-state\">{replay.playing ? 'Playing' : 'Paused'}</span></footer>\n    <div className=\"selection-footer\"><span><span className=\"selection-dot\"/>Investigation interval <strong className=\"mono\">{intervalLabel(effectiveInterval)}</strong></span><form onSubmit={e => { e.preventDefault(); select({ start: Number(draftStart), end: Number(draftEnd) }); }}><label>From <input aria-label=\"Selection start seconds\" type=\"number\" step=\"0.001\" min=\"0\" max={data.recording.durationSeconds} value={draftStart} onChange={e => setDraftStart(e.target.value)}/></label><label>to <input aria-label=\"Selection end seconds\" type=\"number\" step=\"0.001\" min=\"0\" max={data.recording.durationSeconds} value={draftEnd} onChange={e => setDraftEnd(e.target.value)}/></label><button type=\"submit\">Apply</button></form><button className=\"text-button\" disabled={replay.playhead < 1.024} onClick={() => { const end = Math.floor(replay.playhead * 1000) / 1000; select({ start: Math.round((end - 1.024) * 1000) / 1000, end }); }}>Select at cursor</button>{selectionError && <span role=\"alert\" className=\"error-message\">{selectionError}</span>}</div></>}\n  </div>;\n}\nfunction CpuStatus() { return <Radio size={13}/>; }\nimport { useMemo, useRef } from 'react';\nimport { Crosshair, Maximize2 } from 'lucide-react';\nimport { downsample, selectWindow } from '../lib/data';\nimport { COLORS } from '../lib/format';\nimport type { DemoData, Interval } from '../types';\n\ntype Props = { visibleChannelIds?: string[]; data: DemoData; playhead: number; interval: Interval; viewport: Interval; highlighted: string[]; following: boolean; zoom: number; onSelect: (v: Interval) => void; onFollow: () => void; onZoom: (seconds: number) => void };\n\nexport default function SignalViewer({ visibleChannelIds, data, playhead, interval, viewport, highlighted, following, zoom, onSelect, onFollow, onZoom }: Props) {\n  const hover = useRef<number | null>(null);\n  const panel = useRef<HTMLDivElement>(null);\n  const drag = useRef<number | null>(null);\n  const end = Math.min(viewport.end, playhead);\n  const visible = useMemo(() => {\n    if (end <= viewport.start) return null;\n    try { return selectWindow(data, { start: viewport.start, end }); } catch { return null; }\n  }, [data, viewport.start, end]);\n  const plots = useMemo(() => data.channels.map((channel, index) => {\n    const values = visible?.channels[index].values ?? [];\n    const times = visible?.times ?? [];\n    const points = downsample(times.map((x, i) => ({ x, y: values[i] })), 600);\n    let low = values.length ? Math.min(...values) : -1;\n    let high = values.length ? Math.max(...values) : 1;\n    const pad = Math.max((high - low) * .15, .01); low -= pad; high += pad;\n    const x = (t: number) => (t - viewport.start) / (viewport.end - viewport.start) * 1000;\n    const y = (v: number) => 70 - (v - low) / (high - low) * 64;\n    const path = points.map((p, i) => `${i ? 'L' : 'M'}${x(p.x).toFixed(2)},${y(p.y).toFixed(2)}`).join(' ');\n    return { channel, colorIndex: index, values, times, path, low, high, zero: y(0), last: values.at(-1) };\n  }).filter(p => !visibleChannelIds || visibleChannelIds.includes(p.channel.id)), [data, visible, viewport, visibleChannelIds]);\n  function pointerTime(event: React.PointerEvent<SVGSVGElement>) {\n    const rect = event.currentTarget.getBoundingClientRect();\n    return Math.max(viewport.start, Math.min(playhead, viewport.start + (event.clientX - rect.left) / rect.width * (viewport.end - viewport.start)));\n  }\n  function showCursor(time: number | null) {\n    hover.current = time;\n    if (!panel.current) return;\n    panel.current.style.setProperty('--cursor', `${time === null ? -100 : (time - viewport.start) / (viewport.end - viewport.start) * 100}%`);\n    panel.current.querySelectorAll<HTMLElement>('[data-sample-value]').forEach((el, i) => {\n      const p = plots[i];\n      let value = p.last;\n      if (time !== null && p.times.length) {\n        let lo = 0, hi = p.times.length - 1;\n        while (lo < hi) { const mid = (lo + hi) >>> 1; if (p.times[mid] < time) lo = mid + 1; else hi = mid; }\n        const idx = lo > 0 && Math.abs(p.times[lo - 1] - time) < Math.abs(p.times[lo] - time) ? lo - 1 : lo;\n        value = p.values[idx];\n      }\n      el.textContent = value === undefined ? '—' : value.toFixed(3);\n    });\n    const label = panel.current.querySelector('[data-cursor-time]');\n    if (label) label.textContent = time === null ? 'Hover to inspect · drag to select' : `Cursor ${time.toFixed(3)} s · nearest available samples`;\n  }\n  const left = Math.max(0, (interval.start - viewport.start) / (viewport.end - viewport.start) * 100);\n  const right = Math.min(100, (Math.min(interval.end, playhead) - viewport.start) / (viewport.end - viewport.start) * 100);\n  return <section className=\"signals-panel\" ref={panel} aria-label=\"Synchronized torque signals\">\n    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\n    <div className=\"signal-strips\">{plots.map(p => <div key={p.channel.id} className={`signal-strip ${highlighted.includes(p.channel.id) ? 'signal-highlighted' : ''}`} data-channel={p.channel.id}>\n      <div className=\"strip-heading\"><span className=\"channel-name\"><i style={{ background: COLORS[p.colorIndex] }}/>{p.channel.name}<span className=\"unit\">Nm</span></span><span className=\"mono sample-value\" data-sample-value>{p.last?.toFixed(3) ?? '—'}</span></div>\n      <div className=\"plot-frame\"><div className=\"y-labels\"><span>{p.high.toFixed(p.high-p.low < 1 ? 2 : 1)}</span><span>{p.low.toFixed(p.high-p.low < 1 ? 2 : 1)}</span></div><div className=\"plot-area\">\n        {right > left && <div className=\"selection-band\" style={{ left: `${left}%`, width: `${right - left}%` }}/>}<div className=\"hover-guide\"/>\n        <svg viewBox=\"0 0 1000 76\" preserveAspectRatio=\"none\" role=\"img\" aria-label={`${p.channel.name}, signed external torque in Nm, ${viewport.start.toFixed(3)} to ${end.toFixed(3)} seconds`} onPointerMove={e => showCursor(pointerTime(e))} onPointerLeave={() => showCursor(null)} onPointerDown={e => { if (e.pointerType === 'mouse') { drag.current = pointerTime(e); e.currentTarget.setPointerCapture(e.pointerId); } }} onPointerUp={e => { if (drag.current !== null) { const t = pointerTime(e); const start = Math.min(t, drag.current), finish = Math.max(t, drag.current); if (finish - start >= .01) onSelect({ start, end: finish }); drag.current = null; } }}>\n          {[0, 250, 500, 750, 1000].map(x => <line key={x} x1={x} x2={x} y1=\"0\" y2=\"76\" className=\"chart-grid\"/>)}\n          {[18, 38, 58].map(y => <line key={y} x1=\"0\" x2=\"1000\" y1={y} y2={y} className=\"chart-grid\"/>)}\n          {p.zero > 0 && p.zero < 76 && <line x1=\"0\" x2=\"1000\" y1={p.zero} y2={p.zero} className=\"chart-zero\"/>}\n          {data.events.filter(e => e.timeSeconds >= viewport.start && e.timeSeconds <= end).map(e => <line key={e.id} x1={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} x2={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} y1=\"0\" y2=\"76\" className=\"event-line\"/>)}\n          <path d={p.path} fill=\"none\" stroke={COLORS[p.colorIndex]} strokeWidth=\"1.3\" vectorEffect=\"non-scaling-stroke\"/>\n        </svg>\n      </div></div>\n    </div>)}</div>\n    <div className=\"shared-axis\">{[0, .25, .5, .75, 1].map(v => <span key={v}>{(viewport.start+(viewport.end-viewport.start)*v).toFixed(2)} s</span>)}</div>\n    <footer className=\"plot-footer\"><span data-cursor-time>Hover to inspect · drag to select</span><span><Maximize2 size={12}/>{visible ? `${visible.sampleRateHz >= 1000 ? `${(visible.sampleRateHz / 1000).toFixed(0)} kHz` : `${visible.sampleRateHz.toFixed(0)} Hz`} ${visible.resolution === 'raw' ? 'raw' : 'overview'} · extrema-preserving plot` : 'No replayed samples'}</span></footer>\n  </section>;\n}\nfrontend/src/signals/SignalViewer.tsx:15:    if (end <= viewport.start) return null;\nfrontend/src/signals/SignalViewer.tsx:16:    try { return selectWindow(data, { start: viewport.start, end }); } catch { return null; }\nfrontend/src/signals/SignalViewer.tsx:17:  }, [data, viewport.start, end]);\nfrontend/src/signals/SignalViewer.tsx:25:    const x = (t: number) => (t - viewport.start) / (viewport.end - viewport.start) * 1000;\nfrontend/src/signals/SignalViewer.tsx:32:    return Math.max(viewport.start, Math.min(playhead, viewport.start + (event.clientX - rect.left) / rect.width * (viewport.end - viewport.start)));\nfrontend/src/signals/SignalViewer.tsx:37:    panel.current.style.setProperty('--cursor', `${time === null ? -100 : (time - viewport.start) / (viewport.end - viewport.start) * 100}%`);\nfrontend/src/signals/SignalViewer.tsx:52:  const left = Math.max(0, (interval.start - viewport.start) / (viewport.end - viewport.start) * 100);\nfrontend/src/signals/SignalViewer.tsx:53:  const right = Math.min(100, (Math.min(interval.end, playhead) - viewport.start) / (viewport.end - viewport.start) * 100);\nfrontend/src/signals/SignalViewer.tsx:55:    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\nfrontend/src/signals/SignalViewer.tsx:59:        {right > left && <div className=\"selection-band\" style={{ left: `${left}%`, width: `${right - left}%` }}/>}<div className=\"hover-guide\"/>\nfrontend/src/signals/SignalViewer.tsx:60:        <svg viewBox=\"0 0 1000 76\" preserveAspectRatio=\"none\" role=\"img\" aria-label={`${p.channel.name}, signed external torque in Nm, ${viewport.start.toFixed(3)} to ${end.toFixed(3)} seconds`} onPointerMove={e => showCursor(pointerTime(e))} onPointerLeave={() => showCursor(null)} onPointerDown={e => { if (e.pointerType === 'mouse') { drag.current = pointerTime(e); e.currentTarget.setPointerCapture(e.pointerId); } }} onPointerUp={e => { if (drag.current !== null) { const t = pointerTime(e); const start = Math.min(t, drag.current), finish = Math.max(t, drag.current); if (finish - start >= .01) onSelect({ start, end: finish }); drag.current = null; } }}>\nfrontend/src/signals/SignalViewer.tsx:64:          {data.events.filter(e => e.timeSeconds >= viewport.start && e.timeSeconds <= end).map(e => <line key={e.id} x1={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} x2={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} y1=\"0\" y2=\"76\" className=\"event-line\"/>)}\nfrontend/src/signals/SignalViewer.tsx:69:    <div className=\"shared-axis\">{[0, .25, .5, .75, 1].map(v => <span key={v}>{(viewport.start+(viewport.end-viewport.start)*v).toFixed(2)} s</span>)}</div>\n","stderr":"","aggregated_output":"    if (highlighted.length && highlighted.length <= 2) return highlighted;\n    try {\n      return selectWindow(data, interval).channels.map(c => ({ id: c.id, range: Math.max(...c.values) - Math.min(...c.values) }))\n        .sort((a, b) => b.range - a.range).slice(0, 2).map(c => c.id);\n    } catch { return data.channels.slice(0, 2).map(c => c.id); }\n  }, [data, interval, highlighted]);\n  const viewport = useMemo(() => {\n    if (following) return { start: zoom ? Math.max(0, replay.playhead-zoom) : 0, end: Math.max(.01, replay.playhead) };\n    const padding = (interval.end-interval.start)*.18;\n    return { start: Math.max(0, interval.start-padding), end: Math.max(.01, Math.min(data.recording.durationSeconds, interval.end+padding, replay.playhead)) };\n  }, [following, zoom, interval, data.recording.durationSeconds, replay.playhead]);\n  const validViewport = viewport.end > viewport.start ? viewport : { start: 0, end: Math.max(.01, replay.playhead) };\n  // Playback moves the visual cursor, never the investigation's selected input.\n  const effectiveInterval = interval;\n  function select(next: Interval) { setReplayStop(undefined); if (next.start < 0 || next.end <= next.start || next.end > data.recording.durationSeconds) { setSelectionError('Choose a nonempty interval within this recording.'); return; } replay.pause(); setFollowing(false); setInterval(next); setSelectionError(''); }\n  function seek(value: number) {\n    setReplayStop(undefined); replay.seek(value); setFollowing(true); setHighlighted([]); setSelectionError('');\n  }\n  function marker(e: Marker) {\n    setReplayStop(undefined);\n    const context = markerWindow(e, data.recording.durationSeconds);\n    replay.seek(context.start);\n    setInterval(context);\n    setVisualMode('robot');\n    setMobile('signals');\n    setFollowing(false);\n    setHighlighted([]);\n    setSelectionError('');\n  }\n  function navigateMarker(direction: number) {\n    const target = direction > 0 ? data.events.find(e => e.timeSeconds > Math.max(interval.end, replay.playhead)) : [...data.events].reverse().find(e => e.timeSeconds < (effectiveInterval.start || replay.playhead));\n    if (target) marker(target);\n  }\n  function evidence(e: EvidenceLink) { setReplayStop(undefined); if (e.interval.start < 0 || e.interval.end > data.recording.durationSeconds || e.interval.end <= e.interval.start) return; replay.seek(e.interval.end); setInterval({ ...e.interval }); setFollowing(false); setHighlighted(e.channelIds?.length ? e.channelIds : [e.channelId]); setView('inspect'); setMobile('signals'); setVisualMode('signals'); }\n  return <div className={`app-shell view-${view}`}>\n    <header className=\"app-header\"><a className=\"brand\" href=\"#\" onClick={e => { e.preventDefault(); setView('inspect'); }}><Activity size={23} strokeWidth={1.8}/><span>trace</span></a><div className=\"header-divider\"/><span className=\"project-name\">Recorded incident handoff</span><span className=\"replay-label\"><RotateCcw size={11}/>Replay</span><div className=\"header-right\"><span className=\"model-status\"><CpuStatus/>{availability}</span><button className=\"btn btn-subtle\" aria-pressed={view === 'evaluation'} onClick={() => { replay.pause(); setView('evaluation'); }}><BarChart3 size={14}/>Evaluation</button><button className=\"btn btn-subtle\" aria-pressed={view === 'data'} onClick={() => { replay.pause(); setView('data'); }}><Database size={14}/>Data source</button></div></header>\n    <div className=\"app-body\">\n      <main className=\"main-workspace\">\n        {view === 'inspect' && (cases.length > 0 || caseError) && <div className=\"demo-cases\"><label>Recording <select aria-label=\"Example case\" disabled={caseLoading} value={data.demoCase?.id ?? ''} onChange={e => void onOpenCase(e.target.value)}><option value=\"\" disabled>KUKA · original recording</option>{cases.map(c => <option key={c.id} value={c.id}>{c.title}</option>)}</select></label><details className=\"case-source\"><summary>Source · {data.recording.id}</summary><p>{data.demoCase?.note ?? 'Original KUKA recording. Publisher markers are annotations, not verified contact onset. Raw model input is available from 4 to 9 seconds.'}</p></details>{(caseLoading || caseError) && <span role={caseError ? 'alert' : 'status'}>{caseLoading ? 'Loading raw telemetry…' : caseError}</span>}</div>}\n        {view === 'inspect' && <div className=\"mobile-switch\"><button className={mobile === 'signals' ? 'active' : ''} onClick={() => { setView('inspect'); setMobile('signals'); setVisualMode('signals'); }}>Replay</button><button className={mobile === 'assistant' ? 'active' : ''} onClick={() => { setView('inspect'); setMobile('assistant'); }}>Investigation</button></div>}\n        <div className={`inspect-grid mobile-${mobile}`} style={{ display: view === 'inspect' ? undefined : 'none' }}>\n          <div className=\"left-workspace\"><AssistantPanel rawLoading={rawWindow.loading} rawError={rawWindow.error} onRetryRaw={rawWindow.retry} registry={registry} data={data} datasetId={datasetId} playhead={replay.playhead} interval={effectiveInterval} services={services} onEvidence={evidence} onCompare={openComparison} onRobotPrediction={showRobotPrediction} onModelWindow={select}/></div>\n          <div className={`visual-workspace visual-${visualMode}`}>\n            <div className=\"visual-tabs\" role=\"group\" aria-label=\"Replay view\">{(['robot', 'signals', 'markers', 'compare'] as const).map(mode => <button key={mode} aria-pressed={visualMode === mode} onClick={() => setVisualMode(mode)}>{mode === 'robot' ? 'Robot' : mode === 'signals' ? 'All 7 signals' : mode === 'markers' ? 'Publisher markers' : 'Compare'}</button>)}<button className=\"text-button replay-interval\" onClick={replayInterval}><Play size={12}/>Replay interval · 0.5×</button></div>\n            {visualMode === 'compare' && <ComparisonPanel key={`${interval.start}:${interval.end}`} data={data} interval={interval} cases={cases} services={services} onEvidence={e => { evidence(e); replay.seek(e.interval.end); }}/> }\n            {(visualMode === 'robot' || visualMode === 'markers') && <RecordingContext prediction={visiblePrediction} display={visualMode === 'robot' ? 'robot' : 'overview'} datasetId={datasetId} data={data} playhead={replay.playhead} interval={effectiveInterval} highlighted={highlighted} onMarker={marker} onHighlight={id => setHighlighted(h => h.includes(id) ? h.filter(x => x !== id) : [id])} onData={() => { replay.pause(); setView('data'); }}/>}\n            {(visualMode === 'robot' || visualMode === 'signals') && <SignalViewer visibleChannelIds={visualMode === 'robot' ? previewChannels : undefined} data={data} playhead={replay.playhead} interval={effectiveInterval} viewport={validViewport} highlighted={highlighted} following={following} zoom={zoom} onSelect={select} onFollow={() => { setFollowing(true); setZoom(10); }} onZoom={n => { setFollowing(true); setZoom(n); }}/>}\n          </div>\n        </div>\n        {view === 'data' && <div className=\"secondary-view\"><button className=\"text-button back-inspect\" onClick={() => setView('inspect')}><ArrowLeft size={14}/>Back to replay</button><DataWorkspace services={services} data={data} onOpenRecording={onOpenRecording}/></div>}\n        {view === 'evaluation' && <div className=\"secondary-view\"><button className=\"text-button back-inspect\" onClick={() => setView('inspect')}><ArrowLeft size={14}/>Back to replay</button><EvaluationWorkspace /></div>}\n      </main>\n    </div>\n    {view === 'inspect' && <><footer className=\"transport\"><div className=\"transport-controls\"><button className=\"icon-button\" aria-label=\"Replay from beginning\" title=\"Replay from beginning\" onClick={() => { setReplayStop(undefined); setFollowing(true); setHighlighted([]); replay.restart(); }}><RotateCcw size={15}/></button><button className=\"icon-button\" aria-label=\"Previous publisher marker\" disabled={!data.events.some(e => e.timeSeconds < effectiveInterval.start)} onClick={() => navigateMarker(-1)}><SkipBack size={15}/></button><button className=\"play-button\" aria-label={replay.playing ? 'Pause replay' : 'Play replay'} onClick={() => { if (!replay.playing) setFollowing(true); replay.toggle(); }}>{replay.playing ? <Pause size={17} fill=\"currentColor\"/> : <Play size={17} fill=\"currentColor\"/>}</button><button className=\"icon-button\" aria-label=\"Next publisher marker\" disabled={!data.events.some(e => e.timeSeconds > Math.max(interval.end, replay.playhead))} onClick={() => navigateMarker(1)}><SkipForward size={15}/></button></div><div className=\"replay-clock\"><strong className=\"mono\">{timecode(replay.playhead, true)}</strong><span className=\"mono\">/ {timecode(data.recording.durationSeconds)}</span></div><div className=\"timeline-control\"><label className=\"sr-only\" htmlFor=\"playhead\">Replay position in seconds</label><input id=\"playhead\" type=\"range\" min=\"0\" max={data.recording.durationSeconds} step=\"0.001\" value={replay.playhead} onChange={e => seek(Number(e.target.value))} style={{ '--progress': `${replay.playhead/data.recording.durationSeconds*100}%` } as React.CSSProperties}/><div className=\"timeline-marks\">{data.events.map(e => <button key={e.id} className={e.timeSeconds <= replay.playhead ? 'reached' : 'upcoming'} style={{ left: `${e.timeSeconds/data.recording.durationSeconds*100}%` }} aria-label={`${e.label}, publisher annotation at ${e.timeSeconds.toFixed(3)} seconds${e.timeSeconds > replay.playhead ? ', upcoming' : ''}`} title={`${e.label} · ${e.timeSeconds.toFixed(3)} s · publisher annotation`} onClick={() => marker(e)}/>)}</div></div><label className=\"speed-control\"><span className=\"sr-only\">Playback speed</span><select aria-label=\"Playback speed\" value={replay.speed} onChange={e => replay.setSpeed(Number(e.target.value))}>{[.5,1,2,4].map(n => <option key={n} value={n}>{n}×</option>)}</select></label><span className=\"play-state\">{replay.playing ? 'Playing' : 'Paused'}</span></footer>\n    <div className=\"selection-footer\"><span><span className=\"selection-dot\"/>Investigation interval <strong className=\"mono\">{intervalLabel(effectiveInterval)}</strong></span><form onSubmit={e => { e.preventDefault(); select({ start: Number(draftStart), end: Number(draftEnd) }); }}><label>From <input aria-label=\"Selection start seconds\" type=\"number\" step=\"0.001\" min=\"0\" max={data.recording.durationSeconds} value={draftStart} onChange={e => setDraftStart(e.target.value)}/></label><label>to <input aria-label=\"Selection end seconds\" type=\"number\" step=\"0.001\" min=\"0\" max={data.recording.durationSeconds} value={draftEnd} onChange={e => setDraftEnd(e.target.value)}/></label><button type=\"submit\">Apply</button></form><button className=\"text-button\" disabled={replay.playhead < 1.024} onClick={() => { const end = Math.floor(replay.playhead * 1000) / 1000; select({ start: Math.round((end - 1.024) * 1000) / 1000, end }); }}>Select at cursor</button>{selectionError && <span role=\"alert\" className=\"error-message\">{selectionError}</span>}</div></>}\n  </div>;\n}\nfunction CpuStatus() { return <Radio size={13}/>; }\nimport { useMemo, useRef } from 'react';\nimport { Crosshair, Maximize2 } from 'lucide-react';\nimport { downsample, selectWindow } from '../lib/data';\nimport { COLORS } from '../lib/format';\nimport type { DemoData, Interval } from '../types';\n\ntype Props = { visibleChannelIds?: string[]; data: DemoData; playhead: number; interval: Interval; viewport: Interval; highlighted: string[]; following: boolean; zoom: number; onSelect: (v: Interval) => void; onFollow: () => void; onZoom: (seconds: number) => void };\n\nexport default function SignalViewer({ visibleChannelIds, data, playhead, interval, viewport, highlighted, following, zoom, onSelect, onFollow, onZoom }: Props) {\n  const hover = useRef<number | null>(null);\n  const panel = useRef<HTMLDivElement>(null);\n  const drag = useRef<number | null>(null);\n  const end = Math.min(viewport.end, playhead);\n  const visible = useMemo(() => {\n    if (end <= viewport.start) return null;\n    try { return selectWindow(data, { start: viewport.start, end }); } catch { return null; }\n  }, [data, viewport.start, end]);\n  const plots = useMemo(() => data.channels.map((channel, index) => {\n    const values = visible?.channels[index].values ?? [];\n    const times = visible?.times ?? [];\n    const points = downsample(times.map((x, i) => ({ x, y: values[i] })), 600);\n    let low = values.length ? Math.min(...values) : -1;\n    let high = values.length ? Math.max(...values) : 1;\n    const pad = Math.max((high - low) * .15, .01); low -= pad; high += pad;\n    const x = (t: number) => (t - viewport.start) / (viewport.end - viewport.start) * 1000;\n    const y = (v: number) => 70 - (v - low) / (high - low) * 64;\n    const path = points.map((p, i) => `${i ? 'L' : 'M'}${x(p.x).toFixed(2)},${y(p.y).toFixed(2)}`).join(' ');\n    return { channel, colorIndex: index, values, times, path, low, high, zero: y(0), last: values.at(-1) };\n  }).filter(p => !visibleChannelIds || visibleChannelIds.includes(p.channel.id)), [data, visible, viewport, visibleChannelIds]);\n  function pointerTime(event: React.PointerEvent<SVGSVGElement>) {\n    const rect = event.currentTarget.getBoundingClientRect();\n    return Math.max(viewport.start, Math.min(playhead, viewport.start + (event.clientX - rect.left) / rect.width * (viewport.end - viewport.start)));\n  }\n  function showCursor(time: number | null) {\n    hover.current = time;\n    if (!panel.current) return;\n    panel.current.style.setProperty('--cursor', `${time === null ? -100 : (time - viewport.start) / (viewport.end - viewport.start) * 100}%`);\n    panel.current.querySelectorAll<HTMLElement>('[data-sample-value]').forEach((el, i) => {\n      const p = plots[i];\n      let value = p.last;\n      if (time !== null && p.times.length) {\n        let lo = 0, hi = p.times.length - 1;\n        while (lo < hi) { const mid = (lo + hi) >>> 1; if (p.times[mid] < time) lo = mid + 1; else hi = mid; }\n        const idx = lo > 0 && Math.abs(p.times[lo - 1] - time) < Math.abs(p.times[lo] - time) ? lo - 1 : lo;\n        value = p.values[idx];\n      }\n      el.textContent = value === undefined ? '—' : value.toFixed(3);\n    });\n    const label = panel.current.querySelector('[data-cursor-time]');\n    if (label) label.textContent = time === null ? 'Hover to inspect · drag to select' : `Cursor ${time.toFixed(3)} s · nearest available samples`;\n  }\n  const left = Math.max(0, (interval.start - viewport.start) / (viewport.end - viewport.start) * 100);\n  const right = Math.min(100, (Math.min(interval.end, playhead) - viewport.start) / (viewport.end - viewport.start) * 100);\n  return <section className=\"signals-panel\" ref={panel} aria-label=\"Synchronized torque signals\">\n    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\n    <div className=\"signal-strips\">{plots.map(p => <div key={p.channel.id} className={`signal-strip ${highlighted.includes(p.channel.id) ? 'signal-highlighted' : ''}`} data-channel={p.channel.id}>\n      <div className=\"strip-heading\"><span className=\"channel-name\"><i style={{ background: COLORS[p.colorIndex] }}/>{p.channel.name}<span className=\"unit\">Nm</span></span><span className=\"mono sample-value\" data-sample-value>{p.last?.toFixed(3) ?? '—'}</span></div>\n      <div className=\"plot-frame\"><div className=\"y-labels\"><span>{p.high.toFixed(p.high-p.low < 1 ? 2 : 1)}</span><span>{p.low.toFixed(p.high-p.low < 1 ? 2 : 1)}</span></div><div className=\"plot-area\">\n        {right > left && <div className=\"selection-band\" style={{ left: `${left}%`, width: `${right - left}%` }}/>}<div className=\"hover-guide\"/>\n        <svg viewBox=\"0 0 1000 76\" preserveAspectRatio=\"none\" role=\"img\" aria-label={`${p.channel.name}, signed external torque in Nm, ${viewport.start.toFixed(3)} to ${end.toFixed(3)} seconds`} onPointerMove={e => showCursor(pointerTime(e))} onPointerLeave={() => showCursor(null)} onPointerDown={e => { if (e.pointerType === 'mouse') { drag.current = pointerTime(e); e.currentTarget.setPointerCapture(e.pointerId); } }} onPointerUp={e => { if (drag.current !== null) { const t = pointerTime(e); const start = Math.min(t, drag.current), finish = Math.max(t, drag.current); if (finish - start >= .01) onSelect({ start, end: finish }); drag.current = null; } }}>\n          {[0, 250, 500, 750, 1000].map(x => <line key={x} x1={x} x2={x} y1=\"0\" y2=\"76\" className=\"chart-grid\"/>)}\n          {[18, 38, 58].map(y => <line key={y} x1=\"0\" x2=\"1000\" y1={y} y2={y} className=\"chart-grid\"/>)}\n          {p.zero > 0 && p.zero < 76 && <line x1=\"0\" x2=\"1000\" y1={p.zero} y2={p.zero} className=\"chart-zero\"/>}\n          {data.events.filter(e => e.timeSeconds >= viewport.start && e.timeSeconds <= end).map(e => <line key={e.id} x1={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} x2={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} y1=\"0\" y2=\"76\" className=\"event-line\"/>)}\n          <path d={p.path} fill=\"none\" stroke={COLORS[p.colorIndex]} strokeWidth=\"1.3\" vectorEffect=\"non-scaling-stroke\"/>\n        </svg>\n      </div></div>\n    </div>)}</div>\n    <div className=\"shared-axis\">{[0, .25, .5, .75, 1].map(v => <span key={v}>{(viewport.start+(viewport.end-viewport.start)*v).toFixed(2)} s</span>)}</div>\n    <footer className=\"plot-footer\"><span data-cursor-time>Hover to inspect · drag to select</span><span><Maximize2 size={12}/>{visible ? `${visible.sampleRateHz >= 1000 ? `${(visible.sampleRateHz / 1000).toFixed(0)} kHz` : `${visible.sampleRateHz.toFixed(0)} Hz`} ${visible.resolution === 'raw' ? 'raw' : 'overview'} · extrema-preserving plot` : 'No replayed samples'}</span></footer>\n  </section>;\n}\nfrontend/src/signals/SignalViewer.tsx:15:    if (end <= viewport.start) return null;\nfrontend/src/signals/SignalViewer.tsx:16:    try { return selectWindow(data, { start: viewport.start, end }); } catch { return null; }\nfrontend/src/signals/SignalViewer.tsx:17:  }, [data, viewport.start, end]);\nfrontend/src/signals/SignalViewer.tsx:25:    const x = (t: number) => (t - viewport.start) / (viewport.end - viewport.start) * 1000;\nfrontend/src/signals/SignalViewer.tsx:32:    return Math.max(viewport.start, Math.min(playhead, viewport.start + (event.clientX - rect.left) / rect.width * (viewport.end - viewport.start)));\nfrontend/src/signals/SignalViewer.tsx:37:    panel.current.style.setProperty('--cursor', `${time === null ? -100 : (time - viewport.start) / (viewport.end - viewport.start) * 100}%`);\nfrontend/src/signals/SignalViewer.tsx:52:  const left = Math.max(0, (interval.start - viewport.start) / (viewport.end - viewport.start) * 100);\nfrontend/src/signals/SignalViewer.tsx:53:  const right = Math.min(100, (Math.min(interval.end, playhead) - viewport.start) / (viewport.end - viewport.start) * 100);\nfrontend/src/signals/SignalViewer.tsx:55:    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\nfrontend/src/signals/SignalViewer.tsx:59:        {right > left && <div className=\"selection-band\" style={{ left: `${left}%`, width: `${right - left}%` }}/>}<div className=\"hover-guide\"/>\nfrontend/src/signals/SignalViewer.tsx:60:        <svg viewBox=\"0 0 1000 76\" preserveAspectRatio=\"none\" role=\"img\" aria-label={`${p.channel.name}, signed external torque in Nm, ${viewport.start.toFixed(3)} to ${end.toFixed(3)} seconds`} onPointerMove={e => showCursor(pointerTime(e))} onPointerLeave={() => showCursor(null)} onPointerDown={e => { if (e.pointerType === 'mouse') { drag.current = pointerTime(e); e.currentTarget.setPointerCapture(e.pointerId); } }} onPointerUp={e => { if (drag.current !== null) { const t = pointerTime(e); const start = Math.min(t, drag.current), finish = Math.max(t, drag.current); if (finish - start >= .01) onSelect({ start, end: finish }); drag.current = null; } }}>\nfrontend/src/signals/SignalViewer.tsx:64:          {data.events.filter(e => e.timeSeconds >= viewport.start && e.timeSeconds <= end).map(e => <line key={e.id} x1={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} x2={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} y1=\"0\" y2=\"76\" className=\"event-line\"/>)}\nfrontend/src/signals/SignalViewer.tsx:69:    <div className=\"shared-axis\">{[0, .25, .5, .75, 1].map(v => <span key={v}>{(viewport.start+(viewport.end-viewport.start)*v).toFixed(2)} s</span>)}</div>\n","exit_code":0,"duration":{"secs":0,"nanos":4125},"formatted_output":"    if (highlighted.length && highlighted.length <= 2) return highlighted;\n    try {\n      return selectWindow(data, interval).channels.map(c => ({ id: c.id, range: Math.max(...c.values) - Math.min(...c.values) }))\n        .sort((a, b) => b.range - a.range).slice(0, 2).map(c => c.id);\n    } catch { return data.channels.slice(0, 2).map(c => c.id); }\n  }, [data, interval, highlighted]);\n  const viewport = useMemo(() => {\n    if (following) return { start: zoom ? Math.max(0, replay.playhead-zoom) : 0, end: Math.max(.01, replay.playhead) };\n    const padding = (interval.end-interval.start)*.18;\n    return { start: Math.max(0, interval.start-padding), end: Math.max(.01, Math.min(data.recording.durationSeconds, interval.end+padding, replay.playhead)) };\n  }, [following, zoom, interval, data.recording.durationSeconds, replay.playhead]);\n  const validViewport = viewport.end > viewport.start ? viewport : { start: 0, end: Math.max(.01, replay.playhead) };\n  // Playback moves the visual cursor, never the investigation's selected input.\n  const effectiveInterval = interval;\n  function select(next: Interval) { setReplayStop(undefined); if (next.start < 0 || next.end <= next.start || next.end > data.recording.durationSeconds) { setSelectionError('Choose a nonempty interval within this recording.'); return; } replay.pause(); setFollowing(false); setInterval(next); setSelectionError(''); }\n  function seek(value: number) {\n    setReplayStop(undefined); replay.seek(value); setFollowing(true); setHighlighted([]); setSelectionError('');\n  }\n  function marker(e: Marker) {\n    setReplayStop(undefined);\n    const context = markerWindow(e, data.recording.durationSeconds);\n    replay.seek(context.start);\n    setInterval(context);\n    setVisualMode('robot');\n    setMobile('signals');\n    setFollowing(false);\n    setHighlighted([]);\n    setSelectionError('');\n  }\n  function navigateMarker(direction: number) {\n    const target = direction > 0 ? data.events.find(e => e.timeSeconds > Math.max(interval.end, replay.playhead)) : [...data.events].reverse().find(e => e.timeSeconds < (effectiveInterval.start || replay.playhead));\n    if (target) marker(target);\n  }\n  function evidence(e: EvidenceLink) { setReplayStop(undefined); if (e.interval.start < 0 || e.interval.end > data.recording.durationSeconds || e.interval.end <= e.interval.start) return; replay.seek(e.interval.end); setInterval({ ...e.interval }); setFollowing(false); setHighlighted(e.channelIds?.length ? e.channelIds : [e.channelId]); setView('inspect'); setMobile('signals'); setVisualMode('signals'); }\n  return <div className={`app-shell view-${view}`}>\n    <header className=\"app-header\"><a className=\"brand\" href=\"#\" onClick={e => { e.preventDefault(); setView('inspect'); }}><Activity size={23} strokeWidth={1.8}/><span>trace</span></a><div className=\"header-divider\"/><span className=\"project-name\">Recorded incident handoff</span><span className=\"replay-label\"><RotateCcw size={11}/>Replay</span><div className=\"header-right\"><span className=\"model-status\"><CpuStatus/>{availability}</span><button className=\"btn btn-subtle\" aria-pressed={view === 'evaluation'} onClick={() => { replay.pause(); setView('evaluation'); }}><BarChart3 size={14}/>Evaluation</button><button className=\"btn btn-subtle\" aria-pressed={view === 'data'} onClick={() => { replay.pause(); setView('data'); }}><Database size={14}/>Data source</button></div></header>\n    <div className=\"app-body\">\n      <main className=\"main-workspace\">\n        {view === 'inspect' && (cases.length > 0 || caseError) && <div className=\"demo-cases\"><label>Recording <select aria-label=\"Example case\" disabled={caseLoading} value={data.demoCase?.id ?? ''} onChange={e => void onOpenCase(e.target.value)}><option value=\"\" disabled>KUKA · original recording</option>{cases.map(c => <option key={c.id} value={c.id}>{c.title}</option>)}</select></label><details className=\"case-source\"><summary>Source · {data.recording.id}</summary><p>{data.demoCase?.note ?? 'Original KUKA recording. Publisher markers are annotations, not verified contact onset. Raw model input is available from 4 to 9 seconds.'}</p></details>{(caseLoading || caseError) && <span role={caseError ? 'alert' : 'status'}>{caseLoading ? 'Loading raw telemetry…' : caseError}</span>}</div>}\n        {view === 'inspect' && <div className=\"mobile-switch\"><button className={mobile === 'signals' ? 'active' : ''} onClick={() => { setView('inspect'); setMobile('signals'); setVisualMode('signals'); }}>Replay</button><button className={mobile === 'assistant' ? 'active' : ''} onClick={() => { setView('inspect'); setMobile('assistant'); }}>Investigation</button></div>}\n        <div className={`inspect-grid mobile-${mobile}`} style={{ display: view === 'inspect' ? undefined : 'none' }}>\n          <div className=\"left-workspace\"><AssistantPanel rawLoading={rawWindow.loading} rawError={rawWindow.error} onRetryRaw={rawWindow.retry} registry={registry} data={data} datasetId={datasetId} playhead={replay.playhead} interval={effectiveInterval} services={services} onEvidence={evidence} onCompare={openComparison} onRobotPrediction={showRobotPrediction} onModelWindow={select}/></div>\n          <div className={`visual-workspace visual-${visualMode}`}>\n            <div className=\"visual-tabs\" role=\"group\" aria-label=\"Replay view\">{(['robot', 'signals', 'markers', 'compare'] as const).map(mode => <button key={mode} aria-pressed={visualMode === mode} onClick={() => setVisualMode(mode)}>{mode === 'robot' ? 'Robot' : mode === 'signals' ? 'All 7 signals' : mode === 'markers' ? 'Publisher markers' : 'Compare'}</button>)}<button className=\"text-button replay-interval\" onClick={replayInterval}><Play size={12}/>Replay interval · 0.5×</button></div>\n            {visualMode === 'compare' && <ComparisonPanel key={`${interval.start}:${interval.end}`} data={data} interval={interval} cases={cases} services={services} onEvidence={e => { evidence(e); replay.seek(e.interval.end); }}/> }\n            {(visualMode === 'robot' || visualMode === 'markers') && <RecordingContext prediction={visiblePrediction} display={visualMode === 'robot' ? 'robot' : 'overview'} datasetId={datasetId} data={data} playhead={replay.playhead} interval={effectiveInterval} highlighted={highlighted} onMarker={marker} onHighlight={id => setHighlighted(h => h.includes(id) ? h.filter(x => x !== id) : [id])} onData={() => { replay.pause(); setView('data'); }}/>}\n            {(visualMode === 'robot' || visualMode === 'signals') && <SignalViewer visibleChannelIds={visualMode === 'robot' ? previewChannels : undefined} data={data} playhead={replay.playhead} interval={effectiveInterval} viewport={validViewport} highlighted={highlighted} following={following} zoom={zoom} onSelect={select} onFollow={() => { setFollowing(true); setZoom(10); }} onZoom={n => { setFollowing(true); setZoom(n); }}/>}\n          </div>\n        </div>\n        {view === 'data' && <div className=\"secondary-view\"><button className=\"text-button back-inspect\" onClick={() => setView('inspect')}><ArrowLeft size={14}/>Back to replay</button><DataWorkspace services={services} data={data} onOpenRecording={onOpenRecording}/></div>}\n        {view === 'evaluation' && <div className=\"secondary-view\"><button className=\"text-button back-inspect\" onClick={() => setView('inspect')}><ArrowLeft size={14}/>Back to replay</button><EvaluationWorkspace /></div>}\n      </main>\n    </div>\n    {view === 'inspect' && <><footer className=\"transport\"><div className=\"transport-controls\"><button className=\"icon-button\" aria-label=\"Replay from beginning\" title=\"Replay from beginning\" onClick={() => { setReplayStop(undefined); setFollowing(true); setHighlighted([]); replay.restart(); }}><RotateCcw size={15}/></button><button className=\"icon-button\" aria-label=\"Previous publisher marker\" disabled={!data.events.some(e => e.timeSeconds < effectiveInterval.start)} onClick={() => navigateMarker(-1)}><SkipBack size={15}/></button><button className=\"play-button\" aria-label={replay.playing ? 'Pause replay' : 'Play replay'} onClick={() => { if (!replay.playing) setFollowing(true); replay.toggle(); }}>{replay.playing ? <Pause size={17} fill=\"currentColor\"/> : <Play size={17} fill=\"currentColor\"/>}</button><button className=\"icon-button\" aria-label=\"Next publisher marker\" disabled={!data.events.some(e => e.timeSeconds > Math.max(interval.end, replay.playhead))} onClick={() => navigateMarker(1)}><SkipForward size={15}/></button></div><div className=\"replay-clock\"><strong className=\"mono\">{timecode(replay.playhead, true)}</strong><span className=\"mono\">/ {timecode(data.recording.durationSeconds)}</span></div><div className=\"timeline-control\"><label className=\"sr-only\" htmlFor=\"playhead\">Replay position in seconds</label><input id=\"playhead\" type=\"range\" min=\"0\" max={data.recording.durationSeconds} step=\"0.001\" value={replay.playhead} onChange={e => seek(Number(e.target.value))} style={{ '--progress': `${replay.playhead/data.recording.durationSeconds*100}%` } as React.CSSProperties}/><div className=\"timeline-marks\">{data.events.map(e => <button key={e.id} className={e.timeSeconds <= replay.playhead ? 'reached' : 'upcoming'} style={{ left: `${e.timeSeconds/data.recording.durationSeconds*100}%` }} aria-label={`${e.label}, publisher annotation at ${e.timeSeconds.toFixed(3)} seconds${e.timeSeconds > replay.playhead ? ', upcoming' : ''}`} title={`${e.label} · ${e.timeSeconds.toFixed(3)} s · publisher annotation`} onClick={() => marker(e)}/>)}</div></div><label className=\"speed-control\"><span className=\"sr-only\">Playback speed</span><select aria-label=\"Playback speed\" value={replay.speed} onChange={e => replay.setSpeed(Number(e.target.value))}>{[.5,1,2,4].map(n => <option key={n} value={n}>{n}×</option>)}</select></label><span className=\"play-state\">{replay.playing ? 'Playing' : 'Paused'}</span></footer>\n    <div className=\"selection-footer\"><span><span className=\"selection-dot\"/>Investigation interval <strong className=\"mono\">{intervalLabel(effectiveInterval)}</strong></span><form onSubmit={e => { e.preventDefault(); select({ start: Number(draftStart), end: Number(draftEnd) }); }}><label>From <input aria-label=\"Selection start seconds\" type=\"number\" step=\"0.001\" min=\"0\" max={data.recording.durationSeconds} value={draftStart} onChange={e => setDraftStart(e.target.value)}/></label><label>to <input aria-label=\"Selection end seconds\" type=\"number\" step=\"0.001\" min=\"0\" max={data.recording.durationSeconds} value={draftEnd} onChange={e => setDraftEnd(e.target.value)}/></label><button type=\"submit\">Apply</button></form><button className=\"text-button\" disabled={replay.playhead < 1.024} onClick={() => { const end = Math.floor(replay.playhead * 1000) / 1000; select({ start: Math.round((end - 1.024) * 1000) / 1000, end }); }}>Select at cursor</button>{selectionError && <span role=\"alert\" className=\"error-message\">{selectionError}</span>}</div></>}\n  </div>;\n}\nfunction CpuStatus() { return <Radio size={13}/>; }\nimport { useMemo, useRef } from 'react';\nimport { Crosshair, Maximize2 } from 'lucide-react';\nimport { downsample, selectWindow } from '../lib/data';\nimport { COLORS } from '../lib/format';\nimport type { DemoData, Interval } from '../types';\n\ntype Props = { visibleChannelIds?: string[]; data: DemoData; playhead: number; interval: Interval; viewport: Interval; highlighted: string[]; following: boolean; zoom: number; onSelect: (v: Interval) => void; onFollow: () => void; onZoom: (seconds: number) => void };\n\nexport default function SignalViewer({ visibleChannelIds, data, playhead, interval, viewport, highlighted, following, zoom, onSelect, onFollow, onZoom }: Props) {\n  const hover = useRef<number | null>(null);\n  const panel = useRef<HTMLDivElement>(null);\n  const drag = useRef<number | null>(null);\n  const end = Math.min(viewport.end, playhead);\n  const visible = useMemo(() => {\n    if (end <= viewport.start) return null;\n    try { return selectWindow(data, { start: viewport.start, end }); } catch { return null; }\n  }, [data, viewport.start, end]);\n  const plots = useMemo(() => data.channels.map((channel, index) => {\n    const values = visible?.channels[index].values ?? [];\n    const times = visible?.times ?? [];\n    const points = downsample(times.map((x, i) => ({ x, y: values[i] })), 600);\n    let low = values.length ? Math.min(...values) : -1;\n    let high = values.length ? Math.max(...values) : 1;\n    const pad = Math.max((high - low) * .15, .01); low -= pad; high += pad;\n    const x = (t: number) => (t - viewport.start) / (viewport.end - viewport.start) * 1000;\n    const y = (v: number) => 70 - (v - low) / (high - low) * 64;\n    const path = points.map((p, i) => `${i ? 'L' : 'M'}${x(p.x).toFixed(2)},${y(p.y).toFixed(2)}`).join(' ');\n    return { channel, colorIndex: index, values, times, path, low, high, zero: y(0), last: values.at(-1) };\n  }).filter(p => !visibleChannelIds || visibleChannelIds.includes(p.channel.id)), [data, visible, viewport, visibleChannelIds]);\n  function pointerTime(event: React.PointerEvent<SVGSVGElement>) {\n    const rect = event.currentTarget.getBoundingClientRect();\n    return Math.max(viewport.start, Math.min(playhead, viewport.start + (event.clientX - rect.left) / rect.width * (viewport.end - viewport.start)));\n  }\n  function showCursor(time: number | null) {\n    hover.current = time;\n    if (!panel.current) return;\n    panel.current.style.setProperty('--cursor', `${time === null ? -100 : (time - viewport.start) / (viewport.end - viewport.start) * 100}%`);\n    panel.current.querySelectorAll<HTMLElement>('[data-sample-value]').forEach((el, i) => {\n      const p = plots[i];\n      let value = p.last;\n      if (time !== null && p.times.length) {\n        let lo = 0, hi = p.times.length - 1;\n        while (lo < hi) { const mid = (lo + hi) >>> 1; if (p.times[mid] < time) lo = mid + 1; else hi = mid; }\n        const idx = lo > 0 && Math.abs(p.times[lo - 1] - time) < Math.abs(p.times[lo] - time) ? lo - 1 : lo;\n        value = p.values[idx];\n      }\n      el.textContent = value === undefined ? '—' : value.toFixed(3);\n    });\n    const label = panel.current.querySelector('[data-cursor-time]');\n    if (label) label.textContent = time === null ? 'Hover to inspect · drag to select' : `Cursor ${time.toFixed(3)} s · nearest available samples`;\n  }\n  const left = Math.max(0, (interval.start - viewport.start) / (viewport.end - viewport.start) * 100);\n  const right = Math.min(100, (Math.min(interval.end, playhead) - viewport.start) / (viewport.end - viewport.start) * 100);\n  return <section className=\"signals-panel\" ref={panel} aria-label=\"Synchronized torque signals\">\n    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\n    <div className=\"signal-strips\">{plots.map(p => <div key={p.channel.id} className={`signal-strip ${highlighted.includes(p.channel.id) ? 'signal-highlighted' : ''}`} data-channel={p.channel.id}>\n      <div className=\"strip-heading\"><span className=\"channel-name\"><i style={{ background: COLORS[p.colorIndex] }}/>{p.channel.name}<span className=\"unit\">Nm</span></span><span className=\"mono sample-value\" data-sample-value>{p.last?.toFixed(3) ?? '—'}</span></div>\n      <div className=\"plot-frame\"><div className=\"y-labels\"><span>{p.high.toFixed(p.high-p.low < 1 ? 2 : 1)}</span><span>{p.low.toFixed(p.high-p.low < 1 ? 2 : 1)}</span></div><div className=\"plot-area\">\n        {right > left && <div className=\"selection-band\" style={{ left: `${left}%`, width: `${right - left}%` }}/>}<div className=\"hover-guide\"/>\n        <svg viewBox=\"0 0 1000 76\" preserveAspectRatio=\"none\" role=\"img\" aria-label={`${p.channel.name}, signed external torque in Nm, ${viewport.start.toFixed(3)} to ${end.toFixed(3)} seconds`} onPointerMove={e => showCursor(pointerTime(e))} onPointerLeave={() => showCursor(null)} onPointerDown={e => { if (e.pointerType === 'mouse') { drag.current = pointerTime(e); e.currentTarget.setPointerCapture(e.pointerId); } }} onPointerUp={e => { if (drag.current !== null) { const t = pointerTime(e); const start = Math.min(t, drag.current), finish = Math.max(t, drag.current); if (finish - start >= .01) onSelect({ start, end: finish }); drag.current = null; } }}>\n          {[0, 250, 500, 750, 1000].map(x => <line key={x} x1={x} x2={x} y1=\"0\" y2=\"76\" className=\"chart-grid\"/>)}\n          {[18, 38, 58].map(y => <line key={y} x1=\"0\" x2=\"1000\" y1={y} y2={y} className=\"chart-grid\"/>)}\n          {p.zero > 0 && p.zero < 76 && <line x1=\"0\" x2=\"1000\" y1={p.zero} y2={p.zero} className=\"chart-zero\"/>}\n          {data.events.filter(e => e.timeSeconds >= viewport.start && e.timeSeconds <= end).map(e => <line key={e.id} x1={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} x2={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} y1=\"0\" y2=\"76\" className=\"event-line\"/>)}\n          <path d={p.path} fill=\"none\" stroke={COLORS[p.colorIndex]} strokeWidth=\"1.3\" vectorEffect=\"non-scaling-stroke\"/>\n        </svg>\n      </div></div>\n    </div>)}</div>\n    <div className=\"shared-axis\">{[0, .25, .5, .75, 1].map(v => <span key={v}>{(viewport.start+(viewport.end-viewport.start)*v).toFixed(2)} s</span>)}</div>\n    <footer className=\"plot-footer\"><span data-cursor-time>Hover to inspect · drag to select</span><span><Maximize2 size={12}/>{visible ? `${visible.sampleRateHz >= 1000 ? `${(visible.sampleRateHz / 1000).toFixed(0)} kHz` : `${visible.sampleRateHz.toFixed(0)} Hz`} ${visible.resolution === 'raw' ? 'raw' : 'overview'} · extrema-preserving plot` : 'No replayed samples'}</span></footer>\n  </section>;\n}\nfrontend/src/signals/SignalViewer.tsx:15:    if (end <= viewport.start) return null;\nfrontend/src/signals/SignalViewer.tsx:16:    try { return selectWindow(data, { start: viewport.start, end }); } catch { return null; }\nfrontend/src/signals/SignalViewer.tsx:17:  }, [data, viewport.start, end]);\nfrontend/src/signals/SignalViewer.tsx:25:    const x = (t: number) => (t - viewport.start) / (viewport.end - viewport.start) * 1000;\nfrontend/src/signals/SignalViewer.tsx:32:    return Math.max(viewport.start, Math.min(playhead, viewport.start + (event.clientX - rect.left) / rect.width * (v