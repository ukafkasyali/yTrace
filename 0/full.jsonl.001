{"timestamp":"2026-09-13T00:45:17.549Z","ordinal":5375,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","item":{"type":"CommandExecution","id":"exec-4cac4d09-da7d-4435-9dbc-307e3e38f9a0","process_id":"70343","command":["/bin/zsh","-lc","sed -n '1,180p' frontend/src/assistant/AssistantPanel.tsx && rg -n \"composerOpen|abortRef|Analyzing|Stop analysis|model-input-status\" frontend/src/assistant frontend/src/styles.css"],"cwd":"file:///Users/sametdegirmenci/Downloads/ysamet","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' frontend/src/assistant/AssistantPanel.tsx","name":"AssistantPanel.tsx","path":"frontend/src/assistant/AssistantPanel.tsx"},{"type":"search","cmd":"rg -n 'composerOpen|abortRef|Analyzing|Stop analysis|model-input-status' frontend/src/assistant frontend/src/styles.css","query":"composerOpen|abortRef|Analyzing|Stop analysis|model-input-status","path":"assistant"}],"source":"unified_exec_startup","status":"completed","stdout":"import { useEffect, useMemo, useRef, useState } from 'react';\nimport { ArrowUp, ArrowUpRight, CircleStop, Cpu, Download, MessageSquare, RotateCcw, SlidersHorizontal, Waves } from 'lucide-react';\nimport { predictionBrief, predictionCue, structuredPrediction, type PredictionCue } from './predictionBrief';\nimport { reviewPrediction } from './predictionReview';\nimport { downloadInvestigationJson, downloadInvestigationMarkdown, type InvestigationAnswer } from './investigationReport';\nimport { checkpointLabel, fitModelWindow, modelWindowIssue } from '../lib/modelWindow';\nimport { analyzeWindow } from '../lib/data';\nimport { intervalLabel } from '../lib/format';\nimport type { DemoData, EvidenceLink, Interval } from '../types';\nimport type { Evidence, Services } from '../services';\nimport type { ModelRegistry } from '../services/useModelRegistry';\n\ntype Message = InvestigationAnswer & { telemetry: DemoData; id: string; tools: string[]; status: 'running' | 'complete' | 'error' | 'cancelled' };\ntype Props = { rawLoading?: boolean; rawError?: string; onRetryRaw: () => void; data: DemoData; datasetId: string; playhead: number; interval: Interval; services: Services; registry: ModelRegistry; onEvidence: (e: EvidenceLink) => void; onModelWindow: (interval: Interval) => void; onCompare: (interval: Interval) => void; onRobotPrediction: (prediction: PredictionCue) => void };\nfunction AnswerText({ text }: { text: string }) {\n  const blocks = text.split(/\\n\\s*\\n/).filter(Boolean);\n  return <div className=\"answer-brief\">{blocks.map((block, index) => {\n    const [heading, ...body] = block.split('\\n');\n    const structured = body.length > 0 && /^(Measured in this selected window|OpenTSLM interpretation)$/i.test(heading.trim());\n    return structured\n      ? <section key={`${heading}-${index}`}><h3>{heading}</h3><p>{body.join(' ')}</p></section>\n      : <p key={`${heading}-${index}`}>{block.replace(/\\n+/g, ' ')}</p>;\n  })}</div>;\n}\nexport default function AssistantPanel({ rawLoading, rawError, onRetryRaw, data, datasetId, playhead, interval, services, registry, onEvidence, onModelWindow, onRobotPrediction, onCompare }: Props) {\n  const [question, setQuestion] = useState('');\n  const [mode, setMode] = useState<'local' | 'assistant'>('assistant');\n  const availableThrough = data.recording.durationSeconds;\n  const historical = interval.end <= availableThrough;\n  const dataIssue = useMemo(() => modelWindowIssue(data, interval, historical ? interval.end : 0), [data, interval, historical]);\n  const windowIssue = rawLoading ? 'Loading 1,024 raw samples for this interval…' : rawError ?? dataIssue;\n  const fitHorizon = Math.min(Math.floor(availableThrough * 1000) / 1000, data.detail.endSeconds);\n  const fittedWindow = useMemo(() => fitModelWindow(data, interval, fitHorizon), [data, interval, fitHorizon]);\n  const [exportStatus, setExportStatus] = useState('');\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [busy, setBusy] = useState(false);\n  const assistantAvailable = services.connected && !registry.loading && !registry.error && registry.models.some(model => model.id === 'assistant' && model.available && model.capabilities.includes('language'));\n  const modeUnavailable = mode === 'assistant' && (!assistantAvailable || Boolean(windowIssue));\n  const active = useRef<{ id: string; controller: AbortController; queryId?: string } | null>(null);\n  const body = useRef<HTMLDivElement>(null);\n  const completed = useRef(false);\n  useEffect(() => { const container = body.current; const latest = container?.lastElementChild as HTMLElement | null; if (!messages.length || !container || !latest) return; container.scrollTo({ top: latest.offsetTop - container.offsetTop, behavior: 'instant' }); }, [messages.length]);\n  useEffect(() => () => { const job = active.current; job?.controller.abort(); if (job?.queryId) void services.cancelQuery(job.queryId).catch(() => undefined); active.current = null; }, [services]);\n  function update(id: string, changes: Partial<Message> | ((m: Message) => Partial<Message>)) { setMessages(ms => ms.map(m => m.id === id ? { ...m, ...(typeof changes === 'function' ? changes(m) : changes) } : m)); }\n  function evidenceFrom(e: Evidence): EvidenceLink[] {\n    if (e.window.recordingId !== data.recording.id) return [];\n    if (!e.window.channelIds.length) return [];\n    return [{ channelId: e.window.channelIds[0], channelIds: e.window.channelIds, label: `Inspect ${e.window.channelIds.length} input channels`, interval: { start: e.window.startSec, end: e.window.endSec } }];\n  }\n  async function submit(prompt = question, runMode: 'local' | 'assistant' = mode) {\n    if (!prompt.trim() || busy || (runMode === 'assistant' && (rawLoading || rawError)) || (runMode === 'assistant' && !assistantAvailable)) return;\n    const snapshot = { ...interval }, horizon = Math.max(playhead, snapshot.end);\n    if (runMode === 'assistant' && modelWindowIssue(data, snapshot, horizon)) return;\n    const id = crypto.randomUUID(); const controller = new AbortController();\n    active.current = { id, controller }; completed.current = false;\n    setMessages(ms => [...ms, { id, telemetry: data, mode: runMode, question: prompt.trim(), interval: snapshot, playhead: horizon, replayCursor: playhead, text: '', source: runMode === 'local' ? 'Local numerical analysis' : 'Assistant', tools: [], evidence: [], status: 'running' }]);\n    setQuestion('');\n    setBusy(true);\n    try {\n      if (runMode === 'local') {\n        const result = analyzeWindow(data, snapshot, prompt, horizon);\n        update(id, { text: result.text, tools: result.tools, evidence: result.evidence, status: 'complete' });\n      } else {\n        const request = { mode: 'assistant' as const, question: prompt, playheadSec: horizon, window: { datasetId, recordingId: data.recording.id, startSec: snapshot.start, endSec: snapshot.end, channelIds: data.channels.map(c => c.id) } };\n        const job = await services.startQuery(request, controller.signal);\n        if (active.current?.id !== id) { await services.cancelQuery(job.queryId); return; }\n        active.current.queryId = job.queryId;\n        await services.streamQuery(job.streamUrl, event => {\n          if (active.current?.id !== id || event.queryId !== job.queryId) return;\n          const p = event.payload;\n          if (event.type === 'tool.started') update(id, m => ({ tools: [...m.tools, p.label ?? p.tool ?? 'Tool started'] }));\n          if (event.type === 'tool.completed') update(id, m => ({ tools: [...m.tools, p.summary ?? 'Tool completed'] }));\n          if (event.type === 'answer.delta') update(id, m => ({ text: m.text + (p.text ?? '') }));\n          if (event.type === 'answer.completed') { completed.current = true; update(id, m => ({ status: 'complete', text: p.answer ?? m.text, modelId: p.modelId, modelRevision: p.modelRevision, inputTrace: p.inputTrace, modelOutput: typeof p.modelOutput === 'string' ? p.modelOutput : undefined, source: `${p.modelId ?? 'Assistant'} · completed`, evidence: (p.evidence ?? []).flatMap(evidenceFrom) })); }\n          if (event.type === 'query.error') { completed.current = true; update(id, m => ({ status: 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${p.message ?? 'Inference failed.'}` })); }\n          if (event.type === 'query.cancelled') { completed.current = true; update(id, { status: 'cancelled' }); }\n        }, controller.signal);\n      }\n    } catch (error) {\n      update(id, m => ({ status: controller.signal.aborted ? 'cancelled' : 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${controller.signal.aborted ? 'Stopped. This answer is incomplete.' : error instanceof Error ? error.message : 'The request failed.'}` }));\n    } finally { if (active.current?.id === id) { active.current = null; setBusy(false); } }\n  }\n  function exportReport(message: Message) {\n    try { downloadInvestigationMarkdown(message.telemetry, datasetId, message); setExportStatus('Readable investigation report downloaded as Markdown.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The report could not be exported.'); }\n  }\n  function exportEvidence(message: Message) {\n    try { downloadInvestigationJson(message.telemetry, datasetId, message); setExportStatus('Machine-readable evidence downloaded as JSON.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The evidence could not be exported.'); }\n  }\n  async function stop() {\n    const job = active.current; if (!job) return;\n    job.controller.abort();\n    if (job.queryId) { try { await services.cancelQuery(job.queryId); } catch { update(job.id, { status: 'error', text: 'The browser stopped listening, but server cancellation could not be confirmed.' }); } }\n  }\n  return <section className=\"assistant-panel\" aria-label=\"Telemetry assistant\">\n    <header className=\"panel-heading\"><div className=\"assistant-title\"><MessageSquare size={16}/><h2>Event investigation</h2></div><span className=\"assistant-capability\">{checkpointLabel(registry.models.find(m => m.id === 'assistant')?.revision).split(' · ')[0]}</span></header>\n    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\n    {windowIssue && <div className=\"input-guidance\"><p>{windowIssue}</p>{rawError && <button className=\"text-button\" onClick={onRetryRaw}>Retry raw window</button>}{!rawLoading && !rawError && fittedWindow && <button className=\"text-button\" disabled={busy} onClick={() => onModelWindow(fittedWindow)}>Use 1.024 s window</button>}</div>}\n    <div className=\"conversation\" ref={body} aria-live=\"polite\">\n      {!messages.length && <div className=\"conversation-intro\"><Waves size={26}/><h3>Prepare a reviewable incident handoff.</h3><p>Analyze the incident, verify the prediction against exact signals, then export the handoff for a controls engineer.</p><p className=\"intro-limit\">Recorded torque can guide investigation. It cannot verify a physical cause.</p></div>}\n      {messages.map(m => {\n        const brief = predictionBrief(m.modelOutput);\n        const cue = m.status === 'complete' ? predictionCue(m.modelOutput, m.interval) : undefined;\n        const review = m.status === 'complete' ? reviewPrediction(m.telemetry, m.interval, m.modelOutput) : undefined;\n        const measuredText = m.text.split(/\\n\\s*\\n/).find(block => block.startsWith('Measured in this selected window'))?.split('\\n').slice(1).join(' ');\n        return <article className=\"conversation-turn\" key={m.id}>\n          <div className=\"user-question\"><div><p>{m.question}</p><small className=\"mono\">{intervalLabel(m.interval)}</small></div></div>\n          <div className=\"assistant-answer\"><div>\n            {m.status !== 'complete' && <div className=\"answer-source\">{m.status === 'running' ? 'Reading the selected telemetry…' : m.status}</div>}\n            <div className={m.status === 'error' ? 'error-message' : ''}>\n              {brief ? <><section className=\"prediction-summary\"><h3>{brief.title}</h3><div className=\"prediction-facts\">{brief.strongest && <span>Predicted strongest joint <strong>{brief.strongest}</strong></span>}{brief.onset !== undefined && <span>Predicted onset <strong>{brief.onset} ms</strong> into the window</span>}</div><p className=\"prediction-caution\">OpenTSLM prediction · not a verified physical diagnosis.</p></section>{measuredText && <section className=\"measured-summary\"><h3>Measured torque</h3><p>{measuredText}</p></section>}{review && <section className=\"review-note\"><h3>Cross-check</h3><p>{review.note}</p></section>}</> : m.text ? <AnswerText text={m.text}/> : null}\n            </div>\n            {m.status === 'complete' && <section className=\"investigation-next\" aria-label=\"Verify and hand off\"><h3>Verify and hand off</h3><ol className=\"investigation-actions\">\n              {cue && <li><button onClick={() => onRobotPrediction(cue)}><span>1</span><strong>Show generated onset cue in 3D</strong><ArrowUpRight size={12}/></button></li>}\n              {m.evidence.map((e, i) => <li key={i}><button onClick={() => onEvidence(e)}><span>{cue ? 2 : 1}</span><strong>Inspect exact seven-channel input</strong><SlidersHorizontal size={12}/></button></li>)}\n              <li><button onClick={() => onCompare(m.interval)}><span>{cue ? 3 : m.evidence.length ? 2 : 1}</span><strong>Compare with a reference window · optional</strong><ArrowUpRight size={12}/></button></li>\n              <li><button onClick={() => exportReport(m)}><span>{cue ? 4 : m.evidence.length ? 3 : 2}</span><strong>Export incident handoff (.md)</strong><Download size={13}/></button></li>\n            </ol></section>}\n            {m.status === 'complete' && m.mode === 'assistant' && <details className=\"input-receipt\"><summary>Model &amp; input details</summary><p>{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s</p><details><summary>Structured model prediction</summary><p>Only supported prediction fields are shown here. Generated evidence prose is retained only in the audit JSON and is not treated as an annotation or measurement.</p><pre>{JSON.stringify(structuredPrediction(m.modelOutput) ?? { status: 'No valid structured prediction was returned.' }, null, 2)}</pre></details><details><summary>1,024-sample input receipt</summary><pre>{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}</pre><p>{m.modelRevision}</p></details>{m.tools.length > 0 && <details className=\"tool-log\"><summary>{m.tools.length} completed tool steps</summary>{m.tools.map((t, i) => <p key={i}>{t}</p>)}</details>}<button className=\"text-button\" onClick={() => exportEvidence(m)}><Download size={12}/>Download audit JSON</button></details>}\n            {(m.status === 'error' || m.status === 'cancelled') && <button className=\"text-button\" disabled={busy} onClick={() => { setQuestion(m.question); }}><RotateCcw size={12}/>Use this question again</button>}\n          </div></div>\n        </article>;\n      })}\n    </div>\n    {exportStatus && <p className=\"report-status\" role=\"status\">{exportStatus}</p>}\n    {mode === 'assistant' && !assistantAvailable && <p className=\"status-note\" role=\"status\">Model unavailable. Open custom analysis and choose Measurements only.</p>}\n    <details className=\"custom-analysis\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n  </section>;\n}\nfrontend/src/styles.css:245:.model-input-status { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); }\nfrontend/src/styles.css:246:.model-input-status > div { display: grid; gap: 5px; }\nfrontend/src/styles.css:247:.model-input-status strong { font-size: 14px; font-weight: 500; }\nfrontend/src/styles.css:248:.model-input-status span { font-size: 12px; color: var(--quiet); }\nfrontend/src/styles.css:249:.model-input-status .btn { min-height: 38px; padding-inline: 14px; }\nfrontend/src/styles.css:288:  .model-input-status, .assistant-panel > .panel-heading, .conversation { padding-inline: 18px; }\nfrontend/src/styles.css:317:  .model-input-status { padding: 14px 18px; gap: 8px; }\nfrontend/src/styles.css:318:  .model-input-status strong { font-size: 13px; }\nfrontend/src/styles.css:319:  .model-input-status span { font-size: 11px; }\nfrontend/src/styles.css:320:  .model-input-status .btn { font-size: 12px; }\nfrontend/src/assistant/AssistantPanel.tsx:98:    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\nfrontend/src/assistant/AssistantPanel.tsx:128:    <details className=\"custom-analysis\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n","stderr":"","aggregated_output":"import { useEffect, useMemo, useRef, useState } from 'react';\nimport { ArrowUp, ArrowUpRight, CircleStop, Cpu, Download, MessageSquare, RotateCcw, SlidersHorizontal, Waves } from 'lucide-react';\nimport { predictionBrief, predictionCue, structuredPrediction, type PredictionCue } from './predictionBrief';\nimport { reviewPrediction } from './predictionReview';\nimport { downloadInvestigationJson, downloadInvestigationMarkdown, type InvestigationAnswer } from './investigationReport';\nimport { checkpointLabel, fitModelWindow, modelWindowIssue } from '../lib/modelWindow';\nimport { analyzeWindow } from '../lib/data';\nimport { intervalLabel } from '../lib/format';\nimport type { DemoData, EvidenceLink, Interval } from '../types';\nimport type { Evidence, Services } from '../services';\nimport type { ModelRegistry } from '../services/useModelRegistry';\n\ntype Message = InvestigationAnswer & { telemetry: DemoData; id: string; tools: string[]; status: 'running' | 'complete' | 'error' | 'cancelled' };\ntype Props = { rawLoading?: boolean; rawError?: string; onRetryRaw: () => void; data: DemoData; datasetId: string; playhead: number; interval: Interval; services: Services; registry: ModelRegistry; onEvidence: (e: EvidenceLink) => void; onModelWindow: (interval: Interval) => void; onCompare: (interval: Interval) => void; onRobotPrediction: (prediction: PredictionCue) => void };\nfunction AnswerText({ text }: { text: string }) {\n  const blocks = text.split(/\\n\\s*\\n/).filter(Boolean);\n  return <div className=\"answer-brief\">{blocks.map((block, index) => {\n    const [heading, ...body] = block.split('\\n');\n    const structured = body.length > 0 && /^(Measured in this selected window|OpenTSLM interpretation)$/i.test(heading.trim());\n    return structured\n      ? <section key={`${heading}-${index}`}><h3>{heading}</h3><p>{body.join(' ')}</p></section>\n      : <p key={`${heading}-${index}`}>{block.replace(/\\n+/g, ' ')}</p>;\n  })}</div>;\n}\nexport default function AssistantPanel({ rawLoading, rawError, onRetryRaw, data, datasetId, playhead, interval, services, registry, onEvidence, onModelWindow, onRobotPrediction, onCompare }: Props) {\n  const [question, setQuestion] = useState('');\n  const [mode, setMode] = useState<'local' | 'assistant'>('assistant');\n  const availableThrough = data.recording.durationSeconds;\n  const historical = interval.end <= availableThrough;\n  const dataIssue = useMemo(() => modelWindowIssue(data, interval, historical ? interval.end : 0), [data, interval, historical]);\n  const windowIssue = rawLoading ? 'Loading 1,024 raw samples for this interval…' : rawError ?? dataIssue;\n  const fitHorizon = Math.min(Math.floor(availableThrough * 1000) / 1000, data.detail.endSeconds);\n  const fittedWindow = useMemo(() => fitModelWindow(data, interval, fitHorizon), [data, interval, fitHorizon]);\n  const [exportStatus, setExportStatus] = useState('');\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [busy, setBusy] = useState(false);\n  const assistantAvailable = services.connected && !registry.loading && !registry.error && registry.models.some(model => model.id === 'assistant' && model.available && model.capabilities.includes('language'));\n  const modeUnavailable = mode === 'assistant' && (!assistantAvailable || Boolean(windowIssue));\n  const active = useRef<{ id: string; controller: AbortController; queryId?: string } | null>(null);\n  const body = useRef<HTMLDivElement>(null);\n  const completed = useRef(false);\n  useEffect(() => { const container = body.current; const latest = container?.lastElementChild as HTMLElement | null; if (!messages.length || !container || !latest) return; container.scrollTo({ top: latest.offsetTop - container.offsetTop, behavior: 'instant' }); }, [messages.length]);\n  useEffect(() => () => { const job = active.current; job?.controller.abort(); if (job?.queryId) void services.cancelQuery(job.queryId).catch(() => undefined); active.current = null; }, [services]);\n  function update(id: string, changes: Partial<Message> | ((m: Message) => Partial<Message>)) { setMessages(ms => ms.map(m => m.id === id ? { ...m, ...(typeof changes === 'function' ? changes(m) : changes) } : m)); }\n  function evidenceFrom(e: Evidence): EvidenceLink[] {\n    if (e.window.recordingId !== data.recording.id) return [];\n    if (!e.window.channelIds.length) return [];\n    return [{ channelId: e.window.channelIds[0], channelIds: e.window.channelIds, label: `Inspect ${e.window.channelIds.length} input channels`, interval: { start: e.window.startSec, end: e.window.endSec } }];\n  }\n  async function submit(prompt = question, runMode: 'local' | 'assistant' = mode) {\n    if (!prompt.trim() || busy || (runMode === 'assistant' && (rawLoading || rawError)) || (runMode === 'assistant' && !assistantAvailable)) return;\n    const snapshot = { ...interval }, horizon = Math.max(playhead, snapshot.end);\n    if (runMode === 'assistant' && modelWindowIssue(data, snapshot, horizon)) return;\n    const id = crypto.randomUUID(); const controller = new AbortController();\n    active.current = { id, controller }; completed.current = false;\n    setMessages(ms => [...ms, { id, telemetry: data, mode: runMode, question: prompt.trim(), interval: snapshot, playhead: horizon, replayCursor: playhead, text: '', source: runMode === 'local' ? 'Local numerical analysis' : 'Assistant', tools: [], evidence: [], status: 'running' }]);\n    setQuestion('');\n    setBusy(true);\n    try {\n      if (runMode === 'local') {\n        const result = analyzeWindow(data, snapshot, prompt, horizon);\n        update(id, { text: result.text, tools: result.tools, evidence: result.evidence, status: 'complete' });\n      } else {\n        const request = { mode: 'assistant' as const, question: prompt, playheadSec: horizon, window: { datasetId, recordingId: data.recording.id, startSec: snapshot.start, endSec: snapshot.end, channelIds: data.channels.map(c => c.id) } };\n        const job = await services.startQuery(request, controller.signal);\n        if (active.current?.id !== id) { await services.cancelQuery(job.queryId); return; }\n        active.current.queryId = job.queryId;\n        await services.streamQuery(job.streamUrl, event => {\n          if (active.current?.id !== id || event.queryId !== job.queryId) return;\n          const p = event.payload;\n          if (event.type === 'tool.started') update(id, m => ({ tools: [...m.tools, p.label ?? p.tool ?? 'Tool started'] }));\n          if (event.type === 'tool.completed') update(id, m => ({ tools: [...m.tools, p.summary ?? 'Tool completed'] }));\n          if (event.type === 'answer.delta') update(id, m => ({ text: m.text + (p.text ?? '') }));\n          if (event.type === 'answer.completed') { completed.current = true; update(id, m => ({ status: 'complete', text: p.answer ?? m.text, modelId: p.modelId, modelRevision: p.modelRevision, inputTrace: p.inputTrace, modelOutput: typeof p.modelOutput === 'string' ? p.modelOutput : undefined, source: `${p.modelId ?? 'Assistant'} · completed`, evidence: (p.evidence ?? []).flatMap(evidenceFrom) })); }\n          if (event.type === 'query.error') { completed.current = true; update(id, m => ({ status: 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${p.message ?? 'Inference failed.'}` })); }\n          if (event.type === 'query.cancelled') { completed.current = true; update(id, { status: 'cancelled' }); }\n        }, controller.signal);\n      }\n    } catch (error) {\n      update(id, m => ({ status: controller.signal.aborted ? 'cancelled' : 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${controller.signal.aborted ? 'Stopped. This answer is incomplete.' : error instanceof Error ? error.message : 'The request failed.'}` }));\n    } finally { if (active.current?.id === id) { active.current = null; setBusy(false); } }\n  }\n  function exportReport(message: Message) {\n    try { downloadInvestigationMarkdown(message.telemetry, datasetId, message); setExportStatus('Readable investigation report downloaded as Markdown.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The report could not be exported.'); }\n  }\n  function exportEvidence(message: Message) {\n    try { downloadInvestigationJson(message.telemetry, datasetId, message); setExportStatus('Machine-readable evidence downloaded as JSON.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The evidence could not be exported.'); }\n  }\n  async function stop() {\n    const job = active.current; if (!job) return;\n    job.controller.abort();\n    if (job.queryId) { try { await services.cancelQuery(job.queryId); } catch { update(job.id, { status: 'error', text: 'The browser stopped listening, but server cancellation could not be confirmed.' }); } }\n  }\n  return <section className=\"assistant-panel\" aria-label=\"Telemetry assistant\">\n    <header className=\"panel-heading\"><div className=\"assistant-title\"><MessageSquare size={16}/><h2>Event investigation</h2></div><span className=\"assistant-capability\">{checkpointLabel(registry.models.find(m => m.id === 'assistant')?.revision).split(' · ')[0]}</span></header>\n    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\n    {windowIssue && <div className=\"input-guidance\"><p>{windowIssue}</p>{rawError && <button className=\"text-button\" onClick={onRetryRaw}>Retry raw window</button>}{!rawLoading && !rawError && fittedWindow && <button className=\"text-button\" disabled={busy} onClick={() => onModelWindow(fittedWindow)}>Use 1.024 s window</button>}</div>}\n    <div className=\"conversation\" ref={body} aria-live=\"polite\">\n      {!messages.length && <div className=\"conversation-intro\"><Waves size={26}/><h3>Prepare a reviewable incident handoff.</h3><p>Analyze the incident, verify the prediction against exact signals, then export the handoff for a controls engineer.</p><p className=\"intro-limit\">Recorded torque can guide investigation. It cannot verify a physical cause.</p></div>}\n      {messages.map(m => {\n        const brief = predictionBrief(m.modelOutput);\n        const cue = m.status === 'complete' ? predictionCue(m.modelOutput, m.interval) : undefined;\n        const review = m.status === 'complete' ? reviewPrediction(m.telemetry, m.interval, m.modelOutput) : undefined;\n        const measuredText = m.text.split(/\\n\\s*\\n/).find(block => block.startsWith('Measured in this selected window'))?.split('\\n').slice(1).join(' ');\n        return <article className=\"conversation-turn\" key={m.id}>\n          <div className=\"user-question\"><div><p>{m.question}</p><small className=\"mono\">{intervalLabel(m.interval)}</small></div></div>\n          <div className=\"assistant-answer\"><div>\n            {m.status !== 'complete' && <div className=\"answer-source\">{m.status === 'running' ? 'Reading the selected telemetry…' : m.status}</div>}\n            <div className={m.status === 'error' ? 'error-message' : ''}>\n              {brief ? <><section className=\"prediction-summary\"><h3>{brief.title}</h3><div className=\"prediction-facts\">{brief.strongest && <span>Predicted strongest joint <strong>{brief.strongest}</strong></span>}{brief.onset !== undefined && <span>Predicted onset <strong>{brief.onset} ms</strong> into the window</span>}</div><p className=\"prediction-caution\">OpenTSLM prediction · not a verified physical diagnosis.</p></section>{measuredText && <section className=\"measured-summary\"><h3>Measured torque</h3><p>{measuredText}</p></section>}{review && <section className=\"review-note\"><h3>Cross-check</h3><p>{review.note}</p></section>}</> : m.text ? <AnswerText text={m.text}/> : null}\n            </div>\n            {m.status === 'complete' && <section className=\"investigation-next\" aria-label=\"Verify and hand off\"><h3>Verify and hand off</h3><ol className=\"investigation-actions\">\n              {cue && <li><button onClick={() => onRobotPrediction(cue)}><span>1</span><strong>Show generated onset cue in 3D</strong><ArrowUpRight size={12}/></button></li>}\n              {m.evidence.map((e, i) => <li key={i}><button onClick={() => onEvidence(e)}><span>{cue ? 2 : 1}</span><strong>Inspect exact seven-channel input</strong><SlidersHorizontal size={12}/></button></li>)}\n              <li><button onClick={() => onCompare(m.interval)}><span>{cue ? 3 : m.evidence.length ? 2 : 1}</span><strong>Compare with a reference window · optional</strong><ArrowUpRight size={12}/></button></li>\n              <li><button onClick={() => exportReport(m)}><span>{cue ? 4 : m.evidence.length ? 3 : 2}</span><strong>Export incident handoff (.md)</strong><Download size={13}/></button></li>\n            </ol></section>}\n            {m.status === 'complete' && m.mode === 'assistant' && <details className=\"input-receipt\"><summary>Model &amp; input details</summary><p>{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s</p><details><summary>Structured model prediction</summary><p>Only supported prediction fields are shown here. Generated evidence prose is retained only in the audit JSON and is not treated as an annotation or measurement.</p><pre>{JSON.stringify(structuredPrediction(m.modelOutput) ?? { status: 'No valid structured prediction was returned.' }, null, 2)}</pre></details><details><summary>1,024-sample input receipt</summary><pre>{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}</pre><p>{m.modelRevision}</p></details>{m.tools.length > 0 && <details className=\"tool-log\"><summary>{m.tools.length} completed tool steps</summary>{m.tools.map((t, i) => <p key={i}>{t}</p>)}</details>}<button className=\"text-button\" onClick={() => exportEvidence(m)}><Download size={12}/>Download audit JSON</button></details>}\n            {(m.status === 'error' || m.status === 'cancelled') && <button className=\"text-button\" disabled={busy} onClick={() => { setQuestion(m.question); }}><RotateCcw size={12}/>Use this question again</button>}\n          </div></div>\n        </article>;\n      })}\n    </div>\n    {exportStatus && <p className=\"report-status\" role=\"status\">{exportStatus}</p>}\n    {mode === 'assistant' && !assistantAvailable && <p className=\"status-note\" role=\"status\">Model unavailable. Open custom analysis and choose Measurements only.</p>}\n    <details className=\"custom-analysis\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n  </section>;\n}\nfrontend/src/styles.css:245:.model-input-status { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); }\nfrontend/src/styles.css:246:.model-input-status > div { display: grid; gap: 5px; }\nfrontend/src/styles.css:247:.model-input-status strong { font-size: 14px; font-weight: 500; }\nfrontend/src/styles.css:248:.model-input-status span { font-size: 12px; color: var(--quiet); }\nfrontend/src/styles.css:249:.model-input-status .btn { min-height: 38px; padding-inline: 14px; }\nfrontend/src/styles.css:288:  .model-input-status, .assistant-panel > .panel-heading, .conversation { padding-inline: 18px; }\nfrontend/src/styles.css:317:  .model-input-status { padding: 14px 18px; gap: 8px; }\nfrontend/src/styles.css:318:  .model-input-status strong { font-size: 13px; }\nfrontend/src/styles.css:319:  .model-input-status span { font-size: 11px; }\nfrontend/src/styles.css:320:  .model-input-status .btn { font-size: 12px; }\nfrontend/src/assistant/AssistantPanel.tsx:98:    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\nfrontend/src/assistant/AssistantPanel.tsx:128:    <details className=\"custom-analysis\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n","exit_code":0,"duration":{"secs":0,"nanos":2125},"formatted_output":"import { useEffect, useMemo, useRef, useState } from 'react';\nimport { ArrowUp, ArrowUpRight, CircleStop, Cpu, Download, MessageSquare, RotateCcw, SlidersHorizontal, Waves } from 'lucide-react';\nimport { predictionBrief, predictionCue, structuredPrediction, type PredictionCue } from './predictionBrief';\nimport { reviewPrediction } from './predictionReview';\nimport { downloadInvestigationJson, downloadInvestigationMarkdown, type InvestigationAnswer } from './investigationReport';\nimport { checkpointLabel, fitModelWindow, modelWindowIssue } from '../lib/modelWindow';\nimport { analyzeWindow } from '../lib/data';\nimport { intervalLabel } from '../lib/format';\nimport type { DemoData, EvidenceLink, Interval } from '../types';\nimport type { Evidence, Services } from '../services';\nimport type { ModelRegistry } from '../services/useModelRegistry';\n\ntype Message = InvestigationAnswer & { telemetry: DemoData; id: string; tools: string[]; status: 'running' | 'complete' | 'error' | 'cancelled' };\ntype Props = { rawLoading?: boolean; rawError?: string; onRetryRaw: () => void; data: DemoData; datasetId: string; playhead: number; interval: Interval; services: Services; registry: ModelRegistry; onEvidence: (e: EvidenceLink) => void; onModelWindow: (interval: Interval) => void; onCompare: (interval: Interval) => void; onRobotPrediction: (prediction: PredictionCue) => void };\nfunction AnswerText({ text }: { text: string }) {\n  const blocks = text.split(/\\n\\s*\\n/).filter(Boolean);\n  return <div className=\"answer-brief\">{blocks.map((block, index) => {\n    const [heading, ...body] = block.split('\\n');\n    const structured = body.length > 0 && /^(Measured in this selected window|OpenTSLM interpretation)$/i.test(heading.trim());\n    return structured\n      ? <section key={`${heading}-${index}`}><h3>{heading}</h3><p>{body.join(' ')}</p></section>\n      : <p key={`${heading}-${index}`}>{block.replace(/\\n+/g, ' ')}</p>;\n  })}</div>;\n}\nexport default function AssistantPanel({ rawLoading, rawError, onRetryRaw, data, datasetId, playhead, interval, services, registry, onEvidence, onModelWindow, onRobotPrediction, onCompare }: Props) {\n  const [question, setQuestion] = useState('');\n  const [mode, setMode] = useState<'local' | 'assistant'>('assistant');\n  const availableThrough = data.recording.durationSeconds;\n  const historical = interval.end <= availableThrough;\n  const dataIssue = useMemo(() => modelWindowIssue(data, interval, historical ? interval.end : 0), [data, interval, historical]);\n  const windowIssue = rawLoading ? 'Loading 1,024 raw samples for this interval…' : rawError ?? dataIssue;\n  const fitHorizon = Math.min(Math.floor(availableThrough * 1000) / 1000, data.detail.endSeconds);\n  const fittedWindow = useMemo(() => fitModelWindow(data, interval, fitHorizon), [data, interval, fitHorizon]);\n  const [exportStatus, setExportStatus] = useState('');\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [busy, setBusy] = useState(false);\n  const assistantAvailable = services.connected && !registry.loading && !registry.error && registry.models.some(model => model.id === 'assistant' && model.available && model.capabilities.includes('language'));\n  const modeUnavailable = mode === 'assistant' && (!assistantAvailable || Boolean(windowIssue));\n  const active = useRef<{ id: string; controller: AbortController; queryId?: string } | null>(null);\n  const body = useRef<HTMLDivElement>(null);\n  const completed = useRef(false);\n  useEffect(() => { const container = body.current; const latest = container?.lastElementChild as HTMLElement | null; if (!messages.length || !container || !latest) return; container.scrollTo({ top: latest.offsetTop - container.offsetTop, behavior: 'instant' }); }, [messages.length]);\n  useEffect(() => () => { const job = active.current; job?.controller.abort(); if (job?.queryId) void services.cancelQuery(job.queryId).catch(() => undefined); active.current = null; }, [services]);\n  function update(id: string, changes: Partial<Message> | ((m: Message) => Partial<Message>)) { setMessages(ms => ms.map(m => m.id === id ? { ...m, ...(typeof changes === 'function' ? changes(m) : changes) } : m)); }\n  function evidenceFrom(e: Evidence): EvidenceLink[] {\n    if (e.window.recordingId !== data.recording.id) return [];\n    if (!e.window.channelIds.length) return [];\n    return [{ channelId: e.window.channelIds[0], channelIds: e.window.channelIds, label: `Inspect ${e.window.channelIds.length} input channels`, interval: { start: e.window.startSec, end: e.window.endSec } }];\n  }\n  async function submit(prompt = question, runMode: 'local' | 'assistant' = mode) {\n    if (!prompt.trim() || busy || (runMode === 'assistant' && (rawLoading || rawError)) || (runMode === 'assistant' && !assistantAvailable)) return;\n    const snapshot = { ...interval }, horizon = Math.max(playhead, snapshot.end);\n    if (runMode === 'assistant' && modelWindowIssue(data, snapshot, horizon)) return;\n    const id = crypto.randomUUID(); const controller = new AbortController();\n    active.current = { id, controller }; completed.current = false;\n    setMessages(ms => [...ms, { id, telemetry: data, mode: runMode, question: prompt.trim(), interval: snapshot, playhead: horizon, replayCursor: playhead, text: '', source: runMode === 'local' ? 'Local numerical analysis' : 'Assistant', tools: [], evidence: [], status: 'running' }]);\n    setQuestion('');\n    setBusy(true);\n    try {\n      if (runMode === 'local') {\n        const result = analyzeWindow(data, snapshot, prompt, horizon);\n        update(id, { text: result.text, tools: result.tools, evidence: result.evidence, status: 'complete' });\n      } else {\n        const request = { mode: 'assistant' as const, question: prompt, playheadSec: horizon, window: { datasetId, recordingId: data.recording.id, startSec: snapshot.start, endSec: snapshot.end, channelIds: data.channels.map(c => c.id) } };\n        const job = await services.startQuery(request, controller.signal);\n        if (active.current?.id !== id) { await services.cancelQuery(job.queryId); return; }\n        active.current.queryId = job.queryId;\n        await services.streamQuery(job.streamUrl, event => {\n          if (active.current?.id !== id || event.queryId !== job.queryId) return;\n          const p = event.payload;\n          if (event.type === 'tool.started') update(id, m => ({ tools: [...m.tools, p.label ?? p.tool ?? 'Tool started'] }));\n          if (event.type === 'tool.completed') update(id, m => ({ tools: [...m.tools, p.summary ?? 'Tool completed'] }));\n          if (event.type === 'answer.delta') update(id, m => ({ text: m.text + (p.text ?? '') }));\n          if (event.type === 'answer.completed') { completed.current = true; update(id, m => ({ status: 'complete', text: p.answer ?? m.text, modelId: p.modelId, modelRevision: p.modelRevision, inputTrace: p.inputTrace, modelOutput: typeof p.modelOutput === 'string' ? p.modelOutput : undefined, source: `${p.modelId ?? 'Assistant'} · completed`, evidence: (p.evidence ?? []).flatMap(evidenceFrom) })); }\n          if (event.type === 'query.error') { completed.current = true; update(id, m => ({ status: 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${p.message ?? 'Inference failed.'}` })); }\n          if (event.type === 'query.cancelled') { completed.current = true; update(id, { status: 'cancelled' }); }\n        }, controller.signal);\n      }\n    } catch (error) {\n      update(id, m => ({ status: controller.signal.aborted ? 'cancelled' : 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${controller.signal.aborted ? 'Stopped. This answer is incomplete.' : error instanceof Error ? error.message : 'The request failed.'}` }));\n    } finally { if (active.current?.id === id) { active.current = null; setBusy(false); } }\n  }\n  function exportReport(message: Message) {\n    try { downloadInvestigationMarkdown(message.telemetry, datasetId, message); setExportStatus('Readable investigation report downloaded as Markdown.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The report could not be exported.'); }\n  }\n  function exportEvidence(message: Message) {\n    try { downloadInvestigationJson(message.telemetry, datasetId, message); setExportStatus('Machine-readable evidence downloaded as JSON.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The evidence could not be exported.'); }\n  }\n  async function stop() {\n    const job = active.current; if (!job) return;\n    job.controller.abort();\n    if (job.queryId) { try { await services.cancelQuery(job.queryId); } catch { update(job.id, { status: 'error', text: 'The browser stopped listening, but server cancellation could not be confirmed.' }); } }\n  }\n  return <section className=\"assistant-panel\" aria-label=\"Telemetry assistant\">\n    <header className=\"panel-heading\"><div className=\"assistant-title\"><MessageSquare size={16}/><h2>Event investigation</h2></div><span className=\"assistant-capability\">{checkpointLabel(registry.models.find(m => m.id === 'assistant')?.revision).split(' · ')[0]}</span></header>\n    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\n    {windowIssue && <div className=\"input-guidance\"><p>{windowIssue}</p>{rawError && <button className=\"text-button\" onClick={onRetryRaw}>Retry raw window</button>}{!rawLoading && !rawError && fittedWindow && <button className=\"text-button\" disabled={busy} onClick={() => onModelWindow(fittedWindow)}>Use 1.024 s window</button>}</div>}\n    <div className=\"conversation\" ref={body} aria-live=\"polite\">\n      {!messages.length && <div className=\"conversation-intro\"><Waves size={26}/><h3>Prepare a reviewable incident handoff.</h3><p>Analyze the incident, verify the prediction against exact signals, then export the handoff for a controls engineer.</p><p className=\"intro-limit\">Recorded torque can guide investigation. It cannot verify a physical cause.</p></div>}\n      {messages.map(m => {\n        const brief = predictionBrief(m.modelOutput);\n        const cue = m.status === 'complete' ? predictionCue(m.modelOutput, m.interval) : undefined;\n        const review = m.status === 'complete' ? reviewPrediction(m.telemetry, m.interval, m.modelOutput) : undefined;\n        const measuredText = m.text.split(/\\n\\s*\\n/).find(block => block.startsWith('Measured in this selected window'))?.split('\\n').slice(1).join(' ');\n        return <article className=\"conversation-turn\" key={m.id}>\n          <div className=\"user-question\"><div><p>{m.question}</p><small className=\"mono\">{intervalLabel(m.interval)}</small></div></div>\n          <div className=\"assistant-answer\"><div>\n            {m.status !== 'complete' && <div className=\"answer-source\">{m.status === 'running' ? 'Reading the selected telemetry…' : m.status}</div>}\n            <div className={m.status === 'error' ? 'error-message' : ''}>\n              {brief ? <><section className=\"prediction-summary\"><h3>{brief.title}</h3><div className=\"prediction-facts\">{brief.strongest && <span>Predicted strongest joint <strong>{brief.strongest}</strong></span>}{brief.onset !== undefined && <span>Predicted onset <strong>{brief.onset} ms</strong> into the window</span>}</div><p className=\"prediction-caution\">OpenTSLM prediction · not a verified physical diagnosis.</p></section>{measuredText && <section className=\"measured-summary\"><h3>Measured torque</h3><p>{measuredText}</p></section>}{review && <section className=\"review-note\"><h3>Cross-check</h3><p>{review.note}</p></section>}</> : m.text ? <AnswerText text={m.text}/> : null}\n            </div>\n            {m.status === 'complete' && <section className=\"investigation-next\" aria-label=\"Verify and hand off\"><h3>Verify and hand off</h3><ol className=\"investigation-actions\">\n              {cue && <li><button onClick={() => onRobotPrediction(cue)}><span>1</span><strong>Show generated onset cue in 3D</strong><ArrowUpRight size={12}/></button></li>}\n              {m.evidence.map((e, i) => <li key={i}><button onClick={() => onEvidence(e)}><span>{cue ? 2 : 1}</span><strong>Inspect exact seven-channel input</strong><SlidersHorizontal size={12}/></button></li>)}\n              <li><button onClick={() => onCompare(m.interval)}><span>{cue ? 3 : m.evidence.length ? 2 : 1}</span><strong>Compare with a reference window · optional</strong><ArrowUpRight size={12}/></button></li>\n              <li><button onClick={() => exportReport(m)}><span>{cue ? 4 : m.evidence.length ? 3 : 2}</span><strong>Export incident handoff (.md)</strong><Download size={13}/></button></li>\n            </ol></section>}\n            {m.status === 'complete' && m.mode === 'assistant' && <details className=\"input-receipt\"><summary>Model &amp; input details</summary><p>{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s</p><details><summary>Structured model prediction</summary><p>Only supported prediction fields are shown here. Generated evidence prose is retained only in the audit JSON and is not treated as an annotation or measurement.</p><pre>{JSON.stringify(structuredPrediction(m.modelOutput) ?? { status: 'No valid structured prediction was returned.' }, null, 2)}</pre></details><details><summary>1,024-sample input receipt</summary><pre>{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}</pre><p>{m.modelRevision}</p></details>{m.tools.length > 0 && <details className=\"tool-log\"><summary>{m.tools.length} completed tool steps</summary>{m.tools.map((t, i) => <p key={i}>{t}</p>)}</details>}<button className=\"text-button\" onClick={() => exportEvidence(m)}><Download size={12}/>Download audit JSON</button></details>}\n            {(m.status === 'error' || m.status === 'cancelled') && <button className=\"text-button\" disabled={busy} onClick={() => { setQuestion(m.question); }}><RotateCcw size={12}/>Use this question again</button>}\n          </div></div>\n        </article>;\n      })}\n    </div>\n    {exportStatus && <p className=\"report-status\" role=\"status\">{exportStatus}</p>}\n    {mode === 'assistant' && !assistantAvailable && <p className=\"status-note\" role=\"status\">Model unavailable. Open custom analysis and choose Measurements only.</p>}\n    <details className=\"custom-analysis\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n  </section>;\n}\nfrontend/src/styles.css:245:.model-input-status { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); }\nfrontend/src/styles.css:246:.model-input-status > div { display: grid; gap: 5px; }\nfrontend/src/styles.css:247:.model-input-status strong { font-size: 14px; font-weight: 500; }\nfrontend/src/styles.css:248:.model-input-status span { font-size: 12px; color: var(--quiet); }\nfrontend/src/styles.css:249:.model-input-status .btn { min-height: 38px; padding-inline: 14px; }\nfrontend/src/styles.css:288:  .model-input-status, .assistant-panel > .panel-heading, .conversation { padding-inline: 18px; }\nfrontend/src/styles.css:317:  .model-input-status { padding: 14px 18px; gap: 8px; }\nfrontend/src/styles.css:318:  .model-input-status strong { font-size: 13px; }\nfrontend/src/styles.css:319:  .model-input-status span { font-size: 11px; }\nfrontend/src/styles.css:320:  .model-input-status .btn { font-size: 12px; }\nfrontend/src/assistant/AssistantPanel.tsx:98:    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\nfrontend/src/assistant/AssistantPanel.tsx:128:    <details className=\"custom-analysis\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label=\"Stop analysis\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n"},"started_at_ms":1789260317548,"completed_at_ms":1789260317549}}
{"timestamp":"2026-09-13T00:45:17.596Z","ordinal":5376,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a09839-c39c-73a3-8d6f-b3222438c710","call_id":"call_gRcu0OzrIflRspoYs2euojTI","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"52b54b\",\"wall_time_seconds\":0.000002125,\"exit_code\":0,\"original_token_count\":4695,\"output\":\"import { useEffect, useMemo, useRef, useState } from 'react';\\nimport { ArrowUp, ArrowUpRight, CircleStop, Cpu, Download, MessageSquare, RotateCcw, SlidersHorizontal, Waves } from 'lucide-react';\\nimport { predictionBrief, predictionCue, structuredPrediction, type PredictionCue } from './predictionBrief';\\nimport { reviewPrediction } from './predictionReview';\\nimport { downloadInvestigationJson, downloadInvestigationMarkdown, type InvestigationAnswer } from './investigationReport';\\nimport { checkpointLabel, fitModelWindow, modelWindowIssue } from '../lib/modelWindow';\\nimport { analyzeWindow } from '../lib/data';\\nimport { intervalLabel } from '../lib/format';\\nimport type { DemoData, EvidenceLink, Interval } from '../types';\\nimport type { Evidence, Services } from '../services';\\nimport type { ModelRegistry } from '../services/useModelRegistry';\\n\\ntype Message = InvestigationAnswer & { telemetry: DemoData; id: string; tools: string[]; status: 'running' | 'complete' | 'error' | 'cancelled' };\\ntype Props = { rawLoading?: boolean; rawError?: string; onRetryRaw: () => void; data: DemoData; datasetId: string; playhead: number; interval: Interval; services: Services; registry: ModelRegistry; onEvidence: (e: EvidenceLink) => void; onModelWindow: (interval: Interval) => void; onCompare: (interval: Interval) => void; onRobotPrediction: (prediction: PredictionCue) => void };\\nfunction AnswerText({ text }: { text: string }) {\\n  const blocks = text.split(/\\\\n\\\\s*\\\\n/).filter(Boolean);\\n  return <div className=\\\"answer-brief\\\">{blocks.map((block, index) => {\\n    const [heading, ...body] = block.split('\\\\n');\\n    const structured = body.length > 0 && /^(Measured in this selected window|OpenTSLM interpretation)$/i.test(heading.trim());\\n    return structured\\n      ? <section key={`${heading}-${index}`}><h3>{heading}</h3><p>{body.join(' ')}</p></section>\\n      : <p key={`${heading}-${index}`}>{block.replace(/\\\\n+/g, ' ')}</p>;\\n  })}</div>;\\n}\\nexport default function AssistantPanel({ rawLoading, rawError, onRetryRaw, data, datasetId, playhead, interval, services, registry, onEvidence, onModelWindow, onRobotPrediction, onCompare }: Props) {\\n  const [question, setQuestion] = useState('');\\n  const [mode, setMode] = useState<'local' | 'assistant'>('assistant');\\n  const availableThrough = data.recording.durationSeconds;\\n  const historical = interval.end <= availableThrough;\\n  const dataIssue = useMemo(() => modelWindowIssue(data, interval, historical ? interval.end : 0), [data, interval, historical]);\\n  const windowIssue = rawLoading ? 'Loading 1,024 raw samples for this interval…' : rawError ?? dataIssue;\\n  const fitHorizon = Math.min(Math.floor(availableThrough * 1000) / 1000, data.detail.endSeconds);\\n  const fittedWindow = useMemo(() => fitModelWindow(data, interval, fitHorizon), [data, interval, fitHorizon]);\\n  const [exportStatus, setExportStatus] = useState('');\\n  const [messages, setMessages] = useState<Message[]>([]);\\n  const [busy, setBusy] = useState(false);\\n  const assistantAvailable = services.connected && !registry.loading && !registry.error && registry.models.some(model => model.id === 'assistant' && model.available && model.capabilities.includes('language'));\\n  const modeUnavailable = mode === 'assistant' && (!assistantAvailable || Boolean(windowIssue));\\n  const active = useRef<{ id: string; controller: AbortController; queryId?: string } | null>(null);\\n  const body = useRef<HTMLDivElement>(null);\\n  const completed = useRef(false);\\n  useEffect(() => { const container = body.current; const latest = container?.lastElementChild as HTMLElement | null; if (!messages.length || !container || !latest) return; container.scrollTo({ top: latest.offsetTop - container.offsetTop, behavior: 'instant' }); }, [messages.length]);\\n  useEffect(() => () => { const job = active.current; job?.controller.abort(); if (job?.queryId) void services.cancelQuery(job.queryId).catch(() => undefined); active.current = null; }, [services]);\\n  function update(id: string, changes: Partial<Message> | ((m: Message) => Partial<Message>)) { setMessages(ms => ms.map(m => m.id === id ? { ...m, ...(typeof changes === 'function' ? changes(m) : changes) } : m)); }\\n  function evidenceFrom(e: Evidence): EvidenceLink[] {\\n    if (e.window.recordingId !== data.recording.id) return [];\\n    if (!e.window.channelIds.length) return [];\\n    return [{ channelId: e.window.channelIds[0], channelIds: e.window.channelIds, label: `Inspect ${e.window.channelIds.length} input channels`, interval: { start: e.window.startSec, end: e.window.endSec } }];\\n  }\\n  async function submit(prompt = question, runMode: 'local' | 'assistant' = mode) {\\n    if (!prompt.trim() || busy || (runMode === 'assistant' && (rawLoading || rawError)) || (runMode === 'assistant' && !assistantAvailable)) return;\\n    const snapshot = { ...interval }, horizon = Math.max(playhead, snapshot.end);\\n    if (runMode === 'assistant' && modelWindowIssue(data, snapshot, horizon)) return;\\n    const id = crypto.randomUUID(); const controller = new AbortController();\\n    active.current = { id, controller }; completed.current = false;\\n    setMessages(ms => [...ms, { id, telemetry: data, mode: runMode, question: prompt.trim(), interval: snapshot, playhead: horizon, replayCursor: playhead, text: '', source: runMode === 'local' ? 'Local numerical analysis' : 'Assistant', tools: [], evidence: [], status: 'running' }]);\\n    setQuestion('');\\n    setBusy(true);\\n    try {\\n      if (runMode === 'local') {\\n        const result = analyzeWindow(data, snapshot, prompt, horizon);\\n        update(id, { text: result.text, tools: result.tools, evidence: result.evidence, status: 'complete' });\\n      } else {\\n        const request = { mode: 'assistant' as const, question: prompt, playheadSec: horizon, window: { datasetId, recordingId: data.recording.id, startSec: snapshot.start, endSec: snapshot.end, channelIds: data.channels.map(c => c.id) } };\\n        const job = await services.startQuery(request, controller.signal);\\n        if (active.current?.id !== id) { await services.cancelQuery(job.queryId); return; }\\n        active.current.queryId = job.queryId;\\n        await services.streamQuery(job.streamUrl, event => {\\n          if (active.current?.id !== id || event.queryId !== job.queryId) return;\\n          const p = event.payload;\\n          if (event.type === 'tool.started') update(id, m => ({ tools: [...m.tools, p.label ?? p.tool ?? 'Tool started'] }));\\n          if (event.type === 'tool.completed') update(id, m => ({ tools: [...m.tools, p.summary ?? 'Tool completed'] }));\\n          if (event.type === 'answer.delta') update(id, m => ({ text: m.text + (p.text ?? '') }));\\n          if (event.type === 'answer.completed') { completed.current = true; update(id, m => ({ status: 'complete', text: p.answer ?? m.text, modelId: p.modelId, modelRevision: p.modelRevision, inputTrace: p.inputTrace, modelOutput: typeof p.modelOutput === 'string' ? p.modelOutput : undefined, source: `${p.modelId ?? 'Assistant'} · completed`, evidence: (p.evidence ?? []).flatMap(evidenceFrom) })); }\\n          if (event.type === 'query.error') { completed.current = true; update(id, m => ({ status: 'error', text: `${m.text}${m.text ? '\\\\n\\\\n' : ''}${p.message ?? 'Inference failed.'}` })); }\\n          if (event.type === 'query.cancelled') { completed.current = true; update(id, { status: 'cancelled' }); }\\n        }, controller.signal);\\n      }\\n    } catch (error) {\\n      update(id, m => ({ status: controller.signal.aborted ? 'cancelled' : 'error', text: `${m.text}${m.text ? '\\\\n\\\\n' : ''}${controller.signal.aborted ? 'Stopped. This answer is incomplete.' : error instanceof Error ? error.message : 'The request failed.'}` }));\\n    } finally { if (active.current?.id === id) { active.current = null; setBusy(false); } }\\n  }\\n  function exportReport(message: Message) {\\n    try { downloadInvestigationMarkdown(message.telemetry, datasetId, message); setExportStatus('Readable investigation report downloaded as Markdown.'); }\\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The report could not be exported.'); }\\n  }\\n  function exportEvidence(message: Message) {\\n    try { downloadInvestigationJson(message.telemetry, datasetId, message); setExportStatus('Machine-readable evidence downloaded as JSON.'); }\\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The evidence could not be exported.'); }\\n  }\\n  async function stop() {\\n    const job = active.current; if (!job) return;\\n    job.controller.abort();\\n    if (job.queryId) { try { await services.cancelQuery(job.queryId); } catch { update(job.id, { status: 'error', text: 'The browser stopped listening, but server cancellation could not be confirmed.' }); } }\\n  }\\n  return <section className=\\\"assistant-panel\\\" aria-label=\\\"Telemetry assistant\\\">\\n    <header className=\\\"panel-heading\\\"><div className=\\\"assistant-title\\\"><MessageSquare size={16}/><h2>Event investigation</h2></div><span className=\\\"assistant-capability\\\">{checkpointLabel(registry.models.find(m => m.id === 'assistant')?.revision).split(' · ')[0]}</span></header>\\n    <div className=\\\"model-input-status\\\"><div><strong className=\\\"mono\\\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\\\"btn btn-primary\\\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\\n    {windowIssue && <div className=\\\"input-guidance\\\"><p>{windowIssue}</p>{rawError && <button className=\\\"text-button\\\" onClick={onRetryRaw}>Retry raw window</button>}{!rawLoading && !rawError && fittedWindow && <button className=\\\"text-button\\\" disabled={busy} onClick={() => onModelWindow(fittedWindow)}>Use 1.024 s window</button>}</div>}\\n    <div className=\\\"conversation\\\" ref={body} aria-live=\\\"polite\\\">\\n      {!messages.length && <div className=\\\"conversation-intro\\\"><Waves size={26}/><h3>Prepare a reviewable incident handoff.</h3><p>Analyze the incident, verify the prediction against exact signals, then export the handoff for a controls engineer.</p><p className=\\\"intro-limit\\\">Recorded torque can guide investigation. It cannot verify a physical cause.</p></div>}\\n      {messages.map(m => {\\n        const brief = predictionBrief(m.modelOutput);\\n        const cue = m.status === 'complete' ? predictionCue(m.modelOutput, m.interval) : undefined;\\n        const review = m.status === 'complete' ? reviewPrediction(m.telemetry, m.interval, m.modelOutput) : undefined;\\n        const measuredText = m.text.split(/\\\\n\\\\s*\\\\n/).find(block => block.startsWith('Measured in this selected window'))?.split('\\\\n').slice(1).join(' ');\\n        return <article className=\\\"conversation-turn\\\" key={m.id}>\\n          <div className=\\\"user-question\\\"><div><p>{m.question}</p><small className=\\\"mono\\\">{intervalLabel(m.interval)}</small></div></div>\\n          <div className=\\\"assistant-answer\\\"><div>\\n            {m.status !== 'complete' && <div className=\\\"answer-source\\\">{m.status === 'running' ? 'Reading the selected telemetry…' : m.status}</div>}\\n            <div className={m.status === 'error' ? 'error-message' : ''}>\\n              {brief ? <><section className=\\\"prediction-summary\\\"><h3>{brief.title}</h3><div className=\\\"prediction-facts\\\">{brief.strongest && <span>Predicted strongest joint <strong>{brief.strongest}</strong></span>}{brief.onset !== undefined && <span>Predicted onset <strong>{brief.onset} ms</strong> into the window</span>}</div><p className=\\\"prediction-caution\\\">OpenTSLM prediction · not a verified physical diagnosis.</p></section>{measuredText && <section className=\\\"measured-summary\\\"><h3>Measured torque</h3><p>{measuredText}</p></section>}{review && <section className=\\\"review-note\\\"><h3>Cross-check</h3><p>{review.note}</p></section>}</> : m.text ? <AnswerText text={m.text}/> : null}\\n            </div>\\n            {m.status === 'complete' && <section className=\\\"investigation-next\\\" aria-label=\\\"Verify and hand off\\\"><h3>Verify and hand off</h3><ol className=\\\"investigation-actions\\\">\\n              {cue && <li><button onClick={() => onRobotPrediction(cue)}><span>1</span><strong>Show generated onset cue in 3D</strong><ArrowUpRight size={12}/></button></li>}\\n              {m.evidence.map((e, i) => <li key={i}><button onClick={() => onEvidence(e)}><span>{cue ? 2 : 1}</span><strong>Inspect exact seven-channel input</strong><SlidersHorizontal size={12}/></button></li>)}\\n              <li><button onClick={() => onCompare(m.interval)}><span>{cue ? 3 : m.evidence.length ? 2 : 1}</span><strong>Compare with a reference window · optional</strong><ArrowUpRight size={12}/></button></li>\\n              <li><button onClick={() => exportReport(m)}><span>{cue ? 4 : m.evidence.length ? 3 : 2}</span><strong>Export incident handoff (.md)</strong><Download size={13}/></button></li>\\n            </ol></section>}\\n            {m.status === 'complete' && m.mode === 'assistant' && <details className=\\\"input-receipt\\\"><summary>Model &amp; input details</summary><p>{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s</p><details><summary>Structured model prediction</summary><p>Only supported prediction fields are shown here. Generated evidence prose is retained only in the audit JSON and is not treated as an annotation or measurement.</p><pre>{JSON.stringify(structuredPrediction(m.modelOutput) ?? { status: 'No valid structured prediction was returned.' }, null, 2)}</pre></details><details><summary>1,024-sample input receipt</summary><pre>{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}</pre><p>{m.modelRevision}</p></details>{m.tools.length > 0 && <details className=\\\"tool-log\\\"><summary>{m.tools.length} completed tool steps</summary>{m.tools.map((t, i) => <p key={i}>{t}</p>)}</details>}<button className=\\\"text-button\\\" onClick={() => exportEvidence(m)}><Download size={12}/>Download audit JSON</button></details>}\\n            {(m.status === 'error' || m.status === 'cancelled') && <button className=\\\"text-button\\\" disabled={busy} onClick={() => { setQuestion(m.question); }}><RotateCcw size={12}/>Use this question again</button>}\\n          </div></div>\\n        </article>;\\n      })}\\n    </div>\\n    {exportStatus && <p className=\\\"report-status\\\" role=\\\"status\\\">{exportStatus}</p>}\\n    {mode === 'assistant' && !assistantAvailable && <p className=\\\"status-note\\\" role=\\\"status\\\">Model unavailable. Open custom analysis and choose Measurements only.</p>}\\n    <details className=\\\"custom-analysis\\\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\\\"composer\\\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\\\"sr-only\\\" htmlFor=\\\"question\\\">Ask about the selected telemetry</label><textarea id=\\\"question\\\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\\\"Ask about this interval…\\\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\\\"composer-bottom\\\"><label className=\\\"mode-select\\\"><Cpu size={13}/><select aria-label=\\\"Analysis mode\\\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\\\"assistant\\\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\\\"local\\\">Measurements only</option></select></label>{busy ? <button className=\\\"send-button\\\" type=\\\"button\\\" aria-label=\\\"Stop analysis\\\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\\\"send-button\\\" type=\\\"submit\\\" aria-label=\\\"Send question\\\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\\n  </section>;\\n}\\nfrontend/src/styles.css:245:.model-input-status { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); }\\nfrontend/src/styles.css:246:.model-input-status > div { display: grid; gap: 5px; }\\nfrontend/src/styles.css:247:.model-input-status strong { font-size: 14px; font-weight: 500; }\\nfrontend/src/styles.css:248:.model-input-status span { font-size: 12px; color: var(--quiet); }\\nfrontend/src/styles.css:249:.model-input-status .btn { min-height: 38px; padding-inline: 14px; }\\nfrontend/src/styles.css:288:  .model-input-status, .assistant-panel > .panel-heading, .conversation { padding-inline: 18px; }\\nfrontend/src/styles.css:317:  .model-input-status { padding: 14px 18px; gap: 8px; }\\nfrontend/src/styles.css:318:  .model-input-status strong { font-size: 13px; }\\nfrontend/src/styles.css:319:  .model-input-status span { font-size: 11px; }\\nfrontend/src/styles.css:320:  .model-input-status .btn { font-size: 12px; }\\nfrontend/src/assistant/AssistantPanel.tsx:98:    <div className=\\\"model-input-status\\\"><div><strong className=\\\"mono\\\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\\\"btn btn-primary\\\" disabled={busy || !assistantAvailable || Boolean(windowIssue)} onClick={() => { setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{busy ? 'Analyzing…' : 'Analyze interval'}</button></div>\\nfrontend/src/assistant/AssistantPanel.tsx:128:    <details className=\\\"custom-analysis\\\" open={busy || undefined}><summary>Ask a custom question</summary><form className=\\\"composer\\\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\\\"sr-only\\\" htmlFor=\\\"question\\\">Ask about the selected telemetry</label><textarea id=\\\"question\\\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\\\"Ask about this interval…\\\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\\\"composer-bottom\\\"><label className=\\\"mode-select\\\"><Cpu size={13}/><select aria-label=\\\"Analysis mode\\\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\\\"assistant\\\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\\\"local\\\">Measurements only</option></select></label>{busy ? <button className=\\\"send-button\\\" type=\\\"button\\\" aria-label=\\\"Stop analysis\\\" onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\\\"send-button\\\" type=\\\"submit\\\" aria-label=\\\"Send question\\\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\\n\"}"}],"internal_chat_me