654 frontend/public/robot/kuka/positions.json\n2473011 frontend/public/robot/kuka/positions-05-28-20-57.json\n2472672 frontend/public/robot/kuka/positions-05-28-21-02.json\n2471809 frontend/public/robot/kuka/positions-05-28-21-15.json\n2471659 frontend/public/robot/kuka/positions-04-22-15-53.json\n2471125 frontend/public/robot/kuka/positions-05-28-21-07.json\n2442003 frontend/public/robot/kuka/positions-03-22-11-18.json\n1986137 inference/demo_data/03-15-12-53.json.gz\n1607565 inference/demo_data/05-26-14-28.json.gz\n1603055 inference/demo_data/04-22-15-53.json.gz\n1601380 inference/demo_data/04-22-15-33.json.gz\n1587948 inference/demo_data/03-22-11-18.json.gz\n1587490 frontend/public/data/kuka-demo.json\n1460275 docs/submission/evaluation/source/test-records.jsonl.gz\n434949 data_ingestion/outputs/kuka_contact_part2_profile.json\n419379 data_ingestion/outputs/dataset_profile.json\n239866 data_sourcing/uv.lock\n","exit_code":0,"duration":{"secs":0,"nanos":350327542},"formatted_output":"3341813 frontend/public/robot/kuka/positions-03-15-12-53.json\n2488773 frontend/public/robot/kuka/positions-04-22-15-33.json\n2487296 frontend/public/robot/kuka/positions-05-26-14-28.json\n2474654 frontend/public/robot/kuka/positions.json\n2473011 frontend/public/robot/kuka/positions-05-28-20-57.json\n2472672 frontend/public/robot/kuka/positions-05-28-21-02.json\n2471809 frontend/public/robot/kuka/positions-05-28-21-15.json\n2471659 frontend/public/robot/kuka/positions-04-22-15-53.json\n2471125 frontend/public/robot/kuka/positions-05-28-21-07.json\n2442003 frontend/public/robot/kuka/positions-03-22-11-18.json\n1986137 inference/demo_data/03-15-12-53.json.gz\n1607565 inference/demo_data/05-26-14-28.json.gz\n1603055 inference/demo_data/04-22-15-53.json.gz\n1601380 inference/demo_data/04-22-15-33.json.gz\n1587948 inference/demo_data/03-22-11-18.json.gz\n1587490 frontend/public/data/kuka-demo.json\n1460275 docs/submission/evaluation/source/test-records.jsonl.gz\n434949 data_ingestion/outp