ls[{index}]\"\n@@ -114,7 +139,9 @@ def validate_dataset_spec(profile: DatasetProfile, spec: DatasetSpec) -> Validat\n             add(\"CHANNEL_MAPPING_COUNT_MISMATCH\", f\"{path}.channels\",\n                 \"Channel count, source indices, and target names must have equal lengths.\")\n         shapes = summary.get(\"observed_shapes\", [])\n-        row_counts = {shape[0] for shape in shapes if shape}\n+        channel_axis = summary.get(\"channel_axis\", 0)\n+        row_counts = {shape[channel_axis] for shape in shapes\n+                      if shape and channel_axis is not None and channel_axis < len(shape)}\n         source_indices = signal.channels.source_indices\n         if (len(set(source_indices)) != len(source_indices)\n                 or any(index < 0 or any(index >= rows for rows in row_counts)\n@@ -123,25 +150,43 @@ def validate_dataset_spec(profile: DatasetProfile, spec: DatasetSpec) -> Validat\n                 \"Source channel indices must be unique and within every observed matrix shape.\",\n                 source_indices=source_indices, observed_row_counts=sorted(row_counts))\n         observed_dtypes = summary.get(\"observed_dtypes\", [])\n-        if signal.dtype not in observed_dtypes:\n+        if spec.schema_version == \"0.2\":\n+            claimed_dtypes = list(signal.observed_dtypes)\n+            if signal.dtype is not None:\n+                add(\"INVALID_DTYPE_REPRESENTATION\", f\"{path}.dtype\",\n+                    \"DatasetSpec v0.2 represents physical storage types in observed_dtypes.\")\n+            if len(set(claimed_dtypes)) != len(claimed_dtypes):\n+                add(\"DUPLICATE_OBSERVED_DTYPE\", f\"{path}.observed_dtypes\",\n+                    \"Observed dtype values must be unique.\")\n+            if set(claimed_dtypes) != set(observed_dtypes):\n+                add(\"DTYPE_SET_MISMATCH\", f\"{path}.observed_dtypes\",\n+                    \"Claimed physical dtypes do not match the profiled dtype set.\",\n+                    claimed=sorted(set(claimed_dtypes)), observed=sorted(set(observed_dtypes)))\n+        elif signal.dtype not in observed_dtypes:\n             add(\"DTYPE_MISMATCH\", f\"{path}.dtype\",\n                 f\"Claimed dtype {signal.dtype!r} is not among observed dtypes {observed_dtypes!r}.\")\n         if signal.sampling.time_axis not in axes:\n             add(\"UNKNOWN_TIME_AXIS\", f\"{path}.sampling.time_axis\",\n                 f\"Time axis {signal.sampling.time_axis!r} is not declared.\")\n-        if signal.sampling.rate_hz is not None:\n+        if spec.schema_version == \"0.2\" and signal.sampling.rate_hz is not None:\n+            add(\"LEGACY_SAMPLING_RATE\", f\"{path}.sampling.rate_hz\",\n+                \"DatasetSpec v0.2 stores sampling-rate provenance on the referenced time axis.\")\n+        elif signal.sampling.rate_hz is not None:\n             bad_rates = [rate for rate in run_rates if rate is None or not isclose(\n                 rate, signal.sampling.rate_hz, rel_tol=1e-9, abs_tol=1e-9)]\n             if bad_rates:\n                 add(\"SAMPLING_RATE_MISMATCH\", f\"{path}.sampling.rate_hz\",\n                     f\"Claimed {signal.sampling.rate_hz} Hz does not match every run.\",\n                     claimed=signal.sampling.rate_hz, observed=run_rates)\n-        signal_lengths = {shape[-1] for shape in shapes if shape}\n+        sample_axis = summary.get(\"sample_axis\", -1)\n+        signal_lengths = {shape[sample_axis] for shape in shapes\n+                          if shape and sample_axis is not None and abs(sample_axis) < len(shape)}\n         if sequence_lengths and signal_lengths != sequence_lengths:\n             add(\"SEQUENCE_LENGTH_MISMATCH\", f\"{path}.source_variable\",\n                 \"Signal sample dimensions do not match profiled run sequence lengths.\",\n                 signal_lengths=sorted(signal_lengths), run_lengths=sorted(sequence_lengths))\n-        _check_claim(signal.unit.resolution, f\"{path}.unit.resolution\", add)\n+        _check_claim(signal.unit.resolution, f\"{path}.unit.resolution\", add,\n+                     strict_evidence_refs=strict_evidence_refs, evidence_ids=evidence_ids)\n         if signal.unit.resolution.status is EvidenceStatus.UNRESOLVED:\n             if signal.unit.name is not None or signal.unit.symbol is not None:\n                 add(\"INVALID_UNIT_CLAIM\", f\"{path}.unit\",\n@@ -161,7 +206,8 @@ def validate_dataset_spec(profile: DatasetProfile, spec: DatasetSpec) -> Validat\n                     add(\"UNIT_MISMATCH\", f\"{path}.unit.name\",\n                         \"Claimed unit does not match the unit observed in DatasetProfile.\",\n                         claimed=signal.unit.name, observed=observed_unit)\n-        _check_claim(signal.semantics, f\"{path}.semantics\", add)\n+        _check_claim(signal.semantics, f\"{path}.semantics\", add,\n+                     strict_evidence_refs=strict_evidence_refs, evidence_ids=evidence_ids)\n \n     for index, event_mapping in enumerate(spec.events):\n         path = f\"events[{index}]\"\n@@ -202,7 +248,8 @@ def validate_dataset_spec(profile: DatasetProfile, spec: DatasetSpec) -> Validat\n                             f\"Event {event.event_id!r} timestamp disagrees with its converted index.\",\n                             source_run_id=run.source_run_id, converted_index=python_index,\n                             expected=expected, observed=event.inferred_time_seconds)\n-        _check_claim(event_mapping.semantics, f\"{path}.semantics\", add)\n+        _check_claim(event_mapping.semantics, f\"{path}.semantics\", add,\n+                     strict_evidence_refs=strict_evidence_refs, evidence_ids=evidence_ids)\n \n     available = {\n         \"source_run_id\": all(bool(run.source_run_id) for run in profile.runs),\n@@ -229,7 +276,9 @@ def _check_reference(name: str, role: VariableRole, path: str,\n             f\"Source variable {name!r} is declared as {variable.role.value}, expected {role.value}.\")\n \n \n-def _check_claim(claim: EvidenceClaim, path: str, add: Any) -> None:\n+def _check_claim(claim: EvidenceClaim, path: str, add: Any,\n+                 *, strict_evidence_refs: bool = False,\n+                 evidence_ids: set[str] | None = None) -> None:\n     if claim.status in {EvidenceStatus.DOCUMENTED, EvidenceStatus.INFERRED}:\n         if claim.confidence is None or not claim.evidence:\n             add(\"MISSING_EVIDENCE_REFERENCE\", path,\n@@ -237,10 +286,56 @@ def _check_claim(claim: EvidenceClaim, path: str, add: Any) -> None:\n         elif any(not reference.strip() for reference in claim.evidence):\n             add(\"INVALID_EVIDENCE_CLAIM\", path,\n                 \"Evidence references must be non-empty strings.\")\n+        elif strict_evidence_refs and claim.status is EvidenceStatus.DOCUMENTED and not any(\n+                reference.startswith(\"ev_documentation_\") for reference in claim.evidence):\n+            add(\"INVALID_DOCUMENTATION_EVIDENCE\", path,\n+                \"Documented claims require at least one documentation evidence ID.\")\n+        elif strict_evidence_refs and any(\n+                not reference.startswith(\"ev_\") for reference in claim.evidence):\n+            add(\"INVALID_EVIDENCE_REFERENCE\", path,\n+                \"Claims require evidence IDs returned by the bounded evidence session.\")\n+        elif evidence_ids is not None and any(\n+                reference not in evidence_ids for reference in claim.evidence):\n+            add(\"UNKNOWN_EVIDENCE_REFERENCE\", path,\n+                \"Claim references were not returned by this bounded evidence run.\")\n     if claim.status is EvidenceStatus.UNRESOLVED and claim.confidence is not None:\n         add(\"INVALID_EVIDENCE_CLAIM\", path,\n             \"Unresolved claims must not declare confidence.\")\n \n \n+def _validate_sampling_rate(claim: SamplingRateClaim | None, *, run_rates: list[float | None],\n+                            path: str, add: Any, strict_evidence_refs: bool,\n+                            evidence_ids: set[str] | None) -> None:\n+    if claim is None:\n+        add(\"MISSING_SAMPLING_RATE\", path,\n+            \"An implicit regular clock requires a sampling-rate claim.\")\n+        return\n+    _check_claim(claim.resolution, f\"{path}.resolution\", add,\n+                 strict_evidence_refs=strict_evidence_refs, evidence_ids=evidence_ids)\n+    if claim.resolution.status is EvidenceStatus.UNRESOLVED:\n+        if claim.value is not None:\n+            add(\"INVALID_SAMPLING_RATE_CLAIM\", f\"{path}.value\",\n+                \"An unresolved sampling rate must have a null value.\")\n+        return\n+    if claim.value is None or claim.value <= 0:\n+        add(\"INVALID_SAMPLING_RATE\", f\"{path}.value\",\n+            \"A resolved sampling rate must be positive.\")\n+        return\n+    if claim.unit.casefold() not in {\"hz\", \"hertz\"}:\n+        add(\"INVALID_SAMPLING_RATE_UNIT\", f\"{path}.unit\",\n+            \"Sampling rate must use Hz or hertz.\")\n+    observed = [rate for rate in run_rates if rate is not None]\n+    contradictions = [rate for rate in observed\n+                      if not isclose(rate, claim.value, rel_tol=1e-9, abs_tol=1e-9)]\n+    if contradictions:\n+        add(\"SAMPLING_RATE_CONTRADICTION\", f\"{path}.value\",\n+            \"The claimed sampling rate contradicts deterministic observations.\",\n+            claimed=claim.value, observed=sorted(set(observed)))\n+    if (claim.resolution.status is EvidenceStatus.OBSERVED\n+            and (not observed or len(observed) != len(run_rates))):\n+        add(\"SAMPLING_RATE_NOT_OBSERVED\", f\"{path}.resolution.status\",\n+            \"An observed sampling-rate claim requires a rate for every profiled run.\")\n+\n+\n def _normalized_text(value: str) -> str:\n     return \" \".join(re.findall(r\"[a-z0-9]+\", value.casefold()))\n"},"started_at_ms":1789265741366,"completed_at_ms":1789265741366}}
{"timestamp":"2026-09-13T02:15:41.368Z","ordinal":9500,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","item":{"type":"CommandExecution","id":"exec-7604d3ea-e35e-410d-8409-6f4368cd17bf","process_id":"70485","command":["/bin/zsh","-lc","git diff db68e6c..origin/main -- .gitignore data_ingestion/src/dataset_profiler/io/hdf5.py data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py | sed -n '1,700p'"],"cwd":"file:///Users/sametdegirmenci/Downloads/ysamet","parsed_cmd":[{"type":"unknown","cmd":"git diff db68e6c..origin/main -- .gitignore data_ingestion/src/dataset_profiler/io/hdf5.py data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py | sed -n '1,700p'"}],"source":"unified_exec_startup","status":"completed","stdout":"diff --git a/.gitignore b/.gitignore\nindex 60843c8..216e20c 100644\n--- a/.gitignore\n+++ b/.gitignore\n@@ -11,5 +11,5 @@ __pycache__/\n .pytest_cache/\n .ruff_cache/\n .coverage\n-.venv/\n+.venv*/\n data_sourcing/var/\ndiff --git a/data_ingestion/src/dataset_profiler/io/hdf5.py b/data_ingestion/src/dataset_profiler/io/hdf5.py\nnew file mode 100644\nindex 0000000..f3aae05\n--- /dev/null\n+++ b/data_ingestion/src/dataset_profiler/io/hdf5.py\n@@ -0,0 +1,309 @@\n+\"\"\"Bounded, streaming inspection helpers for generic HDF5 files.\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import dataclass\n+from pathlib import Path\n+from typing import Any, Iterator\n+import hashlib\n+import math\n+\n+import numpy as np\n+\n+try:\n+    import h5py\n+except ImportError:  # pragma: no cover - guarded by the optional hdf5 extra\n+    h5py = None\n+\n+from ..models import ChannelStats, FileProfile, VariableProfile\n+from .matlab import sha256_file\n+\n+\n+_MAX_ATTRIBUTE_VALUES = 32\n+_TARGET_CHUNK_ELEMENTS = 1_000_000\n+\n+\n+@dataclass(frozen=True)\n+class Hdf5Structure:\n+    \"\"\"Structural metadata that does not require exposing array contents.\"\"\"\n+\n+    root_attributes: dict[str, Any]\n+    groups: tuple[dict[str, Any], ...]\n+\n+\n+@dataclass\n+class _Moments:\n+    count: int = 0\n+    total: float = 0.0\n+    total_squares: float = 0.0\n+    minimum: float | None = None\n+    maximum: float | None = None\n+    nan_count: int = 0\n+    inf_count: int = 0\n+\n+    def update(self, values: np.ndarray) -> None:\n+        if np.issubdtype(values.dtype, np.inexact):\n+            self.nan_count += int(np.isnan(values).sum())\n+            self.inf_count += int(np.isinf(values).sum())\n+            finite = values[np.isfinite(values)]\n+        else:\n+            finite = values\n+        if not finite.size:\n+            return\n+        numeric = finite.astype(np.float64, copy=False)\n+        local_min = float(np.min(numeric))\n+        local_max = float(np.max(numeric))\n+        self.minimum = (\n+            local_min if self.minimum is None else min(self.minimum, local_min)\n+        )\n+        self.maximum = (\n+            local_max if self.maximum is None else max(self.maximum, local_max)\n+        )\n+        self.count += int(numeric.size)\n+        self.total += float(np.sum(numeric, dtype=np.float64))\n+        self.total_squares += float(np.sum(numeric * numeric, dtype=np.float64))\n+\n+    @property\n+    def mean(self) -> float | None:\n+        return self.total / self.count if self.count else None\n+\n+    @property\n+    def standard_deviation(self) -> float | None:\n+        if not self.count:\n+            return None\n+        mean = self.total / self.count\n+        return math.sqrt(max(0.0, self.total_squares / self.count - mean * mean))\n+\n+\n+def inspect_hdf5_file(\n+    path: str | Path,\n+    root: str | Path | None = None,\n+    source_run_id: str = \"\",\n+    first_value_count: int = 8,\n+) -> FileProfile:\n+    \"\"\"Inspect every dataset in an HDF5 file without materializing large arrays.\"\"\"\n+    _require_h5py()\n+    source = Path(path)\n+    base = Path(root) if root else source.parent\n+    variables: list[VariableProfile] = []\n+    with h5py.File(source, \"r\") as handle:\n+\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\n+            if isinstance(node, h5py.Dataset):\n+                variables.append(_inspect_dataset(name, node, first_value_count))\n+\n+        handle.visititems(visit)\n+    return FileProfile(\n+        relative_path=source.relative_to(base).as_posix(),\n+        source_run_id=source_run_id,\n+        format=\"hdf5\",\n+        size_bytes=source.stat().st_size,\n+        sha256=sha256_file(source),\n+        variables=variables,\n+        loader=\"h5py\",\n+    )\n+\n+\n+def inspect_hdf5_structure(path: str | Path) -> Hdf5Structure:\n+    \"\"\"Return bounded root/group attributes and group paths for one HDF5 file.\"\"\"\n+    _require_h5py()\n+    groups: list[dict[str, Any]] = []\n+    with h5py.File(path, \"r\") as handle:\n+        root_attributes = _attributes(handle.attrs)\n+\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\n+            if isinstance(node, h5py.Group):\n+                groups.append({\"path\": name, \"attributes\": _attributes(node.attrs)})\n+\n+        handle.visititems(visit)\n+    return Hdf5Structure(root_attributes, tuple(groups))\n+\n+\n+def read_hdf5_excerpt(\n+    path: str | Path,\n+    dataset_name: str,\n+    start: int,\n+    length: int,\n+    channels: tuple[int, ...],\n+    channel_axis: int | None,\n+) -> tuple[np.ndarray, str, int]:\n+    \"\"\"Load only a host-validated sample/channel window from an HDF5 dataset.\"\"\"\n+    _require_h5py()\n+    with h5py.File(path, \"r\") as handle:\n+        dataset = handle[dataset_name]\n+        if dataset.ndim not in {1, 2} or not np.issubdtype(dataset.dtype, np.number):\n+            raise ValueError(\n+                \"excerpt source is not a numeric one- or two-dimensional array\"\n+            )\n+        if dataset.ndim == 1:\n+            available_samples = dataset.shape[0]\n+            if channels != (0,):\n+                raise ValueError(\"one-dimensional datasets expose one logical channel\")\n+            excerpt = np.asarray(dataset[start : start + length]).reshape(1, -1)\n+        elif channel_axis == 1:\n+            available_samples = dataset.shape[0]\n+            excerpt = np.stack(\n+                [\n+                    np.asarray(dataset[start : start + length, channel])\n+                    for channel in channels\n+                ]\n+            )\n+        else:\n+            available_samples = dataset.shape[1]\n+            excerpt = np.stack(\n+                [\n+                    np.asarray(dataset[channel, start : start + length])\n+                    for channel in channels\n+                ]\n+            )\n+        if start + length > available_samples:\n+            raise ValueError(\"requested excerpt exceeds the available samples\")\n+        return excerpt, str(dataset.dtype), available_samples\n+\n+\n+def _inspect_dataset(\n+    name: str, dataset: h5py.Dataset, first_value_count: int\n+) -> VariableProfile:\n+    numeric = np.issubdtype(dataset.dtype, np.number)\n+    overall = _Moments()\n+    channel_axis = _channel_axis(dataset.shape) if numeric else None\n+    channel_moments = (\n+        [_Moments() for _ in range(dataset.shape[channel_axis])]\n+        if channel_axis is not None\n+        else []\n+    )\n+    digest = hashlib.sha256()\n+    first_values: list[Any] = []\n+    for values in _chunks(dataset):\n+        contiguous = np.ascontiguousarray(values)\n+        digest.update(contiguous.tobytes(order=\"C\"))\n+        if len(first_values) < first_value_count:\n+            remaining = first_value_count - len(first_values)\n+            first_values.extend(\n+                _json_scalar(value) for value in contiguous.flat[:remaining]\n+            )\n+        if numeric:\n+            overall.update(contiguous)\n+            if channel_axis is not None:\n+                for index, moments in enumerate(channel_moments):\n+                    moments.update(np.take(contiguous, index, axis=channel_axis))\n+\n+    metadata: dict[str, Any] = {\n+        \"hdf5_attributes\": _attributes(dataset.attrs),\n+        \"numeric_statistics\": {\n+            \"sample_count\": overall.count,\n+            \"mean\": overall.mean,\n+            \"standard_deviation\": overall.standard_deviation,\n+        }\n+        if numeric\n+        else None,\n+        \"structural_axes\": {\n+            \"sample_axis\": _sample_axis(dataset.shape),\n+            \"channel_axis\": channel_axis,\n+        },\n+    }\n+    return VariableProfile(\n+        name=name,\n+        python_type=\"h5py.Dataset\",\n+        shape=list(dataset.shape),\n+        dtype=str(dataset.dtype),\n+        ndim=dataset.ndim,\n+        size=int(dataset.size),\n+        minimum=overall.minimum,\n+        maximum=overall.maximum,\n+        nan_count=overall.nan_count,\n+        inf_count=overall.inf_count,\n+        first_values=first_values,\n+        channel_stats=[\n+            _channel_stats(index, moments)\n+            for index, moments in enumerate(channel_moments)\n+        ],\n+        content_sha256=digest.hexdigest(),\n+        nested_structure=metadata,\n+    )\n+\n+\n+def _chunks(dataset: h5py.Dataset) -> Iterator[np.ndarray]:\n+    if dataset.size == 0:\n+        return\n+    if dataset.ndim == 0:\n+        yield np.asarray(dataset[()])\n+        return\n+    trailing = math.prod(dataset.shape[1:]) or 1\n+    rows = max(1, _TARGET_CHUNK_ELEMENTS // trailing)\n+    for start in range(0, dataset.shape[0], rows):\n+        yield np.asarray(dataset[start : min(dataset.shape[0], start + rows)])\n+\n+\n+def _sample_axis(shape: tuple[int, ...]) -> int | None:\n+    if not shape:\n+        return None\n+    return max(range(len(shape)), key=lambda index: shape[index])\n+\n+\n+def _channel_axis(shape: tuple[int, ...]) -> int | None:\n+    if len(shape) != 2 or 0 in shape:\n+        return None\n+    sample_axis = _sample_axis(shape)\n+    return 1 - sample_axis if sample_axis is not None else None\n+\n+\n+def _channel_stats(index: int, moments: _Moments) -> ChannelStats:\n+    span = (\n+        moments.maximum - moments.minimum\n+        if moments.minimum is not None and moments.maximum is not None\n+        else None\n+    )\n+    scale = max(abs(moments.minimum or 0), abs(moments.maximum or 0), 1.0)\n+    return ChannelStats(\n+        index=index,\n+        count=moments.count + moments.nan_count + moments.inf_count,\n+        minimum=moments.minimum,\n+        maximum=moments.maximum,\n+        mean=moments.mean,\n+        standard_deviation=moments.standard_deviation,\n+        nan_count=moments.nan_count,\n+        inf_count=moments.inf_count,\n+        constant=bool(span == 0),\n+        near_constant=bool(span is not None and span <= 1e-12 * scale),\n+    )\n+\n+\n+def _attributes(attributes: h5py.AttributeManager) -> dict[str, Any]:\n+    return {\n+        str(name): _bounded_value(value) for name, value in sorted(attributes.items())\n+    }\n+\n+\n+def _bounded_value(value: Any) -> Any:\n+    array = np.asarray(value)\n+    values = [_json_scalar(item) for item in array.reshape(-1)[:_MAX_ATTRIBUTE_VALUES]]\n+    if array.ndim == 0:\n+        return values[0] if values else None\n+    return {\n+        \"shape\": list(array.shape),\n+        \"dtype\": str(array.dtype),\n+        \"values\": values,\n+        \"truncated\": array.size > _MAX_ATTRIBUTE_VALUES,\n+    }\n+\n+\n+def _json_scalar(value: Any) -> Any:\n+    if isinstance(value, np.generic):\n+        value = value.item()\n+    if isinstance(value, bytes):\n+        return value.decode(\"utf-8\", errors=\"replace\")\n+    if isinstance(value, complex):\n+        return {\"real\": value.real, \"imag\": value.imag}\n+    if isinstance(value, float) and not np.isfinite(value):\n+        return \"NaN\" if np.isnan(value) else (\"Infinity\" if value > 0 else \"-Infinity\")\n+    return (\n+        value\n+        if isinstance(value, (str, int, float, bool)) or value is None\n+        else repr(value)\n+    )\n+\n+\n+def _require_h5py() -> None:\n+    if h5py is None:\n+        raise RuntimeError(\"HDF5 support requires the optional 'hdf5' extra\")\ndiff --git a/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\nnew file mode 100644\nindex 0000000..558252e\n--- /dev/null\n+++ b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\n@@ -0,0 +1,364 @@\n+\"\"\"Human-approved implementation decisions layered over immutable semantic specs.\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import asdict, dataclass\n+import hashlib\n+import json\n+from pathlib import Path\n+import re\n+from typing import Any\n+\n+from .models import DatasetSpec, EvidenceClaim, EvidenceStatus\n+\n+\n+HUMAN_CONFIRMATION = \"human_confirmation\"\n+_FIELD_TOKEN = re.compile(r\"([A-Za-z_][A-Za-z0-9_]*)(?:\\[([0-9]+)\\])?\")\n+\n+\n+class ImplementationHandoffError(ValueError):\n+    \"\"\"Report an invalid downstream requirement or implementation override.\"\"\"\n+\n+\n+@dataclass(frozen=True)\n+class DownstreamRequirement:\n+    \"\"\"Describe one semantic value required by a downstream interface.\"\"\"\n+\n+    field_path: str\n+    downstream_system: str\n+    requirement: str\n+    best_supported_candidate: Any = None\n+    supporting_evidence_refs: tuple[str, ...] = ()\n+    remaining_uncertainty: str | None = None\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> DownstreamRequirement:\n+        return cls(\n+            field_path=raw[\"field_path\"],\n+            downstream_system=raw[\"downstream_system\"],\n+            requirement=raw[\"requirement\"],\n+            best_supported_candidate=raw.get(\"best_supported_candidate\"),\n+            supporting_evidence_refs=tuple(raw.get(\"supporting_evidence_refs\", ())),\n+            remaining_uncertainty=raw.get(\"remaining_uncertainty\"),\n+        )\n+\n+\n+@dataclass(frozen=True)\n+class BlockingUnresolvedField:\n+    \"\"\"Expose an unresolved semantic field that prevents implementation.\"\"\"\n+\n+    field_path: str\n+    semantic_resolution: str\n+    semantic_value: Any\n+    downstream_system: str\n+    requirement: str\n+    best_supported_candidate: Any\n+    supporting_evidence_refs: tuple[str, ...]\n+    remaining_uncertainty: str | None\n+\n+\n+@dataclass(frozen=True)\n+class ImplementationOverride:\n+    \"\"\"Record an approved downstream value that is not semantic evidence.\"\"\"\n+\n+    override_id: str\n+    field_path: str\n+    value: Any\n+    source: str\n+    approved_by: str\n+    rationale: str\n+    downstream_system: str\n+    evidence_refs: tuple[str, ...] = ()\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverride:\n+        return cls(\n+            override_id=raw[\"override_id\"],\n+            field_path=raw[\"field_path\"],\n+            value=raw.get(\"value\"),\n+            source=raw.get(\"source\", \"\"),\n+            approved_by=raw.get(\"approved_by\", \"\"),\n+            rationale=raw.get(\"rationale\", \"\"),\n+            downstream_system=raw.get(\"downstream_system\", \"\"),\n+            evidence_refs=tuple(raw.get(\"evidence_refs\", ())),\n+        )\n+\n+\n+@dataclass(frozen=True)\n+class ImplementationOverrideArtifact:\n+    \"\"\"Bind decisions and requirements to one semantic-spec snapshot.\"\"\"\n+\n+    schema_version: str\n+    dataset_id: str\n+    semantic_spec_sha256: str\n+    requirements: tuple[DownstreamRequirement, ...]\n+    overrides: tuple[ImplementationOverride, ...]\n+    downstream_context: dict[str, Any] | None = None\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    def to_json(self, *, indent: int = 2) -> str:\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \"\\n\"\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverrideArtifact:\n+        if raw.get(\"schema_version\") != \"1.0\":\n+            raise ImplementationHandoffError(\n+                \"unsupported implementation-override schema_version; expected '1.0'\"\n+            )\n+        return cls(\n+            schema_version=\"1.0\",\n+            dataset_id=raw[\"dataset_id\"],\n+            semantic_spec_sha256=raw[\"semantic_spec_sha256\"],\n+            requirements=tuple(\n+                DownstreamRequirement.from_dict(item)\n+                for item in raw.get(\"requirements\", ())\n+            ),\n+            overrides=tuple(\n+                ImplementationOverride.from_dict(item)\n+                for item in raw.get(\"overrides\", ())\n+            ),\n+            downstream_context=raw.get(\"downstream_context\"),\n+        )\n+\n+    @classmethod\n+    def read_json(cls, path: str | Path) -> ImplementationOverrideArtifact:\n+        raw = json.loads(Path(path).read_text(encoding=\"utf-8\"))\n+        if not isinstance(raw, dict):\n+            raise ImplementationHandoffError(\n+                \"implementation-override JSON root must be an object\"\n+            )\n+        return cls.from_dict(raw)\n+\n+\n+@dataclass(frozen=True)\n+class ConnectorHandoff:\n+    \"\"\"Connector view with semantic truth and decisions kept separate.\"\"\"\n+\n+    schema_version: str\n+    dataset_id: str\n+    semantic_spec_sha256: str\n+    semantic_spec: dict[str, Any]\n+    blocking_unresolved_fields: tuple[BlockingUnresolvedField, ...]\n+    implementation_overrides: tuple[ImplementationOverride, ...]\n+    implementation_view: dict[str, dict[str, Any]]\n+    downstream_context: dict[str, Any] | None\n+    connector_ready: bool\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    def to_json(self, *, indent: int = 2) -> str:\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \"\\n\"\n+\n+    def write_json(self, path: str | Path) -> None:\n+        Path(path).write_text(self.to_json(), encoding=\"utf-8\")\n+\n+\n+def semantic_spec_sha256(spec: DatasetSpec) -> str:\n+    \"\"\"Return the stable digest binding decisions to a semantic snapshot.\"\"\"\n+    return hashlib.sha256(spec.to_json().encode()).hexdigest()\n+\n+\n+def detect_blocking_unresolved_fields(\n+    spec: DatasetSpec,\n+    requirements: tuple[DownstreamRequirement, ...],\n+) -> tuple[BlockingUnresolvedField, ...]:\n+    \"\"\"Return downstream-required fields whose semantic status is unresolved.\"\"\"\n+    blockers = []\n+    seen: set[str] = set()\n+    for requirement in requirements:\n+        _validate_requirement(requirement)\n+        if requirement.field_path in seen:\n+            raise ImplementationHandoffError(\n+                f\"duplicate downstream requirement for {requirement.field_path!r}\"\n+            )\n+        seen.add(requirement.field_path)\n+        target = _resolve_field(spec, requirement.field_path)\n+        claim = _resolution_claim(target, requirement.field_path)\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\n+            continue\n+        blockers.append(\n+            BlockingUnresolvedField(\n+                field_path=requirement.field_path,\n+                semantic_resolution=claim.status.value,\n+                semantic_value=_json_value(target),\n+                downstream_system=requirement.downstream_system,\n+                requirement=requirement.requirement,\n+                best_supported_candidate=requirement.best_supported_candidate,\n+                supporting_evidence_refs=requirement.supporting_evidence_refs,\n+                remaining_uncertainty=requirement.remaining_uncertainty,\n+            )\n+        )\n+    return tuple(blockers)\n+\n+\n+def build_connector_handoff(\n+    spec: DatasetSpec,\n+    artifact: ImplementationOverrideArtifact,\n+    *,\n+    evidence_ids: set[str] | None = None,\n+) -> ConnectorHandoff:\n+    \"\"\"Validate overrides and build a deterministic connector-facing view.\"\"\"\n+    digest = semantic_spec_sha256(spec)\n+    if artifact.dataset_id != spec.identity.dataset_id:\n+        raise ImplementationHandoffError(\n+            f\"override dataset_id {artifact.dataset_id!r} does not match \"\n+            f\"{spec.identity.dataset_id!r}\"\n+        )\n+    if artifact.semantic_spec_sha256 != digest:\n+        raise ImplementationHandoffError(\n+            \"override artifact targets a different semantic-spec snapshot\"\n+        )\n+\n+    blockers = detect_blocking_unresolved_fields(spec, artifact.requirements)\n+    if evidence_ids is not None and any(\n+        reference not in evidence_ids\n+        for requirement in artifact.requirements\n+        for reference in requirement.supporting_evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"downstream requirement references evidence absent from the bounded evidence run\"\n+        )\n+    requirements = {item.field_path: item for item in artifact.requirements}\n+    overrides: dict[str, ImplementationOverride] = {}\n+    override_ids: set[str] = set()\n+    for override in artifact.overrides:\n+        if override.field_path in overrides:\n+            raise ImplementationHandoffError(\n+                f\"duplicate or conflicting overrides for {override.field_path!r}\"\n+            )\n+        if override.override_id in override_ids:\n+            raise ImplementationHandoffError(\n+                f\"duplicate implementation override id {override.override_id!r}\"\n+            )\n+        requirement = requirements.get(override.field_path)\n+        if requirement is None:\n+            raise ImplementationHandoffError(\n+                f\"override field {override.field_path!r} has no downstream requirement\"\n+            )\n+        target = _resolve_field(spec, override.field_path)\n+        claim = _resolution_claim(target, override.field_path)\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\n+            raise ImplementationHandoffError(\n+                f\"field {override.field_path!r} is {claim.status.value}, not unresolved; \"\n+                \"an implementation override cannot replace semantic truth\"\n+            )\n+        _validate_override(override, requirement, evidence_ids)\n+        overrides[override.field_path] = override\n+        override_ids.add(override.override_id)\n+\n+    implementation_view = {\n+        path: {\n+            \"value\": override.value,\n+            \"value_source\": override.source,\n+            \"override_id\": override.override_id,\n+            \"semantic_resolution\": \"unresolved\",\n+        }\n+        for path, override in sorted(overrides.items())\n+    }\n+    unresolved_paths = {item.field_path for item in blockers}\n+    return ConnectorHandoff(\n+        schema_version=\"1.0\",\n+        dataset_id=spec.identity.dataset_id,\n+        semantic_spec_sha256=digest,\n+        semantic_spec=spec.to_dict(),\n+        blocking_unresolved_fields=blockers,\n+        implementation_overrides=tuple(overrides[path] for path in sorted(overrides)),\n+        implementation_view=implementation_view,\n+        downstream_context=artifact.downstream_context,\n+        connector_ready=unresolved_paths <= set(overrides),\n+    )\n+\n+\n+def _validate_requirement(requirement: DownstreamRequirement) -> None:\n+    if not isinstance(requirement.field_path, str) or not requirement.field_path.strip():\n+        raise ImplementationHandoffError(\"downstream requirement needs a field_path\")\n+    if (\n+        not isinstance(requirement.downstream_system, str)\n+        or not requirement.downstream_system.strip()\n+    ):\n+        raise ImplementationHandoffError(\"downstream requirement needs a downstream_system\")\n+    if not isinstance(requirement.requirement, str) or not requirement.requirement.strip():\n+        raise ImplementationHandoffError(\"downstream requirement needs an explanation\")\n+    if any(\n+        not isinstance(reference, str) or not reference.startswith(\"ev_\")\n+        for reference in requirement.supporting_evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"downstream requirement supporting_evidence_refs must be evidence IDs\"\n+        )\n+\n+\n+def _validate_override(\n+    override: ImplementationOverride,\n+    requirement: DownstreamRequirement,\n+    evidence_ids: set[str] | None,\n+) -> None:\n+    if not isinstance(override.override_id, str) or not override.override_id.strip():\n+        raise ImplementationHandoffError(\"implementation override needs an override_id\")\n+    if override.source != HUMAN_CONFIRMATION:\n+        raise ImplementationHandoffError(\n+            \"implementation override source must be explicit human_confirmation\"\n+        )\n+    if not isinstance(override.approved_by, str) or not override.approved_by.strip():\n+        raise ImplementationHandoffError(\"human confirmation must identify approved_by\")\n+    if override.value is None:\n+        raise ImplementationHandoffError(\"implementation override value must not be null\")\n+    if not isinstance(override.rationale, str) or not override.rationale.strip():\n+        raise ImplementationHandoffError(\"implementation override needs a rationale\")\n+    if override.downstream_system != requirement.downstream_system:\n+        raise ImplementationHandoffError(\n+            \"implementation override downstream_system does not match its requirement\"\n+        )\n+    if any(\n+        not isinstance(reference, str) or not reference.startswith(\"ev_\")\n+        for reference in override.evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"implementation override evidence_refs must be evidence IDs\"\n+        )\n+    if evidence_ids is not None and any(\n+        reference not in evidence_ids for reference in override.evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"implementation override references evidence absent from the bounded evidence run\"\n+        )\n+\n+\n+def _resolve_field(root: Any, path: str) -> Any:\n+    if not path:\n+        raise ImplementationHandoffError(\"field_path must not be empty\")\n+    current = root\n+    for token in path.split(\".\"):\n+        match = _FIELD_TOKEN.fullmatch(token)\n+        if match is None:\n+            raise ImplementationHandoffError(f\"invalid field path {path!r}\")\n+        name, raw_index = match.groups()\n+        if not hasattr(current, name):\n+            raise ImplementationHandoffError(f\"field path {path!r} does not exist\")\n+        current = getattr(current, name)\n+        if raw_index is not None:\n+            index = int(raw_index)\n+            if not isinstance(current, (tuple, list)) or index >= len(current):\n+                raise ImplementationHandoffError(f\"field path {path!r} does not exist\")\n+            current = current[index]\n+    return current\n+\n+\n+def _resolution_claim(target: Any, path: str) -> EvidenceClaim:\n+    if isinstance(target, EvidenceClaim):\n+        return target\n+    claim = getattr(target, \"resolution\", None)\n+    if isinstance(claim, EvidenceClaim):\n+        return claim\n+    raise ImplementationHandoffError(\n+        f\"field {path!r} has no semantic resolution and is not eligible for override\"\n+    )\n+\n+\n+def _json_value(value: Any) -> Any:\n+    if hasattr(value, \"__dataclass_fields__\"):\n+        return asdict(value)\n+    return value\n","stderr":"","aggregated_output":"diff --git a/.gitignore b/.gitignore\nindex 60843c8..216e20c 100644\n--- a/.gitignore\n+++ b/.gitignore\n@@ -11,5 +11,5 @@ __pycache__/\n .pytest_cache/\n .ruff_cache/\n .coverage\n-.venv/\n+.venv*/\n data_sourcing/var/\ndiff --git a/data_ingestion/src/dataset_profiler/io/hdf5.py b/data_ingestion/src/dataset_profiler/io/hdf5.py\nnew file mode 100644\nindex 0000000..f3aae05\n--- /dev/null\n+++ b/data_ingestion/src/dataset_profiler/io/hdf5.py\n@@ -0,0 +1,309 @@\n+\"\"\"Bounded, streaming inspection helpers for generic HDF5 files.\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import dataclass\n+from pathlib import Path\n+from typing import Any, Iterator\n+import hashlib\n+import math\n+\n+import numpy as np\n+\n+try:\n+    import h5py\n+except ImportError:  # pragma: no cover - guarded by the optional hdf5 extra\n+    h5py = None\n+\n+from ..models import ChannelStats, FileProfile, VariableProfile\n+from .matlab import sha256_file\n+\n+\n+_MAX_ATTRIBUTE_VALUES = 32\n+_TARGET_CHUNK_ELEMENTS = 1_000_000\n+\n+\n+@dataclass(frozen=True)\n+class Hdf5Structure:\n+    \"\"\"Structural metadata that does not require exposing array contents.\"\"\"\n+\n+    root_attributes: dict[str, Any]\n+    groups: tuple[dict[str, Any], ...]\n+\n+\n+@dataclass\n+class _Moments:\n+    count: int = 0\n+    total: float = 0.0\n+    total_squares: float = 0.0\n+    minimum: float | None = None\n+    maximum: float | None = None\n+    nan_count: int = 0\n+    inf_count: int = 0\n+\n+    def update(self, values: np.ndarray) -> None:\n+        if np.issubdtype(values.dtype, np.inexact):\n+            self.nan_count += int(np.isnan(values).sum())\n+            self.inf_count += int(np.isinf(values).sum())\n+            finite = values[np.isfinite(values)]\n+        else:\n+            finite = values\n+        if not finite.size:\n+            return\n+        numeric = finite.astype(np.float64, copy=False)\n+        local_min = float(np.min(numeric))\n+        local_max = float(np.max(numeric))\n+        self.minimum = (\n+            local_min if self.minimum is None else min(self.minimum, local_min)\n+        )\n+        self.maximum = (\n+            local_max if self.maximum is None else max(self.maximum, local_max)\n+        )\n+        self.count += int(numeric.size)\n+        self.total += float(np.sum(numeric, dtype=np.float64))\n+        self.total_squares += float(np.sum(numeric * numeric, dtype=np.float64))\n+\n+    @property\n+    def mean(self) -> float | None:\n+        return self.total / self.count if self.count else None\n+\n+    @property\n+    def standard_deviation(self) -> float | None:\n+        if not self.count:\n+            return None\n+        mean = self.total / self.count\n+        return math.sqrt(max(0.0, self.total_squares / self.count - mean * mean))\n+\n+\n+def inspect_hdf5_file(\n+    path: str | Path,\n+    root: str | Path | None = None,\n+    source_run_id: str = \"\",\n+    first_value_count: int = 8,\n+) -> FileProfile:\n+    \"\"\"Inspect every dataset in an HDF5 file without materializing large arrays.\"\"\"\n+    _require_h5py()\n+    source = Path(path)\n+    base = Path(root) if root else source.parent\n+    variables: list[VariableProfile] = []\n+    with h5py.File(source, \"r\") as handle:\n+\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\n+            if isinstance(node, h5py.Dataset):\n+                variables.append(_inspect_dataset(name, node, first_value_count))\n+\n+        handle.visititems(visit)\n+    return FileProfile(\n+        relative_path=source.relative_to(base).as_posix(),\n+        source_run_id=source_run_id,\n+        format=\"hdf5\",\n+        size_bytes=source.stat().st_size,\n+        sha256=sha256_file(source),\n+        variables=variables,\n+        loader=\"h5py\",\n+    )\n+\n+\n+def inspect_hdf5_structure(path: str | Path) -> Hdf5Structure:\n+    \"\"\"Return bounded root/group attributes and group paths for one HDF5 file.\"\"\"\n+    _require_h5py()\n+    groups: list[dict[str, Any]] = []\n+    with h5py.File(path, \"r\") as handle:\n+        root_attributes = _attributes(handle.attrs)\n+\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\n+            if isinstance(node, h5py.Group):\n+                groups.append({\"path\": name, \"attributes\": _attributes(node.attrs)})\n+\n+        handle.visititems(visit)\n+    return Hdf5Structure(root_attributes, tuple(groups))\n+\n+\n+def read_hdf5_excerpt(\n+    path: str | Path,\n+    dataset_name: str,\n+    start: int,\n+    length: int,\n+    channels: tuple[int, ...],\n+    channel_axis: int | None,\n+) -> tuple[np.ndarray, str, int]:\n+    \"\"\"Load only a host-validated sample/channel window from an HDF5 dataset.\"\"\"\n+    _require_h5py()\n+    with h5py.File(path, \"r\") as handle:\n+        dataset = handle[dataset_name]\n+        if dataset.ndim not in {1, 2} or not np.issubdtype(dataset.dtype, np.number):\n+            raise ValueError(\n+                \"excerpt source is not a numeric one- or two-dimensional array\"\n+            )\n+        if dataset.ndim == 1:\n+            available_samples = dataset.shape[0]\n+            if channels != (0,):\n+                raise ValueError(\"one-dimensional datasets expose one logical channel\")\n+            excerpt = np.asarray(dataset[start : start + length]).reshape(1, -1)\n+        elif channel_axis == 1:\n+            available_samples = dataset.shape[0]\n+            excerpt = np.stack(\n+                [\n+                    np.asarray(dataset[start : start + length, channel])\n+                    for channel in channels\n+                ]\n+            )\n+        else:\n+            available_samples = dataset.shape[1]\n+            excerpt = np.stack(\n+                [\n+                    np.asarray(dataset[channel, start : start + length])\n+                    for channel in channels\n+                ]\n+            )\n+        if start + length > available_samples:\n+            raise ValueError(\"requested excerpt exceeds the available samples\")\n+        return excerpt, str(dataset.dtype), available_samples\n+\n+\n+def _inspect_dataset(\n+    name: str, dataset: h5py.Dataset, first_value_count: int\n+) -> VariableProfile:\n+    numeric = np.issubdtype(dataset.dtype, np.number)\n+    overall = _Moments()\n+    channel_axis = _channel_axis(dataset.shape) if numeric else None\n+    channel_moments = (\n+        [_Moments() for _ in range(dataset.shape[channel_axis])]\n+        if channel_axis is not None\n+        else []\n+    )\n+    digest = hashlib.sha256()\n+    first_values: list[Any] = []\n+    for values in _chunks(dataset):\n+        contiguous = np.ascontiguousarray(values)\n+        digest.update(contiguous.tobytes(order=\"C\"))\n+        if len(first_values) < first_value_count:\n+            remaining = first_value_count - len(first_values)\n+            first_values.extend(\n+                _json_scalar(value) for value in contiguous.flat[:remaining]\n+            )\n+        if numeric:\n+            overall.update(contiguous)\n+            if channel_axis is not None:\n+                for index, moments in enumerate(channel_moments):\n+                    moments.update(np.take(contiguous, index, axis=channel_axis))\n+\n+    metadata: dict[str, Any] = {\n+        \"hdf5_attributes\": _attributes(dataset.attrs),\n+        \"numeric_statistics\": {\n+            \"sample_count\": overall.count,\n+            \"mean\": overall.mean,\n+            \"standard_deviation\": overall.standard_deviation,\n+        }\n+        if numeric\n+        else None,\n+        \"structural_axes\": {\n+            \"sample_axis\": _sample_axis(dataset.shape),\n+            \"channel_axis\": channel_axis,\n+        },\n+    }\n+    return VariableProfile(\n+        name=name,\n+        python_type=\"h5py.Dataset\",\n+        shape=list(dataset.shape),\n+        dtype=str(dataset.dtype),\n+        ndim=dataset.ndim,\n+        size=int(dataset.size),\n+        minimum=overall.minimum,\n+        maximum=overall.maximum,\n+        nan_count=overall.nan_count,\n+        inf_count=overall.inf_count,\n+        first_values=first_values,\n+        channel_stats=[\n+            _channel_stats(index, moments)\n+            for index, moments in enumerate(channel_moments)\n+        ],\n+        content_sha256=digest.hexdigest(),\n+        nested_structure=metadata,\n+    )\n+\n+\n+def _chunks(dataset: h5py.Dataset) -> Iterator[np.ndarray]:\n+    if dataset.size == 0:\n+        return\n+    if dataset.ndim == 0:\n+        yield np.asarray(dataset[()])\n+        return\n+    trailing = math.prod(dataset.shape[1:]) or 1\n+    rows = max(1, _TARGET_CHUNK_ELEMENTS // trailing)\n+    for start in range(0, dataset.shape[0], rows):\n+        yield np.asarray(dataset[start : min(dataset.shape[0], start + rows)])\n+\n+\n+def _sample_axis(shape: tuple[int, ...]) -> int | None:\n+    if not shape:\n+        return None\n+    return max(range(len(shape)), key=lambda index: shape[index])\n+\n+\n+def _channel_axis(shape: tuple[int, ...]) -> int | None:\n+    if len(shape) != 2 or 0 in shape:\n+        return None\n+    sample_axis = _sample_axis(shape)\n+    return 1 - sample_axis if sample_axis is not None else None\n+\n+\n+def _channel_stats(index: int, moments: _Moments) -> ChannelStats:\n+    span = (\n+        moments.maximum - moments.minimum\n+        if moments.minimum is not None and moments.maximum is not None\n+        else None\n+    )\n+    scale = max(abs(moments.minimum or 0), abs(moments.maximum or 0), 1.0)\n+    return ChannelStats(\n+        index=index,\n+        count=moments.count + moments.nan_count + moments.inf_count,\n+        minimum=moments.minimum,\n+        maximum=moments.maximum,\n+        mean=moments.mean,\n+        standard_deviation=moments.standard_deviation,\n+        nan_count=moments.nan_count,\n+        inf_count=moments.inf_count,\n+        constant=bool(span == 0),\n+        near_constant=bool(span is not None and span <= 1e-12 * scale),\n+    )\n+\n+\n+def _attributes(attributes: h5py.AttributeManager) -> dict[str, Any]:\n+    return {\n+        str(name): _bounded_value(value) for name, value in sorted(attributes.items())\n+    }\n+\n+\n+def _bounded_value(value: Any) -> Any:\n+    array = np.asarray(value)\n+    values = [_json_scalar(item) for item in array.reshape(-1)[:_MAX_ATTRIBUTE_VALUES]]\n+    if array.ndim == 0:\n+        return values[0] if values else None\n+    return {\n+        \"shape\": list(array.shape),\n+        \"dtype\": str(array.dtype),\n+        \"values\": values,\n+        \"truncated\": array.size > _MAX_ATTRIBUTE_VALUES,\n+    }\n+\n+\n+def _json_scalar(value: Any) -> Any:\n+    if isinstance(value, np.generic):\n+        value = value.item()\n+    if isinstance(value, bytes):\n+        return value.decode(\"utf-8\", errors=\"replace\")\n+    if isinstance(value, complex):\n+        return {\"real\": value.real, \"imag\": value.imag}\n+    if isinstance(value, float) and not np.isfinite(value):\n+        return \"NaN\" if np.isnan(value) else (\"Infinity\" if value > 0 else \"-Infinity\")\n+    return (\n+        value\n+        if isinstance(value, (str, int, float, bool)) or value is None\n+        else repr(value)\n+    )\n+\n+\n+def _require_h5py() -> None:\n+    if h5py is None:\n+        raise RuntimeError(\"HDF5 support requires the optional 'hdf5' extra\")\ndiff --git a/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\nnew file mode 100644\nindex 0000000..558252e\n--- /dev/null\n+++ b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\n@@ -0,0 +1,364 @@\n+\"\"\"Human-approved implementation decisions layered over immutable semantic specs.\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import asdict, dataclass\n+import hashlib\n+import json\n+from pathlib import Path\n+import re\n+from typing import Any\n+\n+from .models import DatasetSpec, EvidenceClaim, EvidenceStatus\n+\n+\n+HUMAN_CONFIRMATION = \"human_confirmation\"\n+_FIELD_TOKEN = re.compile(r\"([A-Za-z_][A-Za-z0-9_]*)(?:\\[([0-9]+)\\])?\")\n+\n+\n+class ImplementationHandoffError(ValueError):\n+    \"\"\"Report an invalid downstream requirement or implementation override.\"\"\"\n+\n+\n+@dataclass(frozen=True)\n+class DownstreamRequirement:\n+    \"\"\"Describe one semantic value required by a downstream interface.\"\"\"\n+\n+    field_path: str\n+    downstream_system: str\n+    requirement: str\n+    best_supported_candidate: Any = None\n+    supporting_evidence_refs: tuple[str, ...] = ()\n+    remaining_uncertainty: str | None = None\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> DownstreamRequirement:\n+        return cls(\n+            field_path=raw[\"field_path\"],\n+            downstream_system=raw[\"downstream_system\"],\n+            requirement=raw[\"requirement\"],\n+            best_supported_candidate=raw.get(\"best_supported_candidate\"),\n+            supporting_evidence_refs=tuple(raw.get(\"supporting_evidence_refs\", ())),\n+            remaining_uncertainty=raw.get(\"remaining_uncertainty\"),\n+        )\n+\n+\n+@dataclass(frozen=True)\n+class BlockingUnresolvedField:\n+    \"\"\"Expose an unresolved semantic field that prevents implementation.\"\"\"\n+\n+    field_path: str\n+    semantic_resolution: str\n+    semantic_value: Any\n+    downstream_system: str\n+    requirement: str\n+    best_supported_candidate: Any\n+    supporting_evidence_refs: tuple[str, ...]\n+    remaining_uncertainty: str | None\n+\n+\n+@dataclass(frozen=True)\n+class ImplementationOverride:\n+    \"\"\"Record an approved downstream value that is not semantic evidence.\"\"\"\n+\n+    override_id: str\n+    field_path: str\n+    value: Any\n+    source: str\n+    approved_by: str\n+    rationale: str\n+    downstream_system: str\n+    evidence_refs: tuple[str, ...] = ()\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverride:\n+        return cls(\n+            override_id=raw[\"override_id\"],\n+            field_path=raw[\"field_path\"],\n+            value=raw.get(\"value\"),\n+            source=raw.get(\"source\", \"\"),\n+            approved_by=raw.get(\"approved_by\", \"\"),\n+            rationale=raw.get(\"rationale\", \"\"),\n+            downstream_system=raw.get(\"downstream_system\", \"\"),\n+            evidence_refs=tuple(raw.get(\"evidence_refs\", ())),\n+        )\n+\n+\n+@dataclass(frozen=True)\n+class ImplementationOverrideArtifact:\n+    \"\"\"Bind decisions and requirements to one semantic-spec snapshot.\"\"\"\n+\n+    schema_version: str\n+    dataset_id: str\n+    semantic_spec_sha256: str\n+    requirements: tuple[DownstreamRequirement, ...]\n+    overrides: tuple[ImplementationOverride, ...]\n+    downstream_context: dict[str, Any] | None = None\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    def to_json(self, *, indent: int = 2) -> str:\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \"\\n\"\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverrideArtifact:\n+        if raw.get(\"schema_version\") != \"1.0\":\n+            raise ImplementationHandoffError(\n+                \"unsupported implementation-override schema_version; expected '1.0'\"\n+            )\n+        return cls(\n+            schema_version=\"1.0\",\n+            dataset_id=raw[\"dataset_id\"],\n+            semantic_spec_sha256=raw[\"semantic_spec_sha256\"],\n+            requirements=tuple(\n+                DownstreamRequirement.from_dict(item)\n+                for item in raw.get(\"requirements\", ())\n+            ),\n+            overrides=tuple(\n+                ImplementationOverride.from_dict(item)\n+                for item in raw.get(\"overrides\", ())\n+            ),\n+            downstream_context=raw.get(\"downstream_context\"),\n+        )\n+\n+    @classmethod\n+    def read_json(cls, path: str | Path) -> ImplementationOverrideArtifact:\n+        raw = json.loads(Path(path).read_text(encoding=\"utf-8\"))\n+        if not isinstance(raw, dict):\n+            raise ImplementationHandoffError(\n+                \"implementation-override JSON root must be an object\"\n+            )\n+        return cls.from_dict(raw)\n+\n+\n+@dataclass(frozen=True)\n+class ConnectorHandoff:\n+    \"\"\"Connector view with semantic truth and decisions kept separate.\"\"\"\n+\n+    schema_version: str\n+    dataset_id: str\n+    semantic_spec_sha256: str\n+    semantic_spec: dict[str, Any]\n+    blocking_unresolved_fields: tuple[BlockingUnresolvedField, ...]\n+    implementation_overrides: tuple[ImplementationOverride, ...]\n+    implementation_view: dict[str, dict[str, Any]]\n+    downstream_context: dict[str, Any] | None\n+    connector_ready: bool\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    def to_json(self, *, indent: int = 2) -> str:\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \"\\n\"\n+\n+    def write_json(self, path: str | Path) -> None:\n+        Path(path).write_text(self.to_json(), encoding=\"utf-8\")\n+\n+\n+def semantic_spec_sha256(spec: DatasetSpec) -> str:\n+    \"\"\"Return the stable digest binding decisions to a semantic snapshot.\"\"\"\n+    return hashlib.sha256(spec.to_json().encode()).hexdigest()\n+\n+\n+def detect_blocking_unresolved_fields(\n+    spec: DatasetSpec,\n+    requirements: tuple[DownstreamRequirement, ...],\n+) -> tuple[BlockingUnresolvedField, ...]:\n+    \"\"\"Return downstream-required fields whose semantic status is unresolved.\"\"\"\n+    blockers = []\n+    seen: set[str] = set()\n+    for requirement in requirements:\n+        _validate_requirement(requirement)\n+        if requirement.field_path in seen:\n+            raise ImplementationHandoffError(\n+                f\"duplicate downstream requirement for {requirement.field_path!r}\"\n+            )\n+        seen.add(requirement.field_path)\n+        target = _resolve_field(spec, requirement.field_path)\n+        claim = _resolution_claim(target, requirement.field_path)\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\n+            continue\n+        blockers.append(\n+            BlockingUnresolvedField(\n+                field_path=requirement.field_path,\n+                semantic_resolution=claim.status.value,\n+                semantic_value=_json_value(target),\n+                downstream_system=requirement.downstream_system,\n+                requirement=requirement.requirement,\n+                best_supported_candidate=requirement.best_supported_candidate,\n+                supporting_evidence_refs=requirement.supporting_evidence_refs,\n+                remaining_uncertainty=requirement.remaining_uncertainty,\n+            )\n+        )\n+    return tuple(blockers)\n+\n+\n+def build_connector_handoff(\n+    spec: DatasetSpec,\n+    artifact: ImplementationOverrideArtifact,\n+    *,\n+    evidence_ids: set[str] | None = None,\n+) -> ConnectorHandoff:\n+    \"\"\"Validate overrides and build a deterministic connector-facing view.\"\"\"\n+    digest = semantic_spec_sha256(spec)\n+    if artifact.dataset_id != spec.identity.dataset_id:\n+        raise ImplementationHandoffError(\n+            f\"override dataset_id {artifact.dataset_id!r} does not match \"\n+            f\"{spec.identity.dataset_id!r}\"\n+        )\n+    if artifact.semantic_spec_sha256 != digest:\n+        raise ImplementationHandoffError(\n+            \"override artifact targets a different semantic-spec snapshot\"\n+        )\n+\n+    blockers = detect_blocking_unresolved_fields(spec, artifact.requirements)\n+    if evidence_ids is not None and any(\n+        reference not in evidence_ids\n+        for requirement in artifact.requirements\n+        for reference in requirement.supporting_evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"downstream requirement references evidence absent from the bounded evidence run\"\n+        )\n+    requirements = {item.field_path: item for item in artifact.requirements}\n+    overrides: dict[str, ImplementationOverride] = {}\n+    override_ids: set[str] = set()\n+    for override in artifact.overrides:\n+        if override.field_path in overrides:\n+            raise ImplementationHandoffError(\n+                f\"duplicate or conflicting overrides for {override.field_path!r}\"\n+            )\n+        if override.override_id in override_ids:\n+            raise ImplementationHandoffError(\n+                f\"duplicate implementation override id {override.override_id!r}\"\n+            )\n+        requirement = requirements.get(override.field_path)\n+        if requirement is None:\n+            raise ImplementationHandoffError(\n+                f\"override field {override.field_path!r} has no downstream requirement\"\n+            )\n+        target = _resolve_field(spec, override.field_path)\n+        claim = _resolution_claim(target, override.field_path)\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\n+            raise ImplementationHandoffError(\n+                f\"field {override.field_path!r} is {claim.status.value}, not unresolved; \"\n+                \"an implementation override cannot replace semantic truth\"\n+            )\n+        _validate_override(override, requirement, evidence_ids)\n+        overrides[override.field_path] = override\n+        override_ids.add(override.override_id)\n+\n+    implementation_view = {\n+        path: {\n+            \"value\": override.value,\n+            \"value_source\": override.source,\n+            \"override_id\": override.override_id,\n+            \"semantic_resolution\": \"unresolved\",\n+        }\n+        for path, override in sorted(overrides.items())\n+    }\n+    unresolved_paths = {item.field_path for item in blockers}\n+    return ConnectorHandoff(\n+        schema_version=\"1.0\",\n+        dataset_id=spec.identity.dataset_id,\n+        semantic_spec_sha256=digest,\n+        semantic_spec=spec.to_dict(),\n+        blocking_unresolved_fields=blockers,\n+        implementation_overrides=tuple(overrides[path] for path in sorted(overrides)),\n+        implementation_view=implementation_view,\n+        downstream_context=artifact.downstream_context,\n+        connector_ready=unresolved_paths <= set(overrides),\n+    )\n+\n+\n+def _validate_requirement(requirement: DownstreamRequirement) -> None:\n+    if not isinstance(requirement.field_path, str) or not requirement.field_path.strip():\n+        raise ImplementationHandoffError(\"downstream requirement needs a field_path\")\n+    if (\n+        not isinstance(requirement.downstream_system, str)\n+        or not requirement.downstream_system.strip()\n+    ):\n+        raise ImplementationHandoffError(\"downstream requirement needs a downstream_system\")\n+    if not isinstance(requirement.requirement, str) or not requirement.requirement.strip():\n+        raise ImplementationHandoffError(\"downstream requirement needs an explanation\")\n+    if any(\n+        not isinstance(reference, str) or not reference.startswith(\"ev_\")\n+        for reference in requirement.supporting_evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"downstream requirement supporting_evidence_refs must be evidence IDs\"\n+        )\n+\n+\n+def _validate_override(\n+    override: ImplementationOverride,\n+    requirement: DownstreamRequirement,\n+    evidence_ids: set[str] | None,\n+) -> None:\n+    if not isinstance(override.override_id, str) or not override.override_id.strip():\n+        raise ImplementationHandoffError(\"implementation override needs an override_id\")\n+    if override.source != HUMAN_CONFIRMATION:\n+        raise ImplementationHandoffError(\n+            \"implementation override source must be explicit human_confirmation\"\n+        )\n+    if not isinstance(override.approved_by, str) or not override.approved_by.strip():\n+        raise ImplementationHandoffError(\"human confirmation must identify approved_by\")\n+    if override.value is None:\n+        raise ImplementationHandoffError(\"implementation override value must not be null\")\n+    if not isinstance(override.rationale, str) or not override.rationale.strip():\n+        raise ImplementationHandoffError(\"implementation override needs a rationale\")\n+    if override.downstream_system != requirement.downstream_system:\n+        raise ImplementationHandoffError(\n+            \"implementation override downstream_system does not match its requirement\"\n+        )\n+    if any(\n+        not isinstance(reference, str) or not reference.startswith(\"ev_\")\n+        for reference in override.evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"implementation override evidence_refs must be evidence IDs\"\n+        )\n+    if evidence_ids is not None and any(\n+        reference not in evidence_ids for reference in override.evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"implementation override references evidence absent from the bounded evidence run\"\n+        )\n+\n+\n+def _resolve_field(root: Any, path: str) -> Any:\n+    if not path:\n+        raise ImplementationHandoffError(\"field_path must not be empty\")\n+    current = root\n+    for token in path.split(\".\"):\n+        match = _FIELD_TOKEN.fullmatch(token)\n+        if match is None:\n+            raise ImplementationHandoffError(f\"invalid field path {path!r}\")\n+        name, raw_index = match.groups()\n+        if not hasattr(current, name):\n+            raise ImplementationHandoffError(f\"field path {path!r} does not exist\")\n+        current = getattr(current, name)\n+        if raw_index is not None:\n+            index = int(raw_index)\n+            if not isinstance(current, (tuple, list)) or index >= len(current):\n+                raise ImplementationHandoffError(f\"field path {path!r} does not exist\")\n+            current = current[index]\n+    return current\n+\n+\n+def _resolution_claim(target: Any, path: str) -> EvidenceClaim:\n+    if isinstance(target, EvidenceClaim):\n+        return target\n+    claim = getattr(target, \"resolution\", None)\n+    if isinstance(claim, EvidenceClaim):\n+        return claim\n+    raise ImplementationHandoffError(\n+        f\"field {path!r} has no semantic resolution and is not eligible for override\"\n+    )\n+\n+\n+def _json_value(value: Any) -> Any:\n+    if hasattr(value, \"__dataclass_fields__\"):\n+        return asdict(value)\n+    return value\n","exit_code":0,"duration":{"secs":0,"nanos":583},"formatted_output":"diff --git a/.gitignore b/.gitignore\nindex 60843c8..216e20c 100644\n--- a/.gitignore\n+++ b/.gitignore\n@@ -11,5 +11,5 @@ __pycache__/\n .pytest_cache/\n .ruff_cache/\n .coverage\n-.venv/\n+.venv*/\n data_sourcing/var/\ndiff --git a/data_ingestion/src/dataset_profiler/io/hdf5.py b/data_ingestion/src/dataset_profiler/io/hdf5.py\nnew file mode 100644\nindex 0000000..f3aae05\n--- /dev/null\n+++ b/data_ingestion/src/dataset_profiler/io/hdf5.py\n@@ -0,0 +1,309 @@\n+\"\"\"Bounded, streaming inspection helpers for generic HDF5 files.\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import dataclass\n+from pathlib import Path\n+from typing import Any, Iterator\n+import hashlib\n+import math\n+\n+import numpy as np\n+\n+try:\n+    import h5py\n+except ImportError:  # pragma: no cover - guarded by the optional hdf5 extra\n+    h5py = None\n+\n+from ..models import ChannelStats, FileProfile, VariableProfile\n+from .matlab import sha256_file\n+\n+\n+_MAX_ATTRIBUTE_VALUES = 32\n+_TARGET_CHUNK_ELEMENTS = 1_000_000\n+\n+\n+@dataclass(frozen=True)\n+class Hdf5Structure:\n+    \"\"\"Structural metadata that does not require exposing array contents.\"\"\"\n+\n+    root_attributes: dict[str, Any]\n+    groups: tuple[dict[str, Any], ...]\n+\n+\n+@dataclass\n+class _Moments:\n+    count: int = 0\n+    total: float = 0.0\n+    total_squares: float = 0.0\n+    minimum: float | None = None\n+    maximum: float | None = None\n+    nan_count: int = 0\n+    inf_count: int = 0\n+\n+    def update(self, values: np.ndarray) -> None:\n+        if np.issubdtype(values.dtype, np.inexact):\n+            self.nan_count += int(np.isnan(values).sum())\n+            self.inf_count += int(np.isinf(values).sum())\n+            finite = values[np.isfinite(values)]\n+        else:\n+            finite = values\n+        if not finite.size:\n+            return\n+        numeric = finite.astype(np.float64, copy=False)\n+        local_min = float(np.min(numeric))\n+        local_max = float(np.max(numeric))\n+        self.minimum = (\n+            local_min if self.minimum is None else min(self.minimum, local_min)\n+        )\n+        self.maximum = (\n+            local_max if self.maximum is None else max(self.maximum, local_max)\n+        )\n+        self.count += int(numeric.size)\n+        self.total += float(np.sum(numeric, dtype=np.float64))\n+        self.total_squares += float(np.sum(numeric * numeric, dtype=np.float64))\n+\n+    @property\n+    def mean(self) -> float | None:\n+        return self.total / self.count if self.count else None\n+\n+    @property\n+    def standard_deviation(self) -> float | None:\n+        if not self.count:\n+            return None\n+        mean = self.total / self.count\n+        return math.sqrt(max(0.0, self.total_squares / self.count - mean * mean))\n+\n+\n+def inspect_hdf5_file(\n+    path: str | Path,\n+    root: str | Path | None = None,\n+    source_run_id: str = \"\",\n+    first_value_count: int = 8,\n+) -> FileProfile:\n+    \"\"\"Inspect every dataset in an HDF5 file without materializing large arrays.\"\"\"\n+    _require_h5py()\n+    source = Path(path)\n+    base = Path(root) if root else source.parent\n+    variables: list[VariableProfile] = []\n+    with h5py.File(source, \"r\") as handle:\n+\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\n+            if isinstance(node, h5py.Dataset):\n+                variables.append(_inspect_dataset(name, node, first_value_count))\n+\n+        handle.visititems(visit)\n+    return FileProfile(\n+        relative_path=source.relative_to(base).as_posix(),\n+        source_run_id=source_run_id,\n+        format=\"hdf5\",\n+        size_bytes=source.stat().st_size,\n+        sha256=sha256_file(source),\n+        variables=variables,\n+        loader=\"h5py\",\n+    )\n+\n+\n+def inspect_hdf5_structure(path: str | Path) -> Hdf5Structure:\n+    \"\"\"Return bounded root/group attributes and group paths for one HDF5 file.\"\"\"\n+    _require_h5py()\n+    groups: list[dict[str, Any]] = []\n+    with h5py.File(path, \"r\") as handle:\n+        root_attributes = _attributes(handle.attrs)\n+\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\n+            if isinstance(node, h5py.Group):\n+                groups.append({\"path\": name, \"attributes\": _attributes(node.attrs)})\n+\n+        handle.visititems(visit)\n+    return Hdf5Structure(root_attributes, tuple(groups))\n+\n+\n+def read_hdf5_excerpt(\n+    path: str | Path,\n+    dataset_name: str,\n+    start: int,\n+    length: int,\n+    channels: tuple[int, ...],\n+    channel_axis: int | None,\n+) -> tuple[np.ndarray, str, int]:\n+    \"\"\"Load only a host-validated sample/channel window from an HDF5 dataset.\"\"\"\n+    _require_h5py()\n+    with h5py.File(path, \"r\") as handle:\n+        dataset = handle[dataset_name]\n+        if dataset.ndim not in {1, 2} or not np.issubdtype(dataset.dtype, np.number):\n+            raise ValueError(\n+                \"excerpt source is not a numeric one- or two-dimensional array\"\n+            )\n+        if dataset.ndim == 1:\n+            available_samples = dataset.shape[0]\n+            if channels != (0,):\n+                raise ValueError(\"one-dimensional datasets expose one logical channel\")\n+            excerpt = np.asarray(dataset[start : start + length]).reshape(1, -1)\n+        elif channel_axis == 1:\n+            available_samples = dataset.shape[0]\n+            excerpt = np.stack(\n+                [\n+                    np.asarray(dataset[start : start + length, channel])\n+                    for channel in channels\n+                ]\n+            )\n+        else:\n+            available_samples = dataset.shape[1]\n+            excerpt = np.stack(\n+                [\n+                    np.asarray(dataset[channel, start : start + length])\n+                    for channel in channels\n+                ]\n+            )\n+        if start + length > available_samples:\n+            raise ValueError(\"requested excerpt exceeds the available samples\")\n+        return excerpt, str(dataset.dtype), available_samples\n+\n+\n+def _inspect_dataset(\n+    name: str, dataset: h5py.Dataset, first_value_count: int\n+) -> VariableProfile:\n+    numeric = np.issubdtype(dataset.dtype, np.number)\n+    overall = _Moments()\n+    channel_axis = _channel_axis(dataset.shape) if numeric else None\n+    channel_moments = (\n+        [_Moments() for _ in range(dataset.shape[channel_axis])]\n+        if channel_axis is not None\n+        else []\n+    )\n+    digest = hashlib.sha256()\n+    first_values: list[Any] = []\n+    for values in _chunks(dataset):\n+        contiguous = np.ascontiguousarray(values)\n+        digest.update(contiguous.tobytes(order=\"C\"))\n+        if len(first_values) < first_value_count:\n+            remaining = first_value_count - len(first_values)\n+            first_values.extend(\n+                _json_scalar(value) for value in contiguous.flat[:remaining]\n+            )\n+        if numeric:\n+            overall.update(contiguous)\n+            if channel_axis is not None:\n+                for index, moments in enumerate(channel_moments):\n+                    moments.update(np.take(contiguous, index, axis=channel_axis))\n+\n+    metadata: dict[str, Any] = {\n+        \"hdf5_attributes\": _attributes(dataset.attrs),\n+        \"numeric_statistics\": {\n+            \"sample_count\": overall.count,\n+            \"mean\": overall.mean,\n+            \"standard_deviation\": overall.standard_deviation,\n+        }\n+        if numeric\n+        else None,\n+        \"structural_axes\": {\n+            \"sample_axis\": _sample_axis(dataset.shape),\n+            \"channel_axis\": channel_axis,\n+        },\n+    }\n+    return VariableProfile(\n+        name=name,\n+        python_type=\"h5py.Dataset\",\n+        shape=list(dataset.shape),\n+        dtype=str(dataset.dtype),\n+        ndim=dataset.ndim,\n+        size=int(dataset.size),\n+        minimum=overall.minimum,\n+        maximum=overall.maximum,\n+        nan_count=overall.nan_count,\n+        inf_count=overall.inf_count,\n+        first_values=first_values,\n+        channel_stats=[\n+            _channel_stats(index, moments)\n+            for index, moments in enumerate(channel_moments)\n+        ],\n+        content_sha256=digest.hexdigest(),\n+        nested_structure=metadata,\n+    )\n+\n+\n+def _chunks(dataset: h5py.Dataset) -> Iterator[np.ndarray]:\n+    if dataset.size == 0:\n+        return\n+    if dataset.ndim == 0:\n+        yield np.asarray(dataset[()])\n+        return\n+    trailing = math.prod(dataset.shape[1:]) or 1\n+    rows = max(1, _TARGET_CHUNK_ELEMENTS // trailing)\n+    for start in range(0, dataset.shape[0], rows):\n+        yield np.asarray(dataset[start : min(dataset.shape[0], start + rows)])\n+\n+\n+def _sample_axis(shape: tuple[int, ...]) -> int | None:\n+    if not shape:\n+        return None\n+    return max(range(len(shape)), key=lambda index: shape[index])\n+\n+\n+def _channel_axis(shape: tuple[int, ...]) -> int | None:\n+    if len(shape) != 2 or 0 in shape:\n+        return None\n+    sample_axis = _sample_axis(shape)\n+    return 1 - sample_axis if sample_axis is not None else None\n+\n+\n+def _channel_stats(index: int, moments: _Moments) -> ChannelStats:\n+    span = (\n+        moments.maximum - moments.minimum\n+        if moments.minimum is not None and moments.maximum is not None\n+        else None\n+    )\n+    scale = max(abs(moments.minimum or 0), abs(moments.maximum or 0), 1.0)\n+    return ChannelStats(\n+        index=index,\n+        count=moments.count + moments.nan_count + moments.inf_count,\n+        minimum=moments.minimum,\n+        maximum=moments.maximum,\n+        mean=moments.mean,\n+        standard_deviation=moments.standard_deviation,\n+        nan_count=moments.nan_count,\n+        inf_count=moments.inf_count,\n+        constant=bool(span == 0),\n+        near_constant=bool(span is not None and span <= 1e-12 * scale),\n+    )\n+\n+\n+def _attributes(attributes: h5py.AttributeManager) -> dict[str, Any]:\n+    return {\n+        str(name): _bounded_value(value) for name, value in sorted(attributes.items())\n+    }\n+\n+\n+def _bounded_value(value: Any) -> Any:\n+    array = np.asarray(value)\n+    values = [_json_scalar(item) for item in array.reshape(-1)[:_MAX_ATTRIBUTE_VALUES]]\n+    if array.ndim == 0:\n+        return values[0] if values else None\n+    return {\n+        \"shape\": list(array.shape),\n+        \"dtype\": str(array.dtype),\n+        \"values\": values,\n+        \"truncated\": array.size > _MAX_ATTRIBUTE_VALUES,\n+    }\n+\n+\n+def _json_scalar(value: Any) -> Any:\n+    if isinstance(value, np.generic):\n+        value = value.item()\n+    if isinstance(value, bytes):\n+        return value.decode(\"utf-8\", errors=\"replace\")\n+    if isinstance(value, complex):\n+        return {\"real\": value.real, \"imag\": value.imag}\n+    if isinstance(value, float) and not np.isfinite(value):\n+        return \"NaN\" if np.isnan(value) else (\"Infinity\" if value > 0 else \"-Infinity\")\n+    return (\n+        value\n+        if isinstance(value, (str, int, float, bool)) or value is None\n+        else repr(value)\n+    )\n+\n+\n+def _require_h5py() -> None:\n+    if h5py is None:\n+        raise RuntimeError(\"HDF5 support requires the optional 'hdf5' extra\")\ndiff --git a/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\nnew file mode 100644\nindex 0000000..558252e\n--- /dev/null\n+++ b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\n@@ -0,0 +1,364 @@\n+\"\"\"Human-approved implementation decisions layered over immutable semantic specs.\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import asdict, dataclass\n+import hashlib\n+import json\n+from pathlib import Path\n+import re\n+from typing import Any\n+\n+from .models import DatasetSpec, EvidenceClaim, EvidenceStatus\n+\n+\n+HUMAN_CONFIRMATION = \"human_confirmation\"\n+_FIELD_TOKEN = re.compile(r\"([A-Za-z_][A-Za-z0-9_]*)(?:\\[([0-9]+)\\])?\")\n+\n+\n+class ImplementationHandoffError(ValueError):\n+    \"\"\"Report an invalid downstream requirement or implementation override.\"\"\"\n+\n+\n+@dataclass(frozen=True)\n+class DownstreamRequirement:\n+    \"\"\"Describe one semantic value required by a downstream interface.\"\"\"\n+\n+    field_path: str\n+    downstream_system: str\n+    requirement: str\n+    best_supported_candidate: Any = None\n+    supporting_evidence_refs: tuple[str, ...] = ()\n+    remaining_uncertainty: str | None = None\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> DownstreamRequirement:\n+        return cls(\n+            field_path=raw[\"field_path\"],\n+            downstream_system=raw[\"downstream_system\"],\n+            requirement=raw[\"requirement\"],\n+            best_supported_candidate=raw.get(\"best_supported_candidate\"),\n+            supporting_evidence_refs=tuple(raw.get(\"supporting_evidence_refs\", ())),\n+            remaining_uncertainty=raw.get(\"remaining_uncertainty\"),\n+        )\n+\n+\n+@dataclass(frozen=True)\n+class BlockingUnresolvedField:\n+    \"\"\"Expose an unresolved semantic field that prevents implementation.\"\"\"\n+\n+    field_path: str\n+    semantic_resolution: str\n+    semantic_value: Any\n+    downstream_system: str\n+    requirement: str\n+    best_supported_candidate: Any\n+    supporting_evidence_refs: tuple[str, ...]\n+    remaining_uncertainty: str | None\n+\n+\n+@dataclass(frozen=True)\n+class ImplementationOverride:\n+    \"\"\"Record an approved downstream value that is not semantic evidence.\"\"\"\n+\n+    override_id: str\n+    field_path: str\n+    value: Any\n+    source: str\n+    approved_by: str\n+    rationale: str\n+    downstream_system: str\n+    evidence_refs: tuple[str, ...] = ()\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverride:\n+        return cls(\n+            override_id=raw[\"override_id\"],\n+            field_path=raw[\"field_path\"],\n+            value=raw.get(\"value\"),\n+            source=raw.get(\"source\", \"\"),\n+            approved_by=raw.get(\"approved_by\", \"\"),\n+            rationale=raw.get(\"rationale\", \"\"),\n+            downstream_system=raw.get(\"downstream_system\", \"\"),\n+            evidence_refs=tuple(raw.get(\"evidence_refs\", ())),\n+        )\n+\n+\n+@dataclass(frozen=True)\n+class ImplementationOverrideArtifact:\n+    \"\"\"Bind decisions and requirements to one semantic-spec snapshot.\"\"\"\n+\n+    schema_version: str\n+    dataset_id: str\n+    semantic_spec_sha256: str\n+    requirements: tuple[DownstreamRequirement, ...]\n+    overrides: tuple[ImplementationOverride, ...]\n+    downstream_context: dict[str, Any] | None = None\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    def to_json(self, *, indent: int = 2) -> str:\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \"\\n\"\n+\n+    @classmethod\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverrideArtifact:\n+        if raw.get(\"schema_version\") != \"1.0\":\n+            raise ImplementationHandoffError(\n+                \"unsupported implementation-override schema_version; expected '1.0'\"\n+            )\n+        return cls(\n+            schema_version=\"1.0\",\n+            dataset_id=raw[\"dataset_id\"],\n+            semantic_spec_sha256=raw[\"semantic_spec_sha256\"],\n+            requirements=tuple(\n+                DownstreamRequirement.from_dict(item)\n+                for item in raw.get(\"requirements\", ())\n+            ),\n+            overrides=tuple(\n+                ImplementationOverride.from_dict(item)\n+                for item in raw.get(\"overrides\", ())\n+            ),\n+            downstream_context=raw.get(\"downstream_context\"),\n+        )\n+\n+    @classmethod\n+    def read_json(cls, path: str | Path) -> ImplementationOverrideArtifact:\n+        raw = json.loads(Path(path).read_text(encoding=\"utf-8\"))\n+        if not isinstance(raw, dict):\n+            raise ImplementationHandoffError(\n+                \"implementation-override JSON root must be an object\"\n+            )\n+        return cls.from_dict(raw)\n+\n+\n+@dataclass(frozen=True)\n+class ConnectorHandoff:\n+    \"\"\"Connector view with semantic truth and decisions kept separate.\"\"\"\n+\n+    schema_version: str\n+    dataset_id: str\n+    semantic_spec_sha256: str\n+    semantic_spec: dict[str, Any]\n+    blocking_unresolved_fields: tuple[BlockingUnresolvedField, ...]\n+    implementation_overrides: tuple[ImplementationOverride, ...]\n+    implementation_view: dict[str, dict[str, Any]]\n+    downstream_context: dict[str, Any] | None\n+    connector_ready: bool\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    def to_json(self, *, indent: int = 2) -> str:\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \"\\n\"\n+\n+    def write_json(self, path: str | Path) -> None:\n+        Path(path).write_text(self.to_json(), encoding=\"utf-8\")\n+\n+\n+def semantic_spec_sha256(spec: DatasetSpec) -> str:\n+    \"\"\"Return the stable digest binding decisions to a semantic snapshot.\"\"\"\n+    return hashlib.sha256(spec.to_json().encode()).hexdigest()\n+\n+\n+def detect_blocking_unresolved_fields(\n+    spec: DatasetSpec,\n+    requirements: tuple[DownstreamRequirement, ...],\n+) -> tuple[BlockingUnresolvedField, ...]:\n+    \"\"\"Return downstream-required fields whose semantic status is unresolved.\"\"\"\n+    blockers = []\n+    seen: set[str] = set()\n+    for requirement in requirements:\n+        _validate_requirement(requirement)\n+        if requirement.field_path in seen:\n+            raise ImplementationHandoffError(\n+                f\"duplicate downstream requirement for {requirement.field_path!r}\"\n+            )\n+        seen.add(requirement.field_path)\n+        target = _resolve_field(spec, requirement.field_path)\n+        claim = _resolution_claim(target, requirement.field_path)\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\n+            continue\n+        blockers.append(\n+            BlockingUnresolvedField(\n+                field_path=requirement.field_path,\n+                semantic_resolution=claim.status.value,\n+                semantic_value=_json_value(target),\n+                downstream_system=requirement.downstream_system,\n+                requirement=requirement.requirement,\n+                best_supported_candidate=requirement.best_supported_candidate,\n+                supporting_evidence_refs=requirement.supporting_evidence_refs,\n+                remaining_uncertainty=requirement.remaining_uncertainty,\n+            )\n+        )\n+    return tuple(blockers)\n+\n+\n+def build_connector_handoff(\n+    spec: DatasetSpec,\n+    artifact: ImplementationOverrideArtifact,\n+    *,\n+    evidence_ids: set[str] | None = None,\n+) -> ConnectorHandoff:\n+    \"\"\"Validate overrides and build a deterministic connector-facing view.\"\"\"\n+    digest = semantic_spec_sha256(spec)\n+    if artifact.dataset_id != spec.identity.dataset_id:\n+        raise ImplementationHandoffError(\n+            f\"override dataset_id {artifact.dataset_id!r} does not match \"\n+            f\"{spec.identity.dataset_id!r}\"\n+        )\n+    if artifact.semantic_spec_sha256 != digest:\n+        raise ImplementationHandoffError(\n+            \"override artifact targets a different semantic-spec snapshot\"\n+        )\n+\n+    blockers = detect_blocking_unresolved_fields(spec, artifact.requirements)\n+    if evidence_ids is not None and any(\n+        reference not in evidence_ids\n+        for requirement in artifact.requirements\n+        for reference in requirement.supporting_evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"downstream requirement references evidence absent from the bounded evidence run\"\n+        )\n+    requirements = {item.field_path: item for item in artifact.requirements}\n+    overrides: dict[str, ImplementationOverride] = {}\n+    override_ids: set[str] = set()\n+    for override in artifact.overrides:\n+        if override.field_path in overrides:\n+            raise ImplementationHandoffError(\n+                f\"duplicate or conflicting overrides for {override.field_path!r}\"\n+            )\n+        if override.override_id in override_ids:\n+            raise ImplementationHandoffError(\n+                f\"duplicate implementation override id {override.override_id!r}\"\n+            )\n+        requirement = requirements.get(override.field_path)\n+        if requirement is None:\n+            raise ImplementationHandoffError(\n+                f\"override field {override.field_path!r} has no downstream requirement\"\n+            )\n+        target = _resolve_field(spec, override.field_path)\n+        claim = _resolution_claim(target, override.field_path)\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\n+            raise ImplementationHandoffError(\n+                f\"field {override.field_path!r} is {claim.status.value}, not unresolved; \"\n+                \"an implementation override cannot replace semantic truth\"\n+            )\n+        _validate_override(override, requirement, evidence_ids)\n+        overrides[override.field_path] = override\n+        override_ids.add(override.override_id)\n+\n+    implementation_view = {\n+        path: {\n+            \"value\": override.value,\n+            \"value_source\": override.source,\n+            \"override_id\": override.override_id,\n+            \"semantic_resolution\": \"unresolved\",\n+        }\n+        for path, override in sorted(overrides.items())\n+    }\n+    unresolved_paths = {item.field_path for item in blockers}\n+    return ConnectorHandoff(\n+        schema_version=\"1.0\",\n+        dataset_id=spec.identity.dataset_id,\n+        semantic_spec_sha256=digest,\n+        semantic_spec=spec.to_dict(),\n+        blocking_unresolved_fields=blockers,\n+        implementation_overrides=tuple(overrides[path] for path in sorted(overrides)),\n+        implementation_view=implementation_view,\n+        downstream_context=artifact.downstream_context,\n+        connector_ready=unresolved_paths <= set(overrides),\n+    )\n+\n+\n+def _validate_requirement(requirement: DownstreamRequirement) -> None:\n+    if not isinstance(requirement.field_path, str) or not requirement.field_path.strip():\n+        raise ImplementationHandoffError(\"downstream requirement needs a field_path\")\n+    if (\n+        not isinstance(requirement.downstream_system, str)\n+        or not requirement.downstream_system.strip()\n+    ):\n+        raise ImplementationHandoffError(\"downstream requirement needs a downstream_system\")\n+    if not isinstance(requirement.requirement, str) or not requirement.requirement.strip():\n+        raise ImplementationHandoffError(\"downstream requirement needs an explanation\")\n+    if any(\n+        not isinstance(reference, str) or not reference.startswith(\"ev_\")\n+        for reference in requirement.supporting_evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"downstream requirement supporting_evidence_refs must be evidence IDs\"\n+        )\n+\n+\n+def _validate_override(\n+    override: ImplementationOverride,\n+    requirement: DownstreamRequirement,\n+    evidence_ids: set[str] | None,\n+) -> None:\n+    if not isinstance(override.override_id, str) or not override.override_id.strip():\n+        raise ImplementationHandoffError(\"implementation override needs an override_id\")\n+    if override.source != HUMAN_CONFIRMATION:\n+        raise ImplementationHandoffError(\n+            \"implementation override source must be explicit human_confirmation\"\n+        )\n+    if not isinstance(override.approved_by, str) or not override.approved_by.strip():\n+        raise ImplementationHandoffError(\"human confirmation must identify approved_by\")\n+    if override.value is None:\n+        raise ImplementationHandoffError(\"implementation override value must not be null\")\n+    if not isinstance(override.rationale, str) or not override.rationale.strip():\n+        raise ImplementationHandoffError(\"implementation override needs a rationale\")\n+    if override.downstream_system != requirement.downstream_system:\n+        raise ImplementationHandoffError(\n+            \"implementation override downstream_system does not match its requirement\"\n+        )\n+    if any(\n+        not isinstance(reference, str) or not reference.startswith(\"ev_\")\n+        for reference in override.evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"implementation override evidence_refs must be evidence IDs\"\n+        )\n+    if evidence_ids is not None and any(\n+        reference not in evidence_ids for reference in override.evidence_refs\n+    ):\n+        raise ImplementationHandoffError(\n+            \"implementation override references evidence absent from the bounded evidence run\"\n+        )\n+\n+\n+def _resolve_field(root: Any, path: str) -> Any:\n+    if not path:\n+        raise ImplementationHandoffError(\"field_path must not be empty\")\n+    current = root\n+    for token in path.split(\".\"):\n+        match = _FIELD_TOKEN.fullmatch(token)\n+        if match is None:\n+            raise ImplementationHandoffError(f\"invalid field path {path!r}\")\n+        name, raw_index = match.groups()\n+        if not hasattr(current, name):\n+            raise ImplementationHandoffError(f\"field path {path!r} does not exist\")\n+        current = getattr(current, name)\n+        if raw_index is not None:\n+            index = int(raw_index)\n+            if not isinstance(current, (tuple, list)) or index >= len(current):\n+                raise ImplementationHandoffError(f\"field path {path!r} does not exist\")\n+            current = current[index]\n+    return current\n+\n+\n+def _resolution_claim(target: Any, path: str) -> EvidenceClaim:\n+    if isinstance(target, EvidenceClaim):\n+        return target\n+    claim = getattr(target, \"resolution\", None)\n+    if isinstance(claim, EvidenceClaim):\n+        return claim\n+    raise ImplementationHandoffError(\n+        f\"field {path!r} has no semantic resolution and is not eligible for override\"\n+    )\n+\n+\n+def _json_value(value: Any) -> Any:\n+    if hasattr(value, \"__dataclass_fields__\"):\n+        return asdict(value)\n+    return value\n"},"started_at_ms":1789265741366,"completed_at_ms":1789265741366}}
{"timestamp":"2026-09-13T02:15:41.417Z","ordinal":9501,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0988c-8669-7993-a217-149ff9362422","call_id":"call_dObPKWMwA62SgRcITKQYlD5t","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 20960)\nTotal output lines: 3\n\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"3a9f27\",\"wall_time_seconds\":5.83e-7,\"exit_code\":0,\"original_token_count\":6458,\"output\":\"diff --git a/.gitignore b/.gitignore\\nindex 60843c8..216e20c 100644\\n--- a/.gitignore\\n+++ b/.gitignore\\n@@ -11,5 +11,5 @@ __pycache__/\\n .pytest_cache/\\n .ruff_cache/\\n .coverage\\n-.venv/\\n+.venv*/\\n data_sourcing/var/\\ndiff --git a/data_ingestion/src/dataset_profiler/io/hdf5.py b/data_ingestion/src/dataset_profiler/io/hdf5.py\\nnew file mode 100644\\nindex 0000000..f3aae05\\n--- /dev/null\\n+++ b/data_ingestion/src/dataset_profiler/io/hdf5.py\\n@@ -0,0 +1,309 @@\\n+\\\"\\\"\\\"Bounded, streaming inspection helpers for generic HDF5 files.\\\"\\\"\\\"\\n+\\n+from __future__ import annotations\\n+\\n+from dataclasses import dataclass\\n+from pathlib import Path\\n+from typing import Any, Iterator\\n+import hashlib\\n+import math\\n+\\n+import numpy as np\\n+\\n+try:\\n+    import h5py\\n+except ImportError:  # pragma: no cover - guarded by the optional hdf5 extra\\n+    h5py = None\\n+\\n+from ..models import ChannelStats, FileProfile, VariableProfile\\n+from .matlab import sha256_file\\n+\\n+\\n+_MAX_ATTRIBUTE_VALUES = 32\\n+_TARGET_CHUNK_ELEMENTS = 1_000_000\\n+\\n+\\n+@dataclass(frozen=True)\\n+class Hdf5Structure:\\n+    \\\"\\\"\\\"Structural metadata that does not require exposing array contents.\\\"\\\"\\\"\\n+\\n+    root_attributes: dict[str, Any]\\n+    groups: tuple[dict[str, Any], ...]\\n+\\n+\\n+@dataclass\\n+class _Moments:\\n+    count: int = 0\\n+    total: float = 0.0\\n+    total_squares: float = 0.0\\n+    minimum: float | None = None\\n+    maximum: float | None = None\\n+    nan_count: int = 0\\n+    inf_count: int = 0\\n+\\n+    def update(self, values: np.ndarray) -> None:\\n+        if np.issubdtype(values.dtype, np.inexact):\\n+            self.nan_count += int(np.isnan(values).sum())\\n+            self.inf_count += int(np.isinf(values).sum())\\n+            finite = values[np.isfinite(values)]\\n+        else:\\n+            finite = values\\n+        if not finite.size:\\n+            return\\n+        numeric = finite.astype(np.float64, copy=False)\\n+        local_min = float(np.min(numeric))\\n+        local_max = float(np.max(numeric))\\n+        self.minimum = (\\n+            local_min if self.minimum is None else min(self.minimum, local_min)\\n+        )\\n+        self.maximum = (\\n+            local_max if self.maximum is None else max(self.maximum, local_max)\\n+        )\\n+        self.count += int(numeric.size)\\n+        self.total += float(np.sum(numeric, dtype=np.float64))\\n+        self.total_squares += float(np.sum(numeric * numeric, dtype=np.float64))\\n+\\n+    @property\\n+    def mean(self) -> float | None:\\n+        return self.total / self.count if self.count else None\\n+\\n+    @property\\n+    def standard_deviation(self) -> float | None:\\n+        if not self.count:\\n+            return None\\n+        mean = self.total / self.count\\n+        return math.sqrt(max(0.0, self.total_squares / self.count - mean * mean))\\n+\\n+\\n+def inspect_hdf5_file(\\n+    path: str | Path,\\n+    root: str | Path | None = None,\\n+    source_run_id: str = \\\"\\\",\\n+    first_value_count: int = 8,\\n+) -> FileProfile:\\n+    \\\"\\\"\\\"Inspect every dataset in an HDF5 file without materializing large arrays.\\\"\\\"\\\"\\n+    _require_h5py()\\n+    source = Path(path)\\n+    base = Path(root) if root else source.parent\\n+    variables: list[VariableProfile] = []\\n+    with h5py.File(source, \\\"r\\\") as handle:\\n+\\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\\n+            if isinstance(node, h5py.Dataset):\\n+                variables.append(_inspect_dataset(name, node, first_value_count))\\n+\\n+        handle.visititems(visit)\\n+    return FileProfile(\\n+        relative_path=source.relative_to(base).as_posix(),\\n+        source_run_id=source_run_id,\\n+        format=\\\"hdf5\\\",\\n+        size_bytes=source.stat().st_size,\\n+        sha256=sha256_file(source),\\n+        variables=variables,\\n+        loader=\\\"h5py\\\",\\n+    )\\n+\\n+\\n+def inspect_hdf5_structure(path: str | Path) -> Hdf5Structure:\\n+    \\\"\\\"\\\"Return bounded root/group attributes and group paths for one HDF5 file.\\\"\\\"\\\"\\n+    _require_h5py()\\n+    groups: list[dict[str, Any]] = []\\n+    with h5py.File(path, \\\"r\\\") as handle:\\n+        root_attributes = _attributes(handle.attrs)\\n+\\n+        def visit(name: str, node: h5py.Group | h5py.Dataset) -> None:\\n+            if isinstance(node, h5py.Group):\\n+                groups.append({\\\"path\\\": name, \\\"attributes\\\": _attributes(node.attrs)})\\n+\\n+        handle.visititems(visit)\\n+    return Hdf5Structure(root_attributes, tuple(groups))\\n+\\n+\\n+def read_hdf5_excerpt(\\n+    path: str | Path,\\n+    dataset_name: str,\\n+    start: int,\\n+    length: int,\\n+    channels: tuple[int, ...],\\n+    channel_axis: int | None,\\n+) -> tuple[np.ndarray, str, int]:\\n+    \\\"\\\"\\\"Load only a host-validated sample/channel window from an HDF5 dataset.\\\"\\\"\\\"\\n+    _require_h5py()\\n+    with h5py.File(path, \\\"r\\\") as handle:\\n+        dataset = handle[dataset_name]\\n+        if dataset.ndim not in {1, 2} or not np.issubdtype(dataset.dtype, np.number):\\n+            raise ValueError(\\n+                \\\"excerpt source is not a numeric one- or two-dimensional array\\\"\\n+            )\\n+        if dataset.ndim == 1:\\n+            available_samples = dataset.shape[0]\\n+            if channels != (0,):\\n+                raise ValueError(\\\"one-dimensional datasets expose one logical channel\\\")\\n+            excerpt = np.asarray(dataset[start : start + length]).reshape(1, -1)\\n+        elif channel_axis == 1:\\n+            available_samples = dataset.shape[0]\\n+            excerpt = np.stack(\\n+                [\\n+                    np.asarray(dataset[start : start + length, channel])\\n+                    for channel in channels\\n+                ]\\n+            )\\n+        else:\\n+            available_samples = dataset.shape[1]\\n+            excerpt = np.stack(\\n+                [\\n+                    np.asarray(dataset[channel, start : start + length])\\n+                    for channel in channels\\n+                ]\\n+            )\\n+        if start + length > available_samples:\\n+            raise ValueError(\\\"requested excerpt exceeds the available samples\\\")\\n+        return excerpt, str(dataset.dtype), available_samples\\n+\\n+\\n+def _inspect_dataset(\\n+    name: str, dataset: h5py.Dataset, first_value_count: int\\n+) -> VariableProfile:\\n+    numeric = np.issubdtype(dataset.dtype, np.number)\\n+    overall = _Moments()\\n+    channel_axis = _channel_axis(dataset.shape) if numeric else None\\n+    channel_moments = (\\n+        [_Moments() for _ in range(dataset.shape[channel_axis])]\\n+        if channel_axis is not None\\n+        else []\\n+    )\\n+    digest = hashlib.sha256()\\n+    first_values: list[Any] = []\\n+    for values in _chunks(dataset):\\n+        contiguous = np.ascontiguousarray(values)\\n+        digest.update(contiguous.tobytes(order=\\\"C\\\"))\\n+        if len(first_values) < first_value_count:\\n+            remaining = first_value_count - len(first_values)\\n+            first_values.extend(\\n+                _json_scalar(value) for value in contiguous.flat[:remaining]\\n+            )\\n+        if numeric:\\n+            overall.update(contiguous)\\n+            if channel_axis is not None:\\n+                for index, moments in enumerate(channel_moments):\\n+                    moments.update(np.take(contiguous, index, axis=channel_axis))\\n+\\n+    metadata: dict[str, Any] = {\\n+        \\\"hdf5_attributes\\\": _attributes(dataset.attrs),\\n+        \\\"numeric_statistics\\\": {\\n+            \\\"sample_count\\\": overall.count,\\n+            \\\"mean\\\": overall.mean,\\n+            \\\"standard_deviation\\\": overall.standard_deviation,\\n+        }\\n+        if numeric\\n+        else None,\\n+        \\\"structural_axes\\\": {\\n+            \\\"sample_axis\\\": _sample_axis(dataset.shape),\\n+            \\\"channel_axis\\\": channel_axis,\\n+        },\\n+    }\\n+    return VariableProfile(\\n+        name=name,\\n+        python_type=\\\"h5py.Dataset\\\",\\n+        shape=list(dataset.shape),\\n+        dtype=str(dataset.dtype),\\n+        ndim=dataset.ndim,\\n+        size=int(dataset.size),\\n+        minimum=overall.minimum,\\n+        maximum=overall.maximum,\\n+        nan_count=overall.nan_count,\\n+        inf_count=overall.inf_count,\\n+        first_values=first_values,\\n+        channel_stats=[\\n+            _channel_stats(index, moments)\\n+            for index, moments in enumerate(channel_moments)\\n+        ],\\n+        content_sha256=digest.hexdigest(),\\n+        nested_structure=metadata,\\n+    )\\n+\\n+\\n+def _chunks(dataset: h5py.Dataset) -> Iterator[np.ndarray]:\\n+    if dataset.size == 0:\\n+        return\\n+    if dataset.ndim == 0:\\n+        yield np.asarray(dataset[()])\\n+        return\\n+    trailing = math.prod(dataset.shape[1:]) or 1\\n+    rows = max(1, _TARGET_CHUNK_ELEMENTS // trailing)\\n+    for start in range(0, dataset.shape[0], rows):\\n+        yield np.asarray(dataset[start : min(dataset.shape[0], start + rows)])\\n+\\n+\\n+def _sample_axis(shape: tuple[int, ...]) -> int | None:\\n+    if not shape:\\n+        return None\\n+    return max(range(len(shape)), key=lambda index: shape[index])\\n+\\n+\\n+def _channel_axis(shape: tuple[int, ...]) -> int | None:\\n+    if len(shape) != 2 or 0 in shape:\\n+        return None\\n+    sample_axis = _sample_axis(shape)\\n+    return 1 - sample_axis if sample_axis is not None else None\\n+\\n+\\n+def _channel_stats(index: int, moments: _Moments) -> ChannelStats:\\n+    span = (\\n+        moments.maximum - moments.minimum\\n+        if moments.minimum is not None and moments.maximum is not None\\n+        else None\\n+    )\\n+    scale = max(abs(moments.minimum or 0), abs(moments.maximum or 0), 1.0)\\n+    return ChannelStats(\\n+        index=index,\\n+        count=moments.count + moments.nan_count + moments.inf_count,\\n+        minimum=moments.minimum,\\n+        maximum=moments.maximum,\\n+        mean=moments.mean,\\n+        standard_deviation=moments.standard_deviation,\\n+        nan_count=moments.nan_count,\\n+        inf_count=moments.inf_count,\\n+        constant=bool(span == 0),\\n+        near_constant=bool(span is not None and span <= 1e-12 * scale),\\n+    )\\n+\\n+\\n+def _attributes(attributes: h5py.AttributeManager) -> dict[str, Any]:\\n+    return {\\n+        str(name): _bounded_value(value) for name, value in sorted(attributes.items())\\n+    }\\n+\\n+\\n+def _bounded_value(value: Any) -> Any:\\n+    array = np.asarray(value)\\n+    values = [_json_scalar(item) for item in array.reshape(-1)[:_MAX_ATTRIBUTE_VALUES]]\\n+    if array.ndim == 0:\\n+        return values[0] if values else None\\n+    return {\\n+        \\\"shape\\\": list(array.shape),\\n+        \\\"dtype\\\": str(array.dtype),\\n+        \\\"values\\\": values,\\n+        \\\"truncated\\\": array.size > _MAX_ATTRIBUTE_VALUES,\\n+    }\\n+\\n+\\n+def _json_scalar(value: Any) -> Any:\\n+    if isinstance(value, np.generic):\\n+        value = value.item()\\n+    if isinstance(value, bytes):\\n+        return value.decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n+    if isinstance(value, complex):\\n+        return {\\\"real\\\": value.real, \\\"imag\\\": value.imag}\\n+    if isinstance(value, float) and not np.isfinite(value):\\n+        return \\\"NaN\\\" if np.isnan(value) else (\\\"Infinity\\\" if value > 0 else \\\"-Infinity\\\")\\n+    return (\\n+        value\\n+        if isinstance(value, (str, int, float, bool)) or value is None\\n+        else repr(value)\\n+    )\\n+\\n+\\n+def _require_h5py() -> None:\\n+    if h5py is None:\\n+        raise RuntimeError(\\\"HDF5 support requires the optional 'hdf5' extra\\\")\\ndiff --git a/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\\nnew file mode 100644\\nindex 0000000..558252e\\n--- /dev/null\\n+++ b/data_ingestion/src/dataset_profiler/semantic_spec/implementation_handoff.py\\n@@ -0,0 +1,364 @@\\n+\\\"\\\"\\\"Human-approved implementation decisions layered over immutable semantic specs.\\\"\\\"\\\"\\n+\\n+from __future__ import annotations\\n+\\n+from dataclasses import asdict, dataclass\\n+import hashlib\\n+import json\\n+from pathlib import Path\\n+import re\\n+from typing import Any\\n+\\n+from .models import DatasetSpec, EvidenceClaim, EvidenceStatus\\n+\\n+\\n+HUMAN_CONFIRMATION = \\\"human_confirmation\\\"\\n+_FIELD_TOKEN = re.compile(r\\\"([A-Za-z_][A-Za-z0-9_]*)(?:\\\\[([0-9]+)\\\\])?\\\")\\n+\\n+\\n+class ImplementationHandoffError(ValueError):\\n+    \\\"\\\"\\\"Report an invalid downstream requirement or implementation override.\\\"\\\"\\\"\\n+\\n+\\n+@dataclass(frozen=True)\\n+class DownstreamRequirement:\\n+    \\\"\\\"\\\"Describe one semantic value required by a downstream interface.\\\"\\\"\\\"\\n+\\n+    field_path: str\\n+    downstream_system: str\\n+    requirement: str\\n+    best_supported_candidate: Any = None\\n+    supporting_evidence_refs: tuple[str, ...] = ()\\n+    remaining_uncertainty: str | None = None\\n+\\n+    @classmethod\\n+    def from_dict(cls, raw: dict[str, Any]) -> DownstreamRequirement:\\n+        return cls(\\n+            field_path=raw[\\\"field_path\\\"],\\n+            downstream_system=raw[\\\"downstream_system\\\"],\\n+            requirement=raw[\\\"requirement\\\"],\\n+            best_supported_candidate=raw.get(\\\"best_supported_candidate\\\"),\\n+            supporting_evidence_refs=tuple(raw.get(\\\"supporting_evidence_refs\\\", ())),\\n+            remaining_uncertainty=raw.get(\\\"remaining_uncertainty\\\"),\\n+        )\\n+\\n+\\n+@dataclass(frozen=True)\\n+class BlockingUnresolvedField:\\n+    \\\"\\\"\\\"Expose an unresolved semantic field that prevents implementation.\\\"\\\"\\\"\\n+\\n+    field_path: str\\n+    semantic_resolution: str\\n+    semantic_value: Any\\n+    downstream_system: str\\n+    requirement: str\\n+    best_supported_candidate: Any\\n+    supporting_evidence_refs: tuple[str, ...]\\n+    remaining_uncertainty: str | None\\n+\\n+\\n+@dataclass(frozen=True)\\n+class ImplementationOverride:\\n+    \\\"\\\"\\\"Record an approved downstream value that is not semantic evidence.\\\"\\\"\\\"\\n+\\n+    override_id: str\\n+    field_path: str\\n+    value: Any\\n+    source: str\\n+    approved_by: str\\n+    rationale: str\\n+    downstream_system: str\\n+    evidence_refs: tuple[str, ...] = ()\\n+\\n+    @classmethod\\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverride:\\n+        return cls(\\n+            override_id=raw[\\\"override_id\\\"],\\n+            field_path=raw[\\\"field_path\\\"],\\n+            value=raw.get(\\\"value\\\"),\\n+            source=raw.get(\\\"source\\\", \\\"\\\"),\\n+            approved_by=raw.get(\\\"approved_by\\\", \\\"\\\"),\\n+            rationale=raw.get(\\\"rationale\\\", \\\"\\\"),\\n+            downstream_system=raw.get(\\\"downstream_system\\\", \\\"\\\"),\\n+            evidence_refs=tuple(raw.get(\\\"evidence_refs\\\", ())),\\n+        )\\n+\\n+\\n+@dataclass(frozen=True)\\n+class ImplementationOverrideArtifact:\\n+    \\\"\\\"\\\"Bind decisions and requirements to one semantic-spec snapshot.\\\"\\\"\\\"\\n+\\n+    schema_version: str\\n+    dataset_id: str\\n+    semantic_spec_sha256: str\\n+    requirements: tuple[DownstreamRequirement, ...]\\n+    overrides: tuple[ImplementationOverride, ...]\\n+    downstream_context: dict[str, Any] | None = None\\n+\\n+    def to_dict(self) -> dict[str, Any]:\\n+        return asdict(self)\\n+\\n+    def to_json(self, *, indent: int = 2) -> str:\\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \\\"\\\\n\\\"\\n+\\n+    @classmethod\\n+    def from_dict(cls, raw: dict[str, Any]) -> ImplementationOverrideArtifact:\\n+        if raw.get(\\\"schema_version\\\") != \\\"1.0\\\":\\n+            raise ImplementationHandoffError(\\n+                \\\"unsupported implementation-override schema_version; expected '1.0'\\\"\\n+            )\\n+        return cls(\\n+            schema_version=\\\"1.0\\\",\\n+            dataset_id=raw[\\\"dataset_id\\\"],\\n+            semantic_spec_sha256=raw[\\\"semantic_spec_sha256\\\"],\\n+            requirements=tuple(\\n+                DownstreamRequirement.from_dict(item)\\n+                for item in raw.get(\\\"requirements\\\", ())\\n+            ),\\n+            overrides=tuple(\\n+                ImplementationOverride.from_dict(item)\\n+                for item in raw.get(\\\"overrides\\\", ())\\n+            ),\\n+            downstream_context=raw.get(\\\"downstream_context\\\"),\\n+        )\\n+\\n+    @classmethod\\n+    def read_json(cls, path: str | Path) -> ImplementationOverrideArtifact:\\n+        raw = json.loads(Path(path).read_text(encoding=\\\"utf-8\\\"))\\n+        if not isinstance(raw, dict):\\n+            raise ImplementationHandoffError(\\n+                \\\"implementation-override JSON root must be an object\\\"\\n+            )\\n+        return cls.from_dict(raw)\\n+\\n+\\n+@dataclass(frozen=True)\\n+class ConnectorHandoff:\\n+    \\\"\\\"\\\"Connector view with semantic truth and decisions kept separate.\\\"\\\"\\\"\\n+\\n+    schema_version: str\\n+    dataset_id: str\\n+    semantic_spec_sha256: str\\n+    semantic_spec: dict[str, Any]\\n+    blocking_unresolved_fields: tuple[BlockingUnresolvedField, ...]\\n+    implementation_overrides: tuple[ImplementationOverride, ...]\\n+    implementation_view: dict[str, dict[str, Any]]\\n+    downstream_context: dict[str, Any] | None\\n+    connector_ready: bool\\n+\\n+    def to_dict(self) -> dict[str, Any]:\\n+        return asdict(self)\\n+\\n+    def to_json(self, *, indent: int = 2) -> str:\\n+        return json.dumps(self.to_dict(), indent=indent, allow_nan=False) + \\\"\\\\n\\\"\\n+\\n+    def write_json(self, path: str | Path) -> None:\\n+        Path(path).write_text(self.to_json(), encoding=\\\"utf-8\\\")\\n+\\n+\\n+def semantic_spec_sha256(spec: DatasetSpec) -> str:\\n+    \\\"\\\"\\\"Return the stable digest binding decisions to a semantic snapshot.\\\"\\\"\\\"\\n+    return hashlib.sha256(spec.to_json().encode()).hexdigest()\\n+\\n+\\n+def detect_blocking_unresolved_fields(\\n+    spec: DatasetSpec,\\n+    requirements: tuple[DownstreamRequirement, ...],\\n+) -> tuple[BlockingUnresolvedField, ...]:\\n+    \\\"\\\"\\\"Return downstream-required fields whose semantic status is unresolved.\\\"\\\"\\\"\\n+    blockers = []\\n+    seen: set[str] = set()\\n+    for requirement in requirements:\\n+        _validate_requirement(requirement)\\n+        if requirement.field_path in seen:\\n+            raise ImplementationHandoffError(\\n+                f\\\"duplicate downstream requirement for {requirement.field_path!r}\\\"\\n+            )\\n+        seen.add(requirement.field_path)\\n+        target = _resolve_field(spec, requirement.field_path)\\n+        claim = _resolution_claim(target, requirement.field_path)\\n+        if claim.status is not EvidenceStatus.UNRESOLVED:\\n+            continue\\n+        blockers.append(\\n+            BlockingUnresolvedField(\\n+                field_path=requirement.field_path,\\n+                semantic_resolution=claim.status.value,\\n+                semantic_value=_json_value(target),\\n+                downstream_system=requirement.downstream_system,\\n+                requirement=requirement.requirement,\\n+                best_supported_candidate=requirement.best_supported_candidate,\\n+                supporting_evidence_refs=requirement.supporting_evidence_refs,\\n+                remaining_uncertainty=requirement.remaining_uncertainty,\\n+            )\\n+        )\\n+    return tuple(blockers)\\n+\\n+\\n+def build_connector_handoff(\\n+    spec: DatasetSpec,\\n+    artifact: ImplementationOverrideArtifact,\\n+    *,\\n+    evidence_ids: set[str] | None = None,\\n+) -> ConnectorHandoff:\\n+    \\\"\\\"\\\"Validate overrides and build a deterministic connector-facing view.\\\"\\\"\\\"\\n+    digest = semantic_spec_sha256(spec)\\n+    if artifact.dataset_id != spec.identity.dataset_id:\\n+        raise ImplementationHandoffError(\\n+            f\\\"override dataset_id {artifact.dataset_id!r} does not match \\\"\\n+            f\\\"{spec.identity.dataset_id!r}\\\"\\n+        )\\n+    if artifact.semantic_spec_sha256 != digest:\\n+        raise ImplementationHandoffError(\\n+            \\\"override artifact targets a different semantic-spec snapshot\\\"\\n+        )\\n+\\n+    blockers = detect_blocking_unresolved_fields(spec, a…10960 tokens truncated…\\\",\\n+            \\\"An observed sampling-rate claim requires a rate for every profiled run.\\\")\\n+\\n+\\n def _normalized_text(value: str) -> str:\\n     return \\\" \\\".join(re.findall(r\\\"[a-z0-9]+\\\", value.casefold()))\\n\"}}\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"55dc1c\",\"wall_time_seconds\":0.000001292,\"exit_code\":0,\"original_token_count\":4687,\"output\":\"diff --git a/data_ingestion/tests/test_dataset_spec.py b/data_ingestion/tests/test_dataset_spec.py\\nindex 3656a45..60b7588 100644\\n--- a/data_ingestion/tests/test_dataset_spec.py\\n+++ b/data_ingestion/tests/test_dataset_spec.py\\n@@ -1,5 +1,6 @@\\n from dataclasses import replace\\n from pathlib import Path\\n+from unittest.mock import patch\\n \\n import numpy as np\\n from scipy.io import savemat\\n@@ -12,7 +13,10 @@ from dataset_profiler.semantic_spec import (\\n     load_kuka_collision_part1_spec,\\n     validate_dataset_spec,\\n )\\n+from dataset_profiler.semantic_agent.agent import SemanticAgentRun\\n+from dataset_profiler.semantic_agent.repair import run_repairs\\n from dataset_profiler.semantic_spec.models import IndexConversion, SourceVariable\\n+from dataset_profiler.semantic_spec.validation import ValidationIssue, ValidationResult\\n \\n \\n def _profile(tmp_path: Path):\\n@@ -37,6 +41,45 @@ def _codes(profile, spec):\\n     return {issue.code for issue in validate_dataset_spec(profile, spec).errors}\\n \\n \\n+def _v02_spec(profile, *, rate=2000.0, rate_status=\\\"documented\\\", rate_evidence=None,\\n+              observed_dtypes=(\\\"float64\\\",)):\\n+    return DatasetSpec.from_dict({\\n+        \\\"schema_version\\\": \\\"0.2\\\",\\n+        \\\"identity\\\": {\\\"dataset_id\\\": profile.dataset_id,\\n+                     \\\"source_subsets\\\": [profile.source[\\\"scope\\\"]],\\n+                     \\\"compatible_profile_ids\\\": []},\\n+        \\\"record_discovery\\\": {\\\"record_unit\\\": \\\"record\\\",\\n+                             \\\"boundary\\\": profile.observed_structure[\\\"record_boundary\\\"],\\n+                             \\\"included_run_ids\\\": []},\\n+        \\\"source_variables\\\": [{\\\"name\\\": \\\"MsrExtTrq\\\", \\\"role\\\": \\\"signal\\\"}],\\n+        \\\"signals\\\": [{\\n+            \\\"source_variable\\\": \\\"MsrExtTrq\\\", \\\"semantic_type\\\": \\\"generic_signal\\\",\\n+            \\\"channels\\\": {\\\"count\\\": 7, \\\"source_indices\\\": [1, 2, 3, 4, 5, 6, 7],\\n+                         \\\"target_names\\\": [f\\\"channel_{index}\\\" for index in range(7)]},\\n+            \\\"dtype\\\": None, \\\"observed_dtypes\\\": list(observed_dtypes),\\n+            \\\"unit\\\": {\\\"name\\\": None, \\\"symbol\\\": None,\\n+                     \\\"resolution\\\": {\\\"status\\\": \\\"unresolved\\\", \\\"confidence\\\": None,\\n+                                    \\\"evidence\\\": []}},\\n+            \\\"sampling\\\": {\\\"rate_hz\\\": None, \\\"time_axis\\\": \\\"sample_clock\\\"},\\n+            \\\"semantics\\\": {\\\"status\\\": \\\"documented\\\", \\\"confidence\\\": \\\"high\\\",\\n+                          \\\"evidence\\\": [\\\"ev_documentation_signal_123\\\"]},\\n+        }],\\n+        \\\"time_axes\\\": [{\\n+            \\\"name\\\": \\\"sample_clock\\\", \\\"source_variable\\\": None,\\n+            \\\"kind\\\": \\\"implicit_regular\\\", \\\"unit\\\": \\\"second\\\", \\\"monotonic\\\": True,\\n+            \\\"embedded_signal_row\\\": None, \\\"sample_index_origin\\\": 0,\\n+            \\\"sampling_rate\\\": {\\\"value\\\": rate, \\\"unit\\\": \\\"Hz\\\",\\n+                              \\\"resolution\\\": {\\\"status\\\": rate_status,\\n+                                             \\\"confidence\\\": \\\"high\\\",\\n+                                             \\\"evidence\\\": rate_evidence or [\\n+                                                 \\\"ev_documentation_sampling_123\\\"\\n+                                             ]}},\\n+        }],\\n+        \\\"events\\\": [], \\\"provenance\\\": [], \\\"tasks\\\": [],\\n+        \\\"record_defaults\\\": {\\\"subject_ids\\\": [], \\\"start_time\\\": None},\\n+    })\\n+\\n+\\n def test_kuka_reference_spec_round_trips_and_validates(tmp_path):\\n     profile = _profile(tmp_path)\\n     spec = load_kuka_collision_part1_spec()\\n@@ -134,3 +177,97 @@ def test_undeclared_source_reference_is_repairable_issue(tmp_path):\\n     spec = replace(spec, source_variables=declarations)\\n \\n     assert \\\"UNDECLARED_SOURCE_VARIABLE\\\" in _codes(profile, spec)\\n+\\n+\\n+def test_documented_implicit_clock_does_not_require_raw_timestamps(tmp_path):\\n+    profile = _profile(tmp_path)\\n+    for run in profile.runs:\\n+        run.sampling_rate_hz = None\\n+        run.timestamps_monotonic = None\\n+    spec = _v02_spec(profile)\\n+\\n+    assert validate_dataset_spec(profile, spec).valid\\n+    axis = spec.time_axes[0]\\n+    assert axis.source_variable is None\\n+    assert axis.sample_index_origin == 0\\n+    assert axis.sampling_rate.value == 2000.0\\n+\\n+\\n+def test_documented_sampling_rate_fails_when_raw_observation_contradicts_it(tmp_path):\\n+    profile = _profile(tmp_path)\\n+    spec = _v02_spec(profile, rate=2000.0)\\n+\\n+    assert \\\"SAMPLING_RATE_CONTRADICTION\\\" in _codes(profile, spec)\\n+\\n+\\n+def test_v02_accepts_homogeneous_and_heterogeneous_observed_dtype_sets(tmp_path):\\n+    profile = _profile(tmp_path)\\n+    for run in profile.runs:\\n+        run.sampling_rate_hz = None\\n+        run.timestamps_monotonic = None\\n+    homogeneous = _v02_spec(profile)\\n+    assert validate_dataset_spec(profile, homogeneous).valid\\n+\\n+    next(item for item in profile.signals\\n+         if item[\\\"observed_name\\\"] == \\\"MsrExtTrq\\\")[\\\"observed_dtypes\\\"] = [\\n+             \\\"float32\\\", \\\"float64\\\", \\\"int64\\\"\\n+         ]\\n+    heterogeneous = _v02_spec(\\n+        profile, observed_dtypes=(\\\"float32\\\", \\\"float64\\\", \\\"int64\\\")\\n+    )\\n+    assert validate_dataset_spec(profile, heterogeneous).valid\\n+\\n+    false_mixed = replace(heterogeneous.signals[0], dtype=\\\"mixed\\\", observed_dtypes=())\\n+    invalid = replace(heterogeneous, signals=(false_mixed,))\\n+    codes = _codes(profile, invalid)\\n+    assert \\\"INVALID_DTYPE_REPRESENTATION\\\" in codes\\n+    assert \\\"DTYPE_SET_MISMATCH\\\" in codes\\n+\\n+\\n+def test_v02_documented_claim_requires_documentation_evidence_id(tmp_path):\\n+    profile = _profile(tmp_path)\\n+    for run in profile.runs:\\n+        run.sampling_rate_hz = None\\n+        run.timestamps_monotonic = None\\n+    spec = _v02_spec(profile, rate_evidence=[\\\"ev_signal_statistics_rate_123\\\"])\\n+\\n+    assert \\\"INVALID_DOCUMENTATION_EVIDENCE\\\" in _codes(profile, spec)\\n+\\n+\\n+def test_v02_claim_reference_must_exist_in_run_evidence(tmp_path):\\n+    profile = _profile(tmp_path)\\n+    for run in profile.runs:\\n+        run.sampling_rate_hz = None\\n+        run.timestamps_monotonic = None\\n+    spec = _v02_spec(profile)\\n+\\n+    result = validate_dataset_spec(profile, spec, evidence_ids=set())\\n+    assert \\\"UNKNOWN_EVIDENCE_REFERENCE\\\" in {issue.code for issue in result.errors}\\n+\\n+\\n+def test_repair_returns_best_candidate_when_later_round_regresses(tmp_path):\\n+    profile = _profile(tmp_path)\\n+    initial = load_kuka_collision_part1_spec()\\n+    round_one = replace(initial, schema_version=\\\"round-one\\\")\\n+    round_two = replace(initial, schema_version=\\\"round-two\\\")\\n+\\n+    def result(count):\\n+        issues = tuple(ValidationIssue(f\\\"ISSUE_{index}\\\", \\\"path\\\", \\\"message\\\")\\n+                       for index in range(count))\\n+        return ValidationResult(not issues, issues)\\n+\\n+    runs = [SemanticAgentRun(round_one, {\\\"round\\\": 1}),\\n+            SemanticAgentRun(round_two, {\\\"round\\\": 2})]\\n+    with patch(\\\"dataset_profiler.semantic_agent.repair.validate_dataset_spec\\\",\\n+               side_effect=[result(12), result(2), result(5)]), patch(\\n+        \\\"dataset_profiler.semantic_agent.repair.repair_dataset_spec\\\", side_effect=runs\\n+    ):\\n+        rounds, final_spec, final_validation, selection = run_repairs(\\n+            profile, [], initial, object()\\n+        )\\n+\\n+    assert final_spec is round_one\\n+    assert len(final_validation.errors) == 2\\n+    assert selection[\\\"best_round\\\"] == 1\\n+    assert rounds[0][\\\"accepted_as_best\\\"] is True\\n+    assert rounds[1][\\\"accepted_as_best\\\"] is False\\ndiff --git a/data_ingestion/tests/test_implementation_handoff.py b/data_ingestion/tests/test_implementation_handoff.py\\nnew file mode 100644\\nindex 0000000..5f42b11\\n--- /dev/null\\n+++ b/data_ingestion/tests/test_implementation_handoff.py\\n@@ -0,0 +1,205 @@\\n+from dataclasses import replace\\n+from pathlib import Path\\n+\\n+import pytest\\n+\\n+from dataset_profiler.semantic_agent.profile_io import read_dataset_profile\\n+from dataset_profiler.semantic_spec import (\\n+    DatasetSpec,\\n+    DownstreamRequirement,\\n+    ImplementationHandoffError,\\n+    ImplementationOverride,\\n+    ImplementationOverrideArtifact,\\n+    build_connector_handoff,\\n+    detect_blocking_unresolved_fields,\\n+    semantic_spec_sha256,\\n+    validate_dataset_spec,\\n+)\\n+from dataset_profiler.semantic_spec.models import Confidence, EvidenceClaim, EvidenceStatus\\n+\\n+\\n+_ROOT = Path(__file__).parents[1]\\n+_BOSCH_SPEC_PATH = _ROOT / \\\"outputs/bosch_cnc_v02_final/final_spec.json\\\"\\n+_BOSCH_PROFILE_PATH = _ROOT / \\\"outputs/bosch_cnc_profile.json\\\"\\n+_KUKA_SPEC_PATH = _ROOT / \\\"outputs/kuka_part1_agent_validator_repair/final_spec.json\\\"\\n+_KUKA_PROFILE_PATH = _ROOT / \\\"outputs/dataset_profile.json\\\"\\n+_CISS_ID = \\\"ev_documentation_ciss_58517c77b913\\\"\\n+_MG_ID = \\\"ev_documentation_mg_bd382bd44290\\\"\\n+_LOADER_ID = \\\"ev_documentation_not_rescaled_32bf9d638e4e\\\"\\n+_TRANSFORMATION_ID = \\\"ev_documentation_transformation_509e1e2fa633\\\"\\n+_EVIDENCE_IDS = {_CISS_ID, _MG_ID, _LOADER_ID, _TRANSFORMATION_ID}\\n+\\n+\\n+def _bosch_spec() -> DatasetSpec:\\n+    return DatasetSpec.read_json(_BOSCH_SPEC_PATH)\\n+\\n+\\n+def _requirement(field_path: str = \\\"signals[0].unit\\\") -> DownstreamRequirement:\\n+    return DownstreamRequirement(\\n+        field_path=field_path,\\n+        downstream_system=\\\"TimeF TimeSeriesSpec.unit_value\\\",\\n+        requirement=\\\"TimeF requires a concrete Pint unit.\\\",\\n+        best_supported_candidate={\\n+            \\\"name\\\": \\\"milligravity\\\",\\n+            \\\"symbol\\\": \\\"mg\\\",\\n+            \\\"timef_unit\\\": \\\"milligravity\\\",\\n+        },\\n+        supporting_evidence_refs=tuple(sorted(_EVIDENCE_IDS)),\\n+        remaining_uncertainty=\\\"The acquisition-to-HDF5 transformation is undocumented.\\\",\\n+    )\\n+\\n+\\n+def _override(**changes) -> ImplementationOverride:\\n+    values = {\\n+        \\\"override_id\\\": \\\"bosch-cnc-unit-mg-human-approval-v1\\\",\\n+        \\\"field_path\\\": \\\"signals[0].unit\\\",\\n+        \\\"value\\\": {\\n+            \\\"name\\\": \\\"milligravity\\\",\\n+            \\\"symbol\\\": \\\"mg\\\",\\n+            \\\"timef_unit\\\": \\\"milligravity\\\",\\n+        },\\n+        \\\"source\\\": \\\"human_confirmation\\\",\\n+        \\\"approved_by\\\": \\\"user\\\",\\n+        \\\"rationale\\\": \\\"Use the approved candidate without changing semantic truth.\\\",\\n+        \\\"downstream_system\\\": \\\"TimeF TimeSeriesSpec.unit_value\\\",\\n+        \\\"evidence_refs\\\": tuple(sorted(_EVIDENCE_IDS)),\\n+    }\\n+    values.update(changes)\\n+    return ImplementationOverride(**values)\\n+\\n+\\n+def _artifact(\\n+    spec: DatasetSpec,\\n+    *overrides: ImplementationOverride,\\n+    requirements: tuple[DownstreamRequirement, ...] | None = None,\\n+) -> ImplementationOverrideArtifact:\\n+    return ImplementationOverrideArtifact(\\n+        schema_version=\\\"1.0\\\",\\n+        dataset_id=spec.identity.dataset_id,\\n+        semantic_spec_sha256=semantic_spec_sha256(spec),\\n+        requirements=requirements or (_requirement(),),\\n+        overrides=overrides,\\n+        downstream_context={\\\"dataset_id\\\": \\\"boschresearch/cnc-machining\\\"},\\n+    )\\n+\\n+\\n+def test_unresolved_field_can_receive_explicit_human_override():\\n+    spec = _bosch_spec()\\n+\\n+    handoff = build_connector_handoff(\\n+        spec, _artifact(spec, _override()), evidence_ids=_EVIDENCE_IDS\\n+    )\\n+\\n+    assert handoff.connector_ready is True\\n+    assert handoff.implementation_view[\\\"signals[0].unit\\\"][\\\"value\\\"][\\\"symbol\\\"] == \\\"mg\\\"\\n+    assert handoff.implementation_view[\\\"signals[0].unit\\\"][\\\"value_source\\\"] == (\\n+        \\\"human_confirmation\\\"\\n+    )\\n+\\n+\\n+def test_override_does_not_mutate_dataset_spec():\\n+    spec = _bosch_spec()\\n+    before = spec.to_json()\\n+\\n+    handoff = build_connector_handoff(spec, _artifact(spec, _override()))\\n+\\n+    assert spec.to_json() == before\\n+    assert handoff.semantic_spec == spec.to_dict()\\n+    assert spec.signals[0].unit.resolution.status is EvidenceStatus.UNRESOLVED\\n+    assert spec.signals[0].unit.name is None\\n+    assert spec.signals[0].unit.symbol is None\\n+\\n+\\n+def test_documented_field_cannot_be_silently_overridden():\\n+    spec = _bosch_spec()\\n+    documented = replace(\\n+        spec.signals[0].unit,\\n+        name=\\\"acceleration\\\",\\n+        symbol=\\\"m/s^2\\\",\\n+        resolution=EvidenceClaim(\\n+            EvidenceStatus.DOCUMENTED,\\n+            Confidence.HIGH,\\n+            (\\\"ev_documentation_unit_existing\\\",),\\n+        ),\\n+    )\\n+    spec = replace(spec, signals=(replace(spec.signals[0], unit=documented),))\\n+\\n+    with pytest.raises(ImplementationHandoffError, match=\\\"not unresolved\\\"):\\n+        build_connector_handoff(spec, _artifact(spec, _override()))\\n+\\n+\\n+def test_duplicate_and_conflicting_overrides_are_rejected():\\n+    spec = _bosch_spec()\\n+\\n+    with pytest.raises(ImplementationHandoffError, match=\\\"duplicate or conflicting\\\"):\\n+        build_connector_handoff(spec, _artifact(spec, _override(), _override()))\\n+\\n+\\n+def test_missing_human_confirmation_is_rejected():\\n+    spec = _bosch_spec()\\n+\\n+    with pytest.raises(ImplementationHandoffError, match=\\\"human_confirmation\\\"):\\n+        build_connector_handoff(\\n+            spec, _artifact(spec, _override(source=\\\"agent_recommendation\\\"))\\n+        )\\n+\\n+\\n+def test_blocker_is_auditable_before_approval():\\n+    blocker = detect_blocking_unresolved_fields(_bosch_spec(), (_requirement(),))[0]\\n+\\n+    assert blocker.field_path == \\\"signals[0].unit\\\"\\n+    assert blocker.semantic_resolution == \\\"unresolved\\\"\\n+    assert blocker.semantic_value[\\\"name\\\"] is None\\n+    assert blocker.best_supported_candidate[\\\"symbol\\\"] == \\\"mg\\\"\\n+    assert blocker.supporting_evidence_refs\\n+    assert \\\"acquisition-to-HDF5\\\" in blocker.remaining_uncertainty\\n+\\n+\\n+def test_valid_handoff_retains_approval_provenance_and_connector_context():\\n+    spec = _bosch_spec()\\n+    handoff = build_connector_handoff(spec, _artifact(spec, _override()))\\n+\\n+    saved = handoff.implementation_overrides[0]\\n+    assert saved.source == \\\"human_confirmation\\\"\\n+    assert saved.approved_by == \\\"user\\\"\\n+    assert saved.evidence_refs == tuple(sorted(_EVIDENCE_IDS))\\n+    assert saved.rationale\\n+    assert handoff.downstream_context[\\\"dataset_id\\\"] == \\\"boschresearch/cnc-machining\\\"\\n+\\n+\\n+def test_unknown_evidence_reference_is_rejected():\\n+    spec = _bosch_spec()\\n+    unknown = replace(_requirement(), supporting_evidence_refs=(\\\"ev_unknown\\\",))\\n+\\n+    with pytest.raises(ImplementationHandoffError, match=\\\"absent\\\"):\\n+        build_connector_handoff(\\n+            spec,\\n+            _artifact(spec, _override(), requirements=(unknown,)),\\n+            evidence_ids=_EVIDENCE_IDS,\\n+        )\\n+\\n+\\n+def test_bosch_timef_unit_uses_unambiguous_pint_name():\\n+    from timenet.types import ureg\\n+\\n+    spec = _bosch_spec()\\n+    handoff = build_connector_handoff(spec, _artifact(spec, _override()))\\n+    unit_name = handoff.implementation_view[\\\"signals[0].unit\\\"][\\\"value\\\"][\\\"timef_unit\\\"]\\n+\\n+    assert str(ureg.Unit(unit_name)) == \\\"millistandard_gravity\\\"\\n+    assert str(ureg.Unit(\\\"mg\\\")) == \\\"milligram\\\"\\n+\\n+\\n+def test_original_bosch_spec_remains_valid_and_unresolved():\\n+    spec = _bosch_spec()\\n+    profile = read_dataset_profile(_BOSCH_PROFILE_PATH)\\n+\\n+    assert validate_dataset_spec(profile, spec).valid\\n+    assert spec.signals[0].unit.resolution.status is EvidenceStatus.UNRESOLVED\\n+\\n+\\n+def test_kuka_regression_validation_is_unchanged():\\n+    spec = DatasetSpec.read_json(_KUKA_SPEC_PATH)\\n+    profile = read_dataset_profile(_KUKA_PROFILE_PATH)\\n+\\n+    assert validate_dataset_spec(profile, spec).valid\\ndiff --git a/data_ingestion/tests/test_profiler.py b/data_ingestion/tests/test_profiler.py\\nindex a410bdd..7183c63 100644\\n--- a/data_ingestion/tests/test_profiler.py\\n+++ b/data_ingestion/tests/test_profiler.py\\n@@ -8,8 +8,13 @@ import unittest\\n import numpy as np\\n from scipy.io import savemat\\n \\n-from dataset_profiler.datasets import KukaCollisionHints\\n+try:\\n+    import h5py\\n+except ImportError:  # pragma: no cover - exercised by the hdf5 extra\\n+    h5py = None\\n+\\n from dataset_profiler.inspection import inspect_mat_file\\n+from dataset_profiler.io.hdf5 import inspect_hdf5_file, inspect_hdf5_structure\\n from dataset_profiler.profiler import profile_dataset\\n \\n \\n@@ -63,6 +68,57 @@ class ProfilerTests(unittest.TestCase):\\n             self.assertEqual(variable.name, \\\"metadata\\\")\\n             self.assertIsNotNone(variable.nested_structure)\\n \\n+    @unittest.skipIf(h5py is None, \\\"hdf5 extra is not installed\\\")\\n+    def test_hdf5_inspector_reports_structure_attributes_and_bounded_stats(self) -> None:\\n+        with tempfile.TemporaryDirectory() as directory:\\n+            path = Path(directory) / \\\"signal.h5\\\"\\n+            with h5py.File(path, \\\"w\\\") as handle:\\n+                handle.attrs[\\\"creator\\\"] = \\\"fixture\\\"\\n+                group = handle.create_group(\\\"sensors\\\")\\n+                group.attrs[\\\"location\\\"] = \\\"test\\\"\\n+                values = np.array([[1.0, 2.0], [3.0, np.nan], [np.inf, 6.0]])\\n+                dataset = group.create_dataset(\\\"values\\\", data=values)\\n+                dataset.attrs[\\\"units\\\"] = np.array([\\\"a\\\", \\\"b\\\"], dtype=\\\"S1\\\")\\n+\\n+            result = inspect_hdf5_file(path)\\n+            variable = result.variables[0]\\n+            self.assertEqual(variable.name, \\\"sensors/values\\\")\\n+            self.assertEqual(variable.shape, [3, 2])\\n+            self.assertEqual(variable.nan_count, 1)\\n+            self.assertEqual(variable.inf_count, 1)\\n+            self.assertEqual(len(variable.channel_stats), 2)\\n+            self.assertEqual(variable.nested_structure[\\\"structural_axes\\\"][\\\"sample_axis\\\"], 0)\\n+            self.assertEqual(variable.nested_structure[\\\"hdf5_attributes\\\"][\\\"units\\\"][\\\"values\\\"], [\\\"a\\\", \\\"b\\\"])\\n+            self.assertAlmostEqual(variable.nested_structure[\\\"numeric_statistics\\\"][\\\"mean\\\"], 3.0)\\n+\\n+            structure = inspect_hdf5_structure(path)\\n+            self.assertEqual(structure.root_attributes, {\\\"creator\\\": \\\"fixture\\\"})\\n+            self.assertEqual(structure.groups[0][\\\"path\\\"], \\\"sensors\\\")\\n+\\n+    @unittest.skipIf(h5py is None, \\\"hdf5 extra is not installed\\\")\\n+    def test_profiles_recursive_hdf5_files_as_records(self) -> None:\\n+        with tempfile.TemporaryDirectory() as directory:\\n+            root = Path(directory)\\n+            for relative, dtype, length in (\\n+                (\\\"machine-a/process-a/group-a/one.h5\\\", np.float32, 5),\\n+                (\\\"machine-b/process-b/group-b/two.h5\\\", np.int64, 7),\\n+            ):\\n+                path = root / relative\\n+                path.parent.mkdir(parents=True, exist_ok=True)\\n+                with h5py.File(path, \\\"w\\\") as handle:\\n+                    handle.create_dataset(\\\"measurements\\\", data=np.arange(\\n+                        length * 3, dtype=dtype).reshape(length, 3))\\n+\\n+            profile = profile_dataset(root, \\\"hdf5-fixture\\\")\\n+            self.assertEqual(len(profile.files), 2)\\n+            self.assertEqual(len(profile.runs), 2)\\n+            self.assertEqual(profile.observed_structure[\\\"record_boundary\\\"], \\\"HDF5 file\\\")\\n+            self.assertEqual(profile.discovery[\\\"hdf5_files\\\"], 2)\\n+            self.assertEqual(profile.signals[0][\\\"data_channel_count\\\"], [3])\\n+            self.assertEqual(profile.signals[0][\\\"channel_axis\\\"], 1)\\n+            self.assertEqual(profile.signals[0][\\\"sample_axis\\\"], 0)\\n+            self.assertEqual(sorted(run.sequence_length for run in profile.runs), [5, 7])\\n+\\n \\n if __name__ == \\\"__main__\\\":\\n     unittest.main()\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0982b-48a6-7a00-b4fb-0f363c602d5d","create_time":1789265741.417225}}}
