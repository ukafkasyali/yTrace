ns_unresolved():\n     spec = _bosch_spec()\n-    profile = read_dataset_profile(_BOSCH_PROFILE_PATH)\n \n-    assert validate_dataset_spec(profile, spec).valid\n     assert spec.signals[0].unit.resolution.status is EvidenceStatus.UNRESOLVED\n+    assert detect_blocking_unresolved_fields(spec, (_requirement(),))\n \n@@ -201,3 +265,3 @@\n def test_kuka_regression_validation_is_unchanged():\n-    spec = DatasetSpec.read_json(_KUKA_SPEC_PATH)\n+    spec = load_kuka_collision_part1_spec()\n     profile = read_dataset_profile(_KUKA_PROFILE_PATH)\n","move_path":null},"/Users/sametdegirmenci/Downloads/ysamet/data_ingestion/tests/test_profiler.py":{"type":"update","unified_diff":"@@ -15,2 +15,3 @@\n \n+from dataset_profiler.datasets import KukaCollisionHints\n from dataset_profiler.inspection import inspect_mat_file\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/sametdegirmenci/Downloads/ysamet/data_ingestion/tests/test_profiler.py\nM /Users/sametdegirmenci/Downloads/ysamet/data_ingestion/tests/test_implementation_handoff.py\n","stderr":""},"started_at_ms":1789265820658,"completed_at_ms":1789265820766}}
