{"timestamp":"2026-09-13T06:48:19.053Z","ordinal":15398,"type":"token_usage_record","payload":{"thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","session_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","root_turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","response_id":"resp_0f3535a43349ee3d016aa6472ff25087d2ac48bed267b377bd","usage":{"input_tokens":157140,"cached_input_tokens":156932,"cache_write_input_tokens":205,"output_tokens":120,"reasoning_output_tokens":27,"total_tokens":157260},"turn_token_usage":{"input_tokens":7153630,"cached_input_tokens":6970914,"cache_write_input_tokens":173691,"output_tokens":20548,"reasoning_output_tokens":5257,"total_tokens":7174178},"thread_token_usage":{"input_tokens":292894164,"cached_input_tokens":286299053,"cache_write_input_tokens":6472516,"output_tokens":728063,"reasoning_output_tokens":225935,"total_tokens":293622227}}}
{"timestamp":"2026-09-13T06:48:19.054Z","ordinal":15399,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","item":{"type":"CommandExecution","id":"exec-61029d9c-871e-4f3f-86ac-a3b3411ff0a3","process_id":"12781","command":["/bin/zsh","-lc","sed -n '1,360p' model_training/src/robot_observability/factorybench_data.py; sed -n '1,320p' model_training/tests/test_factorybench_data.py"],"cwd":"file:///private/tmp/ysamet-factorybench","parsed_cmd":[{"type":"read","cmd":"sed -n '1,360p' model_training/src/robot_observability/factorybench_data.py","name":"factorybench_data.py","path":"model_training/src/robot_observability/factorybench_data.py"},{"type":"read","cmd":"sed -n '1,320p' model_training/tests/test_factorybench_data.py","name":"test_factorybench_data.py","path":"model_training/tests/test_factorybench_data.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)):\\s*(?P<values>.+)$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n    rows: list[dict[str, Any]] = []\n    seen_ids: set[str] = set()\n    with path.open(encoding=\"utf-8\") as handle:\n        for line_number, line in enumerate(handle, start=1):\n            if not line.strip():\n                continue\n            try:\n                row = json.loads(line)\n            except json.JSONDecodeError as error:\n                raise ValueError(f\"Invalid JSON at {path}:{line_number}: {error}\") from error\n            if not isinstance(row, dict):\n                raise ValueError(f\"Expected an object at {path}:{line_number}\")\n            item_id = row.get(\"id\")\n            if not isinstance(item_id, str) or not item_id:\n                raise ValueError(f\"Missing item id at {path}:{line_number}\")\n            if item_id in seen_ids:\n                raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n            if row.get(\"level\") not in (1, \"1\", \"L1\"):\n                raise ValueError(f\"Expected Level 1 item {item_id}, got {row.get('level')!r}\")\n            if not isinstance(row.get(\"question\"), str) or not row[\"question\"].strip():\n                raise ValueError(f\"Missing question for FactoryBench item {item_id}\")\n            if \"answer\" not in row:\n                raise ValueError(f\"Missing answer for FactoryBench item {item_id}\")\n            _episode_ids(row)\n            _series_contexts(row)\n            seen_ids.add(item_id)\n            rows.append(row)\n    if not rows:\n        raise ValueError(f\"No FactoryBench rows found in {path}\")\n    return rows\n\n\ndef source_receipt(\n    path: Path,\n    *,\n    revision: str,\n    expected_sha256: str | None = None,\n    rows: Sequence[dict[str, Any]] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Create a pinned receipt and refuse an unverified or moving source.\"\"\"\n    if not revision or revision in {\"main\", \"latest\"}:\n        raise ValueError(\"FactoryBench revision must be an immutable commit, not main/latest\")\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and expected_sha256 != actual_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n    return {\n        \"schema_version\": 1,\n        \"dataset_id\": FACTORYBENCH_DATASET_ID,\n        \"source_url\": FACTORYBENCH_SOURCE_URL,\n        \"revision\": revision,\n        \"path\": str(path.resolve()),\n        \"bytes\": path.stat().st_size,\n        \"sha256\": actual_sha256,\n        \"level\": 1,\n        \"items\": len(rows) if rows is not None else None,\n    }\n\n\ndef write_source_receipt(path: Path, receipt: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), receipt)\n\n\ndef _identity(dataset: object, episode: object, *, item_id: str) -> str:\n    if not isinstance(dataset, str) or not dataset:\n        raise ValueError(f\"Missing provenance dataset for FactoryBench item {item_id}\")\n    if not isinstance(episode, (str, int)) or str(episode) == \"\":\n        raise ValueError(f\"Missing provenance episode for FactoryBench item {item_id}\")\n    return f\"{dataset}:{episode}\"\n\n\ndef _episode_ids(row: dict[str, Any]) -> tuple[str, ...]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    provenance = row.get(\"provenance\")\n    if not isinstance(provenance, dict):\n        raise ValueError(f\"Missing provenance for FactoryBench item {item_id}\")\n    if \"episode\" in provenance:\n        return (_identity(provenance.get(\"dataset\"), provenance.get(\"episode\"), item_id=item_id),)\n    if \"episode_a\" in provenance or \"episode_b\" in provenance:\n        return (\n            _identity(provenance.get(\"dataset_a\"), provenance.get(\"episode_a\"), item_id=item_id),\n            _identity(provenance.get(\"dataset_b\"), provenance.get(\"episode_b\"), item_id=item_id),\n        )\n    raise ValueError(f\"No episode identity in provenance for FactoryBench item {item_id}\")\n\n\nclass _DisjointSet:\n    def __init__(self) -> None:\n        self.parent: dict[str, str] = {}\n\n    def find(self, value: str) -> str:\n        self.parent.setdefault(value, value)\n        if self.parent[value] != value:\n            self.parent[value] = self.find(self.parent[value])\n        return self.parent[value]\n\n    def union(self, left: str, right: str) -> None:\n        left_root = self.find(left)\n        right_root = self.find(right)\n        if left_root != right_root:\n            if right_root < left_root:\n                left_root, right_root = right_root, left_root\n            self.parent[right_root] = left_root\n\n\ndef _source_signature(row: dict[str, Any]) -> str:\n    provenance = row[\"provenance\"]\n    if \"dataset\" in provenance:\n        return str(provenance[\"dataset\"])\n    return \"+\".join(sorted((str(provenance[\"dataset_a\"]), str(provenance[\"dataset_b\"]))))\n\n\ndef build_component_split(\n    rows: Sequence[dict[str, Any]],\n    *,\n    train_fraction: float = 0.70,\n    validation_fraction: float = 0.15,\n    seed: int = 20260912,\n    receipt: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Assign connected episode components to deterministic 70/15/15 splits.\"\"\"\n    if not 0 < train_fraction < 1 or not 0 < validation_fraction < 1:\n        raise ValueError(\"Split fractions must be between zero and one\")\n    test_fraction = 1.0 - train_fraction - validation_fraction\n    if test_fraction <= 0:\n        raise ValueError(\"Train and validation fractions must leave a test split\")\n    if len(rows) < 3:\n        raise ValueError(\"At least three FactoryBench items are required for three splits\")\n\n    disjoint = _DisjointSet()\n    row_episodes: dict[str, tuple[str, ...]] = {}\n    rows_by_id: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        item_id = str(row[\"id\"])\n        if item_id in rows_by_id:\n            raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n        episodes = _episode_ids(row)\n        for episode in episodes:\n            disjoint.find(episode)\n        for episode in episodes[1:]:\n            disjoint.union(episodes[0], episode)\n        row_episodes[item_id] = episodes\n        rows_by_id[item_id] = row\n\n    episodes_by_root: dict[str, set[str]] = defaultdict(set)\n    for episode in disjoint.parent:\n        episodes_by_root[disjoint.find(episode)].add(episode)\n    items_by_root: dict[str, list[str]] = defaultdict(list)\n    for item_id, episodes in row_episodes.items():\n        items_by_root[disjoint.find(episodes[0])].append(item_id)\n    if len(items_by_root) < 3:\n        raise ValueError(\"Episode graph has fewer than three connected components\")\n\n    components: list[dict[str, Any]] = []\n    for root, item_ids in items_by_root.items():\n        episode_ids = sorted(episodes_by_root[root])\n        stable_id = hashlib.sha256(\"\\n\".join(episode_ids).encode()).hexdigest()[:16]\n        strata = Counter(\n            f\"template={rows_by_id[item_id].get('template_id')}|source={_source_signature(rows_by_id[item_id])}\"\n            for item_id in item_ids\n        )\n        components.append(\n            {\n                \"component_id\": stable_id,\n                \"episode_ids\": episode_ids,\n                \"item_ids\": sorted(item_ids),\n                \"item_count\": len(item_ids),\n                \"strata\": dict(sorted(strata.items())),\n            }\n        )\n\n    fractions = {\"train\": train_fraction, \"validation\": validation_fraction, \"test\": test_fraction}\n    total_items = len(rows)\n    total_strata = Counter(\n        f\"template={row.get('template_id')}|source={_source_signature(row)}\" for row in rows\n    )\n    targets = {split: total_items * fraction for split, fraction in fractions.items()}\n    stratum_targets = {\n        split: {key: count * fraction for key, count in total_strata.items()}\n        for split, fraction in fractions.items()\n    }\n    assigned_counts = Counter({split: 0 for split in SPLITS})\n    assigned_strata = {split: Counter() for split in SPLITS}\n\n    rng = random.Random(seed)\n    rng.shuffle(components)\n    components.sort(key=lambda component: -int(component[\"item_count\"]))\n    assignment: dict[str, str] = {}\n    for index, component in enumerate(components):\n        remaining_components = len(components) - index\n        empty_splits = [split for split in SPLITS if assigned_counts[split] == 0]\n        candidates = empty_splits if remaining_components <= len(empty_splits) else list(SPLITS)\n\n        def score(split: str) -> tuple[float, float, int]:\n            next_count = assigned_counts[split] + int(component[\"item_count\"])\n            total_fill = next_count / max(targets[split], 1.0)\n            stratum_fill = sum(\n                (\n                    assigned_strata[split][key] + int(component[\"strata\"].get(key, 0))\n                )\n                / max(stratum_targets[split][key], 1.0)\n                for key in total_strata\n            ) / max(len(total_strata), 1)\n            overflow = max(0.0, next_count - targets[split]) / max(targets[split], 1.0)\n            return (\n                total_fill + 0.25 * stratum_fill + 2.0 * overflow,\n                assigned_counts[split],\n                SPLITS.index(split),\n            )\n\n        split = min(candidates, key=score)\n        assignment[str(component[\"component_id\"])] = split\n        assigned_counts[split] += int(component[\"item_count\"])\n        assigned_strata[split].update(component[\"strata\"])\n\n    item_splits = {\n        item_id: assignment[str(component[\"component_id\"])]\n        for component in components\n        for item_id in component[\"item_ids\"]\n    }\n    manifest = {\n        \"schema_version\": 1,\n        \"method\": \"episode_connected_components\",\n        \"seed\": seed,\n        \"fractions\": fractions,\n        \"source\": receipt,\n        \"item_splits\": dict(sorted(item_splits.items())),\n        \"components\": [\n            {**component, \"split\": assignment[str(component[\"component_id\"])]}\n            for component in sorted(components, key=lambda item: str(item[\"component_id\"]))\n        ],\n        \"counts\": {\n            \"items\": dict(assigned_counts),\n            \"components\": dict(Counter(assignment.values())),\n            \"episodes\": {\n                split: sum(\n                    len(component[\"episode_ids\"])\n                    for component in components\n                    if assignment[str(component[\"component_id\"])] == split\n                )\n                for split in SPLITS\n            },\n        },\n    }\n    audit_split(rows, manifest)\n    return manifest\n\n\ndef audit_split(rows: Sequence[dict[str, Any]], manifest: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Verify item coverage and zero episode identity overlap across splits.\"\"\"\n    item_splits = manifest.get(\"item_splits\")\n    if not isinstance(item_splits, dict):\n        raise ValueError(\"Split manifest is missing item_splits\")\n    expected_ids = {str(row[\"id\"]) for row in rows}\n    if set(item_splits) != expected_ids:\n        missing = sorted(expected_ids - set(item_splits))[:5]\n        extra = sorted(set(item_splits) - expected_ids)[:5]\n        raise ValueError(f\"Split item coverage mismatch; missing={missing}, extra={extra}\")\n    invalid = {value for value in item_splits.values() if value not in SPLITS}\n    if invalid:\n        raise ValueError(f\"Invalid split names: {sorted(invalid)}\")\n\n    episodes_by_split = {split: set() for split in SPLITS}\n    items_by_split = Counter()\n    for row in rows:\n        split = str(item_splits[str(row[\"id\"])])\n        items_by_split[split] += 1\n        episodes_by_split[split].update(_episode_ids(row))\n    if any(items_by_split[split] == 0 for split in SPLITS):\n        raise ValueError(\"Train, validation, and test splits must all be non-empty\")\n    overlaps: dict[str, list[str]] = {}\n    for left_index, left in enumerate(SPLITS):\n        for right in SPLITS[left_index + 1 :]:\n            overlap = sorted(episodes_by_split[left] & episodes_by_split[right])\n            if overlap:\n                overlaps[f\"{left}:{right}\"] = overlap\n    if overlaps:\n        raise ValueError(f\"Episode leakage across FactoryBench splits: {overlaps}\")\n    return {\n        \"items\": dict(items_by_split),\n        \"episodes\": {split: len(values) for split, values in episodes_by_split.items()},\n        \"episode_overlap\": 0,\n    }\n\n\ndef write_split_manifest(path: Path, manifest: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), manifest)\n\n\ndef _atomic_json_write(path: Path, payload: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_suffix(path.suffix + \".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef _series_contexts(row: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    context = row.get(\"context\")\n    if not isinstance(context, dict):\n        raise ValueError(f\"Missing context for FactoryBench item {item_id}\")\n    if \"time_series\" in context:\n        return [(\"Series\", context)]\n    if \"series_a\" in context and \"series_b\" in context:\n        if not isinstance(context[\"series_a\"], dict) or not isinstance(context[\"series_b\"], dict):\n            raise ValueError(f\"Invalid comparative context for FactoryBench item {item_id}\")\n        return [(\"Series A\", context[\"series_a\"]), (\"Series B\", context[\"series_b\"])]\n    raise ValueError(f\"Unsupported FactoryBench context for item {item_id}\")\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom robot_observability.factorybench_data import (\n    FactoryBenchDataset,\n    audit_split,\n    build_component_split,\n    load_rows,\n    source_receipt,\n    write_source_receipt,\n    write_split_manifest,\n)\n\n\ndef _single(item_id: str, episode: str, *, answer: object = \"A\") -> dict:\n    return {\n        \"id\": item_id,\n        \"level\": 1,\n        \"template_id\": 6,\n        \"template_type\": \"identification\",\n        \"question\": \"Which robot produced this telemetry? Answer only with one letter.\",\n        \"options\": {\"A\": \"Robot one\", \"B\": \"Robot two\"},\n        \"answer\": answer,\n        \"acceptance_bounds\": None,\n        \"provenance\": {\"dataset\": \"factorywave\", \"episode\": episode},\n        \"context\": {\n            \"time_series_format\": {\n                \"acronym_mapping\": {\"fp0\": \"feedback position 0\", \"fs0\": \"feedback speed 0\"}\n            },\n            \"time_series\": [\n                \"t=100: fp0=1.0, fs0=-2.0\",\n                \"t=200: fp0=1.5, fs0=-1.0\",\n                \"t=300: fp0=2.0, fs0=0.0\",\n                \"t=400: fp0=2.5, fs0=1.0\",\n            ],\n        },\n    }\n\n\ndef _comparison(item_id: str, left: str, right: str) -> dict:\n    left_context = _single(\"unused-left\", left)[\"context\"]\n    right_context = _single(\"unused-right\", right)[\"context\"]\n    right_context[\"time_series\"] = right_context[\"time_series\"][:3]\n    return {\n        \"id\": item_id,\n        \"level\": \"L1\",\n        \"template_id\": 3,\n        \"template_type\": \"comparative\",\n        \"question\": \"What changed? Return four T/F letters.\",\n        \"options\": {\"A\": \"Robot\", \"B\": \"Fault\", \"C\": \"Task\", \"D\": \"Phase\"},\n        \"answer\": \"TFFT\",\n        \"acceptance_bounds\": None,\n        \"provenance\": {\n            \"dataset_a\": \"factorywave\",\n            \"episode_a\": left,\n            \"dataset_b\": \"factorywave\",\n            \"episode_b\": right,\n        },\n        \"context\": {\"series_a\": left_context, \"series_b\": right_context},\n    }\n\n\ndef _write_jsonl(path: Path, rows: list[dict]) -> str:\n    payload = \"\".join(json.dumps(row) + \"\\n\" for row in rows)\n    path.write_text(payload, encoding=\"utf-8\")\n    return hashlib.sha256(payload.encode()).hexdigest()\n\n\ndef test_load_rows_and_pinned_source_receipt(tmp_path: Path) -> None:\n    path = tmp_path / \"level_1.jsonl\"\n    expected_hash = _write_jsonl(path, [_single(\"one\", \"ep-1\", answer=0)])\n\n    rows = load_rows(path, expected_sha256=expected_hash)\n    receipt = source_receipt(\n        path,\n        revision=\"2561c2c90560ae3df90ef8136f774faa5fb4b4e3\",\n        expected_sha256=expected_hash,\n        rows=rows,\n    )\n    receipt_path = tmp_path / \"source_receipt.json\"\n    write_source_receipt(receipt_path, receipt)\n\n    assert receipt[\"sha256\"] == expected_hash\n    assert receipt[\"items\"] == 1\n    assert json.loads(receipt_path.read_text())[\"revision\"].startswith(\"2561c2\")\n    with pytest.raises(ValueError, match=\"immutable commit\"):\n        source_receipt(path, revision=\"main\")\n    with pytest.raises(ValueError, match=\"checksum mismatch\"):\n        load_rows(path, expected_sha256=\"0\" * 64)\n\n\ndef test_dataset_renders_single_series_with_exact_short_answer() -> None:\n    dataset = FactoryBenchDataset([_single(\"one\", \"ep-1\", answer=-0.0)], eos_token=\"<eos>\")\n\n    sample = dataset[0]\n\n    assert sample[\"answer\"] == \"-0.0<eos>\"\n    assert sample[\"target\"] == \"-0.0\"\n    assert sample[\"id\"] == \"one\"\n    assert len(sample[\"time_series\"]) == 3\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert sample[\"time_series\"][1].tolist() == [1.0, 1.5, 2.0, 2.5]\n    assert sample[\"time_series_text\"][1] == \"Series: feedback position 0.\"\n    assert \"factorywave\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n    assert \"ep-1\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n\n\ndef test_dataset_renders_comparative_context_without_forcing_equal_lengths() -> None:\n    sample = FactoryBenchDataset([_comparison(\"compare\", \"ep-1\", \"ep-2\")])[0]\n\n    assert sample[\"answer\"] == \"TFFT\"\n    assert len(sample[\"time_series\"]) == 6\n    assert {len(series) for series in sample[\"time_series\"]} == {3, 4}\n    assert sample[\"time_series_text\"][0].startswith(\"Series A:\")\n    assert sample[\"time_series_text\"][3].startswith(\"Series B:\")\n    assert \"A: Robot\" in sample[\"post_prompt\"]\n\n\ndef test_component_split_keeps_linked_episodes_and_rows_together(tmp_path: Path) -> None:\n    rows = [\n        _single(\"single-a\", \"ep-a\"),\n        _comparison(\"a-to-b\", \"ep-a\", \"ep-b\"),\n        _single(\"single-b\", \"ep-b\"),\n        *[_single(f\"item-{index}\", f\"ep-{index}\") for index in range(3, 16)],\n    ]\n\n    manifest = build_component_split(rows, seed=19)\n    audit = audit_split(rows, manifest)\n    split_path = tmp_path / \"splits.json\"\n    write_split_manifest(split_path, manifest)\n\n    linked_splits = {\n        manifest[\"item_splits\"][item_id] for item_id in (\"single-a\", \"a-to-b\", \"single-b\")\n    }\n    assert len(linked_splits) == 1\n    assert audit[\"episode_overlap\"] == 0\n    assert all(audit[\"items\"][split] for split in (\"train\", \"validation\", \"test\"))\n    assert sum(manifest[\"counts\"][\"items\"].values()) == len(rows)\n    assert json.loads(split_path.read_text())[\"method\"] == \"episode_connected_components\"\n\n    for split in (\"train\", \"validation\", \"test\"):\n        subset = FactoryBenchDataset(rows, split_manifest=manifest, split=split)\n        assert len(subset) == audit[\"items\"][split]\n\n\ndef test_split_audit_rejects_episode_leakage() -> None:\n    rows = [_single(\"one\", \"shared\"), _single(\"two\", \"shared\"), _single(\"three\", \"other\")]\n    manifest = {\"item_splits\": {\"one\": \"train\", \"two\": \"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n","stderr":"","aggregated_output":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)):\\s*(?P<values>.+)$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n    rows: list[dict[str, Any]] = []\n    seen_ids: set[str] = set()\n    with path.open(encoding=\"utf-8\") as handle:\n        for line_number, line in enumerate(handle, start=1):\n            if not line.strip():\n                continue\n            try:\n                row = json.loads(line)\n            except json.JSONDecodeError as error:\n                raise ValueError(f\"Invalid JSON at {path}:{line_number}: {error}\") from error\n            if not isinstance(row, dict):\n                raise ValueError(f\"Expected an object at {path}:{line_number}\")\n            item_id = row.get(\"id\")\n            if not isinstance(item_id, str) or not item_id:\n                raise ValueError(f\"Missing item id at {path}:{line_number}\")\n            if item_id in seen_ids:\n                raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n            if row.get(\"level\") not in (1, \"1\", \"L1\"):\n                raise ValueError(f\"Expected Level 1 item {item_id}, got {row.get('level')!r}\")\n            if not isinstance(row.get(\"question\"), str) or not row[\"question\"].strip():\n                raise ValueError(f\"Missing question for FactoryBench item {item_id}\")\n            if \"answer\" not in row:\n                raise ValueError(f\"Missing answer for FactoryBench item {item_id}\")\n            _episode_ids(row)\n            _series_contexts(row)\n            seen_ids.add(item_id)\n            rows.append(row)\n    if not rows:\n        raise ValueError(f\"No FactoryBench rows found in {path}\")\n    return rows\n\n\ndef source_receipt(\n    path: Path,\n    *,\n    revision: str,\n    expected_sha256: str | None = None,\n    rows: Sequence[dict[str, Any]] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Create a pinned receipt and refuse an unverified or moving source.\"\"\"\n    if not revision or revision in {\"main\", \"latest\"}:\n        raise ValueError(\"FactoryBench revision must be an immutable commit, not main/latest\")\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and expected_sha256 != actual_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n    return {\n        \"schema_version\": 1,\n        \"dataset_id\": FACTORYBENCH_DATASET_ID,\n        \"source_url\": FACTORYBENCH_SOURCE_URL,\n        \"revision\": revision,\n        \"path\": str(path.resolve()),\n        \"bytes\": path.stat().st_size,\n        \"sha256\": actual_sha256,\n        \"level\": 1,\n        \"items\": len(rows) if rows is not None else None,\n    }\n\n\ndef write_source_receipt(path: Path, receipt: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), receipt)\n\n\ndef _identity(dataset: object, episode: object, *, item_id: str) -> str:\n    if not isinstance(dataset, str) or not dataset:\n        raise ValueError(f\"Missing provenance dataset for FactoryBench item {item_id}\")\n    if not isinstance(episode, (str, int)) or str(episode) == \"\":\n        raise ValueError(f\"Missing provenance episode for FactoryBench item {item_id}\")\n    return f\"{dataset}:{episode}\"\n\n\ndef _episode_ids(row: dict[str, Any]) -> tuple[str, ...]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    provenance = row.get(\"provenance\")\n    if not isinstance(provenance, dict):\n        raise ValueError(f\"Missing provenance for FactoryBench item {item_id}\")\n    if \"episode\" in provenance:\n        return (_identity(provenance.get(\"dataset\"), provenance.get(\"episode\"), item_id=item_id),)\n    if \"episode_a\" in provenance or \"episode_b\" in provenance:\n        return (\n            _identity(provenance.get(\"dataset_a\"), provenance.get(\"episode_a\"), item_id=item_id),\n            _identity(provenance.get(\"dataset_b\"), provenance.get(\"episode_b\"), item_id=item_id),\n        )\n    raise ValueError(f\"No episode identity in provenance for FactoryBench item {item_id}\")\n\n\nclass _DisjointSet:\n    def __init__(self) -> None:\n        self.parent: dict[str, str] = {}\n\n    def find(self, value: str) -> str:\n        self.parent.setdefault(value, value)\n        if self.parent[value] != value:\n            self.parent[value] = self.find(self.parent[value])\n        return self.parent[value]\n\n    def union(self, left: str, right: str) -> None:\n        left_root = self.find(left)\n        right_root = self.find(right)\n        if left_root != right_root:\n            if right_root < left_root:\n                left_root, right_root = right_root, left_root\n            self.parent[right_root] = left_root\n\n\ndef _source_signature(row: dict[str, Any]) -> str:\n    provenance = row[\"provenance\"]\n    if \"dataset\" in provenance:\n        return str(provenance[\"dataset\"])\n    return \"+\".join(sorted((str(provenance[\"dataset_a\"]), str(provenance[\"dataset_b\"]))))\n\n\ndef build_component_split(\n    rows: Sequence[dict[str, Any]],\n    *,\n    train_fraction: float = 0.70,\n    validation_fraction: float = 0.15,\n    seed: int = 20260912,\n    receipt: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Assign connected episode components to deterministic 70/15/15 splits.\"\"\"\n    if not 0 < train_fraction < 1 or not 0 < validation_fraction < 1:\n        raise ValueError(\"Split fractions must be between zero and one\")\n    test_fraction = 1.0 - train_fraction - validation_fraction\n    if test_fraction <= 0:\n        raise ValueError(\"Train and validation fractions must leave a test split\")\n    if len(rows) < 3:\n        raise ValueError(\"At least three FactoryBench items are required for three splits\")\n\n    disjoint = _DisjointSet()\n    row_episodes: dict[str, tuple[str, ...]] = {}\n    rows_by_id: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        item_id = str(row[\"id\"])\n        if item_id in rows_by_id:\n            raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n        episodes = _episode_ids(row)\n        for episode in episodes:\n            disjoint.find(episode)\n        for episode in episodes[1:]:\n            disjoint.union(episodes[0], episode)\n        row_episodes[item_id] = episodes\n        rows_by_id[item_id] = row\n\n    episodes_by_root: dict[str, set[str]] = defaultdict(set)\n    for episode in disjoint.parent:\n        episodes_by_root[disjoint.find(episode)].add(episode)\n    items_by_root: dict[str, list[str]] = defaultdict(list)\n    for item_id, episodes in row_episodes.items():\n        items_by_root[disjoint.find(episodes[0])].append(item_id)\n    if len(items_by_root) < 3:\n        raise ValueError(\"Episode graph has fewer than three connected components\")\n\n    components: list[dict[str, Any]] = []\n    for root, item_ids in items_by_root.items():\n        episode_ids = sorted(episodes_by_root[root])\n        stable_id = hashlib.sha256(\"\\n\".join(episode_ids).encode()).hexdigest()[:16]\n        strata = Counter(\n            f\"template={rows_by_id[item_id].get('template_id')}|source={_source_signature(rows_by_id[item_id])}\"\n            for item_id in item_ids\n        )\n        components.append(\n            {\n                \"component_id\": stable_id,\n                \"episode_ids\": episode_ids,\n                \"item_ids\": sorted(item_ids),\n                \"item_count\": len(item_ids),\n                \"strata\": dict(sorted(strata.items())),\n            }\n        )\n\n    fractions = {\"train\": train_fraction, \"validation\": validation_fraction, \"test\": test_fraction}\n    total_items = len(rows)\n    total_strata = Counter(\n        f\"template={row.get('template_id')}|source={_source_signature(row)}\" for row in rows\n    )\n    targets = {split: total_items * fraction for split, fraction in fractions.items()}\n    stratum_targets = {\n        split: {key: count * fraction for key, count in total_strata.items()}\n        for split, fraction in fractions.items()\n    }\n    assigned_counts = Counter({split: 0 for split in SPLITS})\n    assigned_strata = {split: Counter() for split in SPLITS}\n\n    rng = random.Random(seed)\n    rng.shuffle(components)\n    components.sort(key=lambda component: -int(component[\"item_count\"]))\n    assignment: dict[str, str] = {}\n    for index, component in enumerate(components):\n        remaining_components = len(components) - index\n        empty_splits = [split for split in SPLITS if assigned_counts[split] == 0]\n        candidates = empty_splits if remaining_components <= len(empty_splits) else list(SPLITS)\n\n        def score(split: str) -> tuple[float, float, int]:\n            next_count = assigned_counts[split] + int(component[\"item_count\"])\n            total_fill = next_count / max(targets[split], 1.0)\n            stratum_fill = sum(\n                (\n                    assigned_strata[split][key] + int(component[\"strata\"].get(key, 0))\n                )\n                / max(stratum_targets[split][key], 1.0)\n                for key in total_strata\n            ) / max(len(total_strata), 1)\n            overflow = max(0.0, next_count - targets[split]) / max(targets[split], 1.0)\n            return (\n                total_fill + 0.25 * stratum_fill + 2.0 * overflow,\n                assigned_counts[split],\n                SPLITS.index(split),\n            )\n\n        split = min(candidates, key=score)\n        assignment[str(component[\"component_id\"])] = split\n        assigned_counts[split] += int(component[\"item_count\"])\n        assigned_strata[split].update(component[\"strata\"])\n\n    item_splits = {\n        item_id: assignment[str(component[\"component_id\"])]\n        for component in components\n        for item_id in component[\"item_ids\"]\n    }\n    manifest = {\n        \"schema_version\": 1,\n        \"method\": \"episode_connected_components\",\n        \"seed\": seed,\n        \"fractions\": fractions,\n        \"source\": receipt,\n        \"item_splits\": dict(sorted(item_splits.items())),\n        \"components\": [\n            {**component, \"split\": assignment[str(component[\"component_id\"])]}\n            for component in sorted(components, key=lambda item: str(item[\"component_id\"]))\n        ],\n        \"counts\": {\n            \"items\": dict(assigned_counts),\n            \"components\": dict(Counter(assignment.values())),\n            \"episodes\": {\n                split: sum(\n                    len(component[\"episode_ids\"])\n                    for component in components\n                    if assignment[str(component[\"component_id\"])] == split\n                )\n                for split in SPLITS\n            },\n        },\n    }\n    audit_split(rows, manifest)\n    return manifest\n\n\ndef audit_split(rows: Sequence[dict[str, Any]], manifest: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Verify item coverage and zero episode identity overlap across splits.\"\"\"\n    item_splits = manifest.get(\"item_splits\")\n    if not isinstance(item_splits, dict):\n        raise ValueError(\"Split manifest is missing item_splits\")\n    expected_ids = {str(row[\"id\"]) for row in rows}\n    if set(item_splits) != expected_ids:\n        missing = sorted(expected_ids - set(item_splits))[:5]\n        extra = sorted(set(item_splits) - expected_ids)[:5]\n        raise ValueError(f\"Split item coverage mismatch; missing={missing}, extra={extra}\")\n    invalid = {value for value in item_splits.values() if value not in SPLITS}\n    if invalid:\n        raise ValueError(f\"Invalid split names: {sorted(invalid)}\")\n\n    episodes_by_split = {split: set() for split in SPLITS}\n    items_by_split = Counter()\n    for row in rows:\n        split = str(item_splits[str(row[\"id\"])])\n        items_by_split[split] += 1\n        episodes_by_split[split].update(_episode_ids(row))\n    if any(items_by_split[split] == 0 for split in SPLITS):\n        raise ValueError(\"Train, validation, and test splits must all be non-empty\")\n    overlaps: dict[str, list[str]] = {}\n    for left_index, left in enumerate(SPLITS):\n        for right in SPLITS[left_index + 1 :]:\n            overlap = sorted(episodes_by_split[left] & episodes_by_split[right])\n            if overlap:\n                overlaps[f\"{left}:{right}\"] = overlap\n    if overlaps:\n        raise ValueError(f\"Episode leakage across FactoryBench splits: {overlaps}\")\n    return {\n        \"items\": dict(items_by_split),\n        \"episodes\": {split: len(values) for split, values in episodes_by_split.items()},\n        \"episode_overlap\": 0,\n    }\n\n\ndef write_split_manifest(path: Path, manifest: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), manifest)\n\n\ndef _atomic_json_write(path: Path, payload: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_suffix(path.suffix + \".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef _series_contexts(row: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    context = row.get(\"context\")\n    if not isinstance(context, dict):\n        raise ValueError(f\"Missing context for FactoryBench item {item_id}\")\n    if \"time_series\" in context:\n        return [(\"Series\", context)]\n    if \"series_a\" in context and \"series_b\" in context:\n        if not isinstance(context[\"series_a\"], dict) or not isinstance(context[\"series_b\"], dict):\n            raise ValueError(f\"Invalid comparative context for FactoryBench item {item_id}\")\n        return [(\"Series A\", context[\"series_a\"]), (\"Series B\", context[\"series_b\"])]\n    raise ValueError(f\"Unsupported FactoryBench context for item {item_id}\")\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom robot_observability.factorybench_data import (\n    FactoryBenchDataset,\n    audit_split,\n    build_component_split,\n    load_rows,\n    source_receipt,\n    write_source_receipt,\n    write_split_manifest,\n)\n\n\ndef _single(item_id: str, episode: str, *, answer: object = \"A\") -> dict:\n    return {\n        \"id\": item_id,\n        \"level\": 1,\n        \"template_id\": 6,\n        \"template_type\": \"identification\",\n        \"question\": \"Which robot produced this telemetry? Answer only with one letter.\",\n        \"options\": {\"A\": \"Robot one\", \"B\": \"Robot two\"},\n        \"answer\": answer,\n        \"acceptance_bounds\": None,\n        \"provenance\": {\"dataset\": \"factorywave\", \"episode\": episode},\n        \"context\": {\n            \"time_series_format\": {\n                \"acronym_mapping\": {\"fp0\": \"feedback position 0\", \"fs0\": \"feedback speed 0\"}\n            },\n            \"time_series\": [\n                \"t=100: fp0=1.0, fs0=-2.0\",\n                \"t=200: fp0=1.5, fs0=-1.0\",\n                \"t=300: fp0=2.0, fs0=0.0\",\n                \"t=400: fp0=2.5, fs0=1.0\",\n            ],\n        },\n    }\n\n\ndef _comparison(item_id: str, left: str, right: str) -> dict:\n    left_context = _single(\"unused-left\", left)[\"context\"]\n    right_context = _single(\"unused-right\", right)[\"context\"]\n    right_context[\"time_series\"] = right_context[\"time_series\"][:3]\n    return {\n        \"id\": item_id,\n        \"level\": \"L1\",\n        \"template_id\": 3,\n        \"template_type\": \"comparative\",\n        \"question\": \"What changed? Return four T/F letters.\",\n        \"options\": {\"A\": \"Robot\", \"B\": \"Fault\", \"C\": \"Task\", \"D\": \"Phase\"},\n        \"answer\": \"TFFT\",\n        \"acceptance_bounds\": None,\n        \"provenance\": {\n            \"dataset_a\": \"factorywave\",\n            \"episode_a\": left,\n            \"dataset_b\": \"factorywave\",\n            \"episode_b\": right,\n        },\n        \"context\": {\"series_a\": left_context, \"series_b\": right_context},\n    }\n\n\ndef _write_jsonl(path: Path, rows: list[dict]) -> str:\n    payload = \"\".join(json.dumps(row) + \"\\n\" for row in rows)\n    path.write_text(payload, encoding=\"utf-8\")\n    return hashlib.sha256(payload.encode()).hexdigest()\n\n\ndef test_load_rows_and_pinned_source_receipt(tmp_path: Path) -> None:\n    path = tmp_path / \"level_1.jsonl\"\n    expected_hash = _write_jsonl(path, [_single(\"one\", \"ep-1\", answer=0)])\n\n    rows = load_rows(path, expected_sha256=expected_hash)\n    receipt = source_receipt(\n        path,\n        revision=\"2561c2c90560ae3df90ef8136f774faa5fb4b4e3\",\n        expected_sha256=expected_hash,\n        rows=rows,\n    )\n    receipt_path = tmp_path / \"source_receipt.json\"\n    write_source_receipt(receipt_path, receipt)\n\n    assert receipt[\"sha256\"] == expected_hash\n    assert receipt[\"items\"] == 1\n    assert json.loads(receipt_path.read_text())[\"revision\"].startswith(\"2561c2\")\n    with pytest.raises(ValueError, match=\"immutable commit\"):\n        source_receipt(path, revision=\"main\")\n    with pytest.raises(ValueError, match=\"checksum mismatch\"):\n        load_rows(path, expected_sha256=\"0\" * 64)\n\n\ndef test_dataset_renders_single_series_with_exact_short_answer() -> None:\n    dataset = FactoryBenchDataset([_single(\"one\", \"ep-1\", answer=-0.0)], eos_token=\"<eos>\")\n\n    sample = dataset[0]\n\n    assert sample[\"answer\"] == \"-0.0<eos>\"\n    assert sample[\"target\"] == \"-0.0\"\n    assert sample[\"id\"] == \"one\"\n    assert len(sample[\"time_series\"]) == 3\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert sample[\"time_series\"][1].tolist() == [1.0, 1.5, 2.0, 2.5]\n    assert sample[\"time_series_text\"][1] == \"Series: feedback position 0.\"\n    assert \"factorywave\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n    assert \"ep-1\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n\n\ndef test_dataset_renders_comparative_context_without_forcing_equal_lengths() -> None:\n    sample = FactoryBenchDataset([_comparison(\"compare\", \"ep-1\", \"ep-2\")])[0]\n\n    assert sample[\"answer\"] == \"TFFT\"\n    assert len(sample[\"time_series\"]) == 6\n    assert {len(series) for series in sample[\"time_series\"]} == {3, 4}\n    assert sample[\"time_series_text\"][0].startswith(\"Series A:\")\n    assert sample[\"time_series_text\"][3].startswith(\"Series B:\")\n    assert \"A: Robot\" in sample[\"post_prompt\"]\n\n\ndef test_component_split_keeps_linked_episodes_and_rows_together(tmp_path: Path) -> None:\n    rows = [\n        _single(\"single-a\", \"ep-a\"),\n        _comparison(\"a-to-b\", \"ep-a\", \"ep-b\"),\n        _single(\"single-b\", \"ep-b\"),\n        *[_single(f\"item-{index}\", f\"ep-{index}\") for index in range(3, 16)],\n    ]\n\n    manifest = build_component_split(rows, seed=19)\n    audit = audit_split(rows, manifest)\n    split_path = tmp_path / \"splits.json\"\n    write_split_manifest(split_path, manifest)\n\n    linked_splits = {\n        manifest[\"item_splits\"][item_id] for item_id in (\"single-a\", \"a-to-b\", \"single-b\")\n    }\n    assert len(linked_splits) == 1\n    assert audit[\"episode_overlap\"] == 0\n    assert all(audit[\"items\"][split] for split in (\"train\", \"validation\", \"test\"))\n    assert sum(manifest[\"counts\"][\"items\"].values()) == len(rows)\n    assert json.loads(split_path.read_text())[\"method\"] == \"episode_connected_components\"\n\n    for split in (\"train\", \"validation\", \"test\"):\n        subset = FactoryBenchDataset(rows, split_manifest=manifest, split=split)\n        assert len(subset) == audit[\"items\"][split]\n\n\ndef test_split_audit_rejects_episode_leakage() -> None:\n    rows = [_single(\"one\", \"shared\"), _single(\"two\", \"shared\"), _single(\"three\", \"other\")]\n    manifest = {\"item_splits\": {\"one\": \"train\", \"two\": \"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n","exit_code":0,"duration":{"secs":0,"nanos":2083},"formatted_output":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)):\\s*(?P<values>.+)$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n    rows: list[dict[str, Any]] = []\n    seen_ids: set[str] = set()\n    with path.open(encoding=\"utf-8\") as handle:\n        for line_number, line in enumerate(handle, start=1):\n            if not line.strip():\n                continue\n            try:\n                row = json.loads(line)\n            except json.JSONDecodeError as error:\n                raise ValueError(f\"Invalid JSON at {path}:{line_number}: {error}\") from error\n            if not isinstance(row, dict):\n                raise ValueError(f\"Expected an object at {path}:{line_number}\")\n            item_id = row.get(\"id\")\n            if not isinstance(item_id, str) or not item_id:\n                raise ValueError(f\"Missing item id at {path}:{line_number}\")\n            if item_id in seen_ids:\n                raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n            if row.get(\"level\") not in (1, \"1\", \"L1\"):\n                raise ValueError(f\"Expected Level 1 item {item_id}, got {row.get('level')!r}\")\n            if not isinstance(row.get(\"question\"), str) or not row[\"question\"].strip():\n                raise ValueError(f\"Missing question for FactoryBench item {item_id}\")\n            if \"answer\" not in row:\n                raise ValueError(f\"Missing answer for FactoryBench item {item_id}\")\n            _episode_ids(row)\n            _series_contexts(row)\n            seen_ids.add(item_id)\n            rows.append(row)\n    if not rows:\n        raise ValueError(f\"No FactoryBench rows found in {path}\")\n    return rows\n\n\ndef source_receipt(\n    path: Path,\n    *,\n    revision: str,\n    expected_sha256: str | None = None,\n    rows: Sequence[dict[str, Any]] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Create a pinned receipt and refuse an unverified or moving source.\"\"\"\n    if not revision or revision in {\"main\", \"latest\"}:\n        raise ValueError(\"FactoryBench revision must be an immutable commit, not main/latest\")\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and expected_sha256 != actual_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n    return {\n        \"schema_version\": 1,\n        \"dataset_id\": FACTORYBENCH_DATASET_ID,\n        \"source_url\": FACTORYBENCH_SOURCE_URL,\n        \"revision\": revision,\n        \"path\": str(path.resolve()),\n        \"bytes\": path.stat().st_size,\n        \"sha256\": actual_sha256,\n        \"level\": 1,\n        \"items\": len(rows) if rows is not None else None,\n    }\n\n\ndef write_source_receipt(path: Path, receipt: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), receipt)\n\n\ndef _identity(dataset: object, episode: object, *, item_id: str) -> str:\n    if not isinstance(dataset, str) or not dataset:\n        raise ValueError(f\"Missing provenance dataset for FactoryBench item {item_id}\")\n    if not isinstance(episode, (str, int)) or str(episode) == \"\":\n        raise ValueError(f\"Missing provenance episode for FactoryBench item {item_id}\")\n    return f\"{dataset}:{episode}\"\n\n\ndef _episode_ids(row: dict[str, Any]) -> tuple[str, ...]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    provenance = row.get(\"provenance\")\n    if not isinstance(provenance, dict):\n        raise ValueError(f\"Missing provenance for FactoryBench item {item_id}\")\n    if \"episode\" in provenance:\n        return (_identity(provenance.get(\"dataset\"), provenance.get(\"episode\"), item_id=item_id),)\n    if \"episode_a\" in provenance or \"episode_b\" in provenance:\n        return (\n            _identity(provenance.get(\"dataset_a\"), provenance.get(\"episode_a\"), item_id=item_id),\n            _identity(provenance.get(\"dataset_b\"), provenance.get(\"episode_b\"), item_id=item_id),\n        )\n    raise ValueError(f\"No episode identity in provenance for FactoryBench item {item_id}\")\n\n\nclass _DisjointSet:\n    def __init__(self) -> None:\n        self.parent: dict[str, str] = {}\n\n    def find(self, value: str) -> str:\n        self.parent.setdefault(value, value)\n        if self.parent[value] != value:\n            self.parent[value] = self.find(self.parent[value])\n        return self.parent[value]\n\n    def union(self, left: str, right: str) -> None:\n        left_root = self.find(left)\n        right_root = self.find(right)\n        if left_root != right_root:\n            if right_root < left_root:\n                left_root, right_root = right_root, left_root\n            self.parent[right_root] = left_root\n\n\ndef _source_signature(row: dict[str, Any]) -> str:\n    provenance = row[\"provenance\"]\n    if \"dataset\" in provenance:\n        return str(provenance[\"dataset\"])\n    return \"+\".join(sorted((str(provenance[\"dataset_a\"]), str(provenance[\"dataset_b\"]))))\n\n\ndef build_component_split(\n    rows: Sequence[dict[str, Any]],\n    *,\n    train_fraction: float = 0.70,\n    validation_fraction: float = 0.15,\n    seed: int = 20260912,\n    receipt: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Assign connected episode components to deterministic 70/15/15 splits.\"\"\"\n    if not 0 < train_fraction < 1 or not 0 < validation_fraction < 1:\n        raise ValueError(\"Split fractions must be between zero and one\")\n    test_fraction = 1.0 - train_fraction - validation_fraction\n    if test_fraction <= 0:\n        raise ValueError(\"Train and validation fractions must leave a test split\")\n    if len(rows) < 3:\n        raise ValueError(\"At least three FactoryBench items are required for three splits\")\n\n    disjoint = _DisjointSet()\n    row_episodes: dict[str, tuple[str, ...]] = {}\n    rows_by_id: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        item_id = str(row[\"id\"])\n        if item_id in rows_by_id:\n            raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n        episodes = _episode_ids(row)\n        for episode in episodes:\n            disjoint.find(episode)\n        for episode in episodes[1:]:\n            disjoint.union(episodes[0], episode)\n        row_episodes[item_id] = episodes\n        rows_by_id[item_id] = row\n\n    episodes_by_root: dict[str, set[str]] = defaultdict(set)\n    for episode in disjoint.parent:\n        episodes_by_root[disjoint.find(episode)].add(episode)\n    items_by_root: dict[str, list[str]] = defaultdict(list)\n    for item_id, episodes in row_episodes.items():\n        items_by_root[disjoint.find(episodes[0])].append(item_id)\n    if len(items_by_root) < 3:\n        raise ValueError(\"Episode graph has fewer than three connected components\")\n\n    components: list[dict[str, Any]] = []\n    for root, item_ids in items_by_root.items():\n        episode_ids = sorted(episodes_by_root[root])\n        stable_id = hashlib.sha256(\"\\n\".join(episode_ids).encode()).hexdigest()[:16]\n        strata = Counter(\n            f\"template={rows_by_id[item_id].get('template_id')}|source={_source_signature(rows_by_id[item_id])}\"\n            for item_id in item_ids\n        )\n        components.append(\n            {\n                \"component_id\": stable_id,\n                \"episode_ids\": episode_ids,\n                \"item_ids\": sorted(item_ids),\n                \"item_count\": len(item_ids),\n                \"strata\": dict(sorted(strata.items())),\n            }\n        )\n\n    fractions = {\"train\": train_fraction, \"validation\": validation_fraction, \"test\": test_fraction}\n    total_items = len(rows)\n    total_strata = Counter(\n        f\"template={row.get('template_id')}|source={_source_signature(row)}\" for row in rows\n    )\n    targets = {split: total_items * fraction for split, fraction in fractions.items()}\n    stratum_targets = {\n        split: {key: count * fraction for key, count in total_strata.items()}\n        for split, fraction in fractions.items()\n    }\n    assigned_counts = Counter({split: 0 for split in SPLITS})\n    assigned_strata = {split: Counter() for split in SPLITS}\n\n    rng = random.Random(seed)\n    rng.shuffle(components)\n    components.sort(key=lambda component: -int(component[\"item_count\"]))\n    assignment: dict[str, str] = {}\n    for index, component in enumerate(components):\n        remaining_components = len(components) - index\n        empty_splits = [split for split in SPLITS if assigned_counts[split] == 0]\n        candidates = empty_splits if remaining_components <= len(empty_splits) else list(SPLITS)\n\n        def score(split: str) -> tuple[float, float, int]:\n            next_count = assigned_counts[split] + int(component[\"item_count\"])\n            total_fill = next_count / max(targets[split], 1.0)\n            stratum_fill = sum(\n                (\n                    assigned_strata[split][key] + int(component[\"strata\"].get(key, 0))\n                )\n                / max(stratum_targets[split][key], 1.0)\n                for key in total_strata\n            ) / max(len(total_strata), 1)\n            overflow = max(0.0, next_count - targets[split]) / max(targets[split], 1.0)\n            return (\n                total_fill + 0.25 * stratum_fill + 2.0 * overflow,\n                assigned_counts[split],\n                SPLITS.index(split),\n            )\n\n        split = min(candidates, key=score)\n        assignment[str(component[\"component_id\"])] = split\n        assigned_counts[split] += int(component[\"item_count\"])\n        assigned_strata[split].update(component[\"strata\"])\n\n    item_splits = {\n        item_id: assignment[str(component[\"component_id\"])]\n        for component in components\n        for item_id in component[\"item_ids\"]\n    }\n    manifest = {\n        \"schema_version\": 1,\n        \"method\": \"episode_connected_components\",\n        \"seed\": seed,\n        \"fractions\": fractions,\n        \"source\": receipt,\n        \"item_splits\": dict(sorted(item_splits.items())),\n        \"components\": [\n            {**component, \"split\": assignment[str(component[\"component_id\"])]}\n            for component in sorted(components, key=lambda item: str(item[\"component_id\"]))\n        ],\n        \"counts\": {\n            \"items\": dict(assigned_counts),\n            \"components\": dict(Counter(assignment.values())),\n            \"episodes\": {\n                split: sum(\n                    len(component[\"episode_ids\"])\n                    for component in components\n                    if assignment[str(component[\"component_id\"])] == split\n                )\n                for split in SPLITS\n            },\n        },\n    }\n    audit_split(rows, manifest)\n    return manifest\n\n\ndef audit_split(rows: Sequence[dict[str, Any]], manifest: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Verify item coverage and zero episode identity overlap across splits.\"\"\"\n    item_splits = manifest.get(\"item_splits\")\n    if not isinstance(item_splits, dict):\n        raise ValueError(\"Split manifest is missing item_splits\")\n    expected_ids = {str(row[\"id\"]) for row in rows}\n    if set(item_splits) != expected_ids:\n        missing = sorted(expected_ids - set(item_splits))[:5]\n        extra = sorted(set(item_splits) - expected_ids)[:5]\n        raise ValueError(f\"Split item coverage mismatch; missing={missing}, extra={extra}\")\n    invalid = {value for value in item_splits.values() if value not in SPLITS}\n    if invalid:\n        raise ValueError(f\"Invalid split names: {sorted(invalid)}\")\n\n    episodes_by_split = {split: set() for split in SPLITS}\n    items_by_split = Counter()\n    for row in rows:\n        split = str(item_splits[str(row[\"id\"])])\n        items_by_split[split] += 1\n        episodes_by_split[split].update(_episode_ids(row))\n    if any(items_by_split[split] == 0 for split in SPLITS):\n        raise ValueError(\"Train, validation, and test splits must all be non-empty\")\n    overlaps: dict[str, list[str]] = {}\n    for left_index, left in enumerate(SPLITS):\n        for right in SPLITS[left_index + 1 :]:\n            overlap = sorted(episodes_by_split[left] & episodes_by_split[right])\n            if overlap:\n                overlaps[f\"{left}:{right}\"] = overlap\n    if overlaps:\n        raise ValueError(f\"Episode leakage across FactoryBench splits: {overlaps}\")\n    return {\n        \"items\": dict(items_by_split),\n        \"episodes\": {split: len(values) for split, values in episodes_by_split.items()},\n        \"episode_overlap\": 0,\n    }\n\n\ndef write_split_manifest(path: Path, manifest: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), manifest)\n\n\ndef _atomic_json_write(path: Path, payload: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_suffix(path.suffix + \".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef _series_contexts(row: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    context = row.get(\"context\")\n    if not isinstance(context, dict):\n        raise ValueError(f\"Missing context for FactoryBench item {item_id}\")\n    if \"time_series\" in context:\n        return [(\"Series\", context)]\n    if \"series_a\" in context and \"series_b\" in context:\n        if not isinstance(context[\"series_a\"], dict) or not isinstance(context[\"series_b\"], dict):\n            raise ValueError(f\"Invalid comparative context for FactoryBench item {item_id}\")\n        return [(\"Series A\", context[\"series_a\"]), (\"Series B\", context[\"series_b\"])]\n    raise ValueError(f\"Unsupported FactoryBench context for item {item_id}\")\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom robot_observability.factorybench_data import (\n    FactoryBenchDataset,\n    audit_split,\n    build_component_split,\n    load_rows,\n    source_receipt,\n    write_source_receipt,\n    write_split_manifest,\n)\n\n\ndef _single(item_id: str, episode: str, *, answer: object = \"A\") -> dict:\n    return {\n        \"id\": item_id,\n        \"level\": 1,\n        \"template_id\": 6,\n        \"template_type\": \"identification\",\n        \"question\": \"Which robot produced this telemetry? Answer only with one letter.\",\n        \"options\": {\"A\": \"Robot one\", \"B\": \"Robot two\"},\n        \"answer\": answer,\n        \"acceptance_bounds\": None,\n        \"provenance\": {\"dataset\": \"factorywave\", \"episode\": episode},\n        \"context\": {\n            \"time_series_format\": {\n                \"acronym_mapping\": {\"fp0\": \"feedback position 0\", \"fs0\": \"feedback speed 0\"}\n            },\n            \"time_series\": [\n                \"t=100: fp0=1.0, fs0=-2.0\",\n                \"t=200: fp0=1.5, fs0=-1.0\",\n                \"t=300: fp0=2.0, fs0=0.0\",\n                \"t=400: fp0=2.5, fs0=1.0\",\n            ],\n        },\n    }\n\n\ndef _comparison(item_id: str, left: str, right: str) -> dict:\n    left_context = _single(\"unused-left\", left)[\"context\"]\n    right_context = _single(\"unused-right\", right)[\"context\"]\n    right_context[\"time_series\"] = right_context[\"time_series\"][:3]\n    return {\n        \"id\": item_id,\n        \"level\": \"L1\",\n        \"template_id\": 3,\n        \"template_type\": \"comparative\",\n        \"question\": \"What changed? Return four T/F letters.\",\n        \"options\": {\"A\": \"Robot\", \"B\": \"Fault\", \"C\": \"Task\", \"D\": \"Phase\"},\n        \"answer\": \"TFFT\",\n        \"acceptance_bounds\": None,\n        \"provenance\": {\n            \"dataset_a\": \"factorywave\",\n            \"episode_a\": left,\n            \"dataset_b\": \"factorywave\",\n            \"episode_b\": right,\n        },\n        \"context\": {\"series_a\": left_context, \"series_b\": right_context},\n    }\n\n\ndef _write_jsonl(path: Path, rows: list[dict]) -> str:\n    payload = \"\".join(json.dumps(row) + \"\\n\" for row in rows)\n    path.write_text(payload, encoding=\"utf-8\")\n    return hashlib.sha256(payload.encode()).hexdigest()\n\n\ndef test_load_rows_and_pinned_source_receipt(tmp_path: Path) -> None:\n    path = tmp_path / \"level_1.jsonl\"\n    expected_hash = _write_jsonl(path, [_single(\"one\", \"ep-1\", answer=0)])\n\n    rows = load_rows(path, expected_sha256=expected_hash)\n    receipt = source_receipt(\n        path,\n        revision=\"2561c2c90560ae3df90ef8136f774faa5fb4b4e3\",\n        expected_sha256=expected_hash,\n        rows=rows,\n    )\n    receipt_path = tmp_path / \"source_receipt.json\"\n    write_source_receipt(receipt_path, receipt)\n\n    assert receipt[\"sha256\"] == expected_hash\n    assert receipt[\"items\"] == 1\n    assert json.loads(receipt_path.read_text())[\"revision\"].startswith(\"2561c2\")\n    with pytest.raises(ValueError, match=\"immutable commit\"):\n        source_receipt(path, revision=\"main\")\n    with pytest.raises(ValueError, match=\"checksum mismatch\"):\n        load_rows(path, expected_sha256=\"0\" * 64)\n\n\ndef test_dataset_renders_single_series_with_exact_short_answer() -> None:\n    dataset = FactoryBenchDataset([_single(\"one\", \"ep-1\", answer=-0.0)], eos_token=\"<eos>\")\n\n    sample = dataset[0]\n\n    assert sample[\"answer\"] == \"-0.0<eos>\"\n    assert sample[\"target\"] == \"-0.0\"\n    assert sample[\"id\"] == \"one\"\n    assert len(sample[\"time_series\"]) == 3\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert sample[\"time_series\"][1].tolist() == [1.0, 1.5, 2.0, 2.5]\n    assert sample[\"time_series_text\"][1] == \"Series: feedback position 0.\"\n    assert \"factorywave\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n    assert \"ep-1\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n\n\ndef test_dataset_renders_comparative_context_without_forcing_equal_lengths() -> None:\n    sample = FactoryBenchDataset([_comparison(\"compare\", \"ep-1\", \"ep-2\")])[0]\n\n    assert sample[\"answer\"] == \"TFFT\"\n    assert len(sample[\"time_series\"]) == 6\n    assert {len(series) for series in sample[\"time_series\"]} == {3, 4}\n    assert sample[\"time_series_text\"][0].startswith(\"Series A:\")\n    assert sample[\"time_series_text\"][3].startswith(\"Series B:\")\n    assert \"A: Robot\" in sample[\"post_prompt\"]\n\n\ndef test_component_split_keeps_linked_episodes_and_rows_together(tmp_path: Path) -> None:\n    rows = [\n        _single(\"single-a\", \"ep-a\"),\n        _comparison(\"a-to-b\", \"ep-a\", \"ep-b\"),\n        _single(\"single-b\", \"ep-b\"),\n        *[_single(f\"item-{index}\", f\"ep-{index}\") for index in range(3, 16)],\n    ]\n\n    manifest = build_component_split(rows, seed=19)\n    audit = audit_split(rows, manifest)\n    split_path = tmp_path / \"splits.json\"\n    write_split_manifest(split_path, manifest)\n\n    linked_splits = {\n        manifest[\"item_splits\"][item_id] for item_id in (\"single-a\", \"a-to-b\", \"single-b\")\n    }\n    assert len(linked_splits) == 1\n    assert audit[\"episode_overlap\"] == 0\n    assert all(audit[\"items\"][split] for split in (\"train\", \"validation\", \"test\"))\n    assert sum(manifest[\"counts\"][\"items\"].values()) == len(rows)\n    assert json.loads(split_path.read_text())[\"method\"] == \"episode_connected_components\"\n\n    for split in (\"train\", \"validation\", \"test\"):\n        subset = FactoryBenchDataset(rows, split_manifest=manifest, split=split)\n        assert len(subset) == audit[\"items\"][split]\n\n\ndef test_split_audit_rejects_episode_leakage() -> None:\n    rows = [_single(\"one\", \"shared\"), _single(\"two\", \"shared\"), _single(\"three\", \"other\")]\n    manifest = {\"item_splits\": {\"one\": \"train\", \"two\": \"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n"},"started_at_ms":1789282099054,"completed_at_ms":1789282099054}}
{"timestamp":"2026-09-13T06:48:19.114Z","ordinal":15400,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a09986-1fa8-75a1-9210-133195e09ca7","call_id":"call_fCDjBtOMSwjuvXfIBYcfjzA8","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)):\\s*(?P<values>.+)$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n    rows: list[dict[str, Any]] = []\n    seen_ids: set[str] = set()\n    with path.open(encoding=\"utf-8\") as handle:\n        for line_number, line in enumerate(handle, start=1):\n            if not line.strip():\n                continue\n            try:\n                row = json.loads(line)\n            except json.JSONDecodeError as error:\n                raise ValueError(f\"Invalid JSON at {path}:{line_number}: {error}\") from error\n            if not isinstance(row, dict):\n                raise ValueError(f\"Expected an object at {path}:{line_number}\")\n            item_id = row.get(\"id\")\n            if not isinstance(item_id, str) or not item_id:\n                raise ValueError(f\"Missing item id at {path}:{line_number}\")\n            if item_id in seen_ids:\n                raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n            if row.get(\"level\") not in (1, \"1\", \"L1\"):\n                raise ValueError(f\"Expected Level 1 item {item_id}, got {row.get('level')!r}\")\n            if not isinstance(row.get(\"question\"), str) or not row[\"question\"].strip():\n                raise ValueError(f\"Missing question for FactoryBench item {item_id}\")\n            if \"answer\" not in row:\n                raise ValueError(f\"Missing answer for FactoryBench item {item_id}\")\n            _episode_ids(row)\n            _series_contexts(row)\n            seen_ids.add(item_id)\n            rows.append(row)\n    if not rows:\n        raise ValueError(f\"No FactoryBench rows found in {path}\")\n    return rows\n\n\ndef source_receipt(\n    path: Path,\n    *,\n    revision: str,\n    expected_sha256: str | None = None,\n    rows: Sequence[dict[str, Any]] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Create a pinned receipt and refuse an unverified or moving source.\"\"\"\n    if not revision or revision in {\"main\", \"latest\"}:\n        raise ValueError(\"FactoryBench revision must be an immutable commit, not main/latest\")\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and expected_sha256 != actual_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n    return {\n        \"schema_version\": 1,\n        \"dataset_id\": FACTORYBENCH_DATASET_ID,\n        \"source_url\": FACTORYBENCH_SOURCE_URL,\n        \"revision\": revision,\n        \"path\": str(path.resolve()),\n        \"bytes\": path.stat().st_size,\n        \"sha256\": actual_sha256,\n        \"level\": 1,\n        \"items\": len(rows) if rows is not None else None,\n    }\n\n\ndef write_source_receipt(path: Path, receipt: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), receipt)\n\n\ndef _identity(dataset: object, episode: object, *, item_id: str) -> str:\n    if not isinstance(dataset, str) or not dataset:\n        raise ValueError(f\"Missing provenance dataset for FactoryBench item {item_id}\")\n    if not isinstance(episode, (str, int)) or str(episode) == \"\":\n        raise ValueError(f\"Missing provenance episode for FactoryBench item {item_id}\")\n    return f\"{dataset}:{episode}\"\n\n\ndef _episode_ids(row: dict[str, Any]) -> tuple[str, ...]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    provenance = row.get(\"provenance\")\n    if not isinstance(provenance, dict):\n        raise ValueError(f\"Missing provenance for FactoryBench item {item_id}\")\n    if \"episode\" in provenance:\n        return (_identity(provenance.get(\"dataset\"), provenance.get(\"episode\"), item_id=item_id),)\n    if \"episode_a\" in provenance or \"episode_b\" in provenance:\n        return (\n            _identity(provenance.get(\"dataset_a\"), provenance.get(\"episode_a\"), item_id=item_id),\n            _identity(provenance.get(\"dataset_b\"), provenance.get(\"episode_b\"), item_id=item_id),\n        )\n    raise ValueError(f\"No episode identity in provenance for FactoryBench item {item_id}\")\n\n\nclass _DisjointSet:\n    def __init__(self) -> None:\n        self.parent: dict[str, str] = {}\n\n    def find(self, value: str) -> str:\n        self.parent.setdefault(value, value)\n        if self.parent[value] != value:\n            self.parent[value] = self.find(self.parent[value])\n        return self.parent[value]\n\n    def union(self, left: str, right: str) -> None:\n        left_root = self.find(left)\n        right_root = self.find(right)\n        if left_root != right_root:\n            if right_root < left_root:\n                left_root, right_root = right_root, left_root\n            self.parent[right_root] = left_root\n\n\ndef _source_signature(row: dict[str, Any]) -> str:\n    provenance = row[\"provenance\"]\n    if \"dataset\" in provenance:\n        return str(provenance[\"dataset\"])\n    return \"+\".join(sorted((str(provenance[\"dataset_a\"]), str(provenance[\"dataset_b\"]))))\n\n\ndef build_component_split(\n    rows: Sequence[dict[str, Any]],\n    *,\n    train_fraction: float = 0.70,\n    validation_fraction: float = 0.15,\n    seed: int = 20260912,\n    receipt: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Assign connected episode components to deterministic 70/15/15 splits.\"\"\"\n    if not 0 < train_fraction < 1 or not 0 < validation_fraction < 1:\n        raise ValueError(\"Split fractions must be between zero and one\")\n    test_fraction = 1.0 - train_fraction - validation_fraction\n    if test_fraction <= 0:\n        raise ValueError(\"Train and validation fractions must leave a test split\")\n    if len(rows) < 3:\n        raise ValueError(\"At least three FactoryBench items are required for three splits\")\n\n    disjoint = _DisjointSet()\n    row_episodes: dict[str, tuple[str, ...]] = {}\n    rows_by_id: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        item_id = str(row[\"id\"])\n        if item_id in rows_by_id:\n            raise ValueError(f\"Duplicate FactoryBench item id: {item_id}\")\n        episodes = _episode_ids(row)\n        for episode in episodes:\n            disjoint.find(episode)\n        for episode in episodes[1:]:\n            disjoint.union(episodes[0], episode)\n        row_episodes[item_id] = episodes\n        rows_by_id[item_id] = row\n\n    episodes_by_root: dict[str, set[str]] = defaultdict(set)\n    for episode in disjoint.parent:\n        episodes_by_root[disjoint.find(episode)].add(episode)\n    items_by_root: dict[str, list[str]] = defaultdict(list)\n    for item_id, episodes in row_episodes.items():\n        items_by_root[disjoint.find(episodes[0])].append(item_id)\n    if len(items_by_root) < 3:\n        raise ValueError(\"Episode graph has fewer than three connected components\")\n\n    components: list[dict[str, Any]] = []\n    for root, item_ids in items_by_root.items():\n        episode_ids = sorted(episodes_by_root[root])\n        stable_id = hashlib.sha256(\"\\n\".join(episode_ids).encode()).hexdigest()[:16]\n        strata = Counter(\n            f\"template={rows_by_id[item_id].get('template_id')}|source={_source_signature(rows_by_id[item_id])}\"\n            for item_id in item_ids\n        )\n        components.append(\n            {\n                \"component_id\": stable_id,\n                \"episode_ids\": episode_ids,\n                \"item_ids\": sorted(item_ids),\n                \"item_count\": len(item_ids),\n                \"strata\": dict(sorted(strata.items())),\n            }\n        )\n\n    fractions = {\"train\": train_fraction, \"validation\": validation_fraction, \"test\": test_fraction}\n    total_items = len(rows)\n    total_strata = Counter(\n        f\"template={row.get('template_id')}|source={_source_signature(row)}\" for row in rows\n    )\n    targets = {split: total_items * fraction for split, fraction in fractions.items()}\n    stratum_targets = {\n        split: {key: count * fraction for key, count in total_strata.items()}\n        for split, fraction in fractions.items()\n    }\n    assigned_counts = Counter({split: 0 for split in SPLITS})\n    assigned_strata = {split: Counter() for split in SPLITS}\n\n    rng = random.Random(seed)\n    rng.shuffle(components)\n    components.sort(key=lambda component: -int(component[\"item_count\"]))\n    assignment: dict[str, str] = {}\n    for index, component in enumerate(components):\n        remaining_components = len(components) - index\n        empty_splits = [split for split in SPLITS if assigned_counts[split] == 0]\n        candidates = empty_splits if remaining_components <= len(empty_splits) else list(SPLITS)\n\n        def score(split: str) -> tuple[float, float, int]:\n            next_count = assigned_counts[split] + int(component[\"item_count\"])\n            total_fill = next_count / max(targets[split], 1.0)\n            stratum_fill = sum(\n                (\n                    assigned_strata[split][key] + int(component[\"strata\"].get(key, 0))\n                )\n                / max(stratum_targets[split][key], 1.0)\n                for key in total_strata\n            ) / max(len(total_strata), 1)\n            overflow = max(0.0, next_count - targets[split]) / max(targets[split], 1.0)\n            return (\n                total_fill + 0.25 * stratum_fill + 2.0 * overflow,\n                assigned_counts[split],\n                SPLITS.index(split),\n            )\n\n        split = min(candidates, key=score)\n        assignment[str(component[\"component_id\"])] = split\n        assigned_counts[split] += int(component[\"item_count\"])\n        assigned_strata[split].update(component[\"strata\"])\n\n    item_splits = {\n        item_id: assignment[str(component[\"component_id\"])]\n        for component in components\n        for item_id in component[\"item_ids\"]\n    }\n    manifest = {\n        \"schema_version\": 1,\n        \"method\": \"episode_connected_components\",\n        \"seed\": seed,\n        \"fractions\": fractions,\n        \"source\": receipt,\n        \"item_splits\": dict(sorted(item_splits.items())),\n        \"components\": [\n            {**component, \"split\": assignment[str(component[\"component_id\"])]}\n            for component in sorted(components, key=lambda item: str(item[\"component_id\"]))\n        ],\n        \"counts\": {\n            \"items\": dict(assigned_counts),\n            \"components\": dict(Counter(assignment.values())),\n            \"episodes\": {\n                split: sum(\n                    len(component[\"episode_ids\"])\n                    for component in components\n                    if assignment[str(component[\"component_id\"])] == split\n                )\n                for split in SPLITS\n            },\n        },\n    }\n    audit_split(rows, manifest)\n    return manifest\n\n\ndef audit_split(rows: Sequence[dict[str, Any]], manifest: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Verify item coverage and zero episode identity overlap across splits.\"\"\"\n    item_splits = manifest.get(\"item_splits\")\n    if not isinstance(item_splits, dict):\n        raise ValueError(\"Split manifest is missing item_splits\")\n    expected_ids = {str(row[\"id\"]) for row in rows}\n    if set(item_splits) != expected_ids:\n        missing = sorted(expected_ids - set(item_splits))[:5]\n        extra = sorted(set(item_splits) - expected_ids)[:5]\n        raise ValueError(f\"Split item coverage mismatch; missing={missing}, extra={extra}\")\n    invalid = {value for value in item_splits.values() if value not in SPLITS}\n    if invalid:\n        raise ValueError(f\"Invalid split names: {sorted(invalid)}\")\n\n    episodes_by_split = {split: set() for split in SPLITS}\n    items_by_split = Counter()\n    for row in rows:\n        split = str(item_splits[str(row[\"id\"])])\n        items_by_split[split] += 1\n        episodes_by_split[split].update(_episode_ids(row))\n    if any(items_by_split[split] == 0 for split in SPLITS):\n        raise ValueError(\"Train, validation, and test splits must all be non-empty\")\n    overlaps: dict[str, list[str]] = {}\n    for left_index, left in enumerate(SPLITS):\n        for right in SPLITS[left_index + 1 :]:\n            overlap = sorted(episodes_by_split[left] & episodes_by_split[right])\n            if overlap:\n                overlaps[f\"{left}:{right}\"] = overlap\n    if overlaps:\n        raise ValueError(f\"Episode leakage across FactoryBench splits: {overlaps}\")\n    return {\n        \"items\": dict(items_by_split),\n        \"episodes\": {split: len(values) for split, values in episodes_by_split.items()},\n        \"episode_overlap\": 0,\n    }\n\n\ndef write_split_manifest(path: Path, manifest: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), manifest)\n\n\ndef _atomic_json_write(path: Path, payload: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_suffix(path.suffix + \".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef _series_contexts(row: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    context = row.get(\"context\")\n    if not isinstance(context, dict):\n        raise ValueError(f\"Missing context for FactoryBench item {item_id}\")\n    if \"time_series\" in context:\n        return [(\"Series\", context)]\n    if \"series_a\" in context and \"series_b\" in context:\n        if not isinstance(context[\"series_a\"], dict) or not isinstance(context[\"series_b\"], dict):\n            raise ValueError(f\"Invalid comparative context for FactoryBench item {item_id}\")\n        return [(\"Series A\", context[\"series_a\"]), (\"Series B\", context[\"series_b\"])]\n    raise ValueError(f\"Unsupported FactoryBench context for item {item_id}\")\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom robot_observability.factorybench_data import (\n    FactoryBenchDataset,\n    audit_split,\n    build_component_split,\n    load_rows,\n    source_receipt,\n    write_source_receipt,\n    write_split_manifest,\n)\n\n\ndef _single(item_id: str, episode: str, *, answer: object = \"A\") -> dict:\n    return {\n        \"id\": item_id,\n        \"level\": 1,\n        \"template_id\": 6,\n        \"template_type\": \"identification\",\n        \"question\": \"Which robot produced this telemetry? Answer only with one letter.\",\n        \"options\": {\"A\": \"Robot one\", \"B\": \"Robot two\"},\n        \"answer\": answer,\n        \"acceptance_bounds\": None,\n        \"provenance\": {\"dataset\": \"factorywave\", \"episode\": episode},\n        \"context\": {\n            \"time_series_format\": {\n                \"acronym_mapping\": {\"fp0\": \"feedback position 0\", \"fs0\": \"feedback speed 0\"}\n            },\n            \"time_series\": [\n                \"t=100: fp0=1.0, fs0=-2.0\",\n                \"t=200: fp0=1.5, fs0=-1.0\",\n                \"t=300: fp0=2.0, fs0=0.0\",\n                \"t=400: fp0=2.5, fs0=1.0\",\n            ],\n        },\n    }\n\n\ndef _comparison(item_id: str, left: str, right: str) -> dict:\n    left_context = _single(\"unused-left\", left)[\"context\"]\n    right_context = _single(\"unused-right\", right)[\"context\"]\n    right_context[\"time_series\"] = right_context[\"time_series\"][:3]\n    return {\n        \"id\": item_id,\n        \"level\": \"L1\",\n        \"template_id\": 3,\n        \"template_type\": \"comparative\",\n        \"question\": \"What changed? Return four T/F letters.\",\n        \"options\": {\"A\": \"Robot\", \"B\": \"Fault\", \"C\": \"Task\", \"D\": \"Phase\"},\n        \"answer\": \"TFFT\",\n        \"acceptance_bounds\": None,\n        \"provenance\": {\n            \"dataset_a\": \"factorywave\",\n            \"episode_a\": left,\n            \"dataset_b\": \"factorywave\",\n            \"episode_b\": right,\n        },\n        \"context\": {\"series_a\": left_context, \"series_b\": right_context},\n    }\n\n\ndef _write_jsonl(path: Path, rows: list[dict]) -> str:\n    payload = \"\".join(json.dumps(row) + \"\\n\" for row in rows)\n    path.write_text(payload, encoding=\"utf-8\")\n    return hashlib.sha256(payload.encode()).hexdigest()\n\n\ndef test_load_rows_and_pinned_source_receipt(tmp_path: Path) -> None:\n    path = tmp_path / \"level_1.jsonl\"\n    expected_hash = _write_jsonl(path, [_single(\"one\", \"ep-1\", answer=0)])\n\n    rows = load_rows(path, expected_sha256=expected_hash)\n    receipt = source_receipt(\n        path,\n        revision=\"2561c2c90560ae3df90ef8136f774faa5fb4b4e3\",\n        expected_sha256=expected_hash,\n        rows=rows,\n    )\n    receipt_path = tmp_path / \"source_receipt.json\"\n    write_source_receipt(receipt_path, receipt)\n\n    assert receipt[\"sha256\"] == expected_hash\n    assert receipt[\"items\"] == 1\n    assert json.loads(receipt_path.read_text())[\"revision\"].startswith(\"2561c2\")\n    with pytest.raises(ValueError, match=\"immutable commit\"):\n        source_receipt(path, revision=\"main\")\n    with pytest.raises(ValueError, match=\"checksum mismatch\"):\n        load_rows(path, expected_sha256=\"0\" * 64)\n\n\ndef test_dataset_renders_single_series_with_exact_short_answer() -> None:\n    dataset = FactoryBenchDataset([_single(\"one\", \"ep-1\", answer=-0.0)], eos_token=\"<eos>\")\n\n    sample = dataset[0]\n\n    assert sample[\"answer\"] == \"-0.0<eos>\"\n    assert sample[\"target\"] == \"-0.0\"\n    assert sample[\"id\"] == \"one\"\n    assert len(sample[\"time_series\"]) == 3\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert sample[\"time_series\"][1].tolist() == [1.0, 1.5, 2.0, 2.5]\n    assert sample[\"time_series_text\"][1] == \"Series: feedback position 0.\"\n    assert \"factorywave\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n    assert \"ep-1\" not in sample[\"pre_prompt\"] + sample[\"post_prompt\"]\n\n\ndef test_dataset_renders_comparative_context_without_forcing_equal_lengths() -> None:\n    sample = FactoryBenchDataset([_comparison(\"compare\", \"ep-1\", \"ep-2\")])[0]\n\n    assert sample[\"answer\"] == \"TFFT\"\n    assert len(sample[\"time_series\"]) == 6\n    assert {len(series) for series in sample[\"time_series\"]} == {3, 4}\n    assert sample[\"time_series_text\"][0].startswith(\"Series A:\")\n    assert sample[\"time_series_text\"][3].startswith(\"Series B:\")\n    assert \"A: Robot\" in sample[\"post_prompt\"]\n\n\ndef test_component_split_keeps_linked_episodes_and_rows_together(tmp_path: Path) -> None:\n    rows = [\n        _single(\"single-a\", \"ep-a\"),\n        _comparison(\"a-to-b\", \"ep-a\", \"ep-b\"),\n        _single(\"single-b\", \"ep-b\"),\n        *[_single(f\"item-{index}\", f\"ep-{index}\") for index in range(3, 16)],\n    ]\n\n    manifest = build_component_split(rows, seed=19)\n    audit = audit_split(rows, manifest)\n    split_path = tmp_path / \"splits.json\"\n    write_split_manifest(split_path, manifest)\n\n    linked_splits = {\n        manifest[\"item_splits\"][item_id] for item_id in (\"single-a\", \"a-to-b\", \"single-b\")\n    }\n    assert len(linked_splits) == 1\n    assert audit[\"episode_overlap\"] == 0\n    assert all(audit[\"items\"][split] for split in (\"train\", \"validation\", \"test\"))\n    assert sum(manifest[\"counts\"][\"items\"].values()) == len(rows)\n    assert json.loads(split_path.read_text())[\"method\"] == \"episode_connected_components\"\n\n    for split in (\"train\", \"validation\", \"test\"):\n        subset = FactoryBenchDataset(rows, split_manifest=manifest, split=split)\n        assert len(subset) == audit[\"items\"][split]\n\n\ndef test_split_audit_rejects_episode_leakage() -> None:\n    rows = [_single(\"one\", \"shared\"), _single(\"two\", \"shared\"), _single(\"three\", \"other\")]\n    manifest = {\"item_splits\": {\"one\": \"train\", \"two\": \"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","create_time":1789282099.112641}}}
