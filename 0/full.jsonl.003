d],\ndata_ingestion/src/dataset_profiler/profiler.py:295:            metadata={\"source_parent_parts\": list(path.parent.relative_to(root).parts)}, events=[],\ndata_ingestion/src/dataset_profiler/profiler.py:303:        hierarchy_variants.setdefault(signature, {**structure_value, \"files\": []})[\"files\"].append(source_run_id)\ndata_ingestion/src/dataset_profiler/onboarding/models.py:1:\"\"\"Stable, JSON-serializable models for dataset onboarding jobs.\"\"\"\ndata_ingestion/src/dataset_profiler/onboarding/models.py:15:    \"\"\"Externally visible stages in one onboarding workflow.\"\"\"\ndata_ingestion/src/dataset_profiler/onboarding/models.py:45:    \"\"\"Minimal ha…5086 tokens truncated…lision.py:131:            event_semantics_source=\"Part II dataset identity\",\ndata_ingestion/src/dataset_profiler/datasets/kuka_collision.py:144:                \"GenMoments.m defines JK_moments as the source marker vector\",\nfrontend/src/evaluation/EvaluationWorkspace.tsx:4:import cnnSummary from '../../../docs/submission/evaluation/source/cnn-recorded-summary.json';\nfrontend/src/evaluation/EvaluationWorkspace.tsx:207:    \u003cdetails className=\"evaluation-methodology\"\u003e\u003csummary\u003eEvaluation contract and provenance\u003c/summary\u003e\u003cp\u003eSignal features, OpenTSLM, and Qwen are recomputed from checksum-verified archived predictions joined to the same 512 record IDs across 67 held-out recording groups. The CNN summary reports the same locked test size and seed, but its row-level predictions are not in that audited bundle, so it is visibly marked as a recorded run.\u003c/p\u003e\u003cp\u003eRecording sessions were split before window generation. Normalization and thresholds use training sessions only. Joint and evidence targets are deterministic signal-derived labels rather than physical contact-location truth.\u003c/p\u003e\u003cp className=\"mono\"\u003eAudited pipeline · records {comparison.record_ids_sha256.slice(0, 12)}… · checkpoint {comparison.checkpoint_sha256.slice(0, 12)}… · CNN source {cnnSummary.source_commit} · checkpoint {cnnSummary.checkpoint_sha256.slice(0, 12)}…\u003c/p\u003e\u003c/details\u003e\nfrontend/src/comparison/ComparisonPanel.tsx:133:      selected: { recordingId: data.recording.id, interval: { ...interval }, sourceUrl: data.recording.sourceUrl, archive: data.recording.archive },\ndata_ingestion/src/dataset_profiler/audit/checks.py:30:                issues.append(AuditIssue(\"error\", \"missing_values\", f\"{variable.nan_count} NaN values in {variable.name}\", [file.source_run_id], [file.relative_path]))\ndata_ingestion/src/dataset_profiler/audit/checks.py:32:                issues.append(AuditIssue(\"error\", \"infinities\", f\"{variable.inf_count} infinite values in {variable.name}\", [file.source_run_id], [file.relative_path]))\ndata_ingestion/src/dataset_profiler/audit/checks.py:34:                issues.append(AuditIssue(\"error\", \"empty_signals\", f\"Empty variable {variable.name}\", [file.source_run_id], [file.relative_path]))\ndata_ingestion/src/dataset_profiler/audit/checks.py:53:            schemas[file.source_run_id][variable.name] = (schema_shape, variable.dtype)\ndata_ingestion/src/dataset_profiler/audit/checks.py:55:                channels[variable.name][file.source_run_id] = variable.shape[channel_axis]\ndata_ingestion/src/dataset_profiler/audit/checks.py:57:                channels[variable.name][file.source_run_id] = variable.shape[0]\ndata_ingestion/src/dataset_profiler/audit/checks.py:68:    lengths = {run.source_run_id: run.sequence_length for run in runs}\n\ndata_ingestion/src/dataset_profiler/onboarding/__init__.py\ndata_ingestion/src/dataset_profiler/onboarding/backend.py\ndata_ingestion/src/dataset_profiler/onboarding/cli.py\ndata_ingestion/src/dataset_profiler/onboarding/models.py\ndata_ingestion/src/dataset_profiler/onboarding/orchestrator.py\ndata_ingestion/src/dataset_profiler/onboarding/presets.py\ndata_ingestion/src/dataset_profiler/onboarding/store.py\nfrontend/src/workspaces/DataWorkspace.tsx\nfrontend/src/workspaces/ModelWorkspace.tsx\nimport { useEffect, useState } from 'react';\nimport { ArrowUpRight, Database } from 'lucide-react';\nimport type { DemoData } from '../types';\nimport type { Dataset, Recording, Services } from '../services';\nimport DatasetScout from '../sourcing/DatasetScout';\n\ntype Props = { services: Services; data: DemoData; onOpenRecording: (record: Recording) =\u003e Promise\u003cvoid\u003e };\nconst errorText = (error: unknown) =\u003e error instanceof Error ? error.message : 'The request failed.';\n\nexport default function DataWorkspace({ services, data, onOpenRecording }: Props) {\n  const [datasets, setDatasets] = useState\u003cDataset[]\u003e([]);\n  const [datasetId, setDatasetId] = useState('');\n  const [recordings, setRecordings] = useState\u003cRecording[]\u003e([]);\n  const [sourceUrl, setSourceUrl] = useState('');\n  const [sourceApproved, setSourceApproved] = useState(false);\n  const [busy, setBusy] = useState('');\n  const [error, setError] = useState('');\n\n  useEffect(() =\u003e {\n    let alive = true;\n    if (services.connected) services.listDatasets().then(items =\u003e {\n      if (!alive) return;\n      setDatasets(items); setDatasetId(current =\u003e items.some(item =\u003e item.id === current) ? current : items[0]?.id ?? '');\n    }).catch(reason =\u003e { if (alive) setError(`Could not load backend catalog: ${errorText(reason)}`); });\n    return () =\u003e { alive = false; };\n  }, [services]);\n\n  useEffect(() =\u003e {\n    let alive = true; setRecordings([]);\n    if (services.connected \u0026\u0026 datasetId) services.listRecordings(datasetId).then(items =\u003e { if (alive) setRecordings(items); })\n      .catch(reason =\u003e { if (alive) setError(`Could not load recordings for this dataset: ${errorText(reason)}`); });\n    return () =\u003e { alive = false; };\n  }, [services, datasetId]);\n\n  async function run(action: string, work: () =\u003e Promise\u003cvoid\u003e) {\n    setBusy(action); setError('');\n    try { await work(); } catch (reason) { setError(errorText(reason)); } finally { setBusy(''); }\n  }\n\n  function useApprovedSource(url: string) {\n    setSourceUrl(url);\n    setSourceApproved(true);\n    requestAnimationFrame(() =\u003e document.getElementById('ingestion-handoff')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));\n  }\n\n  return \u003csection className=\"workspace-content\" aria-labelledby=\"data-title\"\u003e\n    \u003cheader className=\"workspace-heading data-heading\"\u003e\u003cdiv\u003e\u003ch1 id=\"data-title\"\u003eData sources\u003c/h1\u003e\u003cp\u003eFind robot telemetry, verify its evidence, and prepare it for TimeNet.\u003c/p\u003e\u003c/div\u003e\u003cDatabase size={24} aria-hidden=\"true\" /\u003e\u003c/header\u003e\n    {error \u0026\u0026 \u003cp className=\"error-message\" role=\"alert\"\u003e{error}\u003c/p\u003e}\n\n    \u003cdetails className=\"recording-summary\"\u003e\n      \u003csummary\u003e\u003cspan\u003e\u003cstrong\u003eCurrent recording\u003c/strong\u003e{data.recording.name}\u003c/span\u003e\u003csmall\u003e{data.recording.channelCount} channels · {data.recording.sampleRateHz.toLocaleString('en-US')} Hz · raw {data.detail.startSeconds.toFixed(3)}–{data.detail.endSeconds.toFixed(3)} s\u003c/small\u003e\u003c/summary\u003e\n      \u003cdiv className=\"recording-details\"\u003e\n        \u003cp\u003e\u003cstrong\u003e{data.recording.id}\u003c/strong\u003e · Recorded telemetry with a {data.recording.displaySampleRateHz} Hz overview. Outside the raw interval, Trace only shows display-resolution data.\u003c/p\u003e\n        \u003cdiv className=\"field-row\"\u003e{data.recording.sourceUrl \u0026\u0026 \u003ca className=\"btn\" href={data.recording.sourceUrl} target=\"_blank\" rel=\"noopener noreferrer\"\u003eSource dataset \u003cArrowUpRight size={14} aria-hidden=\"true\" /\u003e\u003c/a\u003e}\u003ca className=\"btn\" href=\"https://docs.timenet.ai\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eTimeNet documentation \u003cArrowUpRight size={14} aria-hidden=\"true\" /\u003e\u003c/a\u003e\u003c/div\u003e\n        \u003cdiv className=\"table-scroll\"\u003e\u003ctable className=\"data-table\"\u003e\u003ccaption\u003eLoaded channel mapping\u003c/caption\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eChannel\u003c/th\u003e\u003cth\u003eSignal\u003c/th\u003e\u003cth\u003eUnit\u003c/th\u003e\u003cth\u003eSource sampling\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e{data.channels.map(channel =\u003e \u003ctr key={channel.id}\u003e\u003ctd\u003e{channel.id}\u003c/td\u003e\u003ctd\u003e{channel.name}\u003c/td\u003e\u003ctd\u003e{channel.unit}\u003c/td\u003e\u003ctd\u003e{data.recording.sampleRateHz} Hz\u003c/td\u003e\u003c/tr\u003e)}\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\n        \u003cp className=\"status-note\"\u003ePublisher markers are annotations, not verified physical collision-onset times. Original archive: {data.recording.archive}.\u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/details\u003e\n\n    \u003cDatasetScout services={services} onUseSource={useApprovedSource} /\u003e\n\n    {sourceApproved \u0026\u0026 \u003csection className=\"workspace-section ingestion-handoff\" id=\"ingestion-handoff\" aria-labelledby=\"ingestion-title\"\u003e\n      \u003cdiv className=\"section-heading\"\u003e\u003cdiv\u003e\u003ch2 id=\"ingestion-title\"\u003eApproved source handoff\u003c/h2\u003e\u003cp\u003eThe revision, licence, native evidence and limitations remain visible in the approved manifest above.\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\n      \u003cp className=\"status-note\"\u003eBrowser acquisition is not connected in this submission build. Continue with the deterministic TimeNet connector; approval alone does not mean the source was downloaded or imported.\u003c/p\u003e\n      \u003clabel htmlFor=\"source-url\"\u003eCanonical source\u003c/label\u003e\u003cdiv className=\"field-row\"\u003e\u003cinput id=\"source-url\" type=\"url\" value={sourceUrl} readOnly /\u003e\u003c/div\u003e\n    \u003c/section\u003e}\n\n    {services.connected \u0026\u0026 \u003cdetails className=\"catalog-summary\"\u003e\u003csummary\u003e\u003cspan\u003e\u003cstrong\u003eAvailable recordings\u003c/strong\u003eOpen a recording already loaded by the backend.\u003c/span\u003e\u003csmall\u003e{recordings.length} recording{recordings.length === 1 ? '' : 's'}\u003c/small\u003e\u003c/summary\u003e\u003cdiv className=\"catalog-details\"\u003e\u003clabel htmlFor=\"catalog-dataset\"\u003eDataset\u003c/label\u003e\u003cselect id=\"catalog-dataset\" value={datasetId} onChange={event =\u003e setDatasetId(event.target.value)}\u003e\u003coption value=\"\"\u003eSelect dataset\u003c/option\u003e{datasets.map(dataset =\u003e \u003coption key={dataset.id} value={dataset.id}\u003e{dataset.name}\u003c/option\u003e)}\u003c/select\u003e{recordings.length ? \u003cdiv className=\"table-scroll\"\u003e\u003ctable className=\"data-table\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eRecording\u003c/th\u003e\u003cth\u003eDuration\u003c/th\u003e\u003cth\u003eChannels\u003c/th\u003e\u003cth\u003eAction\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e{recordings.map(record =\u003e \u003ctr key={record.id}\u003e\u003ctd\u003e{record.name}\u003c/td\u003e\u003ctd\u003e{record.durationSec.toFixed(1)} s\u003c/td\u003e\u003ctd\u003e{record.channels.length}\u003c/td\u003e\u003ctd\u003e\u003cbutton className=\"btn\" disabled={Boolean(busy)} onClick={() =\u003e void run(`open-${record.id}`, () =\u003e onOpenRecording(record))}\u003eOpen recording\u003c/button\u003e\u003c/td\u003e\u003c/tr\u003e)}\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e : \u003cp className=\"empty-state\"\u003eNo recordings loaded for this dataset.\u003c/p\u003e}\u003c/div\u003e\u003c/details\u003e}\n  \u003c/section\u003e;\n}\n\nimport { useEffect, useState } from 'react';\nimport { ArrowUpRight, Database } from 'lucide-react';\nimport type { DemoData } from '../types';\nimport type { Dataset, ImportedDatasetSelection, Recording, Services } from '../services';\nimport ApprovedSourceLibrary from '../sourcing/ApprovedSourceLibrary';\nimport DatasetScout from '../sourcing/DatasetScout';\nimport ImportedDatasetBrowser from '../sourcing/ImportedDatasetBrowser';\n\ntype Props = { services: Services; data: DemoData; onOpenRecording: (record: Recording) =\u003e Promise\u003cvoid\u003e };\nconst errorText = (error: unknown) =\u003e error instanceof Error ? error.message : 'The request failed.';\n\nexport default function DataWorkspace({ services, data, onOpenRecording }: Props) {\n  const [datasets, setDatasets] = useState\u003cDataset[]\u003e([]);\n  const [datasetId, setDatasetId] = useState('');\n  const [recordings, setRecordings] = useState\u003cRecording[]\u003e([]);\n  const [busy, setBusy] = useState('');\n  const [error, setError] = useState('');\n  const [approvedRevision, setApprovedRevision] = useState(0);\n  const [importedDataset, setImportedDataset] = useState\u003cImportedDatasetSelection | null\u003e(null);\n\n  useEffect(() =\u003e {\n    let alive = true;\n    if (services.connected) services.listDatasets().then(items =\u003e {\n      if (!alive) return;\n      setDatasets(items);\n      setDatasetId(current =\u003e items.some(item =\u003e item.id === current) ? current : items[0]?.id ?? '');\n    }).catch(reason =\u003e { if (alive) setError(`Could not load backend catalog: ${errorText(reason)}`); });\n    return () =\u003e { alive = false; };\n  }, [services]);\n\n  useEffect(() =\u003e {\n    let alive = true; setRecordings([]);\n    if (services.connected \u0026\u0026 datasetId) services.listRecordings(datasetId)\n      .then(items =\u003e { if (alive) setRecordings(items); })\n      .catch(reason =\u003e { if (alive) setError(`Could not load recordings for this dataset: ${errorText(reason)}`); });\n    return () =\u003e { alive = false; };\n  }, [services, datasetId]);\n\n  async function open(record: Recording) {\n    setBusy(record.id); setError('');\n    try { await onOpenRecording(record); }\n    catch (reason) { setError(errorText(reason)); }\n    finally { setBusy(''); }\n  }\n\n  function refreshApprovedSources() {\n    setApprovedRevision(value =\u003e value + 1);\n    requestAnimationFrame(() =\u003e document.getElementById('approved-source-library')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));\n  }\n\n  return \u003csection className=\"workspace-content\" aria-labelledby=\"data-title\"\u003e\n    \u003cheader className=\"workspace-heading data-heading\"\u003e\u003cdiv\u003e\u003ch1 id=\"data-title\"\u003eData sources\u003c/h1\u003e\u003cp\u003eFind robot telemetry, verify its evidence, and ingest an approved revision into TimeNet.\u003c/p\u003e\u003c/div\u003e\u003cDatabase size={24} aria-hidden=\"true\" /\u003e\u003c/header\u003e\n    {error \u0026\u0026 \u003cp className=\"error-message\" role=\"alert\"\u003e{error}\u003c/p\u003e}\n\n    \u003cdetails className=\"recording-summary\"\u003e\n      \u003csummary\u003e\u003cspan\u003e\u003cstrong\u003eCurrent recording\u003c/strong\u003e{data.recording.name}\u003c/span\u003e\u003csmall\u003e{data.recording.channelCount} channels · {data.recording.sampleRateHz.toLocaleString('en-US')} Hz · raw {data.detail.startSeconds.toFixed(3)}–{data.detail.endSeconds.toFixed(3)} s\u003c/small\u003e\u003c/summary\u003e\n      \u003cdiv className=\"recording-details\"\u003e\n        \u003cp\u003e\u003cstrong\u003e{data.recording.id}\u003c/strong\u003e · Recorded telemetry with a {data.recording.displaySampleRateHz} Hz overview. Outside the raw interval, Trace only shows display-resolution data.\u003c/p\u003e\n        \u003cdiv className=\"field-row\"\u003e{data.recording.sourceUrl \u0026\u0026 \u003ca className=\"btn\" href={data.recording.sourceUrl} target=\"_blank\" rel=\"noopener noreferrer\"\u003eSource dataset \u003cArrowUpRight size={14} aria-hidden=\"true\" /\u003e\u003c/a\u003e}\u003ca className=\"btn\" href=\"https://docs.timenet.ai\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eTimeNet documentation \u003cArrowUpRight size={14} aria-hidden=\"true\" /\u003e\u003c/a\u003e\u003c/div\u003e\n        \u003cdiv className=\"table-scroll\"\u003e\u003ctable className=\"data-table\"\u003e\u003ccaption\u003eLoaded channel mapping\u003c/caption\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eChannel\u003c/th\u003e\u003cth\u003eSignal\u003c/th\u003e\u003cth\u003eUnit\u003c/th\u003e\u003cth\u003eSource sampling\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e{data.channels.map(channel =\u003e \u003ctr key={channel.id}\u003e\u003ctd\u003e{channel.id}\u003c/td\u003e\u003ctd\u003e{channel.name}\u003c/td\u003e\u003ctd\u003e{channel.unit}\u003c/td\u003e\u003ctd\u003e{data.recording.sampleRateHz} Hz\u003c/td\u003e\u003c/tr\u003e)}\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\n        \u003cp className=\"status-note\"\u003ePublisher markers are annotations, not verified physical collision-onset times. Original archive: {data.recording.archive}.\u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/details\u003e\n\n    \u003cDatasetScout services={services} onUseSource={refreshApprovedSources} /\u003e\n    \u003cdiv id=\"approved-source-library\"\u003e\u003cApprovedSourceLibrary services={services} refreshKey={approvedRevision} onDatasetReady={setImportedDataset} /\u003e\u003c/div\u003e\n    \u003cImportedDatasetBrowser selection={importedDataset} services={services} onClose={() =\u003e setImportedDataset(null)} /\u003e\n\n    {services.connected \u0026\u0026 \u003cdetails className=\"catalog-summary\"\u003e\u003csummary\u003e\u003cspan\u003e\u003cstrong\u003eAvailable recordings\u003c/strong\u003eOpen a recording already loaded by the backend.\u003c/span\u003e\u003csmall\u003e{recordings.length} recording{recordings.length === 1 ? '' : 's'}\u003c/small\u003e\u003c/summary\u003e\u003cdiv className=\"catalog-details\"\u003e\u003clabel htmlFor=\"catalog-dataset\"\u003eDataset\u003c/label\u003e\u003cselect id=\"catalog-dataset\" value={datasetId} onChange={event =\u003e setDatasetId(event.target.value)}\u003e\u003coption value=\"\"\u003eSelect dataset\u003c/option\u003e{datasets.map(dataset =\u003e \u003coption key={dataset.id} value={dataset.id}\u003e{dataset.name}\u003c/option\u003e)}\u003c/select\u003e{recordings.length ? \u003cdiv className=\"table-scroll\"\u003e\u003ctable className=\"data-table\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eRecording\u003c/th\u003e\u003cth\u003eDuration\u003c/th\u003e\u003cth\u003eChannels\u003c/th\u003e\u003cth\u003eAction\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e{recordings.map(record =\u003e \u003ctr key={record.id}\u003e\u003ctd\u003e{record.name}\u003c/td\u003e\u003ctd\u003e{record.durationSec.toFixed(1)} s\u003c/td\u003e\u003ctd\u003e{record.channels.length}\u003c/td\u003e\u003ctd\u003e\u003cbutton className=\"btn\" disabled={Boolean(busy)} onClick={() =\u003e void open(record)}\u003e{busy === record.id ? 'Opening…' : 'Open recording'}\u003c/button\u003e\u003c/td\u003e\u003c/tr\u003e)}\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e : \u003cp className=\"empty-state\"\u003eNo recordings loaded for this dataset.\u003c/p\u003e}\u003c/div\u003e\u003c/details\u003e}\n  \u003c/section\u003e;\n}\n README.md                                          |   5 +-\n data_ingestion/.gitignore                          |   1 +\n data_ingestion/README.md                           |  98 +++\n data_ingestion/pyproject.toml                      |  10 +-\n .../src/dataset_profiler/ingestion/__init__.py     |  60 ++\n .../src/dataset_profiler/ingestion/__main__.py     |  11 +\n .../src/dataset_profiler/ingestion/acquisition.py  | 165 +++++\n .../src/dataset_profiler/ingestion/api.py          | 208 ++++++\n .../src/dataset_profiler/ingestion/archive.py      | 254 +++++++\n .../src/dataset_profiler/ingest