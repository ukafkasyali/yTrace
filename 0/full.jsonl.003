26 \u003cdetails className=\"input-receipt\"\u003e\u003csummary\u003eModel \u0026amp; input details\u003c/summary\u003e\u003cp\u003e{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s\u003c/p\u003e\u003cdetails\u003e\u003csummary\u003eStructured model prediction\u003c/summary\u003e\u003cp\u003eOnly supported prediction fields are shown here. Generated evidence prose is retained only in the audit JSON and is not treated as an annotation or measurement.\u003c/p\u003e\u003cpre\u003e{JSON.stringify(structuredPrediction(m.modelOutput) ?? { status: 'No valid structured prediction was returned.' }, null, 2)}\u003c/pre\u003e\u003c/details\u003e\u003cdetails\u003e\u003csummary\u003e1,024-sample input receipt\u003c/summary\u003e\u003cpre\u003e{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}\u003c/pre\u003e\u003cp\u003e{m.modelRevision}\u003c/p\u003e\u003c/details\u003e{m.tools.length \u003e 0 \u0026\u0026 \u003cdetails className=\"tool-log\"\u003e\u003csummary\u003e{m.tools.length} completed tool steps\u003c/summary\u003e{m.tools.map((t, i) =\u003e \u003cp key={i}\u003e{t}\u003c/p\u003e)}\u003c/details\u003e}\u003cbutton className=\"text-button\" onClick={() =\u003e exportEvidence(m)}\u003e\u003cDownload size={12}/\u003eDownload audit JSON\u003c/button\u003e\u003c/details\u003e}\n   152\t            {(m.status === 'error' || m.status === 'cancelled') \u0026\u0026 \u003cbutton className=\"text-button\" disabled={busy} onClick={() =\u003e { setQuestion(m.question); }}\u003e\u003cRotateCcw size={12}/\u003eUse this question again\u003c/button\u003e}\n   153\t          \u003c/div\u003e\u003c/div\u003e\n   154\t        \u003c/article\u003e;\n   155\t      })}\n   156\t    \u003c/div\u003e\n   157\t    {exportStatus \u0026\u0026 \u003cp className=\"report-status\" role=\"status\"\u003e{exportStatus}\u003c/p\u003e}\n   158\t    {mode === 'assistant' \u0026\u0026 !assistantAvailable \u0