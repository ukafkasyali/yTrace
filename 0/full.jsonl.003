rediction ahead of the replay playhead', () => {\n    expect(render(prediction, .25)).not.toContain('model-onset-cue');\n  });\n});\n"},"/Users/sametdegirmenci/Downloads/ysamet/frontend/src/App.tsx":{"type":"update","unified_diff":"","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/sametdegirmenci/Downloads/ysamet/frontend/src/signals/SignalViewer.test.tsx\nM /Users/sametdegirmenci/Downloads/ysamet/frontend/src/App.tsx\n","stderr":""},"started_at_ms":1789280969387,"completed_at_ms":1789280969499}}
