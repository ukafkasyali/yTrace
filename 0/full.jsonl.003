lines[0].count('=')-1) if lines else 0)\nfor typ in sorted(set(r['template_type'] for r in rows)):\n rs=[r for r in rows if r['template_type']==typ]\n ds=[]\n for r in rs:\n  for s in series_list(r): ds.append(dims(s))\n print(typ,'rows',len(rs),'series',len(ds),'steps', (min(x[0] for x in ds),statistics.median(x[0] for x in ds),max(x[0] for x in ds)) if ds else None,'channels',(min(x[1] for x in ds),statistics.median(x[1] for x in ds),max(x[1] for x in ds)) if ds else None)\nprint('template_ids',collections.Counter(r['template_id'] for r in rows))\nprint('answers top',collections.Counter(str(r['answer']) for r in rows).most_common(15))\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"comparative rows 143 series 0 steps None channels None\nidentification rows 143 series 6879 steps (1, 1, 1) channels (12, 12, 12)\npredictive rows 286 series 13734 steps (1, 1.0, 1) channels (18, 18.0, 30)\ntemplate_ids Counter({1: 143, 3: 143, 6: 143, 7: 143})\nanswers top [('0', 65), ('B', 61), ('A', 44), ('C', 38), ('TFFT', 34), ('FTTF', 22), ('FFTF', 21), ('TTTF', 16), ('FFFT', 14), ('TFTF', 12), ('FTFT', 12), ('TTFT', 8), ('FTFF', 3), ('-0.0', 3), ('101', 2)]\n","stderr":"","aggregated_output":"comparative rows 143 series 0 steps None channels None\nidentification rows 143 series 6879 steps (1, 1, 1) channels (12, 12, 12)\npredictive rows 286 series 13734 steps (1, 1.0, 1) channels (18, 18.0, 30)\ntemplate_ids Counter({1: 143, 3: 143, 6: 143, 7: 143})\nanswers top [('0', 65), ('B', 61), ('A', 44), ('C', 38), ('TFFT', 34), ('FTTF', 22), ('FFTF', 21), ('TTTF', 16), ('FFFT', 14), ('TFTF', 12), ('FTFT', 12), ('TTFT', 8), ('FTFF', 3), ('-0.0', 3), ('101', 2)]\n","exit_code":0,"duration":{"secs":0,"nanos":1416},"formatted_output":"comparative rows 143 series 0 steps None channels None\nidentification rows 143 series 6879 steps (1, 1, 1) channels (12, 12, 12)\npredictive rows 286 series 13734 steps (1, 1.0, 1) channels (18, 18.0, 30)\ntemplate_ids Counter({1: 143, 3: