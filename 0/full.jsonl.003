{"timestamp":"2026-09-13T06:28:25.942Z","ordinal":14356,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a09973-ead6-7f23-b489-a0ba516bfa5a","call_id":"call_XpFta4aMgJZLzib3kOlRlouD","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10989)\nTotal output lines: 472\n\n✓ Metadata branches: OK (no remote-tracking metadata ref found)\n\n✓ Git hooks: OK\n✓ Codex hooks: INSTALLED\n  Codex-discovered hooks: /Users/sametdegirmenci/Downloads/ysamet/.codex/hooks.json\n✓ Codex hook approval records: PRESENT\n✓ Claude Code hook config: OK\n✓ OpenCode hook config: OK\n✓ Pi hook config: OK\nNo stuck sessions found.\n\n?? .cursor/\n?? .factory/\n?? .gemini/\n?? .github/\n?? .opencode/\n?? .pi/\ncodex/final-demo-impact\ne817441 (HEAD -> codex/final-demo-impact, origin/main, origin/HEAD) Merge pull request #25 from ukafkasyali/bugfix/bosch-onboarding-source-root\nf52e12b fix(data-ingestion): keep TimeNet cache within onboarding job\nb9600ec merge: integrate baseline comparison and CNN endpoint\n88c537a Merge pull request #24 from ukafkasyali/bugfix/bosch-onboarding-source-root\na1163c7 (origin/bugfix/bosch-onboarding-source-root) fix(data-ingestion): complete Bosch onboarding preset\n\nimport { useEffect, useMemo, useRef, useState } from 'react';\nimport { ArrowUp, ArrowUpRight, CircleStop, Cpu, Download, MessageSquare, RotateCcw, SlidersHorizontal, Waves } from 'lucide-react';\nimport { predictionBrief, predictionCue, structuredPrediction, type PredictionCue } from './predictionBrief';\nimport { reviewPrediction } from './predictionReview';\nimport { downloadInvestigationJson, downloadInvestigationMarkdown, type InvestigationAnswer } from './investigationReport';\nimport { investigationContextFingerprint, investigationStorageKey, persistInvestigation, restoreInvestigation } from './investigationSession';\nimport { checkpointLabel, fitModelWindow, modelWindowIssue } from '../lib/modelWindow';\nimport { analyzeWindow } from '../lib/data';\nimport { intervalLabel } from '../lib/format';\nimport type { DemoData, EvidenceLink, Interval } from '../types';\nimport type { Evidence, Services } from '../services';\nimport type { ModelRegistry } from '../services/useModelRegistry';\n\ntype Message = InvestigationAnswer & { telemetry: DemoData; id: string; tools: string[]; status: 'running' | 'complete' | 'error' | 'cancelled'; restored?: boolean };\ntype Props = { rawLoading?: boolean; rawError?: string; onRetryRaw: () => void; data: DemoData; datasetId: string; playhead: number; interval: Interval; services: Services; registry: ModelRegistry; onEvidence: (e: EvidenceLink) => void; onModelWindow: (interval: Interval) => void; onCompare: (interval: Interval) => void; onRobotPrediction: (prediction: PredictionCue) => void };\nfunction AnswerText({ text }: { text: string }) {\n  const blocks = text.split(/\\n\\s*\\n/).filter(Boolean);\n  return <div className=\"answer-brief\">{blocks.map((block, index) => {\n    const [heading, ...body] = block.split('\\n');\n    const structured = body.length > 0 && /^(Measured in this selected window|OpenTSLM interpretation)$/i.test(heading.trim());\n    return structured\n      ? <section key={`${heading}-${index}`}><h3>{heading}</h3><p>{body.join(' ')}</p></section>\n      : <p key={`${heading}-${index}`}>{block.replace(/\\n+/g, ' ')}</p>;\n  })}</div>;\n}\nexport default function AssistantPanel({ rawLoading, rawError, onRetryRaw, data, datasetId, playhead, interval, services, registry, onEvidence, onModelWindow, onRobotPrediction, onCompare }: Props) {\n  const [question, setQuestion] = useState('');\n  const [mode, setMode] = useState<'local' | 'assistant'>('assistant');\n  const availableThrough = data.recording.durationSeconds;\n  const historical = interval.end <= availableThrough;\n  const dataIssue = useMemo(() => modelWindowIssue(data, interval, historical ? interval.end : 0), [data, interval, historical]);\n  const windowIssue = rawLoading ? 'Loading 1,024 raw samples for this interval…' : rawError ?? dataIssue;\n  const fitHorizon = Math.min(Math.floor(availableThrough * 1000) / 1000, data.detail.endSeconds);\n  const fittedWindow = useMemo(() => fitModelWindow(data, interval, fitHorizon), [data, interval, fitHorizon]);\n  const [exportStatus, setExportStatus] = useState('');\n  const sessionKey = investigationStorageKey(datasetId, data.recording.id, data.demoCase?.id ?? 'original');\n  const initialContextFingerprint = useMemo(() => investigationContextFingerprint(data, datasetId, interval), [data, datasetId, interval]);\n  const deferredRestore = useRef(rawLoading === true);\n  const [messages, setMessages] = useState<Message[]>(() => {\n    if (rawLoading) return [];\n    const saved = restoreInvestigation(typeof window === 'undefined' ? undefined : window.sessionStorage, sessionKey, data.recording.id, data.recording.durationSeconds, initialContextFingerprint);\n    return saved ? [{ ...saved, telemetry: data, restored: true }] : [];\n  });\n  const [busy, setBusy] = useState(false);\n  const [stopping, setStopping] = useState(false);\n  const assistantAvailable = services.connected && !registry.loading && !registry.error && registry.models.some(model => model.id === 'assistant' && model.available && model.capabilities.includes('language'));\n  const modeUnavailable = mode === 'assistant' && (!assistantAvailable || Boolean(windowIssue));\n  const active = useRef<{ id: string; controller: AbortController; queryId?: string; stopRequested?: boolean } | null>(null);\n  const body = useRef<HTMLDivElement>(null);\n  const completed = useRef(false);\n  useEffect(() => {\n    if (!deferredRestore.current || rawLoading || rawError) return;\n    deferredRestore.current = false;\n    const saved = restoreInvestigation(typeof window === 'undefined' ? undefined : window.sessionStorage, sessionKey, data.recording.id, data.recording.durationSeconds, initialContextFingerprint);\n    if (saved) setMessages(current => current.length ? current : [{ ...saved, telemetry: data, restored: true }]);\n  }, [rawLoading, rawError, sessionKey, data, initialContextFingerprint]);\n  useEffect(() => { const container = body.current; const latest = container?.lastElementChild as HTMLElement | null; if (!messages.length || !container || !latest) return; container.scrollTo({ top: latest.offsetTop - container.offsetTop, behavior: 'instant' }); }, [messages.length]);\n  useEffect(() => {\n    const latest = [...messages].reverse().find(message => message.status === 'complete');\n    if (!latest) return;\n    const { telemetry: _telemetry, restored: _restored, ...persistable } = latest;\n    const contextFingerprint = investigationContextFingerprint(latest.telemetry, datasetId, latest.interval);\n    persistInvestigation(typeof window === 'undefined' ? undefined : window.sessionStorage, sessionKey, data.recording.id, contextFingerprint, persistable);\n  }, [messages, sessionKey, data.recording.id, datasetId]);\n  useEffect(() => () => { const job = active.current; job?.controller.abort(); if (job?.queryId) void services.cancelQuery(job.queryId).catch(() => undefined); active.current = null; }, [services]);\n  function update(id: string, changes: Partial<Message> | ((m: Message) => Partial<Message>)) { setMessages(ms => ms.map(m => m.id === id ? { ...m, ...(typeof changes === 'function' ? changes(m) : changes) } : m)); }\n  function evidenceFrom(e: Evidence): EvidenceLink[] {\n    if (e.window.recordingId !== data.recording.id) return [];\n    if (!e.window.channelIds.length) return [];\n    return [{ channelId: e.window.channelIds[0], channelIds: e.window.channelIds, label: `Inspect ${e.window.channelIds.length} input channels`, interval: { start: e.window.startSec, end: e.window.endSec } }];\n  }\n  async function submit(prompt = question, runMode: 'local' | 'assistant' = mode) {\n    if (!prompt.trim() || busy || (runMode === 'assistant' && (rawLoading || rawError)) || (runMode === 'assistant' && !assistantAvailable)) return;\n    const snapshot = { ...interval }, horizon = Math.max(playhead, snapshot.end);\n    if (runMode === 'assistant' && modelWindowIssue(data, snapshot, horizon)) return;\n    const id = crypto.randomUUID(); const controller = new AbortController();\n    active.current = { id, controller }; completed.current = false;\n    setMessages(ms => [...ms.filter(message => !message.restored), { id, telemetry: data, mode: runMode, question: prompt.trim(), interval: snapshot, playhead: horizon, replayCursor: playhead, text: '', source: runMode === 'local' ? 'Local numerical analysis' : 'Assistant', tools: [], evidence: [], status: 'running' }]);\n    setQuestion('');\n    setBusy(true);\n    try {\n      if (runMode === 'local') {\n        const result = analyzeWindow(data, snapshot, prompt, horizon);\n        update(id, { text: result.text, tools: result.tools, evidence: result.evidence, status: 'complete' });\n      } else {\n        const request = { mode: 'assistant' as const, question: prompt, playheadSec: horizon, window: { datasetId, recordingId: data.recording.id, startSec: snapshot.start, endSec: snapshot.end, channelIds: data.channels.map(c => c.id) } };\n        const job = await services.startQuery(request, controller.signal);\n        if (active.current?.id !== id || controller.signal.aborted) { await services.cancelQuery(job.queryId); return; }\n        active.current.queryId = job.queryId;\n        if (active.current.stopRequested) {\n          try { await services.cancelQuery(job.queryId); }\n          catch { completed.current = true; throw new Error('Server cancellation could not be confirmed.'); }\n        }\n        await services.streamQuery(job.streamUrl, event => {\n          if (active.current?.id !== id || event.queryId !== job.queryId) return;\n          const p = event.payload;\n          if (event.type === 'tool.started') update(id, m => ({ tools: [...m.tools, p.label ?? p.tool ?? 'Tool started'] }));\n          if (event.type === 'tool.completed') update(id, m => ({ tools: [...m.tools, p.summary ?? 'Tool completed'] }));\n          if (event.type === 'answer.delta') update(id, m => ({ text: m.text + (p.text ?? '') }));\n          if (event.type === 'answer.completed') { completed.current = true; update(id, m => ({ status: 'complete', text: p.answer ?? m.text, modelId: p.modelId, modelRevision: p.modelRevision, inputTrace: p.inputTrace, modelOutput: typeof p.modelOutput === 'string' ? p.modelOutput : undefined, source: `${p.modelId ?? 'Assistant'} · completed`, evidence: (p.evidence ?? []).flatMap(evidenceFrom) })); }\n          if (event.type === 'query.error') { completed.current = true; update(id, m => ({ status: 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${p.message ?? 'Inference failed.'}` })); }\n          if (event.type === 'query.cancelled') { completed.current = true; update(id, { status: 'cancelled' }); }\n        }, controller.signal);\n      }\n    } catch (error) {\n      update(id, m => ({ status: controller.signal.aborted ? 'cancelled' : 'error', text: `${m.text}${m.text ? '\\n\\n' : ''}${controller.signal.aborted ? 'Stopped. This answer is incomplete.' : error instanceof Error ? error.message : 'The request failed.'}` }));\n    } finally { if (active.current?.id === id) { if (active.current.stopRequested && !completed.current) update(id, { status: 'cancelled', text: 'Stopped. This answer is incomplete.' }); active.current = null; setBusy(false); setStopping(false); } }\n  }\n  function exportReport(message: Message) {\n    try { downloadInvestigationMarkdown(message.telemetry, datasetId, message); setExportStatus('Readable investigation report downloaded as Markdown.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The report could not be exported.'); }\n  }\n  function exportEvidence(message: Message) {\n    try { downloadInvestigationJson(message.telemetry, datasetId, message); setExportStatus('Machine-readable evidence downloaded as JSON.'); }\n    catch (error) { setExportStatus(error instanceof Error ? error.message : 'The evidence could not be exported.'); }\n  }\n  async function stop() {\n    const job = active.current; if (!job) return;\n    job.stopRequested = true; setStopping(true);\n    if (job.queryId) { try { await services.cancelQuery(job.queryId); } catch { completed.current = true; job.controller.abort(); update(job.id, { status: 'error', text: 'Server cancellation could not be confirmed.' }); } }\n  }\n  return <section className=\"assistant-panel\" aria-label=\"Telemetry assistant\">\n    <header className=\"panel-heading\"><div className=\"assistant-title\"><MessageSquare size={16}/><h2>Event investigation</h2></div><span className=\"assistant-capability\">{checkpointLabel(registry.models.find(m => m.id === 'assistant')?.revision).split(' · ')[0]}</span></header>\n    <div className=\"model-input-status\"><div><strong className=\"mono\">{intervalLabel(interval)}</strong><span>{windowIssue ? 'Selection needs attention' : '1.024 s · 7 joints · raw telemetry'}</span></div><button className=\"btn btn-primary\" disabled={stopping || (!busy && (!assistantAvailable || Boolean(windowIssue)))} onClick={() => { if (busy) { void stop(); return; } setMode('assistant'); void submit('Analyze this robot telemetry window.', 'assistant'); }}>{stopping ? 'Stopping…' : busy ? 'Stop analysis' : 'Analyze interval'}</button></div>\n    {windowIssue && <div className=\"input-guidance\"><p>{windowIssue}</p>{rawError && <button className=\"text-button\" onClick={onRetryRaw}>Retry raw window</button>}{!rawLoading && !rawError && fittedWindow && <button className=\"text-button\" disabled={busy} onClick={() => onModelWindow(fittedWindow)}>Use 1.024 s window</button>}</div>}\n    <div className=\"conversation\" ref={body} aria-live=\"polite\">\n      {!messages.length && <div className=\"conversation-intro\"><Waves size={26}/><h3>Prepare a reviewable incident handoff.</h3><p>Analyze the incident, verify the prediction against exact signals, then export the handoff for a controls engineer.</p><p className=\"intro-limit\">Recorded torque can guide investigation. It cannot verify a physical cause.</p></div>}\n      {messages.map(m => {\n        const brief = predictionBrief(m.modelOutput);\n        const cue = m.status === 'complete' ? predictionCue(m.modelOutput, m.interval) : undefined;\n        const review = m.status === 'complete' ? reviewPrediction(m.telemetry, m.interval, m.modelOutput) : undefined;\n        const measuredText = m.text.split(/\\n\\s*\\n/).find(block => block.startsWith('Measured in this selected window'))?.split('\\n').slice(1).join(' ');\n        return <article className=\"conversation-turn\" key={m.id}>\n          <div className=\"user-question\"><div><p>{m.question}</p><small className=\"mono\">{intervalLabel(m.interval)}</small></div></div>\n          <div className=\"assistant-answer\"><div>\n            {m.restored && <div className=\"answer-source\">Restored from this browser session.</div>}\n            {m.status !== 'complete' && <div className=\"answer-source\">{m.status === 'running' ? 'Reading the selected telemetry…' : m.status}</div>}\n            <div className={m.status === 'error' ? 'error-message' : ''}>\n              {brief ? <><section className=\"prediction-summary\"><h3>{brief.title}</h3><div className=\"prediction-facts\">{brief.strongest && <span>Predicted strongest joint <strong>{brief.strongest}</strong></span>}{brief.onset !== undefined && <span>Predicted onset <strong>{brief.onset} ms</strong> into the window</span>}</div><p className=\"prediction-caution\">OpenTSLM prediction · not a verified physical diagnosis.</p></section>{measuredText && <section className=\"measured-summary\"><h3>Measured torque</h3><p>{measuredText}</p></section>}{review && <section className=\"review-note\"><h3>Cross-check</h3><p>{review.note}</p></section>}</> : m.status === 'complete' && m.mode === 'assistant' ? <><section className=\"prediction-summary\"><h3>No usable structured prediction</h3><p className=\"prediction-caution\">The generation did not meet the complete seven-field contract used by Evaluation. Inspect the raw audit output before retrying.</p></section>{measuredText && <section className=\"measured-summary\"><h3>Measured torque</h3><p>{measuredText}</p></section>}</> : m.text ? <AnswerText text={m.text}/> : null}\n            </div>\n            {m.status === 'complete' && <section className=\"investigation-next\" aria-label=\"Verify and hand off\"><h3>Verify and hand off</h3><ol className=\"investigation-actions\">\n              {cue && <li><button onClick={() => onRobotPrediction(cue)}><span>1</span><strong>Show generated onset cue in 3D</strong><ArrowUpRight size={12}/></button></li>}\n              {m.evidence.map((e, i) => <li key={i}><button onClick={() => onEvidence(e)}><span>{cue ? 2 : 1}</span><strong>Inspect exact seven-channel input</strong><SlidersHorizontal size={12}/></button></li>)}\n              <li><button onClick={() => onCompare(m.interval)}><span>{cue ? 3 : m.evidence.length ? 2 : 1}</span><strong>Compare with a reference window · optional</strong><ArrowUpRight size={12}/></button></li>\n              <li><button onClick={() => exportReport(m)}><span>{cue ? 4 : m.evidence.length ? 3 : 2}</span><strong>Export incident handoff (.md)</strong><Download size={13}/></button></li>\n            </ol></section>}\n            {m.status === 'complete' && m.mode === 'assistant' && <details className=\"input-receipt\"><summary>Model &amp; input details</summary><p>{checkpointLabel(m.modelRevision)} · [{m.interval.start.toFixed(3)}, {m.interval.end.toFixed(3)}) s</p><details><summary>Structured model prediction</summary><p>Only supported prediction fields are shown here. Generated evidence prose is retained only in the audit JSON and is not treated as an annotation or measurement.</p><pre>{JSON.stringify(structuredPrediction(m.modelOutput) ?? { status: 'No valid structured prediction was returned.' }, null, 2)}</pre></details><details><summary>1,024-sample input receipt</summary><pre>{JSON.stringify(m.inputTrace ?? { status: 'The server did not return an input receipt.' }, null, 2)}</pre><p>{m.modelRevision}</p></details>{m.tools.length > 0 && <details className=\"tool-log\"><summary>{m.tools.length} completed tool steps</summary>{m.tools.map((t, i) => <p key={i}>{t}</p>)}</details>}<button className=\"text-button\" onClick={() => exportEvidence(m)}><Download size={12}/>Download audit JSON</button></details>}\n            {(m.status === 'error' || m.status === 'cancelled') && <button className=\"text-button\" disabled={busy} onClick={() => { setQuestion(m.question); }}><RotateCcw size={12}/>Use this question again</button>}\n          </div></div>\n        </article>;\n      })}\n    </div>\n    {exportStatus && <p className=\"report-status\" role=\"status\">{exportStatus}</p>}\n    {mode === 'assistant' && !assistantAvailable && <p className=\"status-note\" role=\"status\">Model unavailable. Open custom analysis and choose Measurements only.</p>}\n    <details className=\"custom-analysis\"><summary>Ask a custom question</summary><form className=\"composer\" onSubmit={e => { e.preventDefault(); void submit(); }}><label className=\"sr-only\" htmlFor=\"question\">Ask about the selected telemetry</label><textarea id=\"question\" value={question} onChange={e => setQuestion(e.target.value)} placeholder=\"Ask about this interval…\" rows={2} onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); void submit(); } }}/><div className=\"composer-bottom\"><label className=\"mode-select\"><Cpu size={13}/><select aria-label=\"Analysis mode\" value={mode} onChange={e => setMode(e.target.value as 'local' | 'assistant')}><option value=\"assistant\" disabled={!assistantAvailable}>Model + measurements{!assistantAvailable ? ' · unavailable' : ''}</option><option value=\"local\">Measurements only</option></select></label>{busy ? <button className=\"send-button\" type=\"button\" aria-label={stopping ? 'Stopping analysis' : 'Stop analysis'} disabled={stopping} onClick={() => void stop()}><CircleStop size={18}/></button> : <button className=\"send-button\" type=\"submit\" aria-label=\"Send question\" disabled={!question.trim() || modeUnavailable || interval.end <= interval.start || interval.end > availableThrough}><ArrowUp size={18}/></button>}</div></form></details>\n  </section>;\n}\nimport { useMemo, useRef } from 'react';\nimport { Crosshair, Maximize2 } from 'lucide-react';\nimport { downsample, selectWindow } from '../lib/…989 tokens truncated…layhead) - viewport.start) / (viewport.end - viewport.start) * 100);\n  return <section className=\"signals-panel\" ref={panel} aria-label=\"Synchronized torque signals\">\n    <header className=\"panel-heading\"><div><h2>{visibleChannelIds ? \"Torque evidence\" : \"All joint signals\"}</h2><span>Signed external torque</span></div><div className=\"plot-actions\"><select aria-label=\"Signal zoom\" value={following ? String(zoom) : \"selection\"} onChange={e => onZoom(Number(e.target.value))}><option value=\"selection\" disabled>Selection</option><option value=\"1.024\">1.024 s</option><option value=\"5\">5 s</option><option value=\"10\">10 s</option><option value=\"0\">Full history</option></select><button className=\"icon-button\" title=\"Follow playhead\" aria-label=\"Follow playhead\" aria-pressed={following} onClick={onFollow}><Crosshair size={16}/></button></div></header>\n    <div className=\"signal-strips\">{plots.map(p => <div key={p.channel.id} className={`signal-strip ${highlighted.includes(p.channel.id) ? 'signal-highlighted' : ''}`} data-channel={p.channel.id}>\n      <div className=\"strip-heading\"><span className=\"channel-name\"><i style={{ background: COLORS[p.colorIndex] }}/>{p.channel.name}<span className=\"unit\">Nm</span></span><span className=\"mono sample-value\" data-sample-value>{p.last?.toFixed(3) ?? '—'}</span></div>\n      <div className=\"plot-frame\"><div className=\"y-labels\"><span>{p.high.toFixed(p.high-p.low < 1 ? 2 : 1)}</span><span>{p.low.toFixed(p.high-p.low < 1 ? 2 : 1)}</span></div><div className=\"plot-area\">\n        {right > left && <div className=\"selection-band\" style={{ left: `${left}%`, width: `${right - left}%` }}/>}<div className=\"hover-guide\"/>\n        <svg viewBox=\"0 0 1000 76\" preserveAspectRatio=\"none\" role=\"img\" aria-label={`${p.channel.name}, signed external torque in Nm, ${viewport.start.toFixed(3)} to ${end.toFixed(3)} seconds`} onPointerMove={e => showCursor(pointerTime(e))} onPointerLeave={() => showCursor(null)} onPointerDown={beginSelection} onPointerUp={finishSelection} onPointerCancel={cancelSelection} onLostPointerCapture={cancelSelection}>\n          {[0, 250, 500, 750, 1000].map(x => <line key={x} x1={x} x2={x} y1=\"0\" y2=\"76\" className=\"chart-grid\"/>)}\n          {[18, 38, 58].map(y => <line key={y} x1=\"0\" x2=\"1000\" y1={y} y2={y} className=\"chart-grid\"/>)}\n          {p.zero > 0 && p.zero < 76 && <line x1=\"0\" x2=\"1000\" y1={p.zero} y2={p.zero} className=\"chart-zero\"/>}\n          {data.events.filter(e => e.timeSeconds >= viewport.start && e.timeSeconds <= end).map(e => <line key={e.id} x1={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} x2={(e.timeSeconds - viewport.start)/(viewport.end-viewport.start)*1000} y1=\"0\" y2=\"76\" className=\"event-line\"/>)}\n          <path d={p.path} fill=\"none\" stroke={COLORS[p.colorIndex]} strokeWidth=\"1.3\" vectorEffect=\"non-scaling-stroke\"/>\n        </svg>\n      </div></div>\n    </div>)}</div>\n    <div className=\"shared-axis\">{[0, .25, .5, .75, 1].map(v => <span key={v}>{(viewport.start+(viewport.end-viewport.start)*v).toFixed(2)} s</span>)}</div>\n    <footer className=\"plot-footer\"><span data-cursor-time>Hover to inspect · drag to select</span><span><Maximize2 size={12}/>{visible ? `${visible.sampleRateHz >= 1000 ? `${(visible.sampleRateHz / 1000).toFixed(0)} kHz` : `${visible.sampleRateHz.toFixed(0)} Hz`} ${visible.resolution === 'raw' ? 'raw' : 'overview'} · extrema-preserving plot` : 'No replayed samples'}</span></footer>\n  </section>;\n}\n\nimport { useEffect, useRef, useState } from 'react';\nimport { Check, Plus, SearchCheck, X } from 'lucide-react';\nimport { sourcingIsActive, type RequirementsPreview, type Services, type SourcingReview, type SourcingRun } from '../services';\nimport RequirementEditor, { selectedRequirements, type RequirementPriorities } from './RequirementEditor';\nimport ScoutReview from './ScoutReview';\n\nconst demoBrief = 'Find 1 kHz robot collision and intentional contact time-series torque data from https://github.com/zhang-zengjie/robot-raw-collision-signals';\nconst errorText = (error: unknown) => error instanceof Error ? error.message : 'The request failed.';\ntype Intent = { signature: string; key: string };\n\nexport default function DatasetScout({ services, onUseSource }: { services: Services; onUseSource: (url: string) => void }) {\n  const [brief, setBrief] = useState(demoBrief);\n  const [resumeId, setResumeId] = useState('');\n  const [runId, setRunId] = useState('');\n  const [pollRevision, setPollRevision] = useState(0);\n  const [run, setRun] = useState<SourcingRun | null>(null);\n  const [busy, setBusy] = useState('');\n  const [error, setError] = useState('');\n  const [sourceReady, setSourceReady] = useState(false);\n  const [customRequirement, setCustomRequirement] = useState('');\n  const [customRequirements, setCustomRequirements] = useState<string[]>([]);\n  const [preview, setPreview] = useState<RequirementsPreview | null>(null);\n  const [priorities, setPriorities] = useState<RequirementPriorities>({});\n  const intent = useRef<Intent | null>(null);\n\n  useEffect(() => {\n    if (!runId || !services.connected) return;\n    let alive = true;\n    let timer: ReturnType<typeof setTimeout> | undefined;\n    const poll = async () => {\n      try {\n        const next = await services.getSourcingRun(runId);\n        if (!alive) return;\n        setRun(next); setError('');\n        if (sourcingIsActive(next.status)) timer = setTimeout(poll, 1500);\n      } catch (reason) { if (alive) setError(`Could not load sourcing run: ${errorText(reason)}`); }\n    };\n    void poll();\n    return () => { alive = false; clearTimeout(timer); };\n  }, [services, runId, pollRevision]);\n\n  function invalidatePreview() {\n    setPreview(null); setPriorities({}); intent.current = null;\n  }\n\n  async function previewRequirements() {\n    const normalized = brief.trim();\n    if (normalized.length < 20) { setError('Describe the dataset need in at least 20 characters.'); return; }\n    setBusy('preview'); setError('');\n    try {\n      const next = await services.previewSourcingRequirements({\n        brief: normalized, customRequirements,\n      });\n      setPreview(next);\n      setPriorities(Object.fromEntries(next.requirements.map(item => [item.id, item.priority])));\n    } catch (reason) { setError(`Could not preview requirements: ${errorText(reason)}`); }\n    finally { setBusy(''); }\n  }\n\n  function addCustomRequirement() {\n    const normalized = customRequirement.trim();\n    if (normalized.length < 3 || customRequirements.length >= 10\n      || customRequirements.some(item => item.toLocaleLowerCase() === normalized.toLocaleLowerCase())) return;\n    setCustomRequirements(items => [...items, normalized]);\n    setCustomRequirement(''); invalidatePreview();\n  }\n\n  async function start() {\n    const normalized = brief.trim();\n    if (!preview) { setError('Review the research requirements before starting.'); return; }\n    const request = {\n      brief: normalized,\n      requirements: selectedRequirements(preview.requirements, priorities),\n    };\n    const signature = JSON.stringify(request);\n    setBusy('start'); setError(''); setRun(null); setSourceReady(false);\n    try {\n      if (!intent.current || intent.current.signature !== signature) intent.current = { signature, key: crypto.randomUUID() };\n      const accepted = await services.startSourcingRun(request, intent.current.key);\n      intent.current = null;\n      setRunId(accepted.runId); setResumeId(accepted.runId); setPollRevision(value => value + 1);\n    } catch (reason) { setError(`Could not start evidence review: ${errorText(reason)}`); }\n    finally { setBusy(''); }\n  }\n\n  async function review(reviewRequest: SourcingReview) {\n    if (!run) return;\n    setBusy(reviewRequest.decision); setError('');\n    try {\n      const next = await services.reviewSourcingRun(run.runId, reviewRequest);\n      if (reviewRequest.decision === 'APPROVE') next.manifest = await services.getSourcingManifest(run.runId);\n      setRun(next);\n    } catch (reason) { setError(`Could not apply reviewer decision: ${errorText(reason)}`); }\n    finally { setBusy(''); }\n  }\n\n  return <section className=\"workspace-section dataset-scout\" aria-labelledby=\"scout-title\">\n    <div className=\"section-heading\"><div><h2 id=\"scout-title\">Find and verify a dataset</h2><p>Describe the data you need. Trace searches bounded sources, checks native evidence, and waits for your approval.</p></div><SearchCheck size={20} aria-hidden=\"true\" /></div>\n    {!services.connected && <p className=\"status-note\">Configure the team API to run or resume dataset research.</p>}\n    <label htmlFor=\"sourcing-brief\">Research brief</label>\n    <textarea id=\"sourcing-brief\" rows={3} value={brief} onChange={event => { setBrief(event.target.value); invalidatePreview(); }} disabled={!services.connected || Boolean(busy)} />\n    <form className=\"custom-requirement\" onSubmit={event => { event.preventDefault(); addCustomRequirement(); }}>\n      <label htmlFor=\"custom-sourcing-requirement\">Custom mandatory requirement</label>\n      <div><input id=\"custom-sourcing-requirement\" value={customRequirement} onChange={event => setCustomRequirement(event.target.value)} maxLength={500} placeholder=\"Example: At least 200 labelled collision sequences\" disabled={!services.connected || Boolean(busy) || customRequirements.length >= 10} /><button className=\"btn\" disabled={customRequirement.trim().length < 3 || customRequirements.length >= 10 || Boolean(busy)}><Plus size={14} aria-hidden=\"true\" />Add</button></div>\n      <small>{customRequirements.length}/10 custom requirements</small>\n    </form>\n    {customRequirements.length > 0 && <ul className=\"custom-requirements\" aria-label=\"Custom requirements\">{customRequirements.map(item => <li key={item}><span>{item}</span><button type=\"button\" aria-label={`Remove custom requirement: ${item}`} onClick={() => { setCustomRequirements(values => values.filter(value => value !== item)); invalidatePreview(); }}><X size={13} aria-hidden=\"true\" /></button></li>)}</ul>}\n    {preview && <RequirementEditor requirements={preview.requirements} priorities={priorities} onPriorityChange={(id, priority) => { setPriorities(current => ({ ...current, [id]: priority })); intent.current = null; }} />}\n    <div className=\"scout-actions\">\n      {preview\n        ? <button className=\"btn btn-primary\" type=\"button\" disabled={!services.connected || Boolean(busy)} onClick={() => void start()}><SearchCheck size={15} aria-hidden=\"true\" />{busy === 'start' ? 'Starting…' : 'Start evidence review'}</button>\n        : <button className=\"btn btn-primary\" type=\"button\" disabled={!services.connected || Boolean(busy)} onClick={() => void previewRequirements()}><SearchCheck size={15} aria-hidden=\"true\" />{busy === 'preview' ? 'Preparing…' : 'Review requirements'}</button>}\n      <form onSubmit={event => { event.preventDefault(); setError(''); setRun(null); setSourceReady(false); setRunId(resumeId.trim()); setPollRevision(value => value + 1); }}><label htmlFor=\"sourcing-run-id\">Resume run</label><input id=\"sourcing-run-id\" value={resumeId} onChange={event => setResumeId(event.target.value)} placeholder=\"Run ID\" disabled={!services.connected || Boolean(busy)} /><button className=\"btn\" disabled={!services.connected || !resumeId.trim() || Boolean(busy)}>Load</button></form>\n    </div>\n    {error && <p className=\"error-message\" role=\"alert\">{error}</p>}\n    {run ? <ScoutReview run={run} busy={busy} onReview={reviewRequest => void review(reviewRequest)} onUseSource={url => { onUseSource(url); setSourceReady(true); }} /> : runId && !error ? <p className=\"status-note\" aria-live=\"polite\">Loading sourcing run…</p> : null}\n    {sourceReady && <p className=\"source-ready\" role=\"status\"><Check size={14} aria-hidden=\"true\" />Approved manifest is ready for a separate deterministic ingestion step.</p>}\n  </section>;\n}\n14:import SignalViewer from './signals/SignalViewer';\n82:  const visiblePrediction = robotPrediction && robotPrediction.interval.start === interval.start && robotPrediction.interval.end === interval.end ? robotPrediction : undefined;\n83:  function showRobotPrediction(prediction: PredictionCue) {\n155:          <div className=\"left-workspace\"><AssistantPanel rawLoading={rawWindow.loading} rawError={rawWindow.error} onRetryRaw={rawWindow.retry} registry={registry} data={data} datasetId={datasetId} playhead={replay.playhead} interval={effectiveInterval} services={services} onEvidence={evidence} onCompare={openComparison} onRobotPrediction={showRobotPrediction} onModelWindow={select}/></div>\n159:            {(visualMode === 'robot' || visualMode === 'markers') && <RecordingContext prediction={visiblePrediction} display={visualMode === 'robot' ? 'robot' : 'overview'} datasetId={datasetId} data={data} playhead={replay.playhead} interval={effectiveInterval} highlighted={highlighted} onMarker={marker} onHighlight={id => setHighlighted(h => h.includes(id) ? h.filter(x => x !== id) : [id])} onData={() => { replay.pause(); setView('data'); }}/>}\n160:            {(visualMode === 'robot' || visualMode === 'signals') && <SignalViewer visibleChannelIds={visualMode === 'robot' ? previewChannels : undefined} data={data} playhead={replay.playhead} interval={effectiveInterval} viewport={validViewport} highlighted={highlighted} following={following} zoom={zoom} onSelect={select} onFollow={() => { setFollowing(true); setZoom(10); }} onZoom={n => { setFollowing(true); setZoom(n); }}/>}\n.comparison-panel { overflow-y: auto; min-height: 0; flex: 1; padding: 24px; overscroll-behavior: contain; }\n.comparison-panel > header h2 { font-size: 22px; font-weight: 500; }\n.comparison-panel > header p { color: var(--quiet); margin-top: 6px; line-height: 1.5; }\n.comparison-selection { display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; margin: 22px 0 14px; font-size: 12px; }\n.comparison-selection strong { font-family: 'IBM Plex Mono', monospace; font-weight: 400; }\n.reference-controls { padding-bottom: 12px; border-bottom: 1px solid var(--line); }\n.reference-controls label { display: grid; gap: 6px; font-size: 12px; color: var(--quiet); }\n.reference-controls select, .reference-controls input { color: var(--text); background: var(--panel); border: 1px solid var(--line); padding: 8px; border-radius: 4px; min-width: 0; width: 100%; }\n.reference-controls > div { display: flex; gap: 12px; align-items: end; margin-top: 12px; }\n.reference-controls > div label { max-width: 125px; }\n.reference-controls > div > span { color: var(--quiet); font-size: 11px; padding-bottom: 10px; }\n.reference-controls button { margin-left: auto; }\n.reference-note, .comparison-empty { font-size: 12px; line-height: 1.6; color: var(--quiet); margin-block: 12px; }\n.comparison-error { color: #edb6ab; font-size: 13px; margin-block: 14px; }\n.comparison-finding { padding-block: 18px; }\n.comparison-finding h3 { font-size: 16px; font-weight: 500; line-height: 1.5; }\n.comparison-finding p { margin: 8px 0; font-size: 19px; font-variant-numeric: tabular-nums; }\n.comparison-finding p strong { font-weight: 400; color: var(--accent); font-size: 15px; }\n.comparison-finding > span { font-size: 11px; color: var(--quiet); }\n.comparison-table-wrap { overflow-x: auto; }\n.comparison-table { width: 100%; border-collapse: collapse; font-size: 12px; font-variant-numeric: tabular-nums; }\n.comparison-table caption { text-align: left; color: var(--quiet); font-size: 11px; padding-bottom: 10px; }\n.comparison-table th, .comparison-table td { padding: 8px; text-align: right; border-bottom: 1px solid var(--line); font-weight: 400; }\n.comparison-table th:first-child { text-align: left; }\n.comparison-table button { background: transparent; border: 0; padding: 3px 0; color: inherit; }\n.comparison-table tr.selected { background: #25352f; }\n.comparison-table tr.selected button { color: var(--accent); }\n.comparison-plot { margin: 24px 0 0; }\n.comparison-plot figcaption { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; }\n.comparison-plot figcaption strong { font-weight: 500; }\n.comparison-plot figcaption span { display: flex; align-items: center; gap: 6px; color: var(--quiet); font-size: 11px; }\n.comparison-plot i { width: 12px; height: 2px; background: var(--accent); }\n.comparison-plot .reference-key { background: var(--amber); margin-left: 6px; }\n.comparison-plot svg { width: 100%; display: block; margin-top: 10px; }\n.comparison-axis { display: flex; justify-content: space-between; gap: 6px; font-size: 10px; color: var(--quiet); font-variant-numeric: tabular-nums; }\n.comparison-plot p, .comparison-secondary { font-size: 11px; color: var(--quiet); line-height: 1.6; margin-top: 10px; }\n.comparison-next { border-top: 1px solid var(--line); margin-top: 20px; padding-top: 18px; }\n.comparison-next h3 { font-size: 14px; font-weight: 500; }\n.comparison-next h3:not(:first-child) { margin-top: 20px; }\n.comparison-next p, .comparison-method p { font-size: 12px; line-height: 1.7; color: var(--quiet); margin-top: 7px; max-width: 70ch; }\n.comparison-next button { margin-top: 8px; }\n.comparison-method { margin-block: 18px; font-size: 12px; color: var(--quiet); }\n.comparison-method summary { cursor: pointer; }\n.comparison-export { margin-bottom: 16px; }\n@media(max-width:1100px) and (min-width:851px) { .visual-tabs { gap: 10px; padding-inline: 12px; flex-wrap: wrap; height: auto; min-height: 48px; } .visual-tabs > button { min-height: 38px; } }\n@media(max-width:850px) { .visual-tabs { grid-template-columns: repeat(4, 1fr); gap: 0 8px; padding-inline: 10px; } .visual-tabs > button { font-size: 11px; } .comparison-panel { padding: 18px 14px; } .reference-controls > div { flex-wrap: wrap; } .reference-controls button { padding-inline: 10px; } .compare-current { padding-inline: 14px; } }\n\n.reference-editor { font-size: 12px; color: var(--quiet); }\n.reference-editor > summary { padding-block: 8px; cursor: pointer; color: var(--text); }\n.reference-editor[open] > summary { margin-bottom: 8px; }\n.comparison-finding > h3 { margin-top: 9px; }\n\n/* Measured callouts attach to source samples, inspired by the supplied signal graphic. */\n.annotated-comparison { margin-top: 12px; }\n.annotated-comparison figcaption { align-items: center; margin-bottom: 22px; }\n.annotated-comparison figcaption label { display: flex; gap: 9px; align-items: center; color: var(--quiet); }\n.annotated-comparison select { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; color: var(--text); padding: 7px 9px; }\n.annotated-comparison svg { margin-top: 0; overflow: visible; }\n.graph-callout { display: flex; flex-direction: column; gap: 5px; font-size: 12px; line-height: 1.5; }\n.graph-callout strong { font-weight: 500; }\n.graph-callout span { color: var(--text); font-variant-numeric: tabular-nums; }\n.selected-callout { color: var(--accent); padding-left: 4%; }\n.reference-callout { color: var(--amber); text-align: right; padding-right: 4%; }\n.selected-wave, .reference-wave { fill: none; stroke-width: 1.6; vector-effect: non-scaling-stroke; }\n.selected-wave { stroke: var(--accent); }\n.reference-wave { stroke: var(--amber); stroke-dasharray: 5 4; }\n.graph-leader { fill: none; stroke-width: 1; vector-effect: non-scaling-stroke; }\n.selected-leader, .selected-point { stroke: var(--accent); }\n.reference-leader, .reference-point { stroke: var(--amber); }\n.reference-leader { stroke-dasharray: 3 3; }\n.graph-point { fill: var(--panel); stroke-width: 1.5; vector-effect: non-scaling-stroke; }\n.graph-scale { fill: #a2adb1; font-size: 13px; font-variant-numeric: tabular-nums; }\n.annotated-comparison .comparison-axis { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 10px; }\n.comparison-all-joints { margin-top: 22px; font-size: 12px; }\n.comparison-all-joints summary { cursor: pointer; padding-block: 10px; }\n.comparison-all-joints[open] summary { margin-bottom: 10px; }\n@media(max-width:850px) {\n  .annotated-comparison figcaption { flex-wrap: wrap; gap: 10px; }\n  .graph-scale { font-size: 18px; }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a09973-2c14-7021-8bb8-3bdcb42353b2","create_time":1789280905.942126}}}
