                                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1mapplications\u001b[0m                                                                                                                                            \n                                                                                                                                                              \n      \u001b[1maudit\u001b[0m                                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1mbilling\u001b[0m                                                                                                                                                 \n                                                                                                                                                              \n      \u001b[1mcapacity\u001b[0m                                                                                                                                                \n                                                                                                                                                              \n      \u001b[1mcompute\u001b[0m                                                                                                                                                 \n                                                                                                                                                              \n      \u001b[1mconfig\u001b[0m                                                                                                                                                  \n        Manage CLI configuration.                                                                                                                             \n                                                                                                                                                              \n      \u001b[1mdns\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1mecho\u001b[0m                                                                                                                                                    \n        Nebius Echo AI Assistant.                                                                                                                             \n                                                                                                                                                              \n      \u001b[1mfeedback\u001b[0m                                                                                                                                                \n        Send feedback about Nebius CLI.                                                                                                                       \n                                                                                                                                                              \n      \u001b[1miam\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1mkms\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1mlogging\u001b[0m                                                                                                                                                 \n                                                                                                                                                              \n      \u001b[1mmaintenance\u001b[0m                                                                                                                                             \n                                                                                                                                                              \n      \u001b[1mmk8s\u001b[0m                                                                                                                                                    \n                                                                                                                                                              \n      \u001b[1mmsp\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1mmysterybox\u001b[0m                                                                                                                                              \n                                                                                                                                                              \n      \u001b[1mprofile\u001b[0m                                                                                                                                                 \n        Manage configuration profiles.                                                                                                                        \n                                                                                                                                                              \n      \u001b[1mquotas\u001b[0m                                                                                                                                                  \n                                                                                                                                                              \n      \u001b[1mregistry\u001b[0m                                                                                                                                                \n                                                                                                                                                              \n      \u001b[1mstorage\u001b[0m                                                                                                                                                 \n                                                                                                                                                              \n      \u001b[1mtunnel\u001b[0m                                                                                                                                                  \n                                                                                                                                                              \n      \u001b[1mupdate\u001b[0m                                                                                                                                                  \n        Update Nebius CLI.                                                                                                                                    \n                                                                                                                                                              \n      \u001b[1mversion\u001b[0m                                                                                                                                                 \n        Display Nebius CLI version.                                                                                                                           \n                                                                                                                                                              \n      \u001b[1mvpc\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mOPTIONS\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1m--auth-timeout\u001b[0m (duration: 2h30m10s)                                                                                                                     \n         Set the timeout for the request including authentication p