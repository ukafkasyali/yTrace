       \n      \u001b[1mactivate\u001b[0m                                                                                                                                                \n        Activate the specified profile.                                                                                                                       \n                                                                                                                                                              \n      \u001b[1mactive\u001b[0m                                                                                                                                                  \n        Print active profile name, set in the config.                                                                                                         \n                                                                                                                                                              \n      \u001b[1mcreate\u001b[0m                                                                                                                                                  \n        Create a new profile.                                                                                                                                 \n                                                                                                                                                              \n      \u001b[1mcurrent\u001b[0m                                                                                                                                                 \n        Print current profile name.                                                                                                                           \n                                                                                                                                                              \n      \u001b[1mdelete\u001b[0m                                                                                                                                                  \n        Delete the specified profile.                                                                                                                         \n                                                                                                                                                              \n      \u001b[1mlist\u001b[0m                                                                                                                                                    \n        List profiles.                                                                                                                                        \n                                                                                                                                                              \n      \u001b[1mupdate\u001b[0m                                                                                                                                                  \n        Update a profile.                                                                                                                                     \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mGLOBAL\u001b[0m\u001b[1m OPTIONS\u001b[0m                                                                                                                                              \n                                                                                                                                                              \n      \u001b[1m-h, --help\u001b[0m (bool)                                                                                                                                       \n         Show this message.                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1m-p, --profile\u001b[0m (string)                                                                                                                                  \n         Set a profile for interacting with the cloud.                                                                                                        \n                                                                                                                                                              \n      \u001b[1m--format\u001b[0m (string)                                                                                                                                       \n         Output format. Supported values: yaml|json|jsonpath|table|text.                                                                                      \n                                                                                                                                                              \n      \u001b[1m-f, --file\u001b[0m (string)                                                                                                                                     \n         Input file. For 'update' commands automatically set --full=true.                                                                                     \n                                                                                                                                                              \n      \u001b[1m-c, --config\u001b[0m (string)                                                                                                                                   \n         Provide path to config file.                                                                                                                         \n                                                                                                                                                              \n      \u001b[1m--debug\u001b[0m (bool)                                                                                                                                          \n         Enable debug logs.                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1m-I, --impersonate-service-account-id\u001b[0m (string)                                                                                                           \n         Impersonate into the service account and use its token for a command.                                                                                \n                                                                                                                                                              \n      \u001b[1m--color\u001b[0m (bool)                                                                                                                                          \n         Enable colored output.                                                                                                                               \n                                                                                                                                                              \n      \u001b[1m--no-browser\u001b[0m (bool)                                                                                                                                     \n         Do not open browser automatically on auth.                                                                                                           \n                                                                                                                                                              \n      \u001b[1m--insecure\u001b[0m (bool)                                                                                                                                       \n         Disable transport security.                                                                                                                          \n                                                                                                                                                              \n      \u001b[1m--auth-timeout\u001b[0m (duration: 2h30m10s)                                                                                                                     \n         Set the timeout for the request including authentication process, default is 15m0s.                                                                  \n                                                                                                                                                              \n      \u001b[1m--per-retry-timeout\u001b[0m (duration: 2h30m10s)                                                                                                                \n         Set the timeout for each retry attempt, default is 20s.                                                                                              \n                                                                                                                                                              \n      \u001b[1m--retries\u001b[0m (uint)                                                                                                                                        \n         Set the number of retry attempts, 1 is disable retries, default is 3.                                                                                \n                                                                                                                                                              \n      \u001b[1m--timeout\u001b[0m (duration: 2h30m10s)                                                                                                                          \n         Set the timeout for the main request, default is 1m0s.                                                                                               \n                                                                                                                                                              \n      \u001b[1m--no-check-update\u001b[0m (bool)                                                                                                                                \n         Suppress check for updates.                                                                                                                          \n                                                                                                                                                              \n      \u001b[1m--no-progress\u001b[0m (bool)                                                                                                                                    \n         Suppress progress indicators and spinners.                                                                                                           \n\n\n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mNAME\u001b[0m                                                                                                                                                        \n                                                                                                                                                              \n      \u001b[1mnebius compute v1 instance list\u001b[0m                                                                                                                         \n        Lists all VM instances within a specified parent.                                                                                                     \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mALIAS\u001b[0m                                                                                                                                                       \n                                                                                                                                                              \n      \u001b[1mnebius compute v1 instance\u001b[0m is an alias of \u001b[1mnebius\u001b[0m \u001b[1mcompute instance\u001b[0m                                                                                       \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mSYNOPSIS\u001b[0m                                                                                                                                                    \n                                                                                                                                                              \n      \u001b[1mnebius compute instance list\u001b[0m                                                                                                                            \n        --page-size                                                                                                                                           \n        --page-token                                                                                                                                          \n        --parent-id                                                                                                                                           \n        --all                                                                                                                                                 \n        -i, --interactive                                                                                                                                     \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mOPTIONS\u001b[0m                                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1m--page-size\u001b[0m (int64)                                                                                                                                     \n                                                                                                                                                              \n      \u001b[1m--page-token\u001b[0m (string)                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1m--parent-id\u001b[0m (string)                                                                                                                                    \n                                                                                                                                                              \n      \u001b[1m--all\u001b[0m (bool)                                                                                                                                            \n         List all the elements. Resets --page-size.                                                                                                           \n                                                                                                                                                              \n      \u001b[1m-i, --interactive\u001b[0m (bool)                                                                                                                                \n         If set, runs a pagination on an alternate screen.                                                                                                    \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mGLOBAL\u001b[0m\u001b[1m OPTIONS\u001b[0m                                                                                                                                              \n                                                                                                                                                              \n      \u001b[1m-h, --help\u001b[0m (bool)                                                                                                                                       \n         Show this message.                                                                                                                                   \n                                                       