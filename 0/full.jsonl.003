{"timestamp":"2026-09-13T06:48:22.207Z","ordinal":15405,"type":"token_usage_record","payload":{"thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","session_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","root_turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","response_id":"resp_0f3535a43349ee3d016aa647334f1887d2bbc9012d8e3197f8","usage":{"input_tokens":162455,"cached_input_tokens":157137,"cache_write_input_tokens":5315,"output_tokens":88,"reasoning_output_tokens":13,"total_tokens":162543},"turn_token_usage":{"input_tokens":7316085,"cached_input_tokens":7128051,"cache_write_input_tokens":179006,"output_tokens":20636,"reasoning_output_tokens":5270,"total_tokens":7336721},"thread_token_usage":{"input_tokens":293056619,"cached_input_tokens":286456190,"cache_write_input_tokens":6477831,"output_tokens":728151,"reasoning_output_tokens":225948,"total_tokens":293784770}}}
{"timestamp":"2026-09-13T06:48:22.242Z","ordinal":15406,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","item":{"type":"CommandExecution","id":"exec-fe3f691b-dc75-4f07-b71c-b111d7a99c40","process_id":"21999","command":["/bin/zsh","-lc","sed -n '360,760p' model_training/src/robot_observability/factorybench_data.py"],"cwd":"file:///private/tmp/ysamet-factorybench","parsed_cmd":[{"type":"read","cmd":"sed -n '360,760p' model_training/src/robot_observability/factorybench_data.py","name":"factorybench_data.py","path":"model_training/src/robot_observability/factorybench_data.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\n\ndef _fallback_description(acronym: str) -> str:\n    families = {\n        \"sp\": \"setpoint position\",\n        \"fp\": \"feedback position\",\n        \"fs\": \"feedback speed\",\n        \"ett\": \"effort target torque\",\n        \"ecf\": \"estimated contact force\",\n    }\n    for prefix, label in families.items():\n        suffix = acronym.removeprefix(prefix)\n        if acronym.startswith(prefix) and suffix.isdigit():\n            return f\"{label} {suffix}\"\n    return acronym\n\n\ndef _parse_series(context: dict[str, Any], *, item_id: str) -> tuple[list[list[float]], list[str], float]:\n    raw_lines = context.get(\"time_series\")\n    if not isinstance(raw_lines, list) or not raw_lines or any(not isinstance(line, str) for line in raw_lines):\n        raise ValueError(f\"Invalid time_series for FactoryBench item {item_id}\")\n    mapping: dict[str, str] = {}\n    time_series_format = context.get(\"time_series_format\")\n    if isinstance(time_series_format, dict):\n        raw_mapping = time_series_format.get(\"acronym_mapping\")\n        if isinstance(raw_mapping, dict):\n            mapping = {str(key): str(value) for key, value in raw_mapping.items()}\n\n    timestamps: list[float] = []\n    columns: dict[str, list[float]] = {}\n    column_order: list[str] | None = None\n    for line in raw_lines:\n        match = _TIMESTEP.fullmatch(line.strip())\n        if match is None:\n            raise ValueError(f\"Invalid time-series row for FactoryBench item {item_id}: {line[:80]!r}\")\n        timestamp = float(match.group(\"timestamp\"))\n        if not math.isfinite(timestamp):\n            raise ValueError(f\"Non-finite timestamp for FactoryBench item {item_id}\")\n        row_values: dict[str, float] = {}\n        row_order: list[str] = []\n        for field in match.group(\"values\").split(\",\"):\n            value_match = _VALUE.fullmatch(field.strip())\n            if value_match is None:\n                raise ValueError(f\"Invalid signal value for FactoryBench item {item_id}: {field!r}\")\n            name = value_match.group(\"name\")\n            if name in row_values:\n                raise ValueError(f\"Duplicate signal {name} for FactoryBench item {item_id}\")\n            value = float(value_match.group(\"value\"))\n            if not math.isfinite(value):\n                raise ValueError(f\"Non-finite signal {name} for FactoryBench item {item_id}\")\n            row_values[name] = value\n            row_order.append(name)\n        if column_order is None:\n            column_order = row_order\n            columns = {name: [] for name in column_order}\n        elif row_order != column_order:\n            raise ValueError(f\"Signal order/schema changes within FactoryBench item {item_id}\")\n        timestamps.append(timestamp)\n        for name in column_order:\n            columns[name].append(row_values[name])\n    if any(right <= left for left, right in zip(timestamps, timestamps[1:])):\n        raise ValueError(f\"Timestamps are not strictly increasing for FactoryBench item {item_id}\")\n\n    assert column_order is not None\n    relative_timestamps = [timestamp - timestamps[0] for timestamp in timestamps]\n    series = [relative_timestamps, *(columns[name] for name in column_order)]\n    descriptions = [\n        \"relative timestamp in milliseconds (the absolute first timestamp is provided in the prompt)\",\n        *(mapping.get(name, _fallback_description(name)) for name in column_order),\n    ]\n    return series, descriptions, timestamps[0]\n\n\ndef _canonical_answer(value: object) -> str:\n    if isinstance(value, bool) or value is None:\n        raise ValueError(f\"Unsupported FactoryBench Level 1 answer: {value!r}\")\n    if isinstance(value, str):\n        if not value or value.strip() != value or \"\\n\" in value:\n            raise ValueError(f\"Invalid FactoryBench short answer: {value!r}\")\n        return value\n    if isinstance(value, int):\n        return str(value)\n    if isinstance(value, float) and math.isfinite(value):\n        return json.dumps(value, allow_nan=False)\n    raise ValueError(f\"Unsupported FactoryBench Level 1 answer: {value!r}\")\n\n\nclass FactoryBenchDataset:\n    \"\"\"Torch-compatible FactoryBench rows rendered into OpenTSLM's sample contract.\"\"\"\n\n    def __init__(\n        self,\n        rows: Sequence[dict[str, Any]],\n        *,\n        split_manifest: dict[str, Any] | None = None,\n        split: str | None = None,\n        eos_token: str = \"\",\n    ) -> None:\n        if split is not None and split not in SPLITS:\n            raise ValueError(f\"Unknown FactoryBench split: {split}\")\n        if (split_manifest is None) != (split is None):\n            raise ValueError(\"split_manifest and split must be provided together\")\n        if split_manifest is not None:\n            audit_split(rows, split_manifest)\n            item_splits = split_manifest[\"item_splits\"]\n            rows = [row for row in rows if item_splits[str(row[\"id\"])] == split]\n        self.rows = list(rows)\n        self.eos_token = eos_token\n\n    def __len__(self) -> int:\n        return len(self.rows)\n\n    def __getitem__(self, index: int) -> dict[str, Any]:\n        import torch\n\n        row = self.rows[index]\n        item_id = str(row[\"id\"])\n        all_series: list[torch.Tensor] = []\n        all_descriptions: list[str] = []\n        timing: list[str] = []\n        for label, context in _series_contexts(row):\n            series, descriptions, absolute_start = _parse_series(context, item_id=item_id)\n            all_series.extend(torch.tensor(values, dtype=torch.float32) for values in series)\n            all_descriptions.extend(f\"{label}: {description}.\" for description in descriptions)\n            timing.append(f\"{label} starts at timestamp {absolute_start:g} ms\")\n\n        options = row.get(\"options\")\n        option_text = \"\"\n        if isinstance(options, dict) and options:\n            option_text = \"\\nOptions:\\n\" + \"\\n\".join(\n                f\"{key}: {value}\" for key, value in sorted(options.items(), key=lambda pair: str(pair[0]))\n            )\n        answer = _canonical_answer(row[\"answer\"])\n        return {\n            \"pre_prompt\": (\n                \"You are answering a FactoryBench Level 1 question from synchronized industrial \"\n                \"robot telemetry. Use the numeric time series as primary evidence.\"\n            ),\n            \"time_series_text\": all_descriptions,\n            \"time_series\": all_series,\n            \"post_prompt\": (\n                f\"\\nTiming: {'; '.join(timing)}.\"\n                f\"\\nQuestion: {row['question'].strip()}\"\n                f\"{option_text}\\nReturn only the short answer requested by the question.\"\n            ),\n            \"answer\": answer + self.eos_token,\n            \"id\": item_id,\n            \"record_id\": item_id,\n            \"level\": 1,\n            \"template_id\": row.get(\"template_id\"),\n            \"template_type\": row.get(\"template_type\"),\n            \"episode_ids\": list(_episode_ids(row)),\n            \"target\": answer,\n            \"acceptance_bounds\": row.get(\"acceptance_bounds\"),\n       