isionEvidence.test.tsx:174:    expect(markup).toContain('Alternate collision dataset');\nfrontend/src/sourcing/DecisionEvidence.test.tsx:187:      query: 'robot collision free-motion baseline dataset',\nfrontend/src/sourcing/DecisionEvidence.test.tsx:203:    expect(markup).toContain('robot collision free-motion baseline dataset');\nfrontend/src/sourcing/DecisionEvidence.test.tsx:215:      query: 'robot collision dataset alternative',\nfrontend/src/comparison/ComparisonPanel.tsx:41:    \u003cp\u003eCircles mark each curve’s largest absolute sampled torque, with its signed value. {result.resolution === 'raw' ? 'Raw samples.' : 'Overview samples; brief peaks may be missed.'} Peaks are measurements, not detected collisions. Motion phases may differ.\u003c/p\u003e\u003c/figure\u003e;\nfrontend/src/comparison/ComparisonPanel.tsx:122:    const content = { ...comparisonReport(result), referenceSelection: suggested ? 'Suggested earlier annotation-free window with 0.5 s marker margin; not verified normal.' : 'User-selected reference; not verified normal.' };\nfrontend/src/comparison/ComparisonPanel.tsx:135:      method: 'Rank equal-length raw 1 kHz windows by symmetric distance over each joint’s torque range, variability and largest sample-to-sample change. Publisher labels and model predictions are not scoring inputs.',\nfrontend/src/comparison/ComparisonPanel.tsx:143:    \u003cheader\u003e\u003ch2\u003eFind repeat patterns\u003c/h2\u003e\u003cp\u003eTrace ranks similar torque events across recordings. Open one to see what changed.\u003c/p\u003e\u003c/header\u003e\nfrontend/src/comparison/ComparisonPanel.tsx:154:    \u003cform className=\"reference-controls\" onSubmit={e =\u003e { e.preventDefault(); apply(); }}\u003e\nfrontend/src/comparison/ComparisonPanel.tsx:167:      \u003cdetails className=\"comparison-method\"\u003e\u003csummary\u003eMeasurements, method \u0026amp; limits\u003c/summary\u003e\u003cp\u003e{selectedJoint.name} variability: {fixed(selectedJoint.reference.variability)} → {fixed(selectedJoint.selected.variability)} Nm. Mean shift: {signed(selectedJoint.meanDelta)} Nm.\u003c/p\u003e\u003cp\u003eReference: {result.reference.recordingId}, {intervalLabel(result.reference.interval)}. Selected: {result.selected.recordingId}, {intervalLabel(result.selected.interval)}.\u003c/p\u003e\u003cp\u003e{result.method}\u003c/p\u003e\u003cp\u003ePublisher markers in reference: {result.reference.publisherAnnotations.length}; selected: {result.selected.publisherAnnotations.length}. These are annotations, not diagnoses.\u003c/p\u003e\u003cp\u003e{result.limitations.join(' ')}\u003c/p\u003e\u003c/details\u003e\nfrontend/src/evaluation/EvaluationWorkspace.tsx:25:      'Summarize amplitude, impulse, derivative energy, and variability for each joint.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:26:      'Fit event semantics on training sessions and estimate onset from the first sustained threshold crossing.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:30:      'Best event-semantics and strongest-joint scores in this comparison.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:39:    learned: '60,082 parameters across a shared temporal encoder and four prediction heads; trained on 29,393 windows.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:42:      'Separate heads predict event semantics, onset, strongest joint, and affected joints.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:49:    limitation: 'This is a recorded locked-split run from the comparison branch. Its row-level predictions are not in the current checksum-audited bundle.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:65:    limitation: 'Most missing answers are free-motion cases. Generated explanations remain predictions, even when the structured fields are correct.',\nfrontend/src/evaluation/EvaluationWorkspace.tsx:163:      \u003cdiv\u003e\u003cdt\u003eBest onset P90 error\u003c/dt\u003e\u003cdd\u003e140 ms\u003c/dd\u003e\u003csmall\u003eOpenTSLM · finite in-window onset predictions\u003c/small\u003e\u003c/div\u003e\nfrontend/src/evaluation/EvaluationWorkspace.tsx:172:      \u003cp className=\"table-note\"\u003eUsable summary requires the complete typed contract; parseable JSON alone is insufficient. The CNN value is unavailable without its row-level predictions. Read positive-contact F1 with coverage because abstentions can leave F1 high while making the full answer unusable.\u003c/p\u003e\nfrontend/src/evaluation/EvaluationWorkspace.tsx:207:    \u003cdetails className=\"evaluation-methodology\"\u003e\u003csummary\u003eEvaluation contract and provenance\u003c/summary\u003e\u003cp\u003eSignal features, OpenTSLM, and Qwen are recomputed from checksum-verified archived predictions joined to the same 512 record IDs across 67 held-out recording groups. The CNN summary reports the same locked test size and seed, but its row-level predictions are not in that audited bundle, so it is visibly marked as a recorded run.\u003c/p\u003e\u003cp\u003eRecording sessions were split before window generation. Normalization and thresholds use training sessions only. Joint and evidence targets are deterministic signal-derived labels rather than physical contact-location truth.\u003c/p\u003e\u003cp className=\"mono\"\u003eAudited pipeline · records {comparison.record_ids_sha256.slice(0, 12)}… · checkpoint {comparison.checkpoint_sha256.slice(0, 12)}… · CNN source {cnnSummary.source_commit} · checkpoint {cnnSummary.checkpoint_sha256.slice(0, 12)}…\u003c/p\u003e\u003c/details\u003e\nfrontend/src/robot/RobotPanel.tsx:3:import type { PredictionCue } from '../assistant/predictionBrief';\nfrontend/src/robot/RobotPanel.tsx:9:type Props = { prediction?: PredictionCue; data: DemoData; playhead: number; interval: Interval; highlighted: string[]; onHighlight: (id: string) =\u003e void };\nfrontend/src/robot/RobotPanel.tsx:10:export default function RobotPanel({ prediction, data, playhead, interval, highlighted, onHighlight }: Props) {\nfrontend/src/robot/RobotPanel.tsx:14:  const highlights = useRef(highlighted); highlights.current = highlighted;\nfrontend/src/robot/RobotPanel.tsx:48:      scene.current.highlight(highlights.current);\nfrontend/src/robot/RobotPanel.tsx:55:  const atOnset = Boolean(prediction \u0026\u0026 Math.abs(playhead - prediction.onsetSeconds) \u003c= .125);\nfrontend/src/robot/RobotPanel.tsx:56:  useEffect(() =\u003e { scene.current?.highlight(highlighted, atOnset ? prediction?.channelId : undefined); }, [highlighted, atOnset, prediction?.channelId, loading]);\nfrontend/src/robot/RobotPanel.tsx:65:  const selectedMarker = data.events.find(event =\u003e event.timeSeconds \u003e= interval.start \u0026\u0026 event.timeSeconds \u003c interval.end);\nfrontend/src/robot/RobotPanel.tsx:69:    \u003cdiv className={`robot-event-cue${atOnset ? ' at-onset' : ''}`} aria-label=\"Robot event context\"\u003e\nfrontend/src/robot/RobotPanel.tsx:70:      {prediction ? \u003c\u003e\u003cstrong\u003e{atOnset ? 'At predicted onset' : playhead \u003c prediction.onsetSeconds ? 'Before predicted onset' : 'After predicted onset'} · {prediction.onsetSeconds.toFixed(3)} s\u003c/strong\u003e\u003cspan\u003e{prediction.title}{prediction.channelId ? ` · strongest response J${prediction.channelId.slice(-1)}` : ''}. Highlight is a time cue, not an impact location.\u003c/span\u003e\u003c/\u003e : selectedMarker ? \u003c\u003e\u003cstrong\u003ePublisher marker · {selectedMarker.timeSeconds.toFixed(3)} s\u003c/strong\u003e\u003cspan\u003e{rawAvailable ? 'Annotated event time. Analyze the interval for a model prediction.' : 'Annotated event time. Only overview measurements are available here.'}\u003c/span\u003e\u003c/\u003e : \u003c\u003e\u003cstrong\u003eRecorded movement\u003c/strong\u003e\u003cspan\u003eSelect an event and analyze its torque to investigate contact.\u003c/span\u003e\u003c/\u003e}\nfrontend/src/robot/RobotPanel.tsx:74:        \u003cdiv className=\"robot-canvas\" ref={host} role=\"img\" aria-label={mea