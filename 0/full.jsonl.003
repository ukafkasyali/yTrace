                                                         \n        Get value for the specified configuration property.                                                                                                   \n                                                                                                                                                              \n      \u001b[1mlist\u001b[0m                                                                                                                                                    \n        List configuration values.                                                                                                                            \n                                                                                                                                                              \n      \u001b[1mset\u001b[0m                                                                                                                                                     \n        Set value for the specified configuration property.                                                                                                   \n                                                                                                                                                              \n      \u001b[1munset\u001b[0m                                                                                                                                                   \n        Unset value for the specified configuration property.                                                                                                 \n                                                                                                                                                              \n\u001b[1m\u001b[0m\u001b[1m\u001b[0m  \u001b[1mGLOBAL\u001b[0m\u001b[1m OPTIONS\u001b[0m                                                                                                                                              \n                                                                                                                                                              \n      \u001b[1m-h, --help\u001b[0m (bool)                                                                                                                                       \n         Show this message.                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1m-p, --profile\u001b[0m (string)                                                                                                                                  \n         Set a profile for interacting with the cloud.                                                                                                        \n                                                                                                                                                              \n      \u001b[1m--format\u001b[0m (string)                                                                                                                                       \n         Output format. Supported values: yaml|json|jsonpath|table|text.                                                                                      \n                                                                                                                                                              \n      \u001b[1m-f, --file\u001b[0m (string)                                                                                                                                     \n         Input file. For 'update' commands automatically set --full=true.                                                                                     \n                                                                                                                                                              \n      \u001b[1m-c, --config\u001b[0m (string)                                                                                                                                   \n         Provide path to config file.                                                                                                                         \n                                                                                                                                                              \n      \u001b[1m--debug\u001b[0m (bool)                                                                                                                                          \n         Enable debug logs.                                                                                                                                   \n                                                                                                                                                              \n      \u001b[1m-I, --impersonate-service-account-id\u001b[0m (string)                                                                                                           \n         Impersonate into the service account and use its token for a command.                                                                                \n                                                                                                                                                              \n      \u001b[1m--color\u001b[0m (bool)                                                                                                                                          \n         Enable colored output.                                                                                                                               \n                                                                                                                                                              \n      \u001b[1m--no-browser\u001b[0m (bool)                                                                                                                                     \n         Do not open browser automatically on auth.                                                                                                           \n                                                                                                                                                              \n      \u001b[1m--insecure\u001b[0m (bool)                                                                                                                                       \n         Disable transport security.                                                                                                                          \n                                                                                                                                                              \n      \u001b[1m--auth-timeout\u001b[0m (duration: 2h30m10s)                                                                                                                     \n         Set the timeout for the request including authentication process, default is 15m0s.                                                                  \n                                                                                                                                                              \n      \u001b[1m--per-retry-timeout\u001b[0m (duration: 2h30m10s)                                                                                                                \n         Set the timeout for each retry attempt, default is 20s.                                                                                              \n                                                                                                                                                              \n      \u001b[1m--retries\u001b[0m (uint)                                                                                                                                        \n         Set the number of retry attempts, 1 is disable retries, default is 3.                                                                                \n                                                                                                                                                              \n      \u001b[1m--timeout\u001b[0m (duration: 2h30m10s)                                                                                                                          \n         Set the timeout for the main request, default is 1m0s.                                                                                               \n                                                                                                                                                              \n      \u001b[1m--no-check-update\u001b[0m (bool)                                                                                                                                \n         Suppress check for updates.                                                                                                                          \n                                                                                                                                                              \n      \u001b[1m--no-progress\u001b[0m (bool)                                                                                                                                    \n         Suppress progress indicators and spinners.                                                                                                           \n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0998d-b939-7813-bf67-95a00f656955","create_time":1789282708.17862}}}
