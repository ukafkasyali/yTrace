tch=\\\"order/schema\\\"):\\n         FactoryBenchDataset([row])[0]\\n+\\n+\\n+def test_parser_accepts_official_timestamp_only_series() -> None:\\n+    row = _single(\\\"timestamp-only\\\", \\\"ep-time\\\")\\n+    row[\\\"context\\\"][\\\"time_series_format\\\"][\\\"acronym_mapping\\\"] = {\\\"tm\\\": \\\"timestamp_ms\\\"}\\n+    row[\\\"context\\\"][\\\"time_series\\\"] = [\\\"t=0\\\", \\\"t=100\\\", \\\"t=200\\\", \\\"t=300\\\"]\\n+\\n+    sample = FactoryBenchDataset([row])[0]\\n+\\n+    assert len(sample[\\\"time_series\\\"]) == 1\\n+    assert sample[\\\"time_series\\\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\\n*** End Patch\";\ntext(await tools.apply_patch(patch));","internal_chat_message_metadata_passthrough":{"turn_id":"01a09989-5963-7ac2-896e-62cf4245c0ce","create_time":1789282377.536265}}}
