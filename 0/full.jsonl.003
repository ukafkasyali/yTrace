\"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_normalization_uses_training_values_only_and_preserves_timestamps(tmp_path: Path) -> None:\n    train_one = _single(\"train-one\", \"train-1\")\n    train_two = _single(\"train-two\", \"train-2\")\n    validation = _single(\"validation\", \"validation\")\n    test = _single(\"test\", \"test\")\n    train_one[\"context\"][\"time_series\"] = [\n        \"t=0: fp0=0, fs0=10\",\n        \"t=100: fp0=1, fs0=11\",\n        \"t=200: fp0=2, fs0=12\",\n        \"t=300: fp0=3, fs0=13\",\n    ]\n    train_two[\"context\"][\"time_series\"] = [\n        \"t=0: fp0=4, fs0=14\",\n        \"t=100: fp0=5, fs0=15\",\n        \"t=200: fp0=6, fs0=16\",\n        \"t=300: fp0=7, fs0=17\",\n    ]\n    for row in (validation, test):\n        row[\"context\"][\"time_series\"] = [\n            \"t=0: fp0=10000, fs0=20000\",\n            \"t=100: fp0=10000, fs0=20000\",\n            \"t=200: fp0=10000, fs0=20000\",\n            \"t=300: fp0=10000, fs0=20000\",\n        ]\n    rows = [train_one, train_two, validation, test]\n    manifest = {\n        \"item_splits\": {\n            \"train-one\": \"train\",\n            \"train-two\": \"train\",\n            \"validation\": \"validation\",\n            \"test\": \"test\",\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n","exit_code":0,"duration":{"secs":0,"nanos":5000},"formatted_output":"    for row in rows:\n        split = str(item_splits[str(row[\"id\"])])\n        items_by_split[split] += 1\n        episodes_by_split[split].update(_episode_ids(row))\n    if any(items_by_split[split] == 0 for split in SPLITS):\n        raise ValueError(\"Train, validation, and test splits must all be non-empty\")\n    overlaps: dict[str, list[str]] = {}\n    for left_index, left in enumerate(SPLITS):\n        for right in SPLITS[left_index + 1 :]:\n            overlap = sorted(episodes_by_split[left] & episodes_by_split[right])\n            if overlap:\n                overlaps[f\"{left}:{right}\"] = overlap\n    if overlaps:\n        raise ValueError(f\"Episode leakage across FactoryBench splits: {overlaps}\")\n    return {\n        \"items\": dict(items_by_split),\n        \"episodes\": {split: len(values) for split, values in episodes_by_split.items()},\n        \"episode_overlap\": 0,\n    }\n\n\ndef write_split_manifest(path: Path, manifest: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), manifest)\n\n\ndef fit_normalization(\n    rows: Sequence[dict[str, Any]],\n    split_manifest: dict[str, Any],\n    *,\n    clip: float = 20.0,\n) -> dict[str, Any]:\n    \"\"\"Fit robust channel statistics using train items and no held-out values.\"\"\"\n    if not math.isfinite(clip) or clip <= 0:\n        raise ValueError(\"Normalization clip must be a positive finite number\")\n    audit_split(rows, split_manifest)\n    item_splits = split_manifest[\"item_splits\"]\n    values_by_channel: dict[str, array] = defaultdict(lambda: array(\"d\"))\n    training_ids: list[str] = []\n    for row in rows:\n        item_id = str(row[\"id\"])\n        if item_splits[item_id] != \"train\":\n            continue\n        training_ids.append(item_id)\n        for _, context in _series_contexts(row):\n            series, descriptions, _ = _parse_series(context, item_id=item_id)\n            for values, description in zip(series[1:], descriptions[1:]):\n                values_by_channel[description].extend(values)\n    if not training_ids or not values_by_channel:\n        raise ValueError(\"FactoryBench training split has no signal values\")\n\n    import numpy as np\n\n    channels: dict[str, dict[str, float | int]] = {}\n    for description, raw_values in sorted(values_by_channel.items()):\n        values = np.frombuffer(raw_values, dtype=np.float64)\n        median = float(np.median(values))\n        mad_scale = float(np.median(np.abs(values - median)) * 1.4826)\n        if mad_scale <= 1e-8:\n            lower, upper = np.quantile(values, (0.25, 0.75))\n            mad_scale = float((upper - lower) / 1.349)\n        scale = mad_scale if math.isfinite(mad_scale) and mad_scale > 1e-8 else 1.0\n        channels[description] = {\n            \"center\": median,\n            \"scale\": scale,\n            \"count\": int(values.size),\n        }\n    training_ids_hash = hashlib.sha256(\"\\n\".join(sorted(training_ids)).encode()).hexdigest()\n    split_hash = hashlib.sha256(\n        json.dumps(split_manifest[\"item_splits\"], sort_keys=True, separators=(\",\", \":\")).encode()\n    ).hexdigest()\n    return {\n        \"schema_version\": 1,\n        \"method\": \"train_only_median_mad\",\n        \"clip\": clip,\n        \"timestamp\": \"relative milliseconds; not normalized\",\n        \"training_items\": len(training_ids),\n        \"training_item_ids_sha256\": training_ids_hash,\n        \"item_splits_sha256\": split_hash,\n        \"channels\": channels,\n    }\n\n\ndef write_normalization_receipt(path: Path, normalization: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), normalization)\n\n\ndef _atomic_json_write(path: Path, payload: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_suffix(path.suffix + \".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef _series_contexts(row: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    context = row.get(\"context\")\n    if not isinstance(context, dict):\n        raise ValueError(f\"Missing context for FactoryBench item {item_id}\")\n    if \"time_series\" in context:\n        return [(\"Series\", context)]\n    if \"series_a\" in context and \"series_b\" in context:\n        if not isinstance(context[\"series_a\"], dict) or not isinstance(context[\"series_b\"], dict):\n            raise ValueError(f\"Invalid comparative context for FactoryBench item {item_id}\")\n        return [(\"Series A\", context[\"series_a\"]), (\"Series B\", context[\"series_b\"])]\n    raise ValueError(f\"Unsupported FactoryBench context for item {item_id}\")\n\n\ndef _fallback_description(acronym: str) -> str:\n    families = {\n        \"sp\": \"setpoint_pos\",\n        \"fp\": \"feedback_pos\",\n        return str(value)\n    if isinstance(value, float) and math.isfinite(value):\n        return json.dumps(value, allow_nan=False)\n    raise ValueError(f\"Unsupported FactoryBench Level 1 answer: {value!r}\")\n\n\nclass FactoryBenchDataset:\n    \"\"\"Torch-compatible FactoryBench rows rendered into OpenTSLM's sample contract.\"\"\"\n\n    def __init__(\n        self,\n        rows: Sequence[dict[str, Any]],\n        *,\n        split_manifest: dict[str, Any] | None = None,\n        split: str | None = None,\n        eos_token: str = \"\",\n        normalization: dict[str, Any] | None = None,\n    ) -> None:\n        if split is not None and split not in SPLITS:\n            raise ValueError(f\"Unknown FactoryBench split: {split}\")\n        if (split_manifest is None) != (split is None):\n            raise ValueError(\"split_manifest and split must be provided together\")\n        if split_manifest is not None:\n            audit_split(rows, split_manifest)\n            item_splits = split_manifest[\"item_splits\"]\n            rows = [row for row in rows if item_splits[str(row[\"id\"])] == split]\n        self.rows = list(rows)\n        self.eos_token = eos_token\n        self.normalization = normalization\n        if normalization is not None:\n            if normalization.get(\"method\") != \"train_only_median_mad\":\n                raise ValueError(\"Unsupported FactoryBench normalization receipt\")\n            if not isinstance(normalization.get(\"channels\"), dict):\n                raise ValueError(\"Normalization receipt is missing channels\")\n\n    def __len__(self) -> int:\n        return len(self.rows)\n\n    def __getitem__(self, index: int) -> dict[str, Any]:\n        import torch\n\n        row = self.rows[index]\n        item_id = str(row[\"id\"])\n        all_series: list[torch.Tensor] = []\n        all_descriptions: list[str] = []\n        timing: list[str] = []\n        for label, context in _series_contexts(row):\n            series, descriptions, absolute_start = _parse_series(context, item_id=item_id)\n            if self.normalization is not None:\n                normalized = [series[0]]\n                clip = float(self.normalization[\"clip\"])\n                channel_stats = self.normalization[\"channels\"]\n                for values, description in zip(series[1:], descriptions[1:]):\n                    stats = channel_stats.get(description)\n                    if not isinstance(stats, dict):\n                        raise ValueError(\n                            f\"No train-only normalization for channel {description!r} in item {item_id}\"\n                        )\n                    center = float(stats[\"center\"])\n                    scale = float(stats[\"scale\"])\n                    normalized.append(\n                        [max(-clip, min(clip, (value - center) / scale)) for value in values]\n                    )\n                series = normalized\n            all_series.extend(torch.tensor(values, dtype=torch.float32) for values in series)\n            all_descriptions.extend(f\"{label}: {description}.\" for description in descriptions)\n            timing.append(f\"{label} starts at timestamp {absolute_start:g} ms\")\n\n        options = row.get(\"options\")\n        option_text = \"\"\n        if isinstance(options, dict) and options:\n            option_text = \"\\nOptions:\\n\" + \"\\n\".join(\n                f\"{key}: {value}\" for key, value in sorted(options.items(), key=lambda pair: str(pair[0]))\n            )\n        answer = _canonical_answer(row[\"answer\"])\n        return {\n            \"pre_prompt\": (\n                \"You are answering a FactoryBench Level 1 question from synchronized industrial \"\n                \"robot telemetry. Use the numeric time series as primary evidence.\"\n            ),\n            \"time_series_text\": all_descriptions,\n        assert len(subset) == audit[\"items\"][split]\n\n\ndef test_split_audit_rejects_episode_leakage() -> None:\n    rows = [_single(\"one\", \"shared\"), _single(\"two\", \"shared\"), _single(\"three\", \"other\")]\n    manifest = {\"item_splits\": {\"one\": \"train\", \"two\": \"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_normalization_uses_training_values_only_and_preserves_timestamps(tmp_path: Path) -> None:\n    train_one = _single(\"train-one\", \"train-1\")\n    train_two = _single(\"train-two\", \"train-2\")\n    validation = _single(\"validation\", \"validation\")\n    test = _single(\"test\", \"test\")\n    train_one[\"context\"][\"time_series\"] = [\n        \"t=0: fp0=0, fs0=10\",\n        \"t=100: fp0=1, fs0=11\",\n        \"t=200: fp0=2, fs0=12\",\n        \"t=300: fp0=3, fs0=13\",\n    ]\n    train_two[\"context\"][\"time_series\"] = [\n        \"t=0: fp0=4, fs0=14\",\n        \"t=100: fp0=5, fs0=15\",\n        \"t=200: fp0=6, fs0=16\",\n        \"t=300: fp0=7, fs0=17\",\n    ]\n    for row in (validation, test):\n        row[\"context\"][\"time_series\"] = [\n            \"t=0: fp0=10000, fs0=20000\",\n            \"t=100: fp0=10000, fs0=20000\",\n            \"t=200: fp0=10000, fs0=20000\",\n            \"t=300: fp0=10000, fs0=20000\",\n        ]\n    rows = [train_one, train_two, validation, test]\n    manifest = {\n        \"item_splits\": {\n            \"train-one\": \"train\",\n            \"train-two\": \"train\",\n            \"validation\": \"validation\",\n            \"test\": \"test\",\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n"},"started_at_ms":1789282245031,"completed_at_ms":1789282245031}}
{"timestamp":"2026-09-13T06:50:45.081Z","ordinal":15482,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a09988-59d9-7472-9bed-f7d2ecce0dcf","call_id":"call_T2G7XZInEo2XDIFUPaIdTC9Z","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    for row in rows:\n        split = str(item_splits[str(row[\"id\"])])\n        items_by_split[split] += 1\n        episodes_by_split[split].update(_episode_ids(row))\n    if any(items_by_split[split] == 0 for split in SPLITS):\n        raise ValueError(\"Train, validation, and test splits must all be non-empty\")\n    overlaps: dict[str, list[str]] = {}\n    for left_index, left in enumerate(SPLITS):\n        for right in SPLITS[left_index + 1 :]:\n            overlap = sorted(episodes_by_split[left] & episodes_by_split[right])\n            if overlap:\n                overlaps[f\"{left}:{right}\"] = overlap\n    if overlaps:\n        raise ValueError(f\"Episode leakage across FactoryBench splits: {overlaps}\")\n    return {\n        \"items\": dict(items_by_split),\n        \"episodes\": {split: len(values) for split, values in episodes_by_split.items()},\n        \"episode_overlap\": 0,\n    }\n\n\ndef write_split_manifest(path: Path, manifest: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), manifest)\n\n\ndef fit_normalization(\n    rows: Sequence[dict[str, Any]],\n    split_manifest: dict[str, Any],\n    *,\n    clip: float = 20.0,\n) -> dict[str, Any]:\n    \"\"\"Fit robust channel statistics using train items and no held-out values.\"\"\"\n    if not math.isfinite(clip) or clip <= 0:\n        raise ValueError(\"Normalization clip must be a positive finite number\")\n    audit_split(rows, split_manifest)\n    item_splits = split_manifest[\"item_splits\"]\n    values_by_channel: dict[str, array] = defaultdict(lambda: array(\"d\"))\n    training_ids: list[str] = []\n    for row in rows:\n        item_id = str(row[\"id\"])\n        if item_splits[item_id] != \"train\":\n            continue\n        training_ids.append(item_id)\n        for _, context in _series_contexts(row):\n            series, descriptions, _ = _parse_series(context, item_id=item_id)\n            for values, description in zip(series[1:], descriptions[1:]):\n                values_by_channel[description].extend(values)\n    if not training_ids or not values_by_channel:\n        raise ValueError(\"FactoryBench training split has no signal values\")\n\n    import numpy as np\n\n    channels: dict[str, dict[str, float | int]] = {}\n    for description, raw_values in sorted(values_by_channel.items()):\n        values = np.frombuffer(raw_values, dtype=np.float64)\n        median = float(np.median(values))\n        mad_scale = float(np.median(np.abs(values - median)) * 1.4826)\n        if mad_scale <= 1e-8:\n            lower, upper = np.quantile(values, (0.25, 0.75))\n            mad_scale = float((upper - lower) / 1.349)\n        scale = mad_scale if math.isfinite(mad_scale) and mad_scale > 1e-8 else 1.0\n        channels[description] = {\n            \"center\": median,\n            \"scale\": scale,\n            \"count\": int(values.size),\n        }\n    training_ids_hash = hashlib.sha256(\"\\n\".join(sorted(training_ids)).encode()).hexdigest()\n    split_hash = hashlib.sha256(\n        json.dumps(split_manifest[\"item_splits\"], sort_keys=True, separators=(\",\", \":\")).encode()\n    ).hexdigest()\n    return {\n        \"schema_version\": 1,\n        \"method\": \"train_only_median_mad\",\n        \"clip\": clip,\n        \"timestamp\": \"relative milliseconds; not normalized\",\n        \"training_items\": len(training_ids),\n        \"training_item_ids_sha256\": training_ids_hash,\n        \"item_splits_sha256\": split_hash,\n        \"channels\": channels,\n    }\n\n\ndef write_normalization_receipt(path: Path, normalization: dict[str, Any]) -> None:\n    _atomic_json_write(Path(path), normalization)\n\n\ndef _atomic_json_write(path: Path, payload: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    temporary = path.with_suffix(path.suffix + \".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef _series_contexts(row: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:\n    item_id = str(row.get(\"id\", \"<unknown>\"))\n    context = row.get(\"context\")\n    if not isinstance(context, dict):\n        raise ValueError(f\"Missing context for FactoryBench item {item_id}\")\n    if \"time_series\" in context:\n        return [(\"Series\", context)]\n    if \"series_a\" in context and \"series_b\" in context:\n        if not isinstance(context[\"series_a\"], dict) or not isinstance(context[\"series_b\"], dict):\n            raise ValueError(f\"Invalid comparative context for FactoryBench item {item_id}\")\n        return [(\"Series A\", context[\"series_a\"]), (\"Series B\", context[\"series_b\"])]\n    raise ValueError(f\"Unsupported FactoryBench context for item {item_id}\")\n\n\ndef _fallback_description(acronym: str) -> str:\n    families = {\n        \"sp\": \"setpoint_pos\",\n        \"fp\": \"feedback_pos\",\n        return str(value)\n    if isinstance(value, float) and math.isfinite(value):\n        return json.dumps(value, allow_nan=False)\n    raise ValueError(f\"Unsupported FactoryBench Level 1 answer: {value!r}\")\n\n\nclass FactoryBenchDataset:\n    \"\"\"Torch-compatible FactoryBench rows rendered into OpenTSLM's sample contract.\"\"\"\n\n    def __init__(\n        self,\n        rows: Sequence[dict[str, Any]],\n        *,\n        split_manifest: dict[str, Any] | None = None,\n        split: str | None = None,\n        eos_token: str = \"\",\n        normalization: dict[str, Any] | None = None,\n    ) -> None:\n        if split is not None and split not in SPLITS:\n            raise ValueError(f\"Unknown FactoryBench split: {split}\")\n        if (split_manifest is None) != (split is None):\n            raise ValueError(\"split_manifest and split must be provided together\")\n        if split_manifest is not None:\n            audit_split(rows, split_manifest)\n            item_splits = split_manifest[\"item_splits\"]\n            rows = [row for row in rows if item_splits[str(row[\"id\"])] == split]\n        self.rows = list(rows)\n        self.eos_token = eos_token\n        self.normalization = normalization\n        if normalization is not None:\n            if normalization.get(\"method\") != \"train_only_median_mad\":\n                raise ValueError(\"Unsupported FactoryBench normalization receipt\")\n            if not isinstance(normalization.get(\"channels\"), dict):\n                raise ValueError(\"Normalization receipt is missing channels\")\n\n    def __len__(self) -> int:\n        return len(self.rows)\n\n    def __getitem__(self, index: int) -> dict[str, Any]:\n        import torch\n\n        row = self.rows[index]\n        item_id = str(row[\"id\"])\n        all_series: list[torch.Tensor] = []\n        all_descriptions: list[str] = []\n        timing: list[str] = []\n        for label, context in _series_contexts(row):\n            series, descriptions, absolute_start = _parse_series(context, item_id=item_id)\n            if self.normalization is not None:\n                normalized = [series[0]]\n                clip = float(self.normalization[\"clip\"])\n                channel_stats = self.normalization[\"channels\"]\n                for values, description in zip(series[1:], descriptions[1:]):\n                    stats = channel_stats.get(description)\n                    if not isinstance(stats, dict):\n                        raise ValueError(\n                            f\"No train-only normalization for channel {description!r} in item {item_id}\"\n                        )\n                    center = float(stats[\"center\"])\n                    scale = float(stats[\"scale\"])\n                    normalized.append(\n                        [max(-clip, min(clip, (value - center) / scale)) for value in values]\n                    )\n                series = normalized\n            all_series.extend(torch.tensor(values, dtype=torch.float32) for values in series)\n            all_descriptions.extend(f\"{label}: {description}.\" for description in descriptions)\n            timing.append(f\"{label} starts at timestamp {absolute_start:g} ms\")\n\n        options = row.get(\"options\")\n        option_text = \"\"\n        if isinstance(options, dict) and options:\n            option_text = \"\\nOptions:\\n\" + \"\\n\".join(\n                f\"{key}: {value}\" for key, value in sorted(options.items(), key=lambda pair: str(pair[0]))\n            )\n        answer = _canonical_answer(row[\"answer\"])\n        return {\n            \"pre_prompt\": (\n                \"You are answering a FactoryBench Level 1 question from synchronized industrial \"\n                \"robot telemetry. Use the numeric time series as primary evidence.\"\n            ),\n            \"time_series_text\": all_descriptions,\n        assert len(subset) == audit[\"items\"][split]\n\n\ndef test_split_audit_rejects_episode_leakage() -> None:\n    rows = [_single(\"one\", \"shared\"), _single(\"two\", \"shared\"), _single(\"three\", \"other\")]\n    manifest = {\"item_splits\": {\"one\": \"train\", \"two\": \"validation\", \"three\": \"test\"}}\n\n    with pytest.raises(ValueError, match=\"Episode leakage\"):\n        audit_split(rows, manifest)\n\n\ndef test_normalization_uses_training_values_only_and_preserves_timestamps(tmp_path: Path) -> None:\n    train_one = _single(\"train-one\", \"train-1\")\n    train_two = _single(\"train-two\", \"train-2\")\n    validation = _single(\"validation\", \"validation\")\n    test = _single(\"test\", \"test\")\n    train_one[\"context\"][\"time_series\"] = [\n        \"t=0: fp0=0, fs0=10\",\n        \"t=100: fp0=1, fs0=11\",\n        \"t=200: fp0=2, fs0=12\",\n        \"t=300: fp0=3, fs0=13\",\n    ]\n    train_two[\"context\"][\"time_series\"] = [\n        \"t=0: fp0=4, fs0=14\",\n        \"t=100: fp0=5, fs0=15\",\n        \"t=200: fp0=6, fs0=16\",\n        \"t=300: fp0=7, fs0=17\",\n    ]\n    for row in (validation, test):\n        row[\"context\"][\"time_series\"] = [\n            \"t=0: fp0=10000, fs0=20000\",\n            \"t=100: fp0=10000, fs0=20000\",\n            \"t=200: fp0=10000, fs0=20000\",\n            \"t=300: fp0=10000, fs0=20000\",\n        ]\n    rows = [train_one, train_two, validation, test]\n    manifest = {\n        \"item_splits\": {\n            \"train-one\": \"train\",\n            \"train-two\": \"train\",\n            \"validation\": \"validation\",\n            \"test\": \"test\",\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","create_time":1789282245.081753}}}
