{"timestamp":"2026-09-13T06:45:55.793Z","ordinal":15287,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","item":{"type":"CommandExecution","id":"exec-0656750b-19dd-41cb-a6c4-7bb5db0f1a1b","process_id":"37800","command":["/bin/zsh","-lc","ssh -o BatchMode=yes samet@89.169.110.3 'source /home/samet/trace-inference/inference/.venv/bin/activate; python - <<\"PY\"\nimport inspect\nfrom opentslm import OpenTSLM\nfrom opentslm.model.llm.OpenTSLMSP import OpenTSLMSP\nprint(inspect.signature(OpenTSLMSP.__init__))\nprint(inspect.signature(OpenTSLMSP.load_from_file))\nprint(inspect.getsource(OpenTSLM.load_pretrained))\nprint(inspect.getsource(OpenTSLMSP.load_from_file))\nPY'"],"cwd":"file:///Users/sametdegirmenci/Downloads/ysamet","parsed_cmd":[{"type":"unknown","cmd":"ssh -o BatchMode=yes samet@89.169.110.3 'source /home/samet/trace-inference/inference/.venv/bin/activate; python - <<\"PY\"\nimport inspect\nfrom opentslm import OpenTSLM\nfrom opentslm.model.llm.OpenTSLMSP import OpenTSLMSP\nprint(inspect.signature(OpenTSLMSP.__init__))\nprint(inspect.signature(OpenTSLMSP.load_from_file))\nprint(inspect.getsource(OpenTSLM.load_pretrained))\nprint(inspect.getsource(OpenTSLMSP.load_from_file))\nPY'"}],"source":"unified_exec_startup","status":"completed","stdout":"(self, llm_id: str = 'meta-llama/Llama-3.2-1B', device: str = 'cuda')\n(self, path: str)\n    @classmethod\n    def load_pretrained(\n        cls,\n        repo_id: str,\n        device: Optional[str] = None,\n        cache_dir: Optional[str] = None,\n        enable_lora: Optional[bool] = False,\n    ) -> Union[OpenTSLMSP, OpenTSLMFlamingo]:\n        \"\"\"\n        Load a pretrained model from Hugging Face Hub.\n\n        Args:\n            repo_id: Hugging Face repository ID (e.g., \"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            device: Device to load the model on (default: auto-detect)\n            cache_dir: Directory to cache downloaded models (optional)\n            enable_lora: Whether to enable LoRA (default: False)\n\n        Returns:\n            Union[OpenTSLMSP, OpenTSLMFlamingo]: The loaded model instance\n\n        Example:\n            >>> model = OpenTSLM.load_pretrained(\"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            >>> prompt = FullPrompt(...)\n            >>> response = model.eval_prompt(prompt)\n        \"\"\"\n        device = cls._get_device(device)\n        model_type = cls._detect_model_type(repo_id)\n        checkpoint_path = cls._download_model_files(repo_id, cache_dir)\n        base_llm_id = cls._get_base_llm_id(repo_id)\n\n        print(f\"🚀 Loading {model_type.value.upper()} model...\")\n        print(f\"   Repository: {repo_id}\")\n        print(f\"   Base LLM: {base_llm_id}\")\n        print(f\"   Device: {device}\")\n\n        # Instantiate model with fixed training parameters\n        if model_type == ModelType.SP:\n            # OpenTSLMSP uses default parameters from curriculum learning\n            model = OpenTSLMSP(llm_id=base_llm_id, device=device)\n            if enable_lora:\n                model.enable_lora()\n        elif model_type == ModelType.FLAMINGO:\n            # OpenTSLMFlamingo with fixed parameters from curriculum learning\n            model = OpenTSLMFlamingo(\n                device=device,\n                llm_id=base_llm_id,\n                cross_attn_every_n_layers=1,\n                gradient_checkpointing=False,\n            )\n        else:\n            raise ValueError(f\"Unknown model type: {model_type}\")\n\n        # Load the checkpoint\n        model.load_from_file(checkpoint_path)\n        model.eval()\n\n        print(f\"✅ {model_type.value.upper()} model loaded successfully!\")\n        return model\n\n    def load_from_file(self, path: str):\n        ckpt = torch.load(path, map_location=self.device, weights_only=False)\n        self.encoder.load_state_dict(ckpt[\"encoder_state\"])\n        self.projector.load_state_dict(ckpt[\"projector_state\"])\n\n        # Load LoRA state if present (allow missing for backward compatibility)\n        self.load_lora_state_from_checkpoint(ckpt, allow_missing=True)\n\n        print(f\"📥 Loaded model from epoch {ckpt.get('epoch', '?')}\")\n\n","stderr":"","aggregated_output":"(self, llm_id: str = 'meta-llama/Llama-3.2-1B', device: str = 'cuda')\n(self, path: str)\n    @classmethod\n    def load_pretrained(\n        cls,\n        repo_id: str,\n        device: Optional[str] = None,\n        cache_dir: Optional[str] = None,\n        enable_lora: Optional[bool] = False,\n    ) -> Union[OpenTSLMSP, OpenTSLMFlamingo]:\n        \"\"\"\n        Load a pretrained model from Hugging Face Hub.\n\n        Args:\n            repo_id: Hugging Face repository ID (e.g., \"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            device: Device to load the model on (default: auto-detect)\n            cache_dir: Directory to cache downloaded models (optional)\n            enable_lora: Whether to enable LoRA (default: False)\n\n        Returns:\n            Union[OpenTSLMSP, OpenTSLMFlamingo]: The loaded model instance\n\n        Example:\n            >>> model = OpenTSLM.load_pretrained(\"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            >>> prompt = FullPrompt(...)\n            >>> response = model.eval_prompt(prompt)\n        \"\"\"\n        device = cls._get_device(device)\n        model_type = cls._detect_model_type(repo_id)\n        checkpoint_path = cls._download_model_files(repo_id, cache_dir)\n        base_llm_id = cls._get_base_llm_id(repo_id)\n\n        print(f\"🚀 Loading {model_type.value.upper()} model...\")\n        print(f\"   Repository: {repo_id}\")\n        print(f\"   Base LLM: {base_llm_id}\")\n        print(f\"   Device: {device}\")\n\n        # Instantiate model with fixed training parameters\n        if model_type == ModelType.SP:\n            # OpenTSLMSP uses default parameters from curriculum learning\n            model = OpenTSLMSP(llm_id=base_llm_id, device=device)\n            if enable_lora:\n                model.enable_lora()\n        elif model_type == ModelType.FLAMINGO:\n            # OpenTSLMFlamingo with fixed parameters from curriculum learning\n            model = OpenTSLMFlamingo(\n                device=device,\n                llm_id=base_llm_id,\n                cross_attn_every_n_layers=1,\n                gradient_checkpointing=False,\n            )\n        else:\n            raise ValueError(f\"Unknown model type: {model_type}\")\n\n        # Load the checkpoint\n        model.load_from_file(checkpoint_path)\n        model.eval()\n\n        print(f\"✅ {model_type.value.upper()} model loaded successfully!\")\n        return model\n\n    def load_from_file(self, path: str):\n        ckpt = torch.load(path, map_location=self.device, weights_only=False)\n        self.encoder.load_state_dict(ckpt[\"encoder_state\"])\n        self.projector.load_state_dict(ckpt[\"projector_state\"])\n\n        # Load LoRA state if present (allow missing for backward compatibility)\n        self.load_lora_state_from_checkpoint(ckpt, allow_missing=True)\n\n        print(f\"📥 Loaded model from epoch {ckpt.get('epoch', '?')}\")\n\n","exit_code":0,"duration":{"secs":7,"nanos":116469625},"formatted_output":"(self, llm_id: str = 'meta-llama/Llama-3.2-1B', device: str = 'cuda')\n(self, path: str)\n    @classmethod\n    def load_pretrained(\n        cls,\n        repo_id: str,\n        device: Optional[str] = None,\n        cache_dir: Optional[str] = None,\n        enable_lora: Optional[bool] = False,\n    ) -> Union[OpenTSLMSP, OpenTSLMFlamingo]:\n        \"\"\"\n        Load a pretrained model from Hugging Face Hub.\n\n        Args:\n            repo_id: Hugging Face repository ID (e.g., \"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            device: Device to load the model on (default: auto-detect)\n            cache_dir: Directory to cache downloaded models (optional)\n            enable_lora: Whether to enable LoRA (default: False)\n\n        Returns:\n            Union[OpenTSLMSP, OpenTSLMFlamingo]: The loaded model instance\n\n        Example:\n            >>> model = OpenTSLM.load_pretrained(\"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            >>> prompt = FullPrompt(...)\n            >>> response = model.eval_prompt(prompt)\n        \"\"\"\n        device = cls._get_device(device)\n        model_type = cls._detect_model_type(repo_id)\n        checkpoint_path = cls._download_model_files(repo_id, cache_dir)\n        base_llm_id = cls._get_base_llm_id(repo_id)\n\n        print(f\"🚀 Loading {model_type.value.upper()} model...\")\n        print(f\"   Repository: {repo_id}\")\n        print(f\"   Base LLM: {base_llm_id}\")\n        print(f\"   Device: {device}\")\n\n        # Instantiate model with fixed training parameters\n        if model_type == ModelType.SP:\n            # OpenTSLMSP uses default parameters from curriculum learning\n            model = OpenTSLMSP(llm_id=base_llm_id, device=device)\n            if enable_lora:\n                model.enable_lora()\n        elif model_type == ModelType.FLAMINGO:\n            # OpenTSLMFlamingo with fixed parameters from curriculum learning\n            model = OpenTSLMFlamingo(\n                device=device,\n                llm_id=base_llm_id,\n                cross_attn_every_n_layers=1,\n                gradient_checkpointing=False,\n            )\n        else:\n            raise ValueError(f\"Unknown model type: {model_type}\")\n\n        # Load the checkpoint\n        model.load_from_file(checkpoint_path)\n        model.eval()\n\n        print(f\"✅ {model_type.value.upper()} model loaded successfully!\")\n        return model\n\n    def load_from_file(self, path: str):\n        ckpt = torch.load(path, map_location=self.device, weights_only=False)\n        self.encoder.load_state_dict(ckpt[\"encoder_state\"])\n        self.projector.load_state_dict(ckpt[\"projector_state\"])\n\n        # Load LoRA state if present (allow missing for backward compatibility)\n        self.load_lora_state_from_checkpoint(ckpt, allow_missing=True)\n\n        print(f\"📥 Loaded model from epoch {ckpt.get('epoch', '?')}\")\n\n"},"started_at_ms":1789281948676,"completed_at_ms":1789281955793}}
{"timestamp":"2026-09-13T06:45:55.858Z","ordinal":15288,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a09983-f012-7e51-a719-3089c4e4e7bd","call_id":"call_xs9qtpFnBSJF7ZbEcklDbXk6","output":[{"type":"input_text","text":"Script completed\nWall time 9.0 seconds\nOutput:\n"},{"type":"input_text","text":"(self, llm_id: str = 'meta-llama/Llama-3.2-1B', device: str = 'cuda')\n(self, path: str)\n    @classmethod\n    def load_pretrained(\n        cls,\n        repo_id: str,\n        device: Optional[str] = None,\n        cache_dir: Optional[str] = None,\n        enable_lora: Optional[bool] = False,\n    ) -> Union[OpenTSLMSP, OpenTSLMFlamingo]:\n        \"\"\"\n        Load a pretrained model from Hugging Face Hub.\n\n        Args:\n            repo_id: Hugging Face repository ID (e.g., \"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            device: Device to load the model on (default: auto-detect)\n            cache_dir: Directory to cache downloaded models (optional)\n            enable_lora: Whether to enable LoRA (default: False)\n\n        Returns:\n            Union[OpenTSLMSP, OpenTSLMFlamingo]: The loaded model instance\n\n        Example:\n            >>> model = OpenTSLM.load_pretrained(\"OpenTSLM/gemma-3-270m-pt-sleep-flamingo\")\n            >>> prompt = FullPrompt(...)\n            >>> response = model.eval_prompt(prompt)\n        \"\"\"\n        device = cls._get_device(device)\n        model_type = cls._detect_model_type(repo_id)\n        checkpoint_path = cls._download_model_files(repo_id, cache_dir)\n        base_llm_id = cls._get_base_llm_id(repo_id)\n\n        print(f\"🚀 Loading {model_type.value.upper()} model...\")\n        print(f\"   Repository: {repo_id}\")\n        print(f\"   Base LLM: {base_llm_id}\")\n        print(f\"   Device: {device}\")\n\n        # Instantiate model with fixed training parameters\n        if model_type == ModelType.SP:\n            # OpenTSLMSP uses default parameters from curriculum learning\n            model = OpenTSLMSP(llm_id=base_llm_id, device=device)\n            if enable_lora:\n                model.enable_lora()\n        elif model_type == ModelType.FLAMINGO:\n            # OpenTSLMFlamingo with fixed parameters from curriculum learning\n            model = OpenTSLMFlamingo(\n                device=device,\n                llm_id=base_llm_id,\n                cross_attn_every_n_layers=1,\n                gradient_checkpointing=False,\n            )\n        else:\n            raise ValueError(f\"Unknown model type: {model_type}\")\n\n        # Load the checkpoint\n        model.load_from_file(checkpoint_path)\n        model.eval()\n\n        print(f\"✅ {model_type.value.upper()} model loaded successfully!\")\n        return model\n\n    def load_from_file(self, path: str):\n        ckpt = torch.load(path, map_location=self.device, weights_only=False)\n        self.encoder.load_state_dict(ckpt[\"encoder_state\"])\n        self.projector.load_state_dict(ckpt[\"projector_state\"])\n\n        # Load LoRA state if present (allow missing for backward compatibility)\n        self.load_lora_state_from_checkpoint(ckpt, allow_missing=True)\n\n        print(f\"📥 Loaded model from epoch {ckpt.get('epoch', '?')}\")\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","create_time":1789281955.858343}}}
