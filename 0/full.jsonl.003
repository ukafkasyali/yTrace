nt-row select{font-size:16px}.requirement-row{grid-template-columns:1fr}.requirement-fixed{justify-self:start}.scout-run-line .mono{width:100%;margin-left:0;overflow-wrap:anywhere}.scout-candidate-heading,.scout-approval{align-items:flex-start;flex-direction:column}.scout-facts{grid-template-columns:repeat(2,minmax(0,1fr))!important}.scout-facts>div:nth-child(2){border-right:0}.suitability-rationale ul,.gate-list{grid-template-columns:1fr}}\n361:.dataset-scout{padding-top:2px}\n362:.dataset-scout .section-heading h2,.ingestion-handoff .section-heading h2{font-size:18px;margin-bottom:0}\n363:.dataset-scout>label,.ingestion-handoff>form>label{display:block;margin-top:18px;color:#cbd4d6;font-size:12px}\n364:.source-ready{display:flex;align-items:center;gap:7px;margin:14px 0 0;color:var(--accent);font-size:12px}\n385:  .dataset-scout .section-heading h2,.ingestion-handoff .section-heading h2{font-size:17px}\n"},"started_at_ms":1789280909994,"completed_at_ms":1789280909994}}
