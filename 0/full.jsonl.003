{"timestamp":"2026-09-13T06:53:08.147Z","ordinal":15601,"type":"token_usage_record","payload":{"thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a09989-5963-7ac2-896e-62cf4245c0ce","session_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","root_turn_id":"01a09989-5963-7ac2-896e-62cf4245c0ce","response_id":"resp_0f3535a43349ee3d016aa64850486487d28a3285d0d283b21b","usage":{"input_tokens":182885,"cached_input_tokens":182087,"cache_write_input_tokens":795,"output_tokens":126,"reasoning_output_tokens":16,"total_tokens":183011},"turn_token_usage":{"input_tokens":1448294,"cached_input_tokens":1444355,"cache_write_input_tokens":3915,"output_tokens":2727,"reasoning_output_tokens":574,"total_tokens":1451021},"thread_token_usage":{"input_tokens":297442913,"cached_input_tokens":290823273,"cache_write_input_tokens":6495969,"output_tokens":739681,"reasoning_output_tokens":228388,"total_tokens":298182594}}}
{"timestamp":"2026-09-13T06:53:08.160Z","ordinal":15602,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a09989-5963-7ac2-896e-62cf4245c0ce","item":{"type":"CommandExecution","id":"exec-e5366f99-c339-428c-a681-7021e923bda4","process_id":"13186","command":["/bin/zsh","-lc","sed -n '1,50p' model_training/src/robot_observability/factorybench_data.py; sed -n '445,495p' model_training/src/robot_observability/factorybench_data.py; tail -35 model_training/tests/test_factorybench_data.py"],"cwd":"file:///private/tmp/ysamet-factorybench","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,50p' model_training/src/robot_observability/factorybench_data.py; sed -n '445,495p' model_training/src/robot_observability/factorybench_data.py; tail -35 model_training/tests/test_factorybench_data.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom array import array\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(?::\\s*(?P<values>.*))?$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n        not isinstance(raw_lines, list)\n        or not raw_lines\n        or any(not isinstance(line, str) for line in raw_lines)\n    ):\n        raise ValueError(f\"Invalid time_series for FactoryBench item {item_id}\")\n    mapping: dict[str, str] = {}\n    time_series_format = context.get(\"time_series_format\")\n    if isinstance(time_series_format, dict):\n        raw_mapping = time_series_format.get(\"acronym_mapping\")\n        if isinstance(raw_mapping, dict):\n            mapping = {str(key): str(value) for key, value in raw_mapping.items()}\n\n    timestamps: list[float] = []\n    columns: dict[str, list[float]] = {}\n    column_order: list[str] | None = None\n    for line in raw_lines:\n        match = _TIMESTEP.fullmatch(line.strip())\n        if match is None:\n            raise ValueError(f\"Invalid time-series row for FactoryBench item {item_id}: {line[:80]!r}\")\n        timestamp = float(match.group(\"timestamp\"))\n        if not math.isfinite(timestamp):\n            raise ValueError(f\"Non-finite timestamp for FactoryBench item {item_id}\")\n        row_values: dict[str, float] = {}\n        row_order: list[str] = []\n        raw_values = match.group(\"values\") or \"\"\n        fields = raw_values.split(\",\") if raw_values.strip() else []\n        for field in fields:\n            value_match = _VALUE.fullmatch(field.strip())\n            if value_match is None:\n                raise ValueError(f\"Invalid signal value for FactoryBench item {item_id}: {field!r}\")\n            name = value_match.group(\"name\")\n            if name in row_values:\n                raise ValueError(f\"Duplicate signal {name} for FactoryBench item {item_id}\")\n            value = float(value_match.group(\"value\"))\n            if not math.isfinite(value):\n                raise ValueError(f\"Non-finite signal {name} for FactoryBench item {item_id}\")\n            row_values[name] = value\n            row_order.append(name)\n        if column_order is None:\n            column_order = row_order\n            columns = {name: [] for name in column_order}\n        elif row_order != column_order:\n            raise ValueError(f\"Signal order/schema changes within FactoryBench item {item_id}\")\n        timestamps.append(timestamp)\n        for name in column_order:\n            columns[name].append(row_values[name])\n    if any(right <= left for left, right in zip(timestamps, timestamps[1:])):\n        raise ValueError(f\"Timestamps are not strictly increasing for FactoryBench item {item_id}\")\n\n    assert column_order is not None\n    relative_timestamps = [timestamp - timestamps[0] for timestamp in timestamps]\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n\n\ndef test_timestamp_only_series_is_preserved_and_flagged() -> None:\n    row = _single(\"timestamp-only\", \"ep-time\")\n    row[\"context\"] = {\"time_series\": [\"t=0\", \"t=100\", \"t=200\", \"t=300\"]}\n\n    sample = FactoryBenchDataset([row])[0]\n\n    assert sample[\"sensor_channel_count\"] == 0\n    assert len(sample[\"time_series\"]) == 1\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n","stderr":"","aggregated_output":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom array import array\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(?::\\s*(?P<values>.*))?$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n        not isinstance(raw_lines, list)\n        or not raw_lines\n        or any(not isinstance(line, str) for line in raw_lines)\n    ):\n        raise ValueError(f\"Invalid time_series for FactoryBench item {item_id}\")\n    mapping: dict[str, str] = {}\n    time_series_format = context.get(\"time_series_format\")\n    if isinstance(time_series_format, dict):\n        raw_mapping = time_series_format.get(\"acronym_mapping\")\n        if isinstance(raw_mapping, dict):\n            mapping = {str(key): str(value) for key, value in raw_mapping.items()}\n\n    timestamps: list[float] = []\n    columns: dict[str, list[float]] = {}\n    column_order: list[str] | None = None\n    for line in raw_lines:\n        match = _TIMESTEP.fullmatch(line.strip())\n        if match is None:\n            raise ValueError(f\"Invalid time-series row for FactoryBench item {item_id}: {line[:80]!r}\")\n        timestamp = float(match.group(\"timestamp\"))\n        if not math.isfinite(timestamp):\n            raise ValueError(f\"Non-finite timestamp for FactoryBench item {item_id}\")\n        row_values: dict[str, float] = {}\n        row_order: list[str] = []\n        raw_values = match.group(\"values\") or \"\"\n        fields = raw_values.split(\",\") if raw_values.strip() else []\n        for field in fields:\n            value_match = _VALUE.fullmatch(field.strip())\n            if value_match is None:\n                raise ValueError(f\"Invalid signal value for FactoryBench item {item_id}: {field!r}\")\n            name = value_match.group(\"name\")\n            if name in row_values:\n                raise ValueError(f\"Duplicate signal {name} for FactoryBench item {item_id}\")\n            value = float(value_match.group(\"value\"))\n            if not math.isfinite(value):\n                raise ValueError(f\"Non-finite signal {name} for FactoryBench item {item_id}\")\n            row_values[name] = value\n            row_order.append(name)\n        if column_order is None:\n            column_order = row_order\n            columns = {name: [] for name in column_order}\n        elif row_order != column_order:\n            raise ValueError(f\"Signal order/schema changes within FactoryBench item {item_id}\")\n        timestamps.append(timestamp)\n        for name in column_order:\n            columns[name].append(row_values[name])\n    if any(right <= left for left, right in zip(timestamps, timestamps[1:])):\n        raise ValueError(f\"Timestamps are not strictly increasing for FactoryBench item {item_id}\")\n\n    assert column_order is not None\n    relative_timestamps = [timestamp - timestamps[0] for timestamp in timestamps]\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n\n\ndef test_timestamp_only_series_is_preserved_and_flagged() -> None:\n    row = _single(\"timestamp-only\", \"ep-time\")\n    row[\"context\"] = {\"time_series\": [\"t=0\", \"t=100\", \"t=200\", \"t=300\"]}\n\n    sample = FactoryBenchDataset([row])[0]\n\n    assert sample[\"sensor_channel_count\"] == 0\n    assert len(sample[\"time_series\"]) == 1\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n","exit_code":0,"duration":{"secs":0,"nanos":1375},"formatted_output":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom array import array\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(?::\\s*(?P<values>.*))?$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n        not isinstance(raw_lines, list)\n        or not raw_lines\n        or any(not isinstance(line, str) for line in raw_lines)\n    ):\n        raise ValueError(f\"Invalid time_series for FactoryBench item {item_id}\")\n    mapping: dict[str, str] = {}\n    time_series_format = context.get(\"time_series_format\")\n    if isinstance(time_series_format, dict):\n        raw_mapping = time_series_format.get(\"acronym_mapping\")\n        if isinstance(raw_mapping, dict):\n            mapping = {str(key): str(value) for key, value in raw_mapping.items()}\n\n    timestamps: list[float] = []\n    columns: dict[str, list[float]] = {}\n    column_order: list[str] | None = None\n    for line in raw_lines:\n        match = _TIMESTEP.fullmatch(line.strip())\n        if match is None:\n            raise ValueError(f\"Invalid time-series row for FactoryBench item {item_id}: {line[:80]!r}\")\n        timestamp = float(match.group(\"timestamp\"))\n        if not math.isfinite(timestamp):\n            raise ValueError(f\"Non-finite timestamp for FactoryBench item {item_id}\")\n        row_values: dict[str, float] = {}\n        row_order: list[str] = []\n        raw_values = match.group(\"values\") or \"\"\n        fields = raw_values.split(\",\") if raw_values.strip() else []\n        for field in fields:\n            value_match = _VALUE.fullmatch(field.strip())\n            if value_match is None:\n                raise ValueError(f\"Invalid signal value for FactoryBench item {item_id}: {field!r}\")\n            name = value_match.group(\"name\")\n            if name in row_values:\n                raise ValueError(f\"Duplicate signal {name} for FactoryBench item {item_id}\")\n            value = float(value_match.group(\"value\"))\n            if not math.isfinite(value):\n                raise ValueError(f\"Non-finite signal {name} for FactoryBench item {item_id}\")\n            row_values[name] = value\n            row_order.append(name)\n        if column_order is None:\n            column_order = row_order\n            columns = {name: [] for name in column_order}\n        elif row_order != column_order:\n            raise ValueError(f\"Signal order/schema changes within FactoryBench item {item_id}\")\n        timestamps.append(timestamp)\n        for name in column_order:\n            columns[name].append(row_values[name])\n    if any(right <= left for left, right in zip(timestamps, timestamps[1:])):\n        raise ValueError(f\"Timestamps are not strictly increasing for FactoryBench item {item_id}\")\n\n    assert column_order is not None\n    relative_timestamps = [timestamp - timestamps[0] for timestamp in timestamps]\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n\n\ndef test_timestamp_only_series_is_preserved_and_flagged() -> None:\n    row = _single(\"timestamp-only\", \"ep-time\")\n    row[\"context\"] = {\"time_series\": [\"t=0\", \"t=100\", \"t=200\", \"t=300\"]}\n\n    sample = FactoryBenchDataset([row])[0]\n\n    assert sample[\"sensor_channel_count\"] == 0\n    assert len(sample[\"time_series\"]) == 1\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n"},"started_at_ms":1789282388160,"completed_at_ms":1789282388160}}
{"timestamp":"2026-09-13T06:53:08.203Z","ordinal":15603,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0998a-88eb-7f22-ad48-55a40d759863","call_id":"call_1hWx9thRXNlzcB7uvZVqyZVs","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\"\"\"Leakage-safe FactoryBench Level 1 adapter for OpenTSLM experiments.\n\nFactoryBench questions may reuse one episode in several items. Comparative items\nalso join two episodes. This module therefore assigns connected episode components\nto splits instead of assigning individual questions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport math\nimport random\nimport re\nfrom array import array\nfrom collections import Counter, defaultdict\nfrom collections.abc import Iterable, Sequence\nfrom pathlib import Path\nfrom typing import Any\n\n\nFACTORYBENCH_DATASET_ID = \"FactoryBench/FactoryBench\"\nFACTORYBENCH_SOURCE_URL = \"https://huggingface.co/datasets/FactoryBench/FactoryBench\"\nSPLITS = (\"train\", \"validation\", \"test\")\n\n_TIMESTEP = re.compile(\n    r\"^t=(?P<timestamp>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))(?::\\s*(?P<values>.*))?$\"\n)\n_VALUE = re.compile(\n    r\"^(?P<name>[A-Za-z][A-Za-z0-9_]*)=(?P<value>[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)$\"\n)\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef load_rows(path: Path, *, expected_sha256: str | None = None) -> list[dict[str, Any]]:\n    \"\"\"Load and validate one full or Lite FactoryBench L1 JSONL file.\"\"\"\n    path = Path(path)\n    actual_sha256 = sha256_file(path)\n    if expected_sha256 is not None and actual_sha256 != expected_sha256:\n        raise ValueError(\n            f\"FactoryBench source checksum mismatch: expected {expected_sha256}, got {actual_sha256}\"\n        )\n\n        not isinstance(raw_lines, list)\n        or not raw_lines\n        or any(not isinstance(line, str) for line in raw_lines)\n    ):\n        raise ValueError(f\"Invalid time_series for FactoryBench item {item_id}\")\n    mapping: dict[str, str] = {}\n    time_series_format = context.get(\"time_series_format\")\n    if isinstance(time_series_format, dict):\n        raw_mapping = time_series_format.get(\"acronym_mapping\")\n        if isinstance(raw_mapping, dict):\n            mapping = {str(key): str(value) for key, value in raw_mapping.items()}\n\n    timestamps: list[float] = []\n    columns: dict[str, list[float]] = {}\n    column_order: list[str] | None = None\n    for line in raw_lines:\n        match = _TIMESTEP.fullmatch(line.strip())\n        if match is None:\n            raise ValueError(f\"Invalid time-series row for FactoryBench item {item_id}: {line[:80]!r}\")\n        timestamp = float(match.group(\"timestamp\"))\n        if not math.isfinite(timestamp):\n            raise ValueError(f\"Non-finite timestamp for FactoryBench item {item_id}\")\n        row_values: dict[str, float] = {}\n        row_order: list[str] = []\n        raw_values = match.group(\"values\") or \"\"\n        fields = raw_values.split(\",\") if raw_values.strip() else []\n        for field in fields:\n            value_match = _VALUE.fullmatch(field.strip())\n            if value_match is None:\n                raise ValueError(f\"Invalid signal value for FactoryBench item {item_id}: {field!r}\")\n            name = value_match.group(\"name\")\n            if name in row_values:\n                raise ValueError(f\"Duplicate signal {name} for FactoryBench item {item_id}\")\n            value = float(value_match.group(\"value\"))\n            if not math.isfinite(value):\n                raise ValueError(f\"Non-finite signal {name} for FactoryBench item {item_id}\")\n            row_values[name] = value\n            row_order.append(name)\n        if column_order is None:\n            column_order = row_order\n            columns = {name: [] for name in column_order}\n        elif row_order != column_order:\n            raise ValueError(f\"Signal order/schema changes within FactoryBench item {item_id}\")\n        timestamps.append(timestamp)\n        for name in column_order:\n            columns[name].append(row_values[name])\n    if any(right <= left for left, right in zip(timestamps, timestamps[1:])):\n        raise ValueError(f\"Timestamps are not strictly increasing for FactoryBench item {item_id}\")\n\n    assert column_order is not None\n    relative_timestamps = [timestamp - timestamps[0] for timestamp in timestamps]\n        }\n    }\n\n    normalization = fit_normalization(rows, manifest)\n    receipt_path = tmp_path / \"normalization.json\"\n    write_normalization_receipt(receipt_path, normalization)\n    validation_sample = FactoryBenchDataset(\n        rows, split_manifest=manifest, split=\"validation\", normalization=normalization\n    )[0]\n\n    assert normalization[\"training_items\"] == 2\n    assert normalization[\"channels\"][\"feedback position 0\"][\"center\"] == 3.5\n    assert normalization[\"channels\"][\"feedback position 0\"][\"count\"] == 8\n    assert validation_sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n    assert validation_sample[\"time_series\"][1].tolist() == [20.0, 20.0, 20.0, 20.0]\n    assert json.loads(receipt_path.read_text())[\"timestamp\"].endswith(\"not normalized\")\n\n\ndef test_parser_rejects_inconsistent_signal_schema() -> None:\n    row = _single(\"bad\", \"ep-bad\")\n    row[\"context\"][\"time_series\"][1] = \"t=200: fs0=-1.0, fp0=1.5\"\n\n    with pytest.raises(ValueError, match=\"order/schema\"):\n        FactoryBenchDataset([row])[0]\n\n\ndef test_timestamp_only_series_is_preserved_and_flagged() -> None:\n    row = _single(\"timestamp-only\", \"ep-time\")\n    row[\"context\"] = {\"time_series\": [\"t=0\", \"t=100\", \"t=200\", \"t=300\"]}\n\n    sample = FactoryBenchDataset([row])[0]\n\n    assert sample[\"sensor_channel_count\"] == 0\n    assert len(sample[\"time_series\"]) == 1\n    assert sample[\"time_series\"][0].tolist() == [0.0, 100.0, 200.0, 300.0]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a09989-5963-7ac2-896e-62cf4245c0ce","create_time":1789282388.203847}}}
