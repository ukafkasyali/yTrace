{"timestamp":"2026-09-13T06:46:23.476Z","ordinal":15299,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0f3535a43349ee3d016aa646b1e61087d2aeae03d5c1a79214","status":"completed","call_id":"call_zcjptKNqPMc5X1rZCVlVGsaa","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Add File: /private/tmp/ysamet-factorybench/model_training/src/robot_observability/factorybench_metrics.py\\n+\\\"\\\"\\\"Deterministic scoring for the bounded FactoryBench Level 1 canary.\\n+\\n+The public benchmark contains short categorical and numeric answers.  This module\\n+keeps training-time checkpoint selection independent from the robot-observability\\n+JSON scorer.  It does not claim to replace the upstream FactoryBench evaluator;\\n+saved predictions can be passed to that evaluator for the final reported score.\\n+\\\"\\\"\\\"\\n+\\n+from __future__ import annotations\\n+\\n+import math\\n+import re\\n+from collections import defaultdict\\n+\\n+\\n+_LETTER = re.compile(r\\\"^[A-Z]$\\\")\\n+_BIT_VECTOR = re.compile(r\\\"^[FT]{4}$\\\")\\n+_NUMBER = re.compile(r\\\"^[+-]?(?:\\\\d+(?:\\\\.\\\\d*)?|\\\\.\\\\d+)$\\\")\\n+\\n+\\n+def parse_short_answer(output: object, template_id: int) -> str | float | int | None:\\n+    \\\"\\\"\\\"Parse only the exact answer format requested by a FactoryBench L1 row.\\\"\\\"\\\"\\n+\\n+    text = str(output or \\\"\\\").strip()\\n+    if template_id == 6:\\n+        value = text.upper()\\n+        return value if _LETTER.fullmatch(value) else None\\n+    if template_id == 3:\\n+        value = text.upper()\\n+        return value if _BIT_VECTOR.fullmatch(value) else None\\n+    if template_id in {1, 7} and _NUMBER.fullmatch(text):\\n+        value = float(text)\\n+        return int(value) if value.is_integer() else value\\n+    return None\\n+\\n+\\n+def answer_is_correct(\\n+    prediction: str | float | int | None,\\n+    target: object,\\n+    acceptance_bounds: object,\\n+) -> bool:\\n+    \\\"\\\"\\\"Apply exact categorical or published numeric-bound acceptance.\\\"\\\"\\\"\\n+\\n+    if prediction is None:\\n+        return False\\n+    if isinstance(target, bool):\\n+        return prediction is target\\n+    if isinstance(target, (int, float)) and not isinstance(target, bool):\\n+        try:\\n+            numeric = float(prediction)\\n+        except (TypeError, ValueError):\\n+            return False\\n+        if not math.isfinite(numeric):\\n+            return False\\n+        if isinstance(acceptance_bounds, dict):\\n+            lower = acceptance_bounds.get(\\\"min\\\")\\n+            upper = acceptance_bounds.get(\\\"max\\\")\\n+            if isinstance(lower, (int, float)) and isinstance(upper, (int, float)):\\n+                return float(lower) <= numeric <= float(upper)\\n+        return math.isclose(numeric, float(target), rel_tol=0.0, abs_tol=1e-9)\\n+    return str(prediction).strip().casefold() == str(target).strip().casefold()\\n+\\n+\\n+def evaluate_prediction_rows(rows: list[dict[str, object]]) -> dict[str, float | int]:\\n+    \\\"\\\"\\\"Return answer coverage and accuracy overall and per L1 template.\\\"\\\"\\\"\\n+\\n+    grouped: dict[int, list[tuple[bool, bool]]] = defaultdict(list)\\n+    for row in rows:\\n+        template_id = int(row[\\\"template_id\\\"])\\n+        prediction = parse_short_answer(row.get(\\\"output\\\"), template_id)\\n+        covered = prediction is not None\\n+        correct = answer_is_correct(prediction, row.get(\\\"target\\\"), row.get(\\\"acceptance_bounds\\\"))\\n+        grouped[template_id].append((covered, correct))\\n+\\n+    result: dict[str, float | int] = {\\\"n\\\": len(rows)}\\n+    all_values = [value for values in grouped.values() for value in values]\\n+    result[\\\"coverage\\\"] = sum(value[0] for value in all_values) / len(all_values) if all_values else 0.0\\n+    result[\\\"accuracy\\\"] = sum(value[1] for value in all_values) / len(all_values) if all_values else 0.0\\n+    for template_id, values in sorted(grouped.items()):\\n+        result[f\\\"template_{template_id}/n\\\"] = len(values)\\n+        result[f\\\"template_{template_id}/coverage\\\"] = sum(value[0] for value in values) / len(values)\\n+        result[f\\\"template_{template_id}/accuracy\\\"] = sum(value[1] for value in values) / len(values)\\n+    if grouped:\\n+        result[\\\"template_macro_accuracy\\\"] = sum(\\n+            sum(value[1] for value in values) / len(values) for values in grouped.values()\\n+        ) / len(grouped)\\n+    else:\\n+        result[\\\"template_macro_accuracy\\\"] = 0.0\\n+    return result\\n*** Add File: /private/tmp/ysamet-factorybench/model_training/tests/test_factorybench_metrics.py\\n+from robot_observability.factorybench_metrics import (\\n+    answer_is_correct,\\n+    evaluate_prediction_rows,\\n+    parse_short_answer,\\n+)\\n+\\n+\\n+def test_parse_short_answer_is_strict() -> None:\\n+    assert parse_short_answer(\\\" B \\\", 6) == \\\"B\\\"\\n+    assert parse_short_answer(\\\"Answer: B\\\", 6) is None\\n+    assert parse_short_answer(\\\"TFFT\\\", 3) == \\\"TFFT\\\"\\n+    assert parse_short_answer(\\\"TFF\\\", 3) is None\\n+    assert parse_short_answer(\\\"-12.5\\\", 7) == -12.5\\n+\\n+\\n+def test_numeric_bounds_control_acceptance() -> None:\\n+    assert answer_is_correct(5, 3, {\\\"min\\\": 1, \\\"max\\\": 8})\\n+    assert not answer_is_correct(9, 3, {\\\"min\\\": 1, \\\"max\\\": 8})\\n+\\n+\\n+def test_evaluate_prediction_rows_reports_coverage_and_macro_accuracy() -> None:\\n+    metrics = evaluate_prediction_rows(\\n+        [\\n+            {\\\"template_id\\\": 6, \\\"output\\\": \\\"A\\\", \\\"target\\\": \\\"A\\\", \\\"acceptance_bounds\\\": None},\\n+            {\\\"template_id\\\": 6, \\\"output\\\": \\\"Answer: B\\\", \\\"target\\\": \\\"B\\\", \\\"acceptance_bounds\\\": None},\\n+            {\\\"template_id\\\": 3, \\\"output\\\": \\\"TFFT\\\", \\\"target\\\": \\\"TFFT\\\", \\\"acceptance_bounds\\\": None},\\n+        ]\\n+    )\\n+    assert metrics[\\\"coverage\\\"] == 2 / 3\\n+    assert metrics[\\\"accuracy\\\"] == 2 / 3\\n+    assert metrics[\\\"template_macro_accuracy\\\"] == 0.75\\n*** End Patch\";\ntext(await tools.apply_patch(patch));","internal_chat_message_metadata_passthrough":{"turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","create_time":1789281961.202327}}}
