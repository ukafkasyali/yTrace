{"timestamp":"2026-09-13T06:49:25.374Z","ordinal":15421,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0f3535a43349ee3d016aa64752e17487d2a4d48001ae806566","status":"completed","call_id":"call_pkW5PSZ0qtcRfl2mmj3MH52K","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Add File: /private/tmp/ysamet-factorybench/model_training/scripts/train_factorybench_opentslm.py\\n+#!/usr/bin/env python3\\n+\\\"\\\"\\\"Run an isolated FactoryBench L1 OpenTSLM canary on a pinned source file.\\n+\\n+This experiment deliberately does not alter Trace's KUKA trainer, runtime, API, or\\n+deployed checkpoint.  Development uses only the generated validation split; test\\n+rows remain sealed for a later confirmation run.\\n+\\\"\\\"\\\"\\n+\\n+from __future__ import annotations\\n+\\n+import argparse\\n+import hashlib\\n+import json\\n+import math\\n+import platform\\n+import random\\n+import time\\n+from collections import Counter\\n+from contextlib import nullcontext\\n+from pathlib import Path\\n+\\n+import numpy as np\\n+import torch\\n+import yaml\\n+from torch.utils.data import DataLoader, Dataset, Subset\\n+\\n+from robot_observability.checkpoints import store_runtime_checkpoint\\n+from robot_observability.factorybench_data import (\\n+    FactoryBenchDataset,\\n+    audit_split,\\n+    build_component_split,\\n+    load_rows,\\n+    source_receipt,\\n+    write_source_receipt,\\n+    write_split_manifest,\\n+)\\n+from robot_observability.factorybench_metrics import evaluate_prediction_rows\\n+from robot_observability.train_opentslm import optimizer_for, scheduler_for\\n+\\n+\\n+def sha256_file(path: Path) -> str:\\n+    digest = hashlib.sha256()\\n+    with path.open(\\\"rb\\\") as handle:\\n+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b\\\"\\\"):\\n+            digest.update(chunk)\\n+    return digest.hexdigest()\\n+\\n+\\n+def emit(path: Path, event: str, **payload: object) -> None:\\n+    row = {\\\"timestamp\\\": time.time(), \\\"event\\\": event, **payload}\\n+    line = json.dumps(row, sort_keys=True)\\n+    print(line, flush=True)\\n+    with path.open(\\\"a\\\", encoding=\\\"utf-8\\\") as handle:\\n+        handle.write(line + \\\"\\\\n\\\")\\n+\\n+\\n+def write_status(path: Path, **payload: object) -> None:\\n+    temporary = path.with_suffix(\\\".tmp\\\")\\n+    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n+    temporary.replace(path)\\n+\\n+\\n+def collate(batch: list[dict[str, object]]) -> list[dict[str, object]]:\\n+    return batch\\n+\\n+\\n+def balanced_subset(dataset: FactoryBenchDataset, size: int, seed: int) -> Dataset:\\n+    groups: dict[int, list[int]] = {}\\n+    for index, row in enumerate(dataset.rows):\\n+        groups.setdefault(int(row[\\\"template_id\\\"]), []).append(index)\\n+    rng = np.random.default_rng(seed)\\n+    queues = {key: rng.permutation(values).tolist() for key, values in groups.items()}\\n+    selected: list[int] = []\\n+    while len(selected) < min(size, len(dataset)):\\n+        previous = len(selected)\\n+        for key in sorted(queues):\\n+            if queues[key] and len(selected) < size:\\n+                selected.append(int(queues[key].pop()))\\n+        if len(selected) == previous:\\n+            break\\n+    return Subset(dataset, selected)\\n+\\n+\\n+class SignalAblationDataset:\\n+    def __init__(self, dataset: Dataset, mode: str) -> None:\\n+        if mode not in {\\\"zero\\\", \\\"reverse\\\"}:\\n+            raise ValueError(f\\\"Unknown ablation mode: {mode}\\\")\\n+        self.dataset = dataset\\n+        self.mode = mode\\n+\\n+    def __len__(self) -> int:\\n+        return len(self.dataset)\\n+\\n+    def __getitem__(self, index: int) -> dict[str, object]:\\n+        sample = dict(self.dataset[index])\\n+        transformed = []\\n+        for description, values in zip(sample[\\\"time_series_text\\\"], sample[\\\"time_series\\\"]):\\n+            tensor = values.detach().clone()\\n+            if \\\"relative timestamp\\\" not in str(description):\\n+                tensor = torch.zeros_like(tensor) if self.mode == \\\"zero\\\" else torch.flip(tensor, dims=(0,))\\n+            transformed.append(tensor)\\n+        sample[\\\"time_series\\\"] = transformed\\n+        return sample\\n+\\n+\\n+def load_model(config: dict[str, object], device: str):\\n+    from opentslm.model.llm.OpenTSLMSP import OpenTSLMSP\\n+\\n+    model_config = config[\\\"model\\\"]\\n+    base_model = Path(str(model_config[\\\"base_model\\\"]))\\n+    warm_start = Path(str(model_config[\\\"warm_start_checkpoint\\\"]))\\n+    base_weights = base_model / \\\"model.safetensors\\\"\\n+    if sha256_file(base_weights) != str(model_config[\\\"base_model_sha256\\\"]):\\n+        raise ValueError(\\\"Local Llama backbone checksum mismatch\\\")\\n+    if sha256_file(warm_start) != str(model_config[\\\"warm_start_sha256\\\"]):\\n+        raise ValueError(\\\"HAR warm-start checkpoint checksum mismatch\\\")\\n+    model = OpenTSLMSP(llm_id=str(base_model), device=device)\\n+    lora = model_config[\\\"lora\\\"]\\n+    model.enable_lora(\\n+        lora_r=int(lora[\\\"rank\\\"]),\\n+        lora_alpha=int(lora[\\\"alpha\\\"]),\\n+        lora_dropout=float(lora[\\\"dropout\\\"]),\\n+    )\\n+    model.load_from_file(str(warm_start))\\n+    return model\\n+\\n+\\n+@torch.no_grad()\\n+def mean_loss(model, dataset: Dataset, batch_size: int, precision: str) -> float:\\n+    model.eval()\\n+    losses = []\\n+    context = (\\n+        torch.autocast(device_type=\\\"cuda\\\", dtype=torch.bfloat16)\\n+        if precision == \\\"bfloat16\\\"\\n+        else nullcontext()\\n+    )\\n+    with context:\\n+        for batch in DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collate):\\n+            losses.append(float(model.compute_loss(batch).detach().cpu()))\\n+    return float(np.mean(losses)) if losses else math.nan\\n+\\n+\\n+@torch.no_grad()\\n+def generate_rows(model, dataset: Dataset, batch_size: int, output_path: Path) -> tuple[dict, list]:\\n+    model.eval()\\n+    rows = []\\n+    with output_path.open(\\\"w\\\", encoding=\\\"utf-8\\\") as handle:\\n+        for batch in DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collate):\\n+            outputs = model.generate(batch, max_new_tokens=12, do_sample=False)\\n+            for sample, output in zip(batch, outputs):\\n+                row = {\\n+                    \\\"id\\\": sample[\\\"id\\\"],\\n+                    \\\"template_id\\\": sample[\\\"template_id\\\"],\\n+                    \\\"output\\\": str(output).strip(),\\n+                    \\\"target\\\": sample[\\\"target\\\"],\\n+                    \\\"acceptance_bounds\\\": sample[\\\"acceptance_bounds\\\"],\\n+                }\\n+                rows.append(row)\\n+                handle.write(json.dumps(row, sort_keys=True) + \\\"\\\\n\\\")\\n+    return evaluate_prediction_rows(rows), rows\\n+\\n+\\n+def prediction_change_rate(real_rows: list[dict], ablated_rows: list[dict]) -> float:\\n+    ablated = {str(row[\\\"id\\\"]): row.get(\\\"output\\\") for row in ablated_rows}\\n+    changed = [row.get(\\\"output\\\") != ablated.get(str(row[\\\"id\\\"])) for row in real_rows]\\n+    return float(np.mean(changed)) if changed else 0.0\\n+\\n+\\n+def run(args: argparse.Namespace) -> None:\\n+    config = yaml.safe_load(args.config.read_text(encoding=\\\"utf-8\\\"))\\n+    run_root = args.output / args.run_name\\n+    run_root.mkdir(parents=True, exist_ok=False)\\n+    metrics_path = run_root / \\\"metrics.jsonl\\\"\\n+    status_path = run_root / \\\"status.json\\\"\\n+    write_status(status_path, state=\\\"initializing\\\", run_name=args.run_name)\\n+\\n+    seed = int(config[\\\"split\\\"][\\\"seed\\\"])\\n+    random.seed(seed)\\n+    np.random.seed(seed)\\n+    torch.manual_seed(seed)\\n+    torch.cuda.manual_seed_all(seed)\\n+    if not torch.cuda.is_available():\\n+        raise RuntimeError(\\\"FactoryBench canary requires CUDA\\\")\\n+\\n+    rows = load_rows(args.data_file, expected_sha256=str(config[\\\"source\\\"][\\\"sha256\\\"]))\\n+    receipt = source_receipt(\\n+        args.data_file,\\n+        revision=str(config[\\\"source\\\"][\\\"revision\\\"]),\\n+        expected_sha256=str(config[\\\"source\\\"][\\\"sha256\\\"]),\\n+        rows=rows,\\n+    )\\n+    write_source_receipt(run_root / \\\"source_receipt.json\\\", receipt)\\n+    split_manifest = build_component_split(\\n+        rows,\\n+        train_fraction=float(config[\\\"split\\\"][\\\"train_fraction\\\"]),\\n+        validation_fraction=float(config[\\\"split\\\"][\\\"validation_fraction\\\"]),\\n+        seed=seed,\\n+        receipt=receipt,\\n+    )\\n+    split_audit = audit_split(rows, split_manifest)\\n+    write_split_manifest(run_root / \\\"splits.json\\\", split_manifest)\\n+\\n+    model = load_model(config, \\\"cuda\\\")\\n+    eos = model.get_eos_token() or \\\"\\\"\\n+    train = FactoryBenchDataset(rows, split_manifest=split_manifest, split=\\\"train\\\", eos_token=eos)\\n+    validation = FactoryBenchDataset(rows, split_manifest=split_manifest, split=\\\"validation\\\", eos_token=eos)\\n+    if args.fit_probe:\\n+        train = balanced_subset(train, int(config[\\\"fit_probe\\\"][\\\"examples\\\"]), seed + 1)\\n+        validation_panel: Dataset = train\\n+        max_steps = int(config[\\\"fit_probe\\\"][\\\"steps\\\"])\\n+        batch_size = int(config[\\\"fit_probe\\\"][\\\"batch_size\\\"])\\n+        accumulation = 1\\n+    else:\\n+        validation_panel = balanced_subset(\\n+            validation, int(config[\\\"validation\\\"][\\\"generation_examples\\\"]), seed + 2\\n+        )\\n+        max_steps = int(config[\\\"training\\\"][\\\"max_steps\\\"])\\n+        batch_size = int(config[\\\"training\\\"][\\\"batch_size\\\"])\\n+        accumulation = int(config[\\\"training\\\"][\\\"gradient_accumulation_steps\\\"])\\n+\\n+    precision = str(config[\\\"training\\\"][\\\"precision\\\"])\\n+    optimizer_config = {\\n+        \\\"learning_rates\\\": config[\\\"training\\\"][\\\"learning_rates\\\"],\\n+    }\\n+    optimizer = optimizer_for(model, optimizer_config)\\n+    scheduler = scheduler_for(\\n+        optimizer,\\n+        max_steps,\\n+        warmup_fraction=float(config[\\\"training\\\"][\\\"warmup_fraction\\\"]),\\n+    )\\n+    manifest = {\\n+        \\\"run_name\\\": args.run_name,\\n+        \\\"fit_probe\\\": args.fit_probe,\\n+        \\\"config\\\": config,\\n+        \\\"config_sha256\\\": sha256_file(args.config),\\n+        \\\"split_audit\\\": split_audit,\\n+        \\\"train_examples\\\": len(train),\\n+        \\\"validation_examples\\\": len(validation),\\n+        \\\"validation_panel_examples\\\": len(validation_panel),\\n+        \\\"template_counts\\\": dict(Counter(str(row[\\\"template_id\\\"]) for row in rows)),\\n+        \\\"python\\\": platform.python_version(),\\n+        \\\"torch\\\": torch.__version__,\\n+        \\\"cuda\\\": torch.version.cuda,\\n+        \\\"gpu\\\": torch.cuda.get_device_name(0),\\n+        \\\"command\\\": \\\" \\\".join(__import__(\\\"sys\\\").argv),\\n+        \\\"test_evaluated\\\": False,\\n+    }\\n+    (run_root / \\\"run_manifest.json\\\").write_text(\\n+        json.dumps(manifest, indent=2, sort_keys=True) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\"\\n+    )\\n+    emit(metrics_path, \\\"run_start\\\", **manifest)\\n+\\n+    eval_batch_size = int(config[\\\"validation\\\"][\\\"batch_size\\\"])\\n+    loss_panel = balanced_subset(validation, int(config[\\\"validation\\\"][\\\"loss_examples\\\"]), seed + 3)\\n+    initial_loss = mean_loss(model, loss_panel, eval_batch_size, precision)\\n+    initial_metrics, _ = generate_rows(\\n+        model, validation_panel, eval_batch_size, run_root / \\\"generation_start.jsonl\\\"\\n+    )\\n+    emit(metrics_path, \\\"validation\\\", phase=\\\"start\\\", loss=initial_loss, **initial_metrics)\\n+\\n+    loader = DataLoader(train, batch_size=batch_size, shuffle=True, collate_fn=collate, num_workers=0)\\n+    context = (\\n+        torch.autocast(device_type=\\\"cuda\\\", dtype=torch.bfloat16)\\n+        if precision == \\\"bfloat16\\\"\\n+        else nullcontext()\\n+    )\\n+    start = time.monotonic()\\n+    deadline = start + float(config[\\\"training\\\"][\\\"max_wall_time_hours\\\"]) * 3600\\n+    step = 0\\n+    optimizer.zero_grad(set_to_none=True)\\n+    best_score = -1.0\\n+    stop_reason = \\\"max_steps\\\"\\n+    while step < max_steps:\\n+        for batch_index, batch in enumerate(loader):\\n+            if time.monotonic() >= deadline:\\n+                stop_reason = \\\"wall_time_limit\\\"\\n+                break\\n+            model.train()\\n+            with context:\\n+                loss = model.compute_loss(batch) / accumulation\\n+            loss.backward()\\n+            if (batch_index + 1) % accumulation != 0 and batch_index + 1 != len(loader):\\n+                continue\\n+            grad_norm = float(torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0).detach().cpu())\\n+            optimizer.step()\\n+            scheduler.step()\\n+            optimizer.zero_grad(set_to_none=True)\\n+            step += 1\\n+            if step == 1 or step % int(config[\\\"observability\\\"][\\\"log_every_steps\\\"]) == 0:\\n+                emit(\\n+                    metrics_path,\\n+                    \\\"train_step\\\",\\n+                    step=step,\\n+                    loss=float(loss.detach().cpu()) * accumulation,\\n+                    grad_norm=grad_norm,\\n+                    elapsed_seconds=time.monotonic() - start,\\n+                    gpu_allocated_gb=torch.cuda.memory_allocated() / 2**30,\\n+                )\\n+                write_status(status_path, state=\\\"training\\\", step=step, loss=float(loss.detach().cpu()))\\n+            cadence = int(config[\\\"fit_probe\\\"][\\\"generation_every_steps\\\"]) if args.fit_probe else 200\\n+            if step % cadence == 0 or step == max_steps:\\n+                metrics, generated = generate_rows(\\n+                    model, validation_panel, eval_batch_size, run_root / f\\\"generation_step_{step:06d}.jsonl\\\"\\n+                )\\n+                emit(metrics_path, \\\"validation\\\", phase=\\\"step\\\", step=step, **metrics)\\n+                eligible = float(metrics[\\\"coverage\\\"]) >= float(config[\\\"validation\\\"][\\\"coverage_gate\\\"])\\n+                score = float(metrics[\\\"template_macro_accuracy\\\"])\\n+                if eligible and score > best_score:\\n+                    best_score = score\\n+                    store_runtime_checkpoint(model, run_root / \\\"best_model.pt\\\")\\n+                model.train()\\n+            if step >= max_steps:\\n+                break\\n+        if stop_reason == \\\"wall_time_limit\\\" or step >= max_steps:\\n+            break\\n+\\n+    final_loss = mean_loss(model, loss_panel, eval_batch_size, precision)\\n+    final_metrics, final_rows = generate_rows(\\n+        model, validation_panel, eval_batch_size, run_root / \\\"generation_final.jsonl\\\"\\n+    )\\n+    zero_metrics, zero_rows = generate_rows(\\n+        model,\\n+        SignalAblationDataset(validation_panel, \\\"zero\\\"),\\n+        eval_batch_size,\\n+        run_root / \\\"generation_zero_signal.jsonl\\\",\\n+    )\\n+    reverse_metrics, reverse_rows = generate_rows(\\n+        model,\\n+        SignalAblationDataset(validation_panel, \\\"reverse\\\"),\\n+        eval_batch_size,\\n+        run_root / \\\"generation_reversed_time.jsonl\\\",\\n+    )\\n+    ablations = {\\n+        \\\"zero_prediction_change_rate\\\": prediction_change_rate(final_rows, zero_rows),\\n+        \\\"reverse_prediction_change_rate\\\": prediction_change_rate(final_rows, reverse_rows),\\n+        \\\"zero_accuracy\\\": zero_metrics[\\\"accuracy\\\"],\\n+        \\\"reverse_accuracy\\\": reverse_metrics[\\\"accuracy\\\"],\\n+    }\\n+    emit(metrics_path, \\\"validation\\\", phase=\\\"final\\\", step=step, loss=final_loss, **final_metrics)\\n+    emit(metrics_path, \\\"signal_ablation\\\", step=step, **ablations)\\n+    store_runtime_checkpoint(model, run_root / \\\"last_model.pt\\\")\\n+\\n+    fit_gate = None\\n+    if args.fit_probe:\\n+        fit_gate = (\\n+            float(final_metrics[\\\"accuracy\\\"]) >= float(config[\\\"fit_probe\\\"][\\\"minimum_train_accuracy\\\"])\\n+            and float(ablations[\\\"zero_prediction_change_rate\\\"])\\n+            >= float(config[\\\"fit_probe\\\"][\\\"minimum_prediction_change_rate\\\"])\\n+        )\\n+    write_status(\\n+        status_path,\\n+        state=\\\"complete\\\",\\n+        stop_reason=stop_reason,\\n+        step=step,\\n+        elapsed_seconds=time.monotonic() - start,\\n+        initial_metrics=initial_metrics,\\n+        final_metrics=final_metrics,\\n+        ablations=ablations,\\n+        fit_gate_passed=fit_gate,\\n+        test_evaluated=False,\\n+    )\\n+\\n+\\n+def main() -> None:\\n+    parser = argparse.ArgumentParser()\\n+    parser.add_argument(\\\"--config\\\", type=Path, required=True)\\n+    parser.add_argument(\\\"--data-file\\\", type=Path, required=True)\\n+    parser.add_argument(\\\"--output\\\", type=Path, default=Path(\\\"runs\\\"))\\n+    parser.add_argument(\\\"--run-name\\\", required=True)\\n+    parser.add_argument(\\\"--fit-probe\\\", action=\\\"store_true\\\")\\n+    args = parser.parse_args()\\n+    try:\\n+        run(args)\\n+    except Exception as error:\\n+        run_root = args.output / args.run_name\\n+        if run_root.exists():\\n+            write_status(run_root / \\\"status.json\\\", state=\\\"failed\\\", error=repr(error))\\n+        raise\\n+\\n+\\n+if __name__ == \\\"__main__\\\":\\n+    main()\\n*** End Patch\";\ntext(await tools.apply_patch(patch));","internal_chat_message_metadata_passthrough":{"turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","create_time":1789282119.160924}}}
{"timestamp":"2026-09-13T06:49:25.412Z","ordinal":15422,"type":"token_usage_record","payload":{"thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","session_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","root_turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","response_id":"resp_0f3535a43349ee3d016aa64746e00487d2b791ccc4772b79c7","usage":{"input_tokens":164334,"cached_input_tokens":164090,"cache_write_input_tokens":0,"output_tokens":5062,"reasoning_output_tokens":653,"total_tokens":169396},"turn_token_usage":{"input_tokens":7644626,"cached_input_tokens":7456231,"cache_write_input_tokens":179006,"output_tokens":25813,"reasoning_output_tokens":5923,"total_tokens":7670439},"thread_token_usage":{"input_tokens":293385160,"cached_input_tokens":286784370,"cache_write_input_tokens":6477831,"output_tokens":733328,"reasoning_output_tokens":226601,"total_tokens":294118488}}}
{"timestamp":"2026-09-13T06:49:28.148Z","ordinal":15423,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09736-d5c6-7cc3-a099-0521c0b02bd2","turn_id":"01a0997d-e59a-7ed3-9008-5472efcdac29","item":{"type":"FileChange","id":"exec-cd3d1b31-28e8-40b9-a0c0-1986127f4615","changes":{"/private/tmp/ysamet-factorybench/model_training/scripts/train_factorybench_opentslm.py":{"type":"add","content":"#!/usr/bin/env python3\n\"\"\"Run an isolated FactoryBench L1 OpenTSLM canary on a pinned source file.\n\nThis experiment deliberately does not alter Trace's KUKA trainer, runtime, API, or\ndeployed checkpoint.  Development uses only the generated validation split; test\nrows remain sealed for a later confirmation run.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport platform\nimport random\nimport time\nfrom collections import Counter\nfrom contextlib import nullcontext\nfrom pathlib import Path\n\nimport numpy as np\nimport torch\nimport yaml\nfrom torch.utils.data import DataLoader, Dataset, Subset\n\nfrom robot_observability.checkpoints import store_runtime_checkpoint\nfrom robot_observability.factorybench_data import (\n    FactoryBenchDataset,\n    audit_split,\n    build_component_split,\n    load_rows,\n    source_receipt,\n    write_source_receipt,\n    write_split_manifest,\n)\nfrom robot_observability.factorybench_metrics import evaluate_prediction_rows\nfrom robot_observability.train_opentslm import optimizer_for, scheduler_for\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef emit(path: Path, event: str, **payload: object) -> None:\n    row = {\"timestamp\": time.time(), \"event\": event, **payload}\n    line = json.dumps(row, sort_keys=True)\n    print(line, flush=True)\n    with path.open(\"a\", encoding=\"utf-8\") as handle:\n        handle.write(line + \"\\n\")\n\n\ndef write_status(path: Path, **payload: object) -> None:\n    temporary = path.with_suffix(\".tmp\")\n    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    temporary.replace(path)\n\n\ndef collate(batch: list[dict[str, object]]) -> list[dict[str, object]]:\n    return batch\n\n\ndef balanced_subset(dataset: FactoryBenchDataset, size: int, seed: int) -> Dataset:\n    groups: dict[int, list[int]] = {}\n    for index, row in enumerate(dataset.rows):\n        groups.setdefault(int(row[\"template_id\"]), []).append(index)\n    rng = np.random.default_rng(seed)\n    queues = {key: rng.permutation(values).tolist() for key, values in groups.items()}\n    selected: list[int] = []\n    while len(selected) < min(size, len(dataset)):\n        previous = len(selected)\n        for key in sorted(queues):\n            if queues[key] and len(selected) < size:\n                selected.append(int(queues[key].pop()))\n        if len(selected) == previous:\n            break\n    return Subset(dataset, selected)\n\n\nclass SignalAblationDataset:\n    def __init__(self, dataset: Dataset, mode: str) -> None:\n        if mode not in {\"zero\", \"reverse\"}:\n            raise ValueError(f\"Unknown ablation mode: {mode}\")\n        self.dataset = dataset\n        self.mode = mode\n\n    def __len__(self) -> int:\n        return len(self.dataset)\n\n    def __getitem__(self, index: int) -> dict[str, object]:\n        sample = dict(self.dataset[index])\n        transformed = []\n        for description, values in zip(sample[\"time_series_text\"], sample[\"time_series\"]):\n            tensor = values.detach().clone()\n            if \"relative timestamp\" not in str(description):\n                tensor = torch.zeros_like(tensor) if self.mode == \"zero\" else torch.flip(tensor, dims=(0,))\n            transformed.append(tensor)\n        sample[\"time_series\"] = transformed\n        return sample\n\n\ndef load_model(config: dict[str, object], device: str):\n    from opentslm.model.llm.OpenTSLMSP import OpenTSLMSP\n\n    model_config = config[\"model\"]\n    base_model = Path(str(model_config[\"base_model\"]))\n    warm_start = Path(str(model_config[\"warm_start_checkpoint\"]))\n    base_weights = base_model / \"model.safetensors\"\n    if sha256_file(base_weights) != str(model_config[\"base_model_sha256\"]):\n        raise ValueError(\"Local Llama backbone checksum mismatch\")\n    if sha256_file(warm_start) != str(model_config[\"warm_start_sha256\"]):\n        raise ValueError(\"HAR warm-start checkpoint checksum mismatch\")\n    model = OpenTSLMSP(llm_id=str(base_model), device=device)\n    lora = model_config[\"lora\"]\n    model.enable_lora(\n        lora_r=int(lora[\"rank\"]),\n        lora_alpha=int(lora[\"alpha\"]),\n        lora_dropout=float(lora[\"dropout\"]),\n    )\n    model.load_from_file(str(warm_start))\n    return model\n\n\n@torch.no_grad()\ndef mean_loss(model, dataset: Dataset, batch_size: int, precision: str) -> float:\n    model.eval()\n    losses = []\n    context = (\n        torch.autocast(device_type=\"cuda\", dtype=torch.bfloat16)\n        if precision == \"bfloat16\"\n        else nullcontext()\n    )\n    with context:\n        for batch in DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collate):\n            losses.append(float(model.compute_loss(batch).detach().cpu()))\n    return float(np.mean(losses)) if losses else math.nan\n\n\n@torch.no_grad()\ndef generate_rows(model, dataset: Dataset, batch_size: int, output_path: Path) -> tuple[dict, list]:\n    model.eval()\n    rows = []\n    with output_path.open(\"w\", encoding=\"utf-8\") as handle:\n        for batch in DataLoader(dataset, batch_size=batch_size, shuffle=False, collate_fn=collate):\n            outputs = model.generate(batch, max_new_tokens=12, do_sample=False)\n            for sample, output in zip(batch, outputs):\n                row = {\n                    \"id\": sample[\"id\"],\n                    \"template_id\": sample[\"template_id\"],\n                    \"output\": str(output).strip(),\n                    \"target\": sample[\"target\"],\n                    \"acceptance_bounds\": sample[\"acceptance_bounds\"],\n                }\n                rows.append(row)\n                handle.write(json.dumps(row, sort_keys=True) + \"\\n\")\n    return evaluate_prediction_rows(rows), rows\n\n\ndef prediction_change_rate(real_rows: list[dict], ablated_rows: list[dict]) -> float:\n    ablated = {str(row[\"id\"]): row.get(\"output\") for row in ablated_rows}\n    changed = [row.get(\"output\") != ablated.get(str(row[\"id\"])) for row in real_rows]\n    return float(np.mean(changed)) if changed else 0.0\n\n\ndef run(args: argparse.Namespace) -> None:\n    config = yaml.safe_load(args.config.read_text(encoding=\"utf-8\"))\n    run_root = args.output / args.run_name\n    run_root.mkdir(parents=True, exist_ok=False)\n    metrics_path = run_root / \"metrics.jsonl\"\n    status_path = run_root / \"status.json\"\n    write_status(status_path, state=\"initializing\", run_name=args.run_name)\n\n    seed = int(config[\"split\"][\"seed\"])\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    if not torch.cuda.is_available():\n        raise RuntimeError(\"FactoryBench canary requires CUDA\")\n\n    rows = load_rows(args.data_file, expected_sha256=str(config[\"source\"][\"sha256\"]))\n    receipt = source_receipt(\n        args.data_file,\n        revision=str(config[\"source\"][\"revision\"]),\n        expected_sha256=str(config[\"source\"][\"sha256\"]),\n        rows=rows,\n    )\n    write_source_receipt(run_root / \"source_receipt.json\", receipt)\n    split_manifest = build_component_split(\n        rows,\n        train_fraction=float(config[\"split\"][\"train_fraction\"]),\n        validation_fraction=float(config[\"split\"][\"validation_fraction\"]),\n        seed=seed,\n        receipt=receipt,\n    )\n    split_audit = audit_split(rows, split_manifest)\n    write_split_manifest(run_root / \"splits.json\", split_manifest)\n\n    model = load_model(config, \"cuda\")\n    eos = model.get_eos_token() or \"\"\n    train = FactoryBenchDataset(rows, split_manifest=split_manifest, split=\"train\", eos_token=eos)\n    validation = FactoryBenchDataset(rows, split_manifest=split_manifest, split=\"validation\", eos_token=eos)\n    if args.fit_probe:\n        train = balanced_subset(train, int(config[\"fit_probe\"][\"examples\"]), seed + 1)\n        validation_panel: Dataset = train\n        max_steps = int(config[\"fit_probe\"][\"steps\"])\n        batch_size = int(config[\"fit_probe\"][\"batch_size\"])\n        accumulation = 1\n    else:\n        validation_panel = balanced_subset(\n            validation, int(config[\"validation\"][\"generation_examples\"]), seed + 2\n        )\n        max_steps = int(config[\"training\"][\"max_steps\"])\n        batch_size = int(config[\"training\"][\"batch_size\"])\n        accumulation = int(config[\"training\"][\"gradient_accumulation_steps\"])\n\n    precision = str(config[\"training\"][\"precision\"])\n    optimizer_config = {\n        \"learning_rates\": config[\"training\"][\"learning_rates\"],\n    }\n    optimizer = optimizer_for(model, optimizer_config)\n    scheduler = scheduler_for(\n        optimizer,\n        max_steps,\n        warmup_fraction=float(config[\"training\"][\"warmup_fraction\"]),\n    )\n    manifest = {\n        \"run_name\": args.run_name,\n        \"fit_probe\": args.fit_probe,\n        \"config\": config,\n        \"config_sha256\": sha256_file(args.config),\n        \"split_audit\": split_audit,\n        \"train_examples\": len(train),\n        \"validation_examples\": len(validation),\n        \"validation_panel_examples\": len(validation_panel),\n        \"template_counts\": dict(Counter(str(row[\"template_id\"]) for row in rows)),\n        \"python\": platform.python_version(),\n        \"torch\": torch.__version__,\n        \"cuda\": torch.version.cuda,\n        \"gpu\": torch.cuda.get_device_name(0),\n        \"command\": \" \".join(__import__(\"sys\").argv),\n        \"test_evaluated\": False,\n    }\n    (run_root / \"run_manifest.json\").write_text(\n        json.dumps(manifest, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n    )\n    emit(metrics_path, \"run_start\", **manifest)\n\n    eval_batch_size = int(config[\"validation\"][\"batch_size\"])\n    loss_panel = balanced_subset(validation, int(config[\"validation\"][\"loss_examples\"]), seed + 3)\n    initial_loss = mean_loss(model, loss_panel, eval_batch_size, precision)\n    initial_metrics, _ = generate_rows(\n        model, validation_panel, eval_batch_size, run_root / \"generation_start.jsonl\"\n    )\n    emit(metrics_path, \"validation\", phase=\"start\", loss=initial_loss, **initial_metrics)\n\n    loader = DataLoader(train, batch_size=batch_size, shuffle=True, collate_fn=collate, num_workers=0)\n    context = (\n        torch.autocast(device_type=\"cuda\", dtype=torch.bfloat16)\n        if precision == \"bfloat16\"\n        else nullcontext()\n    )\n    start = time.monotonic()\n    deadline = start + float(config[\"training\"][\"max_wall_time_hours\"]) * 3600\n    step = 0\n    optimizer.zero_grad(set_to_none=True)\n    best_score = -1.0\n    stop_reason = \"max_steps\"\n    while step < max_steps:\n        for batch_index, batch in enumerate(loader):\n            if time.monotonic() >= deadline:\n                stop_reason = \"wall_time_limit\"\n                break\n            model.train()\n            with context:\n                loss = model.compute_loss(batch) / accumulation\n            loss.backward()\n            if (batch_index + 1) % accumulation != 0 and batch_index + 1 != len(loader):\n                continue\n            grad_norm = float(torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0).detach().cpu())\n            optimizer.step()\n            scheduler.step()\n            optimizer.zero_grad(set_to_none=True)\n            step += 1\n            if step == 1 or step % int(config[\"observability\"][\"log_every_steps\"]) == 0:\n                emit(\n                    metrics_path,\n                    \"train_step\",\n                    step=step,\n                    loss=float(loss.detach().cpu()) * accumulation,\n                    grad_norm=grad_norm,\n                    elapsed_seconds=time.monotonic() - start,\n                    gpu_allocated_gb=torch.cuda.memory_allocated() / 2**30,\n                )\n                write_status(status_path, state=\"training\", step=step, loss=float(loss.detach().cpu()))\n            cadence = int(config[\"fit_probe\"][\"generation_every_steps\"]) if args.fit_probe else 200\n            if step % cadence == 0 or step == max_steps:\n                metrics, generated = generate_rows(\n                    model, validation_panel, eval_batch_size, run_root / f\"generation_step_{step:06d}.jsonl\"\n                )\n                emit(metrics_path, \"validation\", phase=\"step\", step=step, **metrics)\n                eligible = float(metrics[\"coverage\"]) >= float(config[\"validation\"][\"coverage_gate\"])\n                score = float(metrics[\"template_macro_accuracy\"])\n                if eligible and score > best_score:\n                    best_score = score\n                    store_runtime_checkpoint(model, run_root / \"best_model.pt\")\n                model.train()\n            if step >= max_steps:\n                break\n        if stop_reason == \"wall_time_limit\" or step >= max_steps:\n            break\n\n    final_loss = mean_loss(model, loss_panel, eval_batch_size, precision)\n    final_metrics, final_rows = generate_rows(\n        model, validation_panel, eval_batch_size, run_root / \"generation_final.jsonl\"\n    )\n    zero_metrics, zero_rows = generate_rows(\n        model,\n        SignalAblationDataset(validation_panel, \"zero\"),\n        eval_batch_size,\n        run_root / \"generation_zero_signal.jsonl\",\n    )\n    reverse_metrics, reverse_rows = generate_rows(\n        model,\n        SignalAblationDataset(validation_panel, \"reverse\"),\n        eval_batch_size,\n        run_root / \"generation_reversed_time.jsonl\",\n    )\n    ablations = {\n        \"zero_prediction_change_rate\": prediction_change_rate(final_rows, zero_rows),\n        \"reverse_prediction_change_rate\": prediction_change_rate(final_rows, reverse_rows),\n        \"zero_accuracy\": zero_metrics[\"accuracy\"],\n        \"reverse_accuracy\": reverse_metrics[\"accuracy\"],\n    }\n    emit(metrics_path, \"validation\", phase=\"final\", step=step, loss=final_loss, **final_metrics)\n    emit(metrics_path, \"signal_ablation\", step=step, **ablations)\n    store_runtime_checkpoint(model, run_root / \"last_model.pt\")\n\n    fit_gate = None\n    if args.fit_probe:\n        fit_gate = (\n            float(final_metrics[\"accuracy\"]) >= float(config[\"fit_probe\"][\"minimum_train_accuracy\"])\n            and float(ablations[\"zero_prediction_change_rate\"])\n            >= float(config[\"fit_probe\"][\"minimum_prediction_change_rate\"])\n        )\n    write_status(\n        status_path,\n        state=\"complete\",\n        stop_reason=stop_reason,\n        step=step,\n        elapsed_seconds=time.monotonic() - start,\n        initial_metrics=initial_metrics,\n        final_metrics=final_metrics,\n        ablations=ablations,\n        fit_gate_passed=fit_gate,\n        test_evaluated=False,\n    )\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--config\", type=Path, required=True)\n    parser.add_argument(\"--data-file\", type=Path, required=True)\n    parser.add_argument(\"--output\", type=Path, default=Path(\"runs\"))\n    parser.add_argument(\"--run-name\", required=True)\n    parser.add_argument(\"--fit-probe\", action=\"store_true\")\n    args = parser.parse_args()\n    try:\n        run(args)\n    except Exception as error:\n        run_root = args.output / args.run_name\n        if run_root.exists():\n            write_status(run_root / \"status.json\", state=\"failed\", error=repr(error))\n        raise\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /private/tmp/ysamet-factorybench/model_training/scripts/train_factorybench_opentslm.py\n","stderr":""},"started_at_ms":1789282165383,"completed_at_ms":1789282168148}}
